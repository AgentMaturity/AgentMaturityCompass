{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgentMaturity/AgentMaturityCompass/qualification/receipt.schema.json",
  "title": "AMC qualification receipt",
  "description": "What ran, where, on which commit, and with what result. Validated by scripts/check-qualification-receipts.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "date", "commit", "branch", "node", "pnpm", "os", "arch", "commands", "tests", "artifacts", "notes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "key": { "type": "string", "pattern": "^(P[0-3]-[0-9]{2}|D-[0-9]{2}|GATE-G[0-3])$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "branch": { "type": "string", "minLength": 1 },
    "node": { "type": "string", "minLength": 1 },
    "pnpm": { "type": "string", "minLength": 1 },
    "os": { "type": "string", "minLength": 1 },
    "arch": { "enum": ["arm64", "x64"] },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cmd", "exit", "durationMs"],
        "properties": {
          "cmd": { "type": "string", "minLength": 1 },
          "exit": { "type": "integer" },
          "durationMs": { "type": "number", "minimum": 0 }
        }
      }
    },
    "tests": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "skipped"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
