    bioMedArenaReplayCommandHash: normalizeHashLabel(evaluation.bioMedArenaReplayCommandHash),
    bioMedArenaCiReceiptHash: normalizeHashLabel(evaluation.bioMedArenaCiReceiptHash),
    bioMedArenaBenchmarkFamilies: unique(
      (evaluation.bioMedArenaBenchmarkFamilies ?? [])
        .map(normalizeBioMedArenaBenchmarkFamily)
        .filter((value): value is ReplayBenchmarkBioMedArenaBenchmarkFamily => value !== null),
