function buildPawBenchEvaluationSummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkPawBenchEvaluationSummary {
  const pawBenchRows = rows.filter((row) => row.pawBenchEvaluation);
  const scores = pawBenchRows
    .map((row) => row.pawBenchEvaluation?.score0to1 ?? null)
    .filter((value): value is number => value !== null);
  const harnessGaps = pawBenchRows
    .map((row) => row.pawBenchEvaluation?.harnessGapDelta0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: pawBenchRows.length,
    modelIds: unique(pawBenchRows.map((row) => row.pawBenchEvaluation?.modelId ?? "")),
    harnessIds: unique(pawBenchRows.map((row) => row.pawBenchEvaluation?.harnessId ?? "")),
    taskSources: unique(
      pawBenchRows
        .map((row) => row.pawBenchEvaluation?.taskSource ?? "")
        .filter((value): value is ReplayBenchmarkPawBenchTaskSource => (
          pawBenchTaskSources.includes(value as ReplayBenchmarkPawBenchTaskSource)
        )),
    ) as ReplayBenchmarkPawBenchTaskSource[],
    scenarios: unique(
      pawBenchRows
        .map((row) => row.pawBenchEvaluation?.scenario ?? "")
        .filter((value): value is ReplayBenchmarkPawBenchScenario => (
          pawBenchScenarios.includes(value as ReplayBenchmarkPawBenchScenario)
        )),
    ) as ReplayBenchmarkPawBenchScenario[],
    capabilities: unique(
      pawBenchRows
        .map((row) => row.pawBenchEvaluation?.capability ?? "")
        .filter((value): value is ReplayBenchmarkPawBenchCapability => (
          pawBenchCapabilities.includes(value as ReplayBenchmarkPawBenchCapability)
        )),
    ) as ReplayBenchmarkPawBenchCapability[],
    gradingModes: unique(
      pawBenchRows
        .map((row) => row.pawBenchEvaluation?.gradingMode ?? "")
        .filter((value): value is ReplayBenchmarkPawBenchGradingMode => (
          pawBenchGradingModes.includes(value as ReplayBenchmarkPawBenchGradingMode)
        )),
    ) as ReplayBenchmarkPawBenchGradingMode[],
    failedRowIds: pawBenchRows.filter(isPawBenchEvaluationFailure).map((row) => row.rowId),
    openEnvironmentRowCount: pawBenchRows.filter((row) => row.pawBenchEvaluation?.environment === "open").length,
    savedWorkspaceRowCount: pawBenchRows.filter((row) => Boolean(row.pawBenchEvaluation?.savedWorkspaceHash)).length,
    savedDockerImageRowCount: pawBenchRows.filter((row) => Boolean(row.pawBenchEvaluation?.savedDockerImageHash)).length,
    averageScore0to1: scores.length === 0
      ? null
      : round(scores.reduce((sum, value) => sum + value, 0) / scores.length),
    averageHarnessGapDelta0to1: harnessGaps.length === 0
      ? null
      : round(harnessGaps.reduce((sum, value) => sum + value, 0) / harnessGaps.length),
  };
}

