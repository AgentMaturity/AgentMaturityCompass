          hackabilityAuditBackends.includes(value as ReplayBenchmarkHackabilityAuditBackend)
        )),
    ) as ReplayBenchmarkHackabilityAuditBackend[],
    vulnerabilityClasses: unique(
      auditRows.flatMap((row) => (
        row.benchmarkHackabilityAudit?.vulnerabilityFindings
          .map((finding) => finding.vulnerabilityClass ?? "")
          .filter((value): value is ReplayBenchmarkHackabilityVulnerabilityClass => (
            hackabilityVulnerabilityClasses.includes(value as ReplayBenchmarkHackabilityVulnerabilityClass)
          )) ?? []
      )),
    ) as ReplayBenchmarkHackabilityVulnerabilityClass[],
    failedRowIds: auditRows.filter(isBenchmarkHackabilityAuditFailure).map((row) => row.rowId),
    totalFindingCount: auditRows.reduce((sum, row) => (
      sum + (row.benchmarkHackabilityAudit?.vulnerabilityFindings.reduce((
        findingSum,
        finding,
      ) => findingSum + (finding.findingCount ?? 0), 0) ?? 0)
    ), 0),
    generatedPocCount: auditRows.reduce((sum, row) => sum + (row.benchmarkHackabilityAudit?.generatedPocCount ?? 0), 0),
    validatedPocCount: auditRows.reduce((sum, row) => sum + (row.benchmarkHackabilityAudit?.validatedPocCount ?? 0), 0),
    averageExploitabilityScore0to1: exploitabilityScores.length === 0
      ? null
      : round(exploitabilityScores.reduce((sum, value) => sum + value, 0) / exploitabilityScores.length),
  };
}

