function appendWarehouseNativeLlmEvalMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`warehouse-native llm eval ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`warehouse-native llm eval ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`warehouse-native llm eval ${label} below threshold`);
  }
}

function appendWarehouseNativeLlmEvalMaximumIssue(
  issues: string[],
  label: string,
  value: number | null,
  maximum: number | null,
): void {
  if (value === null) {
    issues.push(`warehouse-native llm eval ${label} missing`);
  }
  if (maximum === null) {
    issues.push(`warehouse-native llm eval ${label} threshold missing`);
  }
  if (value !== null && maximum !== null && value > maximum) {
    issues.push(`warehouse-native llm eval ${label} above threshold`);
  }
}

