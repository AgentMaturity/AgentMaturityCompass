}

function positiveInteger(value: number | null | undefined): number | null {
  if (typeof value !== "number" || !Number.isFinite(value)) return null;
  const integer = Math.trunc(value);
  return integer > 0 ? integer : null;
}

function nonNegativeNumber(value: number | undefined): number | null {
  if (typeof value !== "number" || !Number.isFinite(value)) return null;
  return value >= 0 ? round(value) : null;
}

function finiteNumber(value: number | null | undefined): number | null {
  if (typeof value !== "number" || !Number.isFinite(value)) return null;
  return round(value);
}

function nonNegativeInteger(value: number | null | undefined): number | null {
  if (typeof value !== "number" || !Number.isFinite(value)) return null;
  const integer = Math.trunc(value);
  return integer >= 0 ? integer : null;
}

function skillAxisScore(value: number | undefined): number | null {
  if (typeof value !== "number" || !Number.isFinite(value)) return null;
  return value >= 0 && value <= 10 ? round(value) : null;
}

function minSkillAxisScore(value: number | undefined): number | null {
  if (typeof value !== "number" || !Number.isFinite(value)) return null;
  return value >= 0 && value <= 10 ? round(value) : null;
}

function agentWorkflowRiskScore(value: number | undefined): number | null {
  if (typeof value !== "number" || !Number.isFinite(value)) return null;
  return value >= 0 && value <= 16 ? round(value) : null;
}

function fixtureHash(fixture: ReplayBenchmarkFixture): string {
  if (fixture.fixtureHash && isSha256(fixture.fixtureHash)) {
    return fixture.fixtureHash.toLowerCase();
  }
  const payload = {
    task: fixture.task,
    inputHash: fixture.inputHash,
    expectedHash: fixture.expectedHash,
    seed: fixture.seed,
    runtime: fixture.runtime,
    outputArtifactHashes: fixture.outputArtifactHashes,
    turnCount: fixture.turnCount,
    toolUse: fixture.toolUse,
    riskProfile: fixture.riskProfile,
    adversarialRegression: fixture.adversarialRegression,
    pairwiseComparison: fixture.pairwiseComparison,
    modalityPair: fixture.modalityPair,
    interactiveEpisode: fixture.interactiveEpisode,
    videoPostProduction: fixture.videoPostProduction,
    pawBenchEvaluation: fixture.pawBenchEvaluation,
    codingAgentReport: fixture.codingAgentReport,
    benchmarkHackabilityAudit: fixture.benchmarkHackabilityAudit,
    logicBenchmark: fixture.logicBenchmark,
    skillLifecycle: fixture.skillLifecycle,
    skillBenchmarkRegression: fixture.skillBenchmarkRegression,
    ragEvaluation: fixture.ragEvaluation,
    chunkingStrategyEvaluation: fixture.chunkingStrategyEvaluation,
    advancedRag: fixture.advancedRag,
    docThinkerDocumentRag: fixture.docThinkerDocumentRag,
    gageEvaluation: fixture.gageEvaluation,
    vlaWorldModel: fixture.vlaWorldModel,
    aiResearchTask: fixture.aiResearchTask,
    scientificEvaluation: fixture.scientificEvaluation,
    toolSandbox: fixture.toolSandbox,
    platformEvaluation: fixture.platformEvaluation,
    azureAgentLab: fixture.azureAgentLab,
    clawEnvKit: fixture.clawEnvKit,
    deepResearch: fixture.deepResearch,
    webSearchEvaluation: fixture.webSearchEvaluation,
    binaryAudit: fixture.binaryAudit,
    longTermMemory: fixture.longTermMemory,
    streamingImprovement: fixture.streamingImprovement,
    enterpriseToolCalling: fixture.enterpriseToolCalling,
    biomedicalAgentEvaluation: fixture.biomedicalAgentEvaluation,
    mlDevBenchmark: fixture.mlDevBenchmark,
    text2SqlAgent: fixture.text2SqlAgent,
    agentBenchmarkReplay: fixture.agentBenchmarkReplay,
    deepMathAgentReplay: fixture.deepMathAgentReplay,
    judgeItReplay: fixture.judgeItReplay,
    benchLoop: fixture.benchLoop,
    scenarioSimulation: fixture.scenarioSimulation,
    warehouseNativeLlmEval: fixture.warehouseNativeLlmEval,
    adGenSocDataset: fixture.adGenSocDataset,
    freshStackRetrieval: fixture.freshStackRetrieval,
    dbContextEnrichment: fixture.dbContextEnrichment,
    metadata: fixture.metadata,
  };
  return sha256Hex(canonicalize(payload));
}

