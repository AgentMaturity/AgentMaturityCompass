  );
  if (replay.aiAgentBenchmarkDeterministicSeed === null) {
    issues.push("agent benchmark replay ai-agent deterministic seed missing");
  }
  if (replay.aiAgentBenchmarkBaselineScore0to1 === null) {
    issues.push("agent benchmark replay ai-agent baseline score missing");
  }
  if (replay.aiAgentBenchmarkCandidateScore0to1 === null) {
