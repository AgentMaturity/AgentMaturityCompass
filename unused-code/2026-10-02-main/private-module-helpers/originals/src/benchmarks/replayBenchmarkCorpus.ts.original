function buildScientificEvaluationSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkScientificEvaluationSummary {
  const scienceRows = rows.filter((row) => row.scientificEvaluation);
  const capabilityCoverages = scienceRows
    .map((row) => row.scientificEvaluation?.capabilityCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const disciplineCoverages = scienceRows
    .map((row) => row.scientificEvaluation?.disciplineCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const scores = scienceRows
    .map((row) => row.scientificEvaluation?.averageScore0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: scienceRows.length,
    capabilityDimensions: unique(
      scienceRows.flatMap((row) => row.scientificEvaluation?.capabilityDimensions ?? []),
    ) as ReplayBenchmarkScientificCapability[],
    disciplines: unique(
      scienceRows.flatMap((row) => row.scientificEvaluation?.disciplines ?? []),
    ) as ReplayBenchmarkScientificDiscipline[],
    inputModalities: unique(
      scienceRows.flatMap((row) => row.scientificEvaluation?.inputModalities ?? []),
    ) as ReplayBenchmarkScientificInputModality[],
    scoringBackends: unique(
      scienceRows
        .map((row) => row.scientificEvaluation?.scoringBackend ?? "")
        .filter((value): value is ReplayBenchmarkScientificScoringBackend => (
          scientificScoringBackends.includes(value as ReplayBenchmarkScientificScoringBackend)
        )),
    ) as ReplayBenchmarkScientificScoringBackend[],
    failedRowIds: scienceRows.filter(isScientificEvaluationFailure).map((row) => row.rowId),
    totalTaskCount: scienceRows.reduce((sum, row) => sum + (row.scientificEvaluation?.taskCount ?? 0), 0),
    averageCapabilityCoverage0to1: capabilityCoverages.length === 0
      ? null
      : round(capabilityCoverages.reduce((sum, value) => sum + value, 0) / capabilityCoverages.length),
    averageDisciplineCoverage0to1: disciplineCoverages.length === 0
      ? null
      : round(disciplineCoverages.reduce((sum, value) => sum + value, 0) / disciplineCoverages.length),
    averageScore0to1: scores.length === 0 ? null : round(scores.reduce((sum, value) => sum + value, 0) / scores.length),
    leaderboardSnapshotCount: scienceRows.filter((row) => {
      const hash = row.scientificEvaluation?.leaderboardSnapshotHash;
      return Boolean(hash && isSha256(hash));
    }).length,
  };
}

function buildToolSandboxReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkToolSandboxReceipt | undefined {
