          codingAgentCategories.includes(value as ReplayBenchmarkCodingAgentCategory)
        )),
    ) as ReplayBenchmarkCodingAgentCategory[],
    recommendationUseCases: unique(
      reportRows.flatMap((row) => row.codingAgentReport?.recommendationUseCases ?? []),
    ) as ReplayBenchmarkCodingAgentUseCase[],
    failedRowIds: reportRows.filter(isCodingAgentReportFailure).map((row) => row.rowId),
    totalAgentCount: reportRows.reduce((sum, row) => sum + (row.codingAgentReport?.agentCount ?? 0), 0),
    totalCategoryCount: reportRows.reduce((sum, row) => sum + (row.codingAgentReport?.categoryScores.length ?? 0), 0),
    screenshotManifestCount: reportRows.filter((row) => Boolean(row.codingAgentReport?.screenshotManifestHash)).length,
    implementationArtifactCount: reportRows.filter((row) => Boolean(row.codingAgentReport?.implementationArtifactHash)).length,
    averageNormalizedScore0to1: normalizedScores.length === 0
      ? null
      : round(normalizedScores.reduce((sum, value) => sum + value, 0) / normalizedScores.length),
  };
}

