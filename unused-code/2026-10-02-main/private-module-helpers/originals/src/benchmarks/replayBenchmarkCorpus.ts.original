    issues.push("agent benchmark replay innovatorbench final score regression exceeds threshold");
  }
  if (replay.innovatorBenchBaselineBestScore === null) {
    issues.push("agent benchmark replay innovatorbench baseline best score missing");
  }
  if (replay.innovatorBenchCandidateBestScore === null) {
    issues.push("agent benchmark replay innovatorbench candidate best score missing");
  }
  if (replay.innovatorBenchBestScoreDelta === null) {
    issues.push("agent benchmark replay innovatorbench best score delta missing");
  }
  if (replay.maxInnovatorBenchBestScoreRegression === null) {
    issues.push("agent benchmark replay innovatorbench best score regression threshold missing");
  }
  if (
    replay.innovatorBenchBestScoreDelta !== null
    && replay.maxInnovatorBenchBestScoreRegression !== null
    && replay.innovatorBenchBestScoreDelta < -replay.maxInnovatorBenchBestScoreRegression
  ) {
    issues.push("agent benchmark replay innovatorbench best score regression exceeds threshold");
  }
  appendInnovatorBenchMinimumIssue(
    issues,
    "replay pass rate",
    replay.innovatorBenchReplayPassRate0to1,
    replay.minInnovatorBenchReplayPassRate0to1,
  );
  appendInnovatorBenchMinimumIssue(
    issues,
    "result coverage",
    replay.innovatorBenchResultCoverage0to1,
    replay.minInnovatorBenchResultCoverage0to1,
  );
  appendInnovatorBenchMinimumIssue(
    issues,
    "checkpoint restore coverage",
    replay.innovatorBenchCheckpointRestoreCoverage0to1,
    replay.minInnovatorBenchCheckpointRestoreCoverage0to1,
  );
  appendInnovatorBenchMinimumIssue(
    issues,
    "tool evidence coverage",
    replay.innovatorBenchToolEvidenceCoverage0to1,
    replay.minInnovatorBenchToolEvidenceCoverage0to1,
  );
  if (replay.innovatorBenchNoLeaderboardOnlyBoundary === null) {
    issues.push("agent benchmark replay innovatorbench leaderboard-only boundary flag missing");
  } else if (!replay.innovatorBenchNoLeaderboardOnlyBoundary) {
    issues.push("agent benchmark replay innovatorbench leaderboard-only boundary missing");
  }
  if (replay.innovatorBenchNoDatasetCopyBoundary === null) {
    issues.push("agent benchmark replay innovatorbench dataset-copy boundary flag missing");
  } else if (!replay.innovatorBenchNoDatasetCopyBoundary) {
    issues.push("agent benchmark replay innovatorbench dataset-copy boundary missing");
  }
}

function hasGtoWizardPokerReplaySignal(replay: ReplayBenchmarkAgentBenchmarkReplayReceipt): boolean {
  return [
    replay.gtoWizardBenchmarkId,
    replay.gtoWizardSourceRefHash,
    replay.gtoWizardRepositorySnapshotHash,
    replay.gtoWizardLicenseRefHash,
    replay.gtoWizardApiDocRefHash,
    replay.gtoWizardTechnicalPaperRefHash,
    replay.gtoWizardEvalPackManifestHash,
    replay.gtoWizardFixtureHash,
    replay.gtoWizardAgentPolicyManifestHash,
    replay.gtoWizardApiKeyScopeHash,
    replay.gtoWizardNoSolverAccessPolicyHash,
    replay.gtoWizardHandHistoryManifestHash,
    replay.gtoWizardActionTraceHash,
    replay.gtoWizardResultManifestHash,
    replay.gtoWizardAivatMetricReportHash,
    replay.gtoWizardLeaderboardSnapshotHash,
    replay.gtoWizardReplayCommandHash,
    replay.gtoWizardCiReceiptHash,
    replay.gtoWizardGameVariant,
  ].some((value) => value !== null)
    || replay.gtoWizardAgentTypeIds.length > 0
    || [
      replay.minGtoWizardAgentTypeCount,
      replay.gtoWizardHandCount,
      replay.minGtoWizardHandCount,
      replay.gtoWizardDeterministicSeed,
      replay.gtoWizardBaselineAivatBbPer100,
      replay.gtoWizardCandidateAivatBbPer100,
      replay.gtoWizardAivatScoreDeltaBbPer100,
      replay.maxGtoWizardAivatRegressionBbPer100,
      replay.gtoWizardReplayPassRate0to1,
      replay.minGtoWizardReplayPassRate0to1,
      replay.gtoWizardLegalActionRate0to1,
      replay.minGtoWizardLegalActionRate0to1,
    ].some((value) => value !== null);
}

function appendGtoWizardCountIssue(
  issues: string[],
  label: string,
  count: number,
  minimum: number | null,
): void {
  if (count === 0) {
    issues.push(`agent benchmark replay gtowizard ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay gtowizard ${label} threshold missing`);
  }
  if (minimum !== null && count < minimum) {
    issues.push(`agent benchmark replay gtowizard ${label} below threshold`);
  }
}

function appendGtoWizardMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`agent benchmark replay gtowizard ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay gtowizard ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`agent benchmark replay gtowizard ${label} below threshold`);
  }
}

function appendGtoWizardPokerReplayIssues(
  issues: string[],
  replay: ReplayBenchmarkAgentBenchmarkReplayReceipt,
): void {
  if (!hasGtoWizardPokerReplaySignal(replay)) {
    return;
  }
  if (!replay.gtoWizardBenchmarkId) {
    issues.push("agent benchmark replay gtowizard benchmark id missing");
  }
  if (!replay.gtoWizardGameVariant) {
    issues.push("agent benchmark replay gtowizard game variant missing");
  }
  for (const [label, hash] of [
    ["source ref", replay.gtoWizardSourceRefHash],
    ["repository snapshot", replay.gtoWizardRepositorySnapshotHash],
    ["license ref", replay.gtoWizardLicenseRefHash],
    ["api doc ref", replay.gtoWizardApiDocRefHash],
    ["technical paper ref", replay.gtoWizardTechnicalPaperRefHash],
    ["eval pack manifest", replay.gtoWizardEvalPackManifestHash],
    ["fixture", replay.gtoWizardFixtureHash],
    ["agent policy manifest", replay.gtoWizardAgentPolicyManifestHash],
    ["api key scope", replay.gtoWizardApiKeyScopeHash],
    ["no solver access policy", replay.gtoWizardNoSolverAccessPolicyHash],
    ["hand history manifest", replay.gtoWizardHandHistoryManifestHash],
    ["action trace", replay.gtoWizardActionTraceHash],
    ["result manifest", replay.gtoWizardResultManifestHash],
    ["aivat metric report", replay.gtoWizardAivatMetricReportHash],
    ["leaderboard snapshot", replay.gtoWizardLeaderboardSnapshotHash],
    ["replay command", replay.gtoWizardReplayCommandHash],
    ["ci receipt", replay.gtoWizardCiReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`agent benchmark replay gtowizard ${label} hash invalid`);
    }
  }
  appendGtoWizardCountIssue(
    issues,
    "agent type ids",
    replay.gtoWizardAgentTypeIds.length,
    replay.minGtoWizardAgentTypeCount,
  );
  appendGtoWizardMinimumIssue(
    issues,
    "hand count",
    replay.gtoWizardHandCount,
    replay.minGtoWizardHandCount,
  );
  if (replay.gtoWizardDeterministicSeed === null) {
    issues.push("agent benchmark replay gtowizard deterministic seed missing");
  }
  if (replay.gtoWizardBaselineAivatBbPer100 === null) {
    issues.push("agent benchmark replay gtowizard baseline aivat missing");
  }
  if (replay.gtoWizardCandidateAivatBbPer100 === null) {
    issues.push("agent benchmark replay gtowizard candidate aivat missing");
  }
  if (replay.gtoWizardAivatScoreDeltaBbPer100 === null) {
    issues.push("agent benchmark replay gtowizard aivat score delta missing");
  }
  if (replay.maxGtoWizardAivatRegressionBbPer100 === null) {
    issues.push("agent benchmark replay gtowizard aivat regression threshold missing");
  }
  if (
    replay.gtoWizardAivatScoreDeltaBbPer100 !== null
    && replay.maxGtoWizardAivatRegressionBbPer100 !== null
    && replay.gtoWizardAivatScoreDeltaBbPer100 < -replay.maxGtoWizardAivatRegressionBbPer100
  ) {
    issues.push("agent benchmark replay gtowizard aivat score regression exceeds threshold");
  }
  appendGtoWizardMinimumIssue(
    issues,
    "replay pass rate",
    replay.gtoWizardReplayPassRate0to1,
    replay.minGtoWizardReplayPassRate0to1,
  );
  appendGtoWizardMinimumIssue(
    issues,
    "legal action rate",
    replay.gtoWizardLegalActionRate0to1,
    replay.minGtoWizardLegalActionRate0to1,
  );
}

