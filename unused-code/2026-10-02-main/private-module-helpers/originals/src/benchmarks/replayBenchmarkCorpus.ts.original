    relevance0to1: nullableRate(rag.relevance0to1),
    completeness0to1: nullableRate(rag.completeness0to1),
    retrievalRecall0to1: nullableRate(rag.retrievalRecall0to1),
    qualityScoreMean0to1: qualityScores.length === 0
      ? null
      : round(qualityScores.reduce((sum, value) => sum + value, 0) / qualityScores.length),
    answerCorrectness0to1: nullableRate(rag.answerCorrectness0to1),
    answerRelevancy0to1: nullableRate(rag.answerRelevancy0to1),
    textContextRelevancy0to1: nullableRate(rag.textContextRelevancy0to1),
