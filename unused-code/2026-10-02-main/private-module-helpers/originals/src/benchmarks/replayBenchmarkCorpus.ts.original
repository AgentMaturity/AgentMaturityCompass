    security0to1: nullableRate(benchmark.security0to1),
    minSecurity0to1: nullableRate(benchmark.minSecurity0to1),
    completeness0to1: nullableRate(benchmark.completeness0to1),
    minCompleteness0to1: nullableRate(benchmark.minCompleteness0to1),
    robustness0to1: nullableRate(benchmark.robustness0to1),
    minRobustness0to1: nullableRate(benchmark.minRobustness0to1),
    baselineScore0to100: nullableScore0to100(benchmark.baselineScore0to100),
    withSkillScore0to100: nullableScore0to100(benchmark.withSkillScore0to100),
    minWithSkillScore0to100: nullableScore0to100(benchmark.minWithSkillScore0to100),
    scoreDelta0to100: nullableScoreDelta0to100(benchmark.scoreDelta0to100),
    minScoreDelta0to100: nullableScore0to100(benchmark.minScoreDelta0to100),
  };
}

function isSkillBenchmarkRegressionFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("skillbench "));
}

function buildSkillBenchmarkRegressionSummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkSkillBenchmarkRegressionSummary {
  const benchmarkRows = rows.filter((row) => row.skillBenchmarkRegression);
  const withSkillScores = benchmarkRows
    .map((row) => row.skillBenchmarkRegression?.withSkillScore0to100 ?? null)
    .filter((value): value is number => value !== null);
  const scoreDeltas = benchmarkRows
    .map((row) => row.skillBenchmarkRegression?.scoreDelta0to100 ?? null)
    .filter((value): value is number => value !== null);
  const correctnessScores = benchmarkRows
    .map((row) => row.skillBenchmarkRegression?.correctness0to1 ?? null)
    .filter((value): value is number => value !== null);
  const securityScores = benchmarkRows
    .map((row) => row.skillBenchmarkRegression?.security0to1 ?? null)
    .filter((value): value is number => value !== null);
  const completenessScores = benchmarkRows
    .map((row) => row.skillBenchmarkRegression?.completeness0to1 ?? null)
    .filter((value): value is number => value !== null);
  const robustnessScores = benchmarkRows
    .map((row) => row.skillBenchmarkRegression?.robustness0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: benchmarkRows.length,
    benchmarkIds: unique(
      benchmarkRows
        .map((row) => row.skillBenchmarkRegression?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    domains: unique(
      benchmarkRows
        .map((row) => row.skillBenchmarkRegression?.skillDomain ?? "")
        .filter((value): value is ReplayBenchmarkSkillBenchmarkDomain => (
          skillBenchmarkDomains.includes(value as ReplayBenchmarkSkillBenchmarkDomain)
        )),
    ) as ReplayBenchmarkSkillBenchmarkDomain[],
    evaluationModes: unique(
      benchmarkRows
        .map((row) => row.skillBenchmarkRegression?.evaluationMode ?? "")
        .filter((value): value is ReplayBenchmarkSkillBenchmarkEvaluationMode => (
          skillBenchmarkEvaluationModes.includes(value as ReplayBenchmarkSkillBenchmarkEvaluationMode)
        )),
    ) as ReplayBenchmarkSkillBenchmarkEvaluationMode[],
    failedRowIds: benchmarkRows.filter(isSkillBenchmarkRegressionFailure).map((row) => row.rowId),
    totalEvalCaseCount: benchmarkRows.reduce((sum, row) => sum + (row.skillBenchmarkRegression?.evalCaseCount ?? 0), 0),
    averageWithSkillScore0to100: withSkillScores.length === 0
      ? null
      : round(withSkillScores.reduce((sum, value) => sum + value, 0) / withSkillScores.length),
    averageScoreDelta0to100: scoreDeltas.length === 0
      ? null
      : round(scoreDeltas.reduce((sum, value) => sum + value, 0) / scoreDeltas.length),
    averageCorrectness0to1: correctnessScores.length === 0
      ? null
      : round(correctnessScores.reduce((sum, value) => sum + value, 0) / correctnessScores.length),
    averageSecurity0to1: securityScores.length === 0
      ? null
      : round(securityScores.reduce((sum, value) => sum + value, 0) / securityScores.length),
    averageCompleteness0to1: completenessScores.length === 0
      ? null
      : round(completenessScores.reduce((sum, value) => sum + value, 0) / completenessScores.length),
    averageRobustness0to1: robustnessScores.length === 0
      ? null
      : round(robustnessScores.reduce((sum, value) => sum + value, 0) / robustnessScores.length),
  };
}

function buildRagEvaluationReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkRagEvaluationReceipt | undefined {
  const rag = row.fixture.ragEvaluation;
  if (!rag) return undefined;
  const qualityScores = [
    nullableRate(rag.accuracy0to1),
    nullableRate(rag.relevance0to1),
    nullableRate(rag.completeness0to1),
    nullableRate(rag.retrievalRecall0to1),
  ].filter((value): value is number => value !== null);
  const multimodalJudgeScores = [
    nullableRate(rag.answerCorrectness0to1),
    nullableRate(rag.answerRelevancy0to1),
    nullableRate(rag.textContextRelevancy0to1),
    nullableRate(rag.imageContextRelevancy0to1),
    nullableRate(rag.textFaithfulness0to1),
    nullableRate(rag.imageFaithfulness0to1),
  ].filter((value): value is number => value !== null);
  const ragEvalFlowBaselineScore0to1 = nullableRate(rag.ragEvalFlowBaselineScore0to1);
  const ragEvalFlowCandidateScore0to1 = nullableRate(rag.ragEvalFlowCandidateScore0to1);
  const explicitRagEvalFlowScoreDelta0to1 = nullableScoreDelta(rag.ragEvalFlowScoreDelta0to1);
  const ragEvalDatasetBaselineScore0to1 = nullableRate(rag.ragEvalDatasetBaselineScore0to1);
  const ragEvalDatasetCandidateScore0to1 = nullableRate(rag.ragEvalDatasetCandidateScore0to1);
  const explicitRagEvalDatasetScoreDelta0to1 = nullableScoreDelta(rag.ragEvalDatasetScoreDelta0to1);
  const mirageBaselineQuality0to1 = nullableRate(rag.mirageBaselineQuality0to1);
  const mirageCandidateQuality0to1 = nullableRate(rag.mirageCandidateQuality0to1);
  const explicitMirageScoreDelta0to1 = nullableScoreDelta(rag.mirageScoreDelta0to1);
  const encourageBaselineScore0to1 = nullableRate(rag.encourageBaselineScore0to1);
  const encourageCandidateScore0to1 = nullableRate(rag.encourageCandidateScore0to1);
  const explicitEncourageScoreDelta0to1 = nullableScoreDelta(rag.encourageScoreDelta0to1);
  return {
    projectId: normalizeLabel(rag.projectId),
    datasetId: normalizeLabel(rag.datasetId),
    ragModalityMode: normalizeRagModalityMode(rag.ragModalityMode),
    vectorStoreMode: normalizeRagVectorStoreMode(rag.vectorStoreMode),
    corpusDocumentHash: normalizeHashLabel(rag.corpusDocumentHash),
    textCorpusHash: normalizeHashLabel(rag.textCorpusHash),
    imageCorpusHash: normalizeHashLabel(rag.imageCorpusHash),
    pdfExtractionTraceHash: normalizeHashLabel(rag.pdfExtractionTraceHash),
    imageExtractionTraceHash: normalizeHashLabel(rag.imageExtractionTraceHash),
    imageSummaryHash: normalizeHashLabel(rag.imageSummaryHash),
    chunkingConfigHash: normalizeHashLabel(rag.chunkingConfigHash),
    textVectorStoreHash: normalizeHashLabel(rag.textVectorStoreHash),
    imageVectorStoreHash: normalizeHashLabel(rag.imageVectorStoreHash),
    combinedVectorStoreHash: normalizeHashLabel(rag.combinedVectorStoreHash),
    multimodalEmbeddingConfigHash: normalizeHashLabel(rag.multimodalEmbeddingConfigHash),
    generatedQuestionSetHash: normalizeHashLabel(rag.generatedQuestionSetHash),
    referenceAnswerSetHash: normalizeHashLabel(rag.referenceAnswerSetHash),
    retrievalTraceHash: normalizeHashLabel(rag.retrievalTraceHash),
    generationTraceHash: normalizeHashLabel(rag.generationTraceHash),
    scoringReportHash: normalizeHashLabel(rag.scoringReportHash),
    humanReviewHash: normalizeHashLabel(rag.humanReviewHash),
    baselineRunHash: normalizeHashLabel(rag.baselineRunHash),
    correctContextRunHash: normalizeHashLabel(rag.correctContextRunHash),
    judgeModelId: normalizeLabel(rag.judgeModelId),
