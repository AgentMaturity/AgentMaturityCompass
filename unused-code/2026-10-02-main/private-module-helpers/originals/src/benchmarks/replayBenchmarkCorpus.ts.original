  const failedDbContextEnrichmentRows = manifest.rows.filter(isDbContextEnrichmentFailure);
  const passed = manifest.replayable && failedRows.length === 0;
  const receiptWithoutHash: Omit<ReplayBenchmarkCiReceipt, "receiptHash"> = {
    receiptId: `replay-ci:${manifest.manifestHash.slice(0, 16)}`,
