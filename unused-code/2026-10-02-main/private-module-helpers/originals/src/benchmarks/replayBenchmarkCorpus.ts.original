function normalizeModalityKind(value: ReplayBenchmarkModalityKind | undefined): ReplayBenchmarkModalityKind | null {
  if (typeof value !== "string") return null;
  const normalized = value.trim().toLowerCase();
  return modalityKinds.includes(normalized as ReplayBenchmarkModalityKind)
    ? normalized as ReplayBenchmarkModalityKind
    : null;
}

function normalizeFeedbackMode(value: ReplayBenchmarkFeedbackMode | undefined): ReplayBenchmarkFeedbackMode | null {
  if (typeof value !== "string") return null;
  const normalized = value.trim().toLowerCase();
  return feedbackModes.includes(normalized as ReplayBenchmarkFeedbackMode)
    ? normalized as ReplayBenchmarkFeedbackMode
    : null;
}

function normalizeVideoPostProductionFamily(
  value: ReplayBenchmarkVideoPostProductionFamily | undefined,
): ReplayBenchmarkVideoPostProductionFamily | null {
  if (typeof value !== "string") return null;
  const normalized = value.trim().toLowerCase().replace(/[-\s]+/g, "_");
  return videoPostProductionFamilies.includes(normalized as ReplayBenchmarkVideoPostProductionFamily)
    ? normalized as ReplayBenchmarkVideoPostProductionFamily
    : null;
}

function normalizeVideoPostProductionExecutor(
  value: ReplayBenchmarkVideoPostProductionExecutor | undefined,
