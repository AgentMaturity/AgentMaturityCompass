  }
  if (replay.spentSessionCostNoTelemetryBoundary !== true) {
    issues.push("agent benchmark replay spent session cost no-telemetry boundary missing");
  }
}

function hasFireFactCheckingSignal(replay: ReplayBenchmarkAgentBenchmarkReplayReceipt): boolean {
  return [
    replay.fireBenchmarkId,
    replay.fireSourceRefHash,
    replay.fireRepositorySnapshotHash,
    replay.firePaperRefHash,
    replay.fireDatasetManifestHash,
    replay.fireAtomicClaimManifestHash,
    replay.fireRetrieverConfigHash,
    replay.fireVerifierConfigHash,
    replay.fireDecisionPolicyHash,
    replay.fireSearchProviderConfigHash,
    replay.fireEvidenceTraceHash,
    replay.fireQueryTraceHash,
    replay.fireVerificationLabelHash,
    replay.fireCostReportHash,
    replay.fireResultManifestHash,
    replay.fireReplayCommandHash,
    replay.fireCiReceiptHash,
  ].some((value) => value !== null)
    || [
      replay.fireAtomicClaimCount,
      replay.minFireAtomicClaimCount,
      replay.fireRetrievalStepCount,
      replay.minFireRetrievalStepCount,
      replay.fireMaxRetrievalDepth,
      replay.fireDeterministicSeed,
      replay.fireBaselineFactuality0to1,
      replay.fireCandidateFactuality0to1,
      replay.fireFactualityDelta0to1,
      replay.maxFireFactualityRegression0to1,
      replay.fireBaselineLlmCostUsd,
      replay.fireCandidateLlmCostUsd,
      replay.fireLlmCostDeltaUsd,
      replay.maxFireLlmCostIncreaseUsd,
      replay.fireBaselineSearchCostUsd,
      replay.fireCandidateSearchCostUsd,
      replay.fireSearchCostDeltaUsd,
      replay.maxFireSearchCostIncreaseUsd,
      replay.fireReplayPassRate0to1,
      replay.minFireReplayPassRate0to1,
      replay.fireEvidenceRecall0to1,
      replay.minFireEvidenceRecall0to1,
      replay.fireLabelAgreement0to1,
      replay.minFireLabelAgreement0to1,
      replay.fireDynamicRetrievalBoundary,
      replay.fireSearchProviderBoundary,
    ].some((value) => value !== null);
}

function isFireFactCheckingRegressionIssue(issue: string): boolean {
  return [
    "agent benchmark replay fire atomic claim count below threshold",
    "agent benchmark replay fire retrieval step count below threshold",
    "agent benchmark replay fire factuality regression exceeds threshold",
    "agent benchmark replay fire llm cost increase exceeds threshold",
    "agent benchmark replay fire search cost increase exceeds threshold",
    "agent benchmark replay fire replay pass rate below threshold",
    "agent benchmark replay fire evidence recall below threshold",
    "agent benchmark replay fire label agreement below threshold",
  ].includes(issue);
}

function appendFireMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`agent benchmark replay fire ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay fire ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`agent benchmark replay fire ${label} below threshold`);
  }
}

function appendFireCostIncreaseIssue(
  issues: string[],
  label: string,
  value: number | null,
  maximum: number | null,
): void {
  if (value === null) {
    issues.push(`agent benchmark replay fire ${label} delta missing`);
  }
  if (maximum === null) {
    issues.push(`agent benchmark replay fire ${label} increase threshold missing`);
  }
  if (value !== null && maximum !== null && value > maximum) {
    issues.push(`agent benchmark replay fire ${label} increase exceeds threshold`);
  }
}

function appendFireFactCheckingIssues(
  issues: string[],
  replay: ReplayBenchmarkAgentBenchmarkReplayReceipt,
): void {
  if (!hasFireFactCheckingSignal(replay)) {
    return;
  }
  if (!replay.fireBenchmarkId) {
    issues.push("agent benchmark replay fire benchmark id missing");
  }
  for (const [label, hash] of [
    ["source ref", replay.fireSourceRefHash],
    ["repository snapshot", replay.fireRepositorySnapshotHash],
    ["paper ref", replay.firePaperRefHash],
    ["dataset manifest", replay.fireDatasetManifestHash],
    ["atomic claim manifest", replay.fireAtomicClaimManifestHash],
    ["retriever config", replay.fireRetrieverConfigHash],
    ["verifier config", replay.fireVerifierConfigHash],
    ["decision policy", replay.fireDecisionPolicyHash],
    ["search provider config", replay.fireSearchProviderConfigHash],
    ["evidence trace", replay.fireEvidenceTraceHash],
    ["query trace", replay.fireQueryTraceHash],
    ["verification label", replay.fireVerificationLabelHash],
    ["cost report", replay.fireCostReportHash],
    ["result manifest", replay.fireResultManifestHash],
    ["replay command", replay.fireReplayCommandHash],
    ["ci receipt", replay.fireCiReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`agent benchmark replay fire ${label} hash invalid`);
    }
  }
  appendFireMinimumIssue(
    issues,
    "atomic claim count",
    replay.fireAtomicClaimCount,
    replay.minFireAtomicClaimCount,
  );
  appendFireMinimumIssue(
    issues,
    "retrieval step count",
    replay.fireRetrievalStepCount,
    replay.minFireRetrievalStepCount,
  );
  if (replay.fireMaxRetrievalDepth === null) {
    issues.push("agent benchmark replay fire max retrieval depth missing");
  }
  if (replay.fireDeterministicSeed === null) {
    issues.push("agent benchmark replay fire deterministic seed missing");
  }
  if (replay.fireBaselineFactuality0to1 === null) {
    issues.push("agent benchmark replay fire baseline factuality missing");
  }
  if (replay.fireCandidateFactuality0to1 === null) {
    issues.push("agent benchmark replay fire candidate factuality missing");
  }
  if (replay.fireFactualityDelta0to1 === null) {
    issues.push("agent benchmark replay fire factuality delta missing");
  }
  if (replay.maxFireFactualityRegression0to1 === null) {
    issues.push("agent benchmark replay fire factuality regression threshold missing");
  }
  if (
    replay.fireFactualityDelta0to1 !== null
    && replay.maxFireFactualityRegression0to1 !== null
    && replay.fireFactualityDelta0to1 < -replay.maxFireFactualityRegression0to1
  ) {
    issues.push("agent benchmark replay fire factuality regression exceeds threshold");
  }
  if (replay.fireBaselineLlmCostUsd === null) {
    issues.push("agent benchmark replay fire baseline llm cost missing");
  }
  if (replay.fireCandidateLlmCostUsd === null) {
    issues.push("agent benchmark replay fire candidate llm cost missing");
  }
  appendFireCostIncreaseIssue(
    issues,
    "llm cost",
    replay.fireLlmCostDeltaUsd,
    replay.maxFireLlmCostIncreaseUsd,
  );
  if (replay.fireBaselineSearchCostUsd === null) {
    issues.push("agent benchmark replay fire baseline search cost missing");
  }
  if (replay.fireCandidateSearchCostUsd === null) {
    issues.push("agent benchmark replay fire candidate search cost missing");
  }
  appendFireCostIncreaseIssue(
    issues,
    "search cost",
    replay.fireSearchCostDeltaUsd,
    replay.maxFireSearchCostIncreaseUsd,
  );
  appendFireMinimumIssue(
    issues,
    "replay pass rate",
    replay.fireReplayPassRate0to1,
    replay.minFireReplayPassRate0to1,
  );
  appendFireMinimumIssue(
    issues,
    "evidence recall",
    replay.fireEvidenceRecall0to1,
    replay.minFireEvidenceRecall0to1,
  );
  appendFireMinimumIssue(
    issues,
    "label agreement",
    replay.fireLabelAgreement0to1,
    replay.minFireLabelAgreement0to1,
  );
  if (replay.fireDynamicRetrievalBoundary !== true) {
    issues.push("agent benchmark replay fire dynamic retrieval boundary missing");
  }
  if (replay.fireSearchProviderBoundary !== true) {
    issues.push("agent benchmark replay fire search provider boundary missing");
  }
}

