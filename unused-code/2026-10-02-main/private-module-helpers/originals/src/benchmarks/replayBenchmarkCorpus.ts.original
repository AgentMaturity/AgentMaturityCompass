  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkCodingAgentReportSummary {
  const reportRows = rows.filter((row) => row.codingAgentReport);
  const normalizedScores = reportRows
    .map((row) => row.codingAgentReport?.normalizedScore0to1 ?? null)
    .filter((value): value is number => value !== null);
