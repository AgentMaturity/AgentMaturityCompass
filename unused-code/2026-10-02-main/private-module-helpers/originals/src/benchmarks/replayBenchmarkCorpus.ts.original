    trajectoryTraceHash: normalizeHashLabel(sandbox.trajectoryTraceHash),
    toolRetrievalTraceHash: normalizeHashLabel(sandbox.toolRetrievalTraceHash),
    toolRetrievalRecall0to1: nullableRate(sandbox.toolRetrievalRecall0to1),
    verificationStepCoverage0to1: nullableRate(sandbox.verificationStepCoverage0to1),
    minVerificationStepCoverage0to1: nullableRate(sandbox.minVerificationStepCoverage0to1),
    recoveryAttemptCount: typeof sandbox.recoveryAttemptCount === "number" && Number.isFinite(sandbox.recoveryAttemptCount)
      ? Math.max(0, Math.trunc(sandbox.recoveryAttemptCount))
