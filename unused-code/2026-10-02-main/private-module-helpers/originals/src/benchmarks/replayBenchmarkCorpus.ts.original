function isWarehouseNativeLlmEvalFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("warehouse-native llm eval "));
}

function buildWarehouseNativeLlmEvalSummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkWarehouseNativeLlmEvalSummary {
  const warehouseRows = rows.filter((row) => row.warehouseNativeLlmEval);
  const driftAlertRates = warehouseRows
    .map((row) => row.warehouseNativeLlmEval?.driftAlertRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: warehouseRows.length,
    benchmarkIds: unique(
      warehouseRows
        .map((row) => row.warehouseNativeLlmEval?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    warehouses: unique(
      warehouseRows
        .map((row) => row.warehouseNativeLlmEval?.warehouse ?? "")
        .filter((value): value is ReplayBenchmarkWarehouseNativeLlmEvalWarehouse => (
          warehouseNativeLlmEvalWarehouses.includes(value as ReplayBenchmarkWarehouseNativeLlmEvalWarehouse)
        )),
    ) as ReplayBenchmarkWarehouseNativeLlmEvalWarehouse[],
    evaluationModes: unique(
      warehouseRows
        .map((row) => row.warehouseNativeLlmEval?.evaluationMode ?? "")
        .filter((value): value is ReplayBenchmarkWarehouseNativeLlmEvalMode => (
          warehouseNativeLlmEvalModes.includes(value as ReplayBenchmarkWarehouseNativeLlmEvalMode)
        )),
    ) as ReplayBenchmarkWarehouseNativeLlmEvalMode[],
    failedRowIds: warehouseRows.filter(isWarehouseNativeLlmEvalFailure).map((row) => row.rowId),
    totalModelCount: warehouseRows.reduce((sum, row) => sum + (row.warehouseNativeLlmEval?.modelCount ?? 0), 0),
    totalCapturedRowCount: warehouseRows.reduce((sum, row) => (
      sum + (row.warehouseNativeLlmEval?.capturedRowCount ?? 0)
    ), 0),
    totalEvaluatedRowCount: warehouseRows.reduce((sum, row) => (
      sum + (row.warehouseNativeLlmEval?.evaluatedRowCount ?? 0)
    ), 0),
    averageCaptureCoverage0to1: averageNullable(
      warehouseRows.map((row) => row.warehouseNativeLlmEval?.captureCoverage0to1 ?? null),
    ),
    averageJudgeScoreMean0to1: averageNullable(
      warehouseRows.map((row) => row.warehouseNativeLlmEval?.judgeScoreMean0to1 ?? null),
    ),
    averagePassRate0to1: averageNullable(
      warehouseRows.map((row) => row.warehouseNativeLlmEval?.passRate0to1 ?? null),
    ),
    maxDriftAlertRate0to1: driftAlertRates.length === 0 ? null : Math.max(...driftAlertRates),
    averageReplayPassRate0to1: averageNullable(
      warehouseRows.map((row) => row.warehouseNativeLlmEval?.replayPassRate0to1 ?? null),
    ),
    averageScoreDelta0to1: averageNullable(
      warehouseRows.map((row) => row.warehouseNativeLlmEval?.scoreDelta0to1 ?? null),
    ),
    dataEgressBlockedRowCount: warehouseRows.filter((row) => row.warehouseNativeLlmEval?.dataEgressBlocked).length,
  };
}

function buildAdGenSocDatasetReceipt(
  row: ReplayBenchmarkCorpusRowInput,
