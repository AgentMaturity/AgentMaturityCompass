}

function appendAgentKernelArenaIssues(
  issues: string[],
  replay: ReplayBenchmarkAgentBenchmarkReplayReceipt,
): void {
  if (!hasAgentKernelArenaSignal(replay)) {
    return;
  }
  if (!replay.agentKernelArenaBenchmarkId) {
    issues.push("agent benchmark replay agentkernelarena benchmark id missing");
  }
  for (const [label, hash] of [
    ["source ref", replay.agentKernelArenaSourceRefHash],
    ["repository snapshot", replay.agentKernelArenaRepositorySnapshotHash],
    ["license ref", replay.agentKernelArenaLicenseRefHash],
    ["task manifest", replay.agentKernelArenaTaskManifestHash],
    ["task config", replay.agentKernelArenaTaskConfigHash],
    ["agent roster", replay.agentKernelArenaAgentRosterHash],
    ["agent config", replay.agentKernelArenaAgentConfigHash],
    ["prompt template", replay.agentKernelArenaPromptTemplateHash],
    ["workspace isolation", replay.agentKernelArenaWorkspaceIsolationHash],
    ["environment manifest", replay.agentKernelArenaEnvironmentManifestHash],
    ["gpu profile", replay.agentKernelArenaGpuProfileHash],
    ["dependency lock", replay.agentKernelArenaDependencyLockHash],
    ["compile command", replay.agentKernelArenaCompileCommandHash],
    ["correctness command", replay.agentKernelArenaCorrectnessCommandHash],
    ["performance command", replay.agentKernelArenaPerformanceCommandHash],
    ["baseline kernel", replay.agentKernelArenaBaselineKernelHash],
    ["candidate kernel", replay.agentKernelArenaCandidateKernelHash],
    ["compile result", replay.agentKernelArenaCompileResultHash],
    ["correctness result", replay.agentKernelArenaCorrectnessResultHash],
    ["performance profile", replay.agentKernelArenaPerformanceProfileHash],
    ["score report", replay.agentKernelArenaScoreReportHash],
    ["run log", replay.agentKernelArenaRunLogHash],
    ["replay command", replay.agentKernelArenaReplayCommandHash],
    ["ci receipt", replay.agentKernelArenaCiReceiptHash],
    ["comparison report", replay.agentKernelArenaComparisonReportHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`agent benchmark replay agentkernelarena ${label} hash invalid`);
    }
  }
  appendAgentKernelArenaCountIssue(
    issues,
    "task category count",
    replay.agentKernelArenaTaskCategories.length,
    replay.minAgentKernelArenaTaskCategoryCount,
  );
  appendAgentKernelArenaCountIssue(
    issues,
    "agent type count",
    replay.agentKernelArenaAgentTypes.length,
    replay.minAgentKernelArenaAgentTypeCount,
  );
  appendAgentKernelArenaMinimumIssue(
    issues,
    "task count",
    replay.agentKernelArenaTaskCount,
    replay.minAgentKernelArenaTaskCount,
  );
  if (replay.agentKernelArenaDeterministicSeed === null) {
    issues.push("agent benchmark replay agentkernelarena deterministic seed missing");
  }
  appendAgentKernelArenaMinimumIssue(
    issues,
    "compilation success rate",
    replay.agentKernelArenaCompilationSuccessRate0to1,
    replay.minAgentKernelArenaCompilationSuccessRate0to1,
  );
  appendAgentKernelArenaMinimumIssue(
    issues,
    "correctness pass rate",
    replay.agentKernelArenaCorrectnessPassRate0to1,
    replay.minAgentKernelArenaCorrectnessPassRate0to1,
  );
  if (replay.agentKernelArenaBaselineSpeedupX === null) {
    issues.push("agent benchmark replay agentkernelarena baseline speedup missing");
  }
  if (replay.agentKernelArenaCandidateSpeedupX === null) {
    issues.push("agent benchmark replay agentkernelarena candidate speedup missing");
  }
  if (replay.agentKernelArenaSpeedupDeltaX === null) {
    issues.push("agent benchmark replay agentkernelarena speedup delta missing");
  }
  if (replay.maxAgentKernelArenaSpeedupRegressionX === null) {
    issues.push("agent benchmark replay agentkernelarena speedup regression threshold missing");
  }
  if (
    replay.agentKernelArenaSpeedupDeltaX !== null
    && replay.maxAgentKernelArenaSpeedupRegressionX !== null
    && replay.agentKernelArenaSpeedupDeltaX < -replay.maxAgentKernelArenaSpeedupRegressionX
  ) {
    issues.push("agent benchmark replay agentkernelarena speedup regression exceeds threshold");
  }
  appendAgentKernelArenaMinimumIssue(
    issues,
    "replay pass rate",
    replay.agentKernelArenaReplayPassRate0to1,
    replay.minAgentKernelArenaReplayPassRate0to1,
  );
  appendAgentKernelArenaMinimumIssue(
    issues,
    "result coverage",
    replay.agentKernelArenaResultCoverage0to1,
    replay.minAgentKernelArenaResultCoverage0to1,
  );
  if (replay.agentKernelArenaWorkspaceIsolated === null) {
    issues.push("agent benchmark replay agentkernelarena workspace isolation flag missing");
  } else if (!replay.agentKernelArenaWorkspaceIsolated) {
    issues.push("agent benchmark replay agentkernelarena workspace isolation disabled");
  }
  if (replay.agentKernelArenaNoLeaderboardOnlyBoundary === null) {
    issues.push("agent benchmark replay agentkernelarena leaderboard-only boundary flag missing");
  } else if (!replay.agentKernelArenaNoLeaderboardOnlyBoundary) {
    issues.push("agent benchmark replay agentkernelarena leaderboard-only boundary missing");
  }
}

function hasLlmEvaluationSystemSignal(replay: ReplayBenchmarkAgentBenchmarkReplayReceipt): boolean {
  return [
