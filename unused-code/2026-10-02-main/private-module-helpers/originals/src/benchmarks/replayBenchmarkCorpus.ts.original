    || issues.includes("skillbench with-skill score below threshold")
    || issues.includes("skillbench score delta below threshold")
    || issues.some(isRagEvalFlowRegressionIssue)
    || issues.some(isRagEvalDatasetRegressionIssue)
    || issues.includes("chunking strategy question count below threshold")
    || issues.includes("chunking strategy chunker count below threshold")
    || issues.includes("chunking strategy candidate score below threshold")
    || issues.includes("chunking strategy score regression exceeds threshold")
    || issues.includes("chunking strategy answer span coverage below threshold")
    || issues.includes("chunking strategy semantic focus below threshold")
    || issues.includes("ai research valid submission false")
    || issues.includes("scientific capability coverage below threshold")
    || issues.includes("scientific discipline coverage below threshold")
    || issues.includes("tool sandbox verification coverage below threshold")
    || issues.includes("platform evaluated row count exceeds dataset row count")
    || issues.includes("web search domain coverage below threshold")
    || issues.includes("web search question-type coverage below threshold")
    || issues.includes("web search source-link coverage below threshold")
    || issues.includes("binary audit expected decision not met")
    || issues.includes("binary audit false positive rate above threshold")
    || issues.includes("long-term memory score below threshold")
    || issues.some(isRealTalkRegressionIssue)
    || issues.some(isCloneMemRegressionIssue)
    || issues.some(isMemEvalRegressionIssue)
    || issues.includes("streaming improvement online update disabled")
    || issues.includes("streaming improvement sanity check failed")
    || issues.includes("streaming improvement delta below threshold")
    || issues.includes("streaming improvement retention below threshold")
    || issues.includes("streaming improvement forgetting above threshold")
    || issues.includes("enterprise tool calling reasoning step count below minimum")
    || issues.includes("enterprise tool calling reasoning step count above maximum")
    || issues.includes("enterprise tool calling tool call count below minimum")
    || issues.includes("enterprise tool calling policy adherence below threshold")
    || issues.includes("enterprise tool calling groundedness below threshold")
    || issues.includes("enterprise tool calling exact tool response match below threshold")
    || issues.includes("enterprise tool calling final answer score below threshold")
    || issues.includes("enterprise tool calling deterministic replay disabled")
    || issues.includes("enterprise tool calling output validation failed")
    || issues.includes("biomedical agent evaluation completed task count exceeds task count")
    || issues.includes("biomedical agent evaluation score below threshold")
    || issues.includes("biomedical agent evaluation safe code execution disabled")
    || issues.includes("ml-dev benchmark candidate metric below threshold")
    || issues.includes("ml-dev benchmark task pass rate below threshold")
    || issues.includes("ml-dev benchmark score regression exceeds threshold")
    || issues.includes("text2sql agent query count below threshold")
    || issues.includes("text2sql agent execution accuracy below threshold")
    || issues.includes("text2sql agent exact match below threshold")
    || issues.includes("text2sql agent retrieval grounding below threshold")
    || issues.includes("text2sql agent unsafe sql rate above threshold")
    || issues.includes("text2sql agent rls violation rate above threshold")
    || issues.includes("agent benchmark replay sample count below threshold")
    || issues.includes("agent benchmark replay trace saved disabled")
    || issues.includes("agent benchmark replay replay pass rate below threshold")
    || issues.includes("agent benchmark replay trace coverage below threshold")
    || issues.includes("agent benchmark replay score regression exceeds threshold")
    || issues.some(isAiAgentBenchmarkComparisonRegressionIssue)
    || issues.some(isGaiaAgentReplayRegressionIssue)
    || issues.some(isSocialReasoningBenchRegressionIssue)
    || issues.some(isBestTesterRegressionIssue)
    || issues.some(isAgentKernelArenaRegressionIssue)
    || issues.some(isLlmEvaluationSystemRegressionIssue)
    || issues.some(isInnovatorBenchRegressionIssue)
    || issues.some(isResearchHarnessRegressionIssue)
    || issues.some(isAgentMontRegressionIssue)
    || issues.some(isKnowlyticsAiRegressionIssue)
    || issues.some(isSpentSessionCostRegressionIssue)
    || issues.some(isFireFactCheckingRegressionIssue)
    || issues.some(isNucliaRagTriadRegressionIssue)
    || issues.includes("deepmath agent replay sample count below threshold")
    || issues.includes("deepmath agent replay majority@16 accuracy below threshold")
    || issues.includes("deepmath agent replay exact answer accuracy below threshold")
    || issues.includes("deepmath agent replay code snippet use below threshold")
    || issues.includes("deepmath agent replay sandbox violation rate above threshold")
    || issues.includes("deepmath agent replay execution timeout rate above threshold")
    || issues.includes("deepmath agent replay output token reduction below threshold")
    || issues.includes("deepmath agent replay replay pass rate below threshold")
    || issues.includes("deepmath agent replay score regression exceeds threshold")
    || issues.includes("judgeit replay sample count below threshold")
    || issues.includes("judgeit replay score regression exceeds threshold")
    || issues.includes("judgeit replay precision below threshold")
    || issues.includes("judgeit replay recall below threshold")
    || issues.includes("judgeit replay f1 below threshold")
    || issues.includes("judgeit replay human agreement f1 below threshold")
    || issues.includes("judgeit replay false negative rate above threshold")
    || issues.includes("judgeit replay replay pass rate below threshold")
    || issues.includes("judgeit replay blackbox score below threshold")
    || issues.includes("judgeit replay whitebox trace invalid")
    || issues.includes("judgeit replay negative testing harmful rate above threshold")
    || issues.some(isBenchLoopRegressionIssue)
    || issues.some(isScenarioSimulationRegressionIssue)
    || issues.some(isWarehouseNativeLlmEvalRegressionIssue)
    || issues.some(isAdGenSocDatasetRegressionIssue)
    || issues.some(isDocThinkerDocumentRagRegressionIssue)
    || issues.includes("freshstack retrieval query count below threshold")
    || issues.includes("freshstack retrieval corpus document count below threshold")
    || issues.includes("freshstack retrieval topic coverage below threshold")
    || issues.includes("freshstack retrieval alpha-nDCG@10 below threshold")
    || issues.includes("freshstack retrieval coverage@20 below threshold")
    || issues.includes("freshstack retrieval recall@50 below threshold")
    || issues.includes("freshstack retrieval replay pass rate below threshold")
    || issues.includes("freshstack retrieval score regression exceeds threshold")
    || issues.includes("db context enrichment golden question count below threshold")
    || issues.includes("db context enrichment context item count below threshold")
    || issues.includes("db context enrichment candidate sql accuracy below threshold")
    || issues.includes("db context enrichment context reuse coverage below threshold")
    || issues.includes("db context enrichment executable sql rate below threshold")
    || issues.includes("db context enrichment hallucinated column rate above threshold")
    || issues.includes("db context enrichment replay pass rate below threshold")
    || issues.includes("db context enrichment score regression exceeds threshold")
  ) {
    return "regressed";
  }
  return "passed";
}

