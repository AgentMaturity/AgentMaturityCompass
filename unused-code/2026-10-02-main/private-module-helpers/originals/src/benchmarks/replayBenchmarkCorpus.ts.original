function isRealTalkRegressionIssue(issue: string): boolean {
  return [
    "long-term memory realtalk conversation day span below threshold",
    "long-term memory realtalk participant count below threshold",
    "long-term memory realtalk question count below threshold",
    "long-term memory realtalk lexical f1 score below threshold",
    "long-term memory realtalk gpt score below threshold",
    "long-term memory realtalk persona consistency below threshold",
    "long-term memory realtalk emotional intelligence coverage below threshold",
  ].includes(issue);
}

function isCloneMemRegressionIssue(issue: string): boolean {
  return [
    "long-term memory clonemem trace kind count below threshold",
    "long-term memory clonemem task category count below threshold",
    "long-term memory clonemem language count below threshold",
    "long-term memory clonemem persona count below threshold",
    "long-term memory clonemem question count below threshold",
    "long-term memory clonemem context span below threshold",
    "long-term memory clonemem evidence grounding below threshold",
    "long-term memory clonemem temporal consistency below threshold",
    "long-term memory clonemem unanswerable accuracy below threshold",
    "long-term memory clonemem trajectory reasoning below threshold",
    "long-term memory clonemem replay pass rate below threshold",
    "long-term memory clonemem score delta below threshold",
  ].includes(issue);
}

function isMemEvalRegressionIssue(issue: string): boolean {
  return [
    "long-term memory memeval benchmark count below threshold",
    "long-term memory memeval memory system count below threshold",
    "long-term memory memeval metric kind count below threshold",
    "long-term memory memeval question count below threshold",
    "long-term memory memeval conversation count below threshold",
    "long-term memory memeval token f1 below threshold",
    "long-term memory memeval judge score below threshold",
    "long-term memory memeval category breakdown coverage below threshold",
    "long-term memory memeval replay pass rate below threshold",
    "long-term memory memeval score delta below threshold",
  ].includes(issue);
}

function appendMemEvalLongTermMemoryIssues(
  longTermMemory: ReplayBenchmarkLongTermMemoryReceipt,
  issues: string[],
): void {
  if (!hasMemEvalSignal(longTermMemory)) return;

  for (const [label, hash] of [
    ["source reference", longTermMemory.memEvalSourceRefHash],
    ["repository snapshot", longTermMemory.memEvalRepositorySnapshotHash],
    ["license reference", longTermMemory.memEvalLicenseRefHash],
    ["benchmark manifest", longTermMemory.memEvalBenchmarkManifestHash],
    ["dataset manifest", longTermMemory.memEvalDatasetManifestHash],
    ["question set", longTermMemory.memEvalQuestionSetHash],
    ["conversation manifest", longTermMemory.memEvalConversationManifestHash],
    ["memory system roster", longTermMemory.memEvalMemorySystemRosterHash],
    ["system config", longTermMemory.memEvalSystemConfigHash],
    ["llm config", longTermMemory.memEvalLlmConfigHash],
    ["embedding config", longTermMemory.memEvalEmbeddingConfigHash],
    ["scoring pipeline", longTermMemory.memEvalScoringPipelineHash],
    ["judge config", longTermMemory.memEvalJudgeConfigHash],
    ["token cost trace", longTermMemory.memEvalTokenCostTraceHash],
    ["result artifact", longTermMemory.memEvalResultArtifactHash],
    ["replay command", longTermMemory.memEvalReplayCommandHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`long-term memory memeval ${label} hash invalid`);
    }
  }

  const minBenchmarkCount = longTermMemory.minMemEvalBenchmarkCount ?? 1;
  if (longTermMemory.memEvalBenchmarkIds.length === 0) {
    issues.push("long-term memory memeval benchmarks missing");
  } else if (longTermMemory.memEvalBenchmarkIds.length < minBenchmarkCount) {
    issues.push("long-term memory memeval benchmark count below threshold");
  }

  const minMemorySystemCount = longTermMemory.minMemEvalMemorySystemCount ?? 1;
  if (longTermMemory.memEvalMemorySystems.length === 0) {
    issues.push("long-term memory memeval memory systems missing");
  } else if (longTermMemory.memEvalMemorySystems.length < minMemorySystemCount) {
    issues.push("long-term memory memeval memory system count below threshold");
  }

  const minMetricKindCount = longTermMemory.minMemEvalMetricKindCount ?? 1;
  if (longTermMemory.memEvalMetricKinds.length === 0) {
    issues.push("long-term memory memeval metric kinds missing");
  } else if (longTermMemory.memEvalMetricKinds.length < minMetricKindCount) {
    issues.push("long-term memory memeval metric kind count below threshold");
  }

  if (longTermMemory.memEvalQuestionCount === null) {
    issues.push("long-term memory memeval question count missing");
  } else if (longTermMemory.memEvalQuestionCount < (longTermMemory.minMemEvalQuestionCount ?? 1)) {
    issues.push("long-term memory memeval question count below threshold");
  }
  if (longTermMemory.memEvalConversationCount === null) {
    issues.push("long-term memory memeval conversation count missing");
  } else if (longTermMemory.memEvalConversationCount < (longTermMemory.minMemEvalConversationCount ?? 1)) {
    issues.push("long-term memory memeval conversation count below threshold");
  }
  if (longTermMemory.memEvalAverageTokenF1_0to1 === null) {
    issues.push("long-term memory memeval token f1 missing");
  } else if (
    longTermMemory.memEvalAverageTokenF1_0to1 < (longTermMemory.minMemEvalAverageTokenF1_0to1 ?? 0)
  ) {
    issues.push("long-term memory memeval token f1 below threshold");
  }
  if (longTermMemory.memEvalAverageJudgeScore0to1 === null) {
    issues.push("long-term memory memeval judge score missing");
  } else if (
    longTermMemory.memEvalAverageJudgeScore0to1 < (longTermMemory.minMemEvalAverageJudgeScore0to1 ?? 0)
  ) {
    issues.push("long-term memory memeval judge score below threshold");
  }
  if (longTermMemory.memEvalTokenCostTracked === null) {
    issues.push("long-term memory memeval token cost tracking missing");
  } else if (!longTermMemory.memEvalTokenCostTracked) {
    issues.push("long-term memory memeval token cost tracking disabled");
  }
  if (longTermMemory.memEvalCategoryBreakdownCoverage0to1 === null) {
    issues.push("long-term memory memeval category breakdown coverage missing");
  } else if (
    longTermMemory.memEvalCategoryBreakdownCoverage0to1 < (
      longTermMemory.minMemEvalCategoryBreakdownCoverage0to1 ?? 0.95
    )
  ) {
    issues.push("long-term memory memeval category breakdown coverage below threshold");
  }
  if (longTermMemory.memEvalReplayPassRate0to1 === null) {
    issues.push("long-term memory memeval replay pass rate missing");
  } else if (longTermMemory.memEvalReplayPassRate0to1 < (longTermMemory.minMemEvalReplayPassRate0to1 ?? 0.95)) {
    issues.push("long-term memory memeval replay pass rate below threshold");
  }
  if (longTermMemory.memEvalScoreDelta0to1 === null) {
    issues.push("long-term memory memeval score delta missing");
  } else if (longTermMemory.memEvalScoreDelta0to1 < (longTermMemory.minMemEvalScoreDelta0to1 ?? 0)) {
    issues.push("long-term memory memeval score delta below threshold");
  }
}

function isLongTermMemoryFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("long-term memory benchmark id missing")
    || row.issues.includes("long-term memory benchmark version missing")
    || row.issues.includes("long-term memory configuration hash invalid")
    || row.issues.includes("long-term memory dataset spec hash invalid")
    || row.issues.includes("long-term memory dataset interface hash invalid")
    || row.issues.includes("long-term memory model interface hash invalid")
    || row.issues.includes("long-term memory runner config hash invalid")
    || row.issues.includes("long-term memory test spec hash invalid")
    || row.issues.includes("long-term memory conversation trace hash invalid")
    || row.issues.includes("long-term memory update trace hash invalid")
    || row.issues.includes("long-term memory retrieval trace hash invalid")
    || row.issues.includes("long-term memory result artifact hash invalid")
    || row.issues.includes("long-term memory report artifact hash invalid")
    || row.issues.includes("long-term memory span missing")
    || row.issues.includes("long-term memory context limit missing")
    || row.issues.includes("long-term memory generated test count missing")
    || row.issues.includes("long-term memory score missing")
    || row.issues.includes("long-term memory score below threshold")
    || row.issues.some((issue) => issue.startsWith("long-term memory realtalk "))
    || row.issues.some((issue) => issue.startsWith("long-term memory clonemem "))
    || row.issues.some((issue) => issue.startsWith("long-term memory memeval "));
}

function buildLongTermMemorySummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkLongTermMemorySummary {
  const memoryRows = rows.filter((row) => row.longTermMemory);
  const realTalkRows = memoryRows.filter((row) => row.longTermMemory && hasRealTalkSignal(row.longTermMemory));
  const cloneMemRows = memoryRows.filter((row) => row.longTermMemory && hasCloneMemSignal(row.longTermMemory));
  const memEvalRows = memoryRows.filter((row) => row.longTermMemory && hasMemEvalSignal(row.longTermMemory));
  const memorySpans = memoryRows
    .map((row) => row.longTermMemory?.memorySpanTokens ?? null)
    .filter((value): value is number => value !== null);
  const scores = memoryRows
    .map((row) => row.longTermMemory?.score0to1 ?? null)
    .filter((value): value is number => value !== null);
  const realTalkConversationSpans = realTalkRows
    .map((row) => row.longTermMemory?.realTalkConversationDaySpan ?? null)
    .filter((value): value is number => value !== null);
  const realTalkLexicalScores = realTalkRows
    .map((row) => row.longTermMemory?.realTalkLexicalF1Score0to1 ?? null)
    .filter((value): value is number => value !== null);
  const realTalkGptScores = realTalkRows
    .map((row) => row.longTermMemory?.realTalkGptScore0to1 ?? null)
    .filter((value): value is number => value !== null);
  const realTalkEiCoverageScores = realTalkRows
    .map((row) => row.longTermMemory?.realTalkEiCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const cloneMemContextSpans = cloneMemRows
    .map((row) => row.longTermMemory?.cloneMemContextSpanMonths ?? null)
    .filter((value): value is number => value !== null);
  const cloneMemEvidenceGroundingScores = cloneMemRows
    .map((row) => row.longTermMemory?.cloneMemEvidenceGrounding0to1 ?? null)
    .filter((value): value is number => value !== null);
  const cloneMemReplayPassRates = cloneMemRows
    .map((row) => row.longTermMemory?.cloneMemReplayPassRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const memEvalTokenF1Scores = memEvalRows
    .map((row) => row.longTermMemory?.memEvalAverageTokenF1_0to1 ?? null)
    .filter((value): value is number => value !== null);
  const memEvalJudgeScores = memEvalRows
    .map((row) => row.longTermMemory?.memEvalAverageJudgeScore0to1 ?? null)
    .filter((value): value is number => value !== null);
  const memEvalReplayPassRates = memEvalRows
    .map((row) => row.longTermMemory?.memEvalReplayPassRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: memoryRows.length,
    benchmarkVersions: unique(
      memoryRows
        .map((row) => row.longTermMemory?.benchmarkVersion ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    failedRowIds: memoryRows.filter(isLongTermMemoryFailure).map((row) => row.rowId),
    maxMemorySpanTokens: memorySpans.length === 0 ? null : Math.max(...memorySpans),
    totalGeneratedTestCount: memoryRows.reduce((sum, row) => sum + (row.longTermMemory?.generatedTestCount ?? 0), 0),
    averageScore0to1: scores.length === 0 ? null : round(scores.reduce((sum, value) => sum + value, 0) / scores.length),
    reportArtifactCount: memoryRows.filter((row) => {
      const hash = row.longTermMemory?.reportArtifactHash;
      return Boolean(hash && isSha256(hash));
    }).length,
    realTalkRowCount: realTalkRows.length,
    realTalkTasks: unique(
      realTalkRows
        .map((row) => row.longTermMemory?.realTalkTask ?? "")
        .filter((value): value is ReplayBenchmarkRealTalkTask => realTalkTasks.includes(value as ReplayBenchmarkRealTalkTask)),
    ) as ReplayBenchmarkRealTalkTask[],
    failedRealTalkRowIds: realTalkRows.filter(isLongTermMemoryFailure).map((row) => row.rowId),
    maxRealTalkConversationDaySpan: realTalkConversationSpans.length === 0
      ? null
      : Math.max(...realTalkConversationSpans),
    totalRealTalkQuestionCount: realTalkRows.reduce(
      (sum, row) => sum + (row.longTermMemory?.realTalkQuestionCount ?? 0),
      0,
    ),
    averageRealTalkLexicalF1Score0to1: realTalkLexicalScores.length === 0
      ? null
      : round(realTalkLexicalScores.reduce((sum, value) => sum + value, 0) / realTalkLexicalScores.length),
    averageRealTalkGptScore0to1: realTalkGptScores.length === 0
      ? null
      : round(realTalkGptScores.reduce((sum, value) => sum + value, 0) / realTalkGptScores.length),
    averageRealTalkEiCoverage0to1: realTalkEiCoverageScores.length === 0
      ? null
      : round(realTalkEiCoverageScores.reduce((sum, value) => sum + value, 0) / realTalkEiCoverageScores.length),
    cloneMemRowCount: cloneMemRows.length,
    cloneMemTraceKinds: unique(
      cloneMemRows.flatMap((row) => row.longTermMemory?.cloneMemTraceKinds ?? []),
    ) as ReplayBenchmarkCloneMemTraceKind[],
    cloneMemTaskCategories: unique(
      cloneMemRows.flatMap((row) => row.longTermMemory?.cloneMemTaskCategories ?? []),
    ) as ReplayBenchmarkCloneMemTaskCategory[],
    cloneMemLanguageIds: unique(
      cloneMemRows.flatMap((row) => row.longTermMemory?.cloneMemLanguageIds ?? []),
    ),
    failedCloneMemRowIds: cloneMemRows.filter(isLongTermMemoryFailure).map((row) => row.rowId),
    totalCloneMemPersonaCount: cloneMemRows.reduce((sum, row) => sum + (row.longTermMemory?.cloneMemPersonaCount ?? 0), 0),
    totalCloneMemQuestionCount: cloneMemRows.reduce((sum, row) => sum + (row.longTermMemory?.cloneMemQuestionCount ?? 0), 0),
    maxCloneMemContextSpanMonths: cloneMemContextSpans.length === 0 ? null : Math.max(...cloneMemContextSpans),
    averageCloneMemEvidenceGrounding0to1: cloneMemEvidenceGroundingScores.length === 0
      ? null
      : round(cloneMemEvidenceGroundingScores.reduce((sum, value) => sum + value, 0) / cloneMemEvidenceGroundingScores.length),
    averageCloneMemReplayPassRate0to1: cloneMemReplayPassRates.length === 0
      ? null
      : round(cloneMemReplayPassRates.reduce((sum, value) => sum + value, 0) / cloneMemReplayPassRates.length),
    memEvalRowCount: memEvalRows.length,
    memEvalBenchmarkIds: unique(
      memEvalRows.flatMap((row) => row.longTermMemory?.memEvalBenchmarkIds ?? []),
    ) as ReplayBenchmarkMemEvalBenchmarkId[],
    memEvalMemorySystems: unique(
      memEvalRows.flatMap((row) => row.longTermMemory?.memEvalMemorySystems ?? []),
    ) as ReplayBenchmarkMemEvalMemorySystem[],
    memEvalMetricKinds: unique(
      memEvalRows.flatMap((row) => row.longTermMemory?.memEvalMetricKinds ?? []),
    ) as ReplayBenchmarkMemEvalMetricKind[],
    failedMemEvalRowIds: memEvalRows.filter(isLongTermMemoryFailure).map((row) => row.rowId),
    totalMemEvalQuestionCount: memEvalRows.reduce((sum, row) => sum + (row.longTermMemory?.memEvalQuestionCount ?? 0), 0),
    totalMemEvalConversationCount: memEvalRows.reduce(
      (sum, row) => sum + (row.longTermMemory?.memEvalConversationCount ?? 0),
      0,
    ),
    averageMemEvalTokenF1_0to1: memEvalTokenF1Scores.length === 0
      ? null
      : round(memEvalTokenF1Scores.reduce((sum, value) => sum + value, 0) / memEvalTokenF1Scores.length),
    averageMemEvalJudgeScore0to1: memEvalJudgeScores.length === 0
      ? null
      : round(memEvalJudgeScores.reduce((sum, value) => sum + value, 0) / memEvalJudgeScores.length),
    averageMemEvalReplayPassRate0to1: memEvalReplayPassRates.length === 0
      ? null
      : round(memEvalReplayPassRates.reduce((sum, value) => sum + value, 0) / memEvalReplayPassRates.length),
  };
}

function buildStreamingImprovementReceipt(
  row: ReplayBenchmarkCorpusRowInput,
): ReplayBenchmarkStreamingImprovementReceipt | undefined {
  const streaming = row.fixture.streamingImprovement;
  if (!streaming) return undefined;
  const initialScore0to1 = nullableRate(streaming.initialScore0to1);
  const finalScore0to1 = nullableRate(streaming.finalScore0to1);
  return {
    benchmarkId: normalizeLabel(streaming.benchmarkId),
    datasetId: normalizeLabel(streaming.datasetId),
    sequenceId: normalizeLabel(streaming.sequenceId),
    sourceDatasetManifestHash: normalizeHashLabel(streaming.sourceDatasetManifestHash),
    originalSourceManifestHash: normalizeHashLabel(streaming.originalSourceManifestHash),
    agentConfigHash: normalizeHashLabel(streaming.agentConfigHash),
    benchmarkConfigHash: normalizeHashLabel(streaming.benchmarkConfigHash),
    streamSequenceHash: normalizeHashLabel(streaming.streamSequenceHash),
    initialStateHash: normalizeHashLabel(streaming.initialStateHash),
    updateTraceHash: normalizeHashLabel(streaming.updateTraceHash),
    predictionTraceHash: normalizeHashLabel(streaming.predictionTraceHash),
    evaluationTraceHash: normalizeHashLabel(streaming.evaluationTraceHash),
    sanityCheckTraceHash: normalizeHashLabel(streaming.sanityCheckTraceHash),
    resultArtifactHash: normalizeHashLabel(streaming.resultArtifactHash),
    batchRunConfigHash: normalizeHashLabel(streaming.batchRunConfigHash),
    externalTrackerRunId: normalizeLabel(streaming.externalTrackerRunId),
    stepCount: positiveInteger(streaming.stepCount),
    windowCount: positiveInteger(streaming.windowCount),
    updateCount: positiveInteger(streaming.updateCount),
    onlineUpdateEnabled: typeof streaming.onlineUpdateEnabled === "boolean" ? streaming.onlineUpdateEnabled : null,
    sanityCheckPassed: typeof streaming.sanityCheckPassed === "boolean" ? streaming.sanityCheckPassed : null,
    initialScore0to1,
    finalScore0to1,
    improvementDelta0to1: initialScore0to1 === null || finalScore0to1 === null
      ? null
      : round(finalScore0to1 - initialScore0to1),
    minImprovementDelta0to1: nullableRate(streaming.minImprovementDelta0to1),
    retentionScore0to1: nullableRate(streaming.retentionScore0to1),
    minRetentionScore0to1: nullableRate(streaming.minRetentionScore0to1),
    catastrophicForgettingRate0to1: nullableRate(streaming.catastrophicForgettingRate0to1),
    maxCatastrophicForgettingRate0to1: nullableRate(streaming.maxCatastrophicForgettingRate0to1),
  };
}

function isStreamingImprovementFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("streaming improvement benchmark id missing")
    || row.issues.includes("streaming improvement dataset id missing")
    || row.issues.includes("streaming improvement sequence id missing")
    || row.issues.includes("streaming improvement source dataset manifest hash invalid")
    || row.issues.includes("streaming improvement original source manifest hash invalid")
    || row.issues.includes("streaming improvement agent config hash invalid")
    || row.issues.includes("streaming improvement benchmark config hash invalid")
    || row.issues.includes("streaming improvement sequence hash invalid")
    || row.issues.includes("streaming improvement initial state hash invalid")
    || row.issues.includes("streaming improvement update trace hash invalid")
    || row.issues.includes("streaming improvement prediction trace hash invalid")
    || row.issues.includes("streaming improvement evaluation trace hash invalid")
    || row.issues.includes("streaming improvement sanity check trace hash invalid")
    || row.issues.includes("streaming improvement result artifact hash invalid")
    || row.issues.includes("streaming improvement batch run config hash invalid")
    || row.issues.includes("streaming improvement step count missing")
    || row.issues.includes("streaming improvement window count missing")
    || row.issues.includes("streaming improvement update count missing")
    || row.issues.includes("streaming improvement online update flag missing")
    || row.issues.includes("streaming improvement online update disabled")
    || row.issues.includes("streaming improvement sanity check flag missing")
    || row.issues.includes("streaming improvement sanity check failed")
    || row.issues.includes("streaming improvement initial score missing")
    || row.issues.includes("streaming improvement final score missing")
    || row.issues.includes("streaming improvement delta below threshold")
    || row.issues.includes("streaming improvement retention score missing")
    || row.issues.includes("streaming improvement retention below threshold")
    || row.issues.includes("streaming improvement forgetting rate missing")
    || row.issues.includes("streaming improvement forgetting above threshold");
}

function buildStreamingImprovementSummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkStreamingImprovementSummary {
  const streamingRows = rows.filter((row) => row.streamingImprovement);
  const improvementDeltas = streamingRows
    .map((row) => row.streamingImprovement?.improvementDelta0to1 ?? null)
    .filter((value): value is number => value !== null);
  const retentionScores = streamingRows
    .map((row) => row.streamingImprovement?.retentionScore0to1 ?? null)
    .filter((value): value is number => value !== null);
  const forgettingRates = streamingRows
    .map((row) => row.streamingImprovement?.catastrophicForgettingRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: streamingRows.length,
    datasetIds: unique(
      streamingRows
        .map((row) => row.streamingImprovement?.datasetId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    failedRowIds: streamingRows.filter(isStreamingImprovementFailure).map((row) => row.rowId),
    totalStepCount: streamingRows.reduce((sum, row) => sum + (row.streamingImprovement?.stepCount ?? 0), 0),
    onlineUpdateRowCount: streamingRows.filter((row) => row.streamingImprovement?.onlineUpdateEnabled === true).length,
    sanityCheckedRowCount: streamingRows.filter((row) => row.streamingImprovement?.sanityCheckPassed === true).length,
    averageImprovementDelta0to1: improvementDeltas.length === 0
      ? null
      : round(improvementDeltas.reduce((sum, value) => sum + value, 0) / improvementDeltas.length),
    averageRetentionScore0to1: retentionScores.length === 0
      ? null
      : round(retentionScores.reduce((sum, value) => sum + value, 0) / retentionScores.length),
    maxCatastrophicForgettingRate0to1: forgettingRates.length === 0 ? null : Math.max(...forgettingRates),
  };
}

function buildMlDevBenchmarkReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkMlDevBenchmarkReceipt | undefined {
  const benchmark = row.fixture.mlDevBenchmark;
  if (!benchmark) return undefined;
  const baselineMetric0to1 = nullableRate(benchmark.baselineMetric0to1);
  const candidateMetric0to1 = nullableRate(benchmark.candidateMetric0to1);
  const explicitScoreDelta0to1 = nullableScoreDelta(benchmark.scoreDelta0to1);
  return {
    benchmarkId: normalizeLabel(benchmark.benchmarkId),
    benchmarkVersion: normalizeLabel(benchmark.benchmarkVersion),
    paperRefHash: normalizeHashLabel(benchmark.paperRefHash),
    taskSuiteHash: normalizeHashLabel(benchmark.taskSuiteHash),
    taskCategory: normalizeMlDevTaskCategory(benchmark.taskCategory),
    problemDomain: normalizeMlDevProblemDomain(benchmark.problemDomain),
    taskId: normalizeLabel(benchmark.taskId),
    taskConfigHash: normalizeHashLabel(benchmark.taskConfigHash),
    workspaceFixtureHash: normalizeHashLabel(benchmark.workspaceFixtureHash),
    runtimeEnvironmentHash: normalizeHashLabel(benchmark.runtimeEnvironmentHash),
    dependencyLockHash: normalizeHashLabel(benchmark.dependencyLockHash),
    agentHarness: normalizeMlDevAgentHarness(benchmark.agentHarness),
    agentConfigHash: normalizeHashLabel(benchmark.agentConfigHash),
    calipersConfigHash: normalizeHashLabel(benchmark.calipersConfigHash),
    hydraOverrideHash: normalizeHashLabel(benchmark.hydraOverrideHash),
    metricsConfigHash: normalizeHashLabel(benchmark.metricsConfigHash),
    scoringMode: normalizeMlDevScoringMode(benchmark.scoringMode),
    validationScriptHash: normalizeHashLabel(benchmark.validationScriptHash),
    replayCommandHash: normalizeHashLabel(benchmark.replayCommandHash),
    deterministicSeed: nonNegativeInteger(benchmark.deterministicSeed),
    runCount: positiveInteger(benchmark.runCount),
    baselineMetric0to1,
    candidateMetric0to1,
    scoreDelta0to1: explicitScoreDelta0to1 ?? (
      baselineMetric0to1 === null || candidateMetric0to1 === null
        ? null
        : round(candidateMetric0to1 - baselineMetric0to1)
    ),
    taskPassRate0to1: nullableRate(benchmark.taskPassRate0to1),
    reportArtifactHash: normalizeHashLabel(benchmark.reportArtifactHash),
    traceArtifactHash: normalizeHashLabel(benchmark.traceArtifactHash),
    minCandidateMetric0to1: nullableRate(benchmark.minCandidateMetric0to1),
    minTaskPassRate0to1: nullableRate(benchmark.minTaskPassRate0to1),
    maxScoreRegression0to1: nonNegativeNumber(benchmark.maxScoreRegression0to1),
  };
}

function isMlDevBenchmarkFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("ml-dev benchmark "));
}

function buildMlDevBenchmarkSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkMlDevBenchmarkSummary {
  const benchmarkRows = rows.filter((row) => row.mlDevBenchmark);
  const baselineMetrics = benchmarkRows
    .map((row) => row.mlDevBenchmark?.baselineMetric0to1 ?? null)
    .filter((value): value is number => value !== null);
  const candidateMetrics = benchmarkRows
    .map((row) => row.mlDevBenchmark?.candidateMetric0to1 ?? null)
    .filter((value): value is number => value !== null);
  const scoreDeltas = benchmarkRows
    .map((row) => row.mlDevBenchmark?.scoreDelta0to1 ?? null)
    .filter((value): value is number => value !== null);
  const taskPassRates = benchmarkRows
    .map((row) => row.mlDevBenchmark?.taskPassRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: benchmarkRows.length,
    benchmarkIds: unique(
      benchmarkRows
        .map((row) => row.mlDevBenchmark?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    taskCategories: unique(
      benchmarkRows
        .map((row) => row.mlDevBenchmark?.taskCategory ?? "")
        .filter((value): value is ReplayBenchmarkMlDevTaskCategory => (
          mlDevTaskCategories.includes(value as ReplayBenchmarkMlDevTaskCategory)
        )),
    ) as ReplayBenchmarkMlDevTaskCategory[],
    problemDomains: unique(
      benchmarkRows
        .map((row) => row.mlDevBenchmark?.problemDomain ?? "")
        .filter((value): value is ReplayBenchmarkMlDevProblemDomain => (
          mlDevProblemDomains.includes(value as ReplayBenchmarkMlDevProblemDomain)
        )),
    ) as ReplayBenchmarkMlDevProblemDomain[],
    agentHarnesses: unique(
      benchmarkRows
        .map((row) => row.mlDevBenchmark?.agentHarness ?? "")
        .filter((value): value is ReplayBenchmarkMlDevAgentHarness => (
          mlDevAgentHarnesses.includes(value as ReplayBenchmarkMlDevAgentHarness)
        )),
    ) as ReplayBenchmarkMlDevAgentHarness[],
    failedRowIds: benchmarkRows.filter(isMlDevBenchmarkFailure).map((row) => row.rowId),
    totalRunCount: benchmarkRows.reduce((sum, row) => sum + (row.mlDevBenchmark?.runCount ?? 0), 0),
    averageBaselineMetric0to1: baselineMetrics.length === 0
      ? null
      : round(baselineMetrics.reduce((sum, value) => sum + value, 0) / baselineMetrics.length),
    averageCandidateMetric0to1: candidateMetrics.length === 0
      ? null
      : round(candidateMetrics.reduce((sum, value) => sum + value, 0) / candidateMetrics.length),
    averageScoreDelta0to1: scoreDeltas.length === 0
      ? null
      : round(scoreDeltas.reduce((sum, value) => sum + value, 0) / scoreDeltas.length),
    averageTaskPassRate0to1: taskPassRates.length === 0
      ? null
      : round(taskPassRates.reduce((sum, value) => sum + value, 0) / taskPassRates.length),
  };
}

