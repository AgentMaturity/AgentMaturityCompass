    replay.nucliaRagTriadEvaluatorConfigHash,
    replay.nucliaRagTriadDatasetManifestHash,
    replay.nucliaRagTriadQaContextManifestHash,
    replay.nucliaRagTriadMetricManifestHash,
    replay.nucliaRagTriadAnswerRelevanceTraceHash,
    replay.nucliaRagTriadContextRelevanceTraceHash,
