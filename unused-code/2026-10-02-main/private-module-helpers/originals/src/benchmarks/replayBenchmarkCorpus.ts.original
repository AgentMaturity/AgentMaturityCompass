  const failedScientificEvaluationRows = manifest.rows.filter(isScientificEvaluationFailure);
  const failedToolSandboxRows = manifest.rows.filter(isToolSandboxFailure);
  const failedPlatformEvaluationRows = manifest.rows.filter(isPlatformEvaluationFailure);
  const failedAzureAgentLabRows = manifest.rows.filter(isAzureAgentLabFailure);
  const failedClawEnvKitRows = manifest.rows.filter(isClawEnvKitFailure);
  const failedDeepResearchRows = manifest.rows.filter(isDeepResearchFailure);
  const failedWebSearchEvaluationRows = manifest.rows.filter(isWebSearchEvaluationFailure);
  const failedBinaryAuditRows = manifest.rows.filter(isBinaryAuditFailure);
