function normalizePawBenchToken(value: string | undefined): string | null {
  if (typeof value !== "string") return null;
  const normalized = value.trim().toLowerCase().replace(/[\s-]+/g, "_");
  return normalized.length > 0 ? normalized : null;
}

function normalizePawBenchTaskSource(
  value: ReplayBenchmarkPawBenchTaskSource | undefined,
): ReplayBenchmarkPawBenchTaskSource | null {
  const normalized = normalizePawBenchToken(value);
  if (!normalized) return null;
  const source = normalized === "self_built" ? "self-built" : normalized;
  return pawBenchTaskSources.includes(source as ReplayBenchmarkPawBenchTaskSource)
    ? source as ReplayBenchmarkPawBenchTaskSource
    : null;
}

function normalizePawBenchScenario(
  value: ReplayBenchmarkPawBenchScenario | undefined,
): ReplayBenchmarkPawBenchScenario | null {
  const normalized = normalizePawBenchToken(value);
  return normalized && pawBenchScenarios.includes(normalized as ReplayBenchmarkPawBenchScenario)
    ? normalized as ReplayBenchmarkPawBenchScenario
