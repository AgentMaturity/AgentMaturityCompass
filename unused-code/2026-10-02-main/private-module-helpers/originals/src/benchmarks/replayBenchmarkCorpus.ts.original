    mirageVisualizationArtifactHash: normalizeHashLabel(rag.mirageVisualizationArtifactHash),
    mirageDatasetId: normalizeLabel(rag.mirageDatasetId),
    mirageBackendIds: unique((rag.mirageBackendIds ?? [])
      .map((backendId) => normalizeLabel(backendId))
      .filter((backendId): backendId is string => Boolean(backendId))),
    mirageModalityIds: unique((rag.mirageModalityIds ?? [])
      .map((modalityId) => normalizeLabel(modalityId))
      .filter((modalityId): modalityId is string => Boolean(modalityId))),
    miragePipelineStageIds: unique((rag.miragePipelineStageIds ?? [])
      .map((stageId) => normalizeLabel(stageId))
      .filter((stageId): stageId is string => Boolean(stageId))),
    mirageQuestionCount: positiveInteger(rag.mirageQuestionCount),
    mirageMinQuestionCount: positiveInteger(rag.mirageMinQuestionCount),
    mirageDeterministicSeed: nonNegativeInteger(rag.mirageDeterministicSeed),
    mirageBaselineQuality0to1,
    mirageCandidateQuality0to1,
    mirageScoreDelta0to1: explicitMirageScoreDelta0to1 ?? (
      mirageBaselineQuality0to1 === null || mirageCandidateQuality0to1 === null
        ? null
        : round(mirageCandidateQuality0to1 - mirageBaselineQuality0to1)
    ),
    mirageMaxScoreRegression0to1: nullableRate(rag.mirageMaxScoreRegression0to1),
    mirageReplayPassRate0to1: nullableRate(rag.mirageReplayPassRate0to1),
    mirageMinReplayPassRate0to1: nullableRate(rag.mirageMinReplayPassRate0to1),
    mirageMetricCoverage0to1: nullableRate(rag.mirageMetricCoverage0to1),
    mirageMinMetricCoverage0to1: nullableRate(rag.mirageMinMetricCoverage0to1),
    encourageSourceRefHash: normalizeHashLabel(rag.encourageSourceRefHash),
    encourageRepositorySnapshotHash: normalizeHashLabel(rag.encourageRepositorySnapshotHash),
