function buildLogicBenchmarkSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkLogicBenchmarkSummary {
  const logicRows = rows.filter((row) => row.logicBenchmark);
  const logicAccuracies = logicRows
    .map((row) => row.logicBenchmark?.logicAccuracy0to1 ?? null)
    .filter((value): value is number => value !== null);
  const solverAgreements = logicRows
    .map((row) => row.logicBenchmark?.solverAgreement0to1 ?? null)
    .filter((value): value is number => value !== null);
  const toolUseCoverages = logicRows
    .map((row) => row.logicBenchmark?.toolUseCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const replayPassRates = logicRows
    .map((row) => row.logicBenchmark?.replayPassRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: logicRows.length,
    datasetIds: unique(
      logicRows
        .map((row) => row.logicBenchmark?.datasetId ?? "")
        .filter((value): value is ReplayBenchmarkLogicBenchmarkDataset => (
          logicBenchmarkDatasets.includes(value as ReplayBenchmarkLogicBenchmarkDataset)
        )),
    ) as ReplayBenchmarkLogicBenchmarkDataset[],
    toolKinds: unique(
      logicRows
        .flatMap((row) => row.logicBenchmark?.toolKinds ?? [])
        .filter((value): value is ReplayBenchmarkLogicToolKind => (
          logicToolKinds.includes(value as ReplayBenchmarkLogicToolKind)
        )),
    ) as ReplayBenchmarkLogicToolKind[],
    failedRowIds: logicRows.filter(isLogicBenchmarkFailure).map((row) => row.rowId),
    totalTaskCount: logicRows.reduce((sum, row) => sum + (row.logicBenchmark?.taskCount ?? 0), 0),
    zeroEvalRowCount: logicRows.filter((row) => Boolean(row.logicBenchmark?.zeroEvalResultHash)).length,
    unitTestedRowCount: logicRows.filter((row) => Boolean(row.logicBenchmark?.unitTestResultHash)).length,
    averageLogicAccuracy0to1: logicAccuracies.length === 0
      ? null
      : round(logicAccuracies.reduce((sum, value) => sum + value, 0) / logicAccuracies.length),
    averageSolverAgreement0to1: solverAgreements.length === 0
      ? null
      : round(solverAgreements.reduce((sum, value) => sum + value, 0) / solverAgreements.length),
    averageToolUseCoverage0to1: toolUseCoverages.length === 0
      ? null
      : round(toolUseCoverages.reduce((sum, value) => sum + value, 0) / toolUseCoverages.length),
    averageReplayPassRate0to1: replayPassRates.length === 0
      ? null
      : round(replayPassRates.reduce((sum, value) => sum + value, 0) / replayPassRates.length),
  };
}

function buildSkillLifecycleReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkSkillLifecycleReceipt | undefined {
  const lifecycle = row.fixture.skillLifecycle;
  if (!lifecycle) return undefined;
  const axisScores = {
    discovery: skillAxisScore(lifecycle.axisScores?.discovery),
    clarity: skillAxisScore(lifecycle.axisScores?.clarity),
    efficiency: skillAxisScore(lifecycle.axisScores?.efficiency),
    robustness: skillAxisScore(lifecycle.axisScores?.robustness),
    completeness: skillAxisScore(lifecycle.axisScores?.completeness),
  };
  const axisValues = Object.values(axisScores).filter((value): value is number => value !== null);
  return {
    lifecycleMode: normalizeSkillLifecycleMode(lifecycle.lifecycleMode),
    architecturePattern: normalizeSkillArchitecturePattern(lifecycle.architecturePattern),
    tddBaselineHash: normalizeHashLabel(lifecycle.tddBaselineHash),
    candidateSkillHash: normalizeHashLabel(lifecycle.candidateSkillHash),
    graderReportHash: normalizeHashLabel(lifecycle.graderReportHash),
    comparatorReportHash: normalizeHashLabel(lifecycle.comparatorReportHash),
    analyzerReportHash: normalizeHashLabel(lifecycle.analyzerReportHash),
    blindComparisonHash: normalizeHashLabel(lifecycle.blindComparisonHash),
    benchmarkSummaryHash: normalizeHashLabel(lifecycle.benchmarkSummaryHash),
    packageArtifactHash: normalizeHashLabel(lifecycle.packageArtifactHash),
    axisScores,
    minAxisScore0to10: minSkillAxisScore(lifecycle.minAxisScore0to10),
    averageAxisScore0to10: axisValues.length === 0
      ? null
      : round(axisValues.reduce((sum, value) => sum + value, 0) / axisValues.length),
    agentWorkflowKitSourceRefHash: normalizeHashLabel(lifecycle.agentWorkflowKitSourceRefHash),
    agentWorkflowKitRepositorySnapshotHash: normalizeHashLabel(lifecycle.agentWorkflowKitRepositorySnapshotHash),
    agentWorkflowKitLicenseRefHash: normalizeHashLabel(lifecycle.agentWorkflowKitLicenseRefHash),
    agentWorkflowKitGuideHash: normalizeHashLabel(lifecycle.agentWorkflowKitGuideHash),
    agentWorkflowKitSkillPackageManifestHash: normalizeHashLabel(lifecycle.agentWorkflowKitSkillPackageManifestHash),
    agentWorkflowKitTemplateManifestHash: normalizeHashLabel(lifecycle.agentWorkflowKitTemplateManifestHash),
    agentWorkflowKitRiskScoringRubricHash: normalizeHashLabel(lifecycle.agentWorkflowKitRiskScoringRubricHash),
    agentWorkflowKitWorkflowLevelPolicyHash: normalizeHashLabel(lifecycle.agentWorkflowKitWorkflowLevelPolicyHash),
    agentWorkflowKitSpecLayerPolicyHash: normalizeHashLabel(lifecycle.agentWorkflowKitSpecLayerPolicyHash),
    agentWorkflowKitApprovalPolicyHash: normalizeHashLabel(lifecycle.agentWorkflowKitApprovalPolicyHash),
    agentWorkflowKitVerificationCommandManifestHash: normalizeHashLabel(lifecycle.agentWorkflowKitVerificationCommandManifestHash),
    agentWorkflowKitDocsCheckWorkflowHash: normalizeHashLabel(lifecycle.agentWorkflowKitDocsCheckWorkflowHash),
    agentWorkflowKitEvaluationManifestHash: normalizeHashLabel(lifecycle.agentWorkflowKitEvaluationManifestHash),
    agentWorkflowKitReplayCommandHash: normalizeHashLabel(lifecycle.agentWorkflowKitReplayCommandHash),
    agentWorkflowKitRiskScore0to16: agentWorkflowRiskScore(lifecycle.agentWorkflowKitRiskScore0to16),
    agentWorkflowKitRecommendedLevel: normalizeAgentWorkflowKitLevel(lifecycle.agentWorkflowKitRecommendedLevel),
    agentWorkflowKitAppliedLevel: normalizeAgentWorkflowKitLevel(lifecycle.agentWorkflowKitAppliedLevel),
    agentWorkflowKitWorkflowLevelMatchesRisk: typeof lifecycle.agentWorkflowKitWorkflowLevelMatchesRisk === "boolean"
      ? lifecycle.agentWorkflowKitWorkflowLevelMatchesRisk
      : null,
    agentWorkflowKitSpecLayerDecisionValid: typeof lifecycle.agentWorkflowKitSpecLayerDecisionValid === "boolean"
      ? lifecycle.agentWorkflowKitSpecLayerDecisionValid
      : null,
    agentWorkflowKitExternalApprovalRequired: typeof lifecycle.agentWorkflowKitExternalApprovalRequired === "boolean"
      ? lifecycle.agentWorkflowKitExternalApprovalRequired
      : null,
    agentWorkflowKitExternalApprovalGatePresent: typeof lifecycle.agentWorkflowKitExternalApprovalGatePresent === "boolean"
      ? lifecycle.agentWorkflowKitExternalApprovalGatePresent
      : null,
    agentWorkflowKitDeterministicSeed: nonNegativeInteger(lifecycle.agentWorkflowKitDeterministicSeed),
    agentWorkflowKitVerificationPassRate0to1: nullableRate(lifecycle.agentWorkflowKitVerificationPassRate0to1),
    minAgentWorkflowKitVerificationPassRate0to1: nullableRate(lifecycle.minAgentWorkflowKitVerificationPassRate0to1),
    agentWorkflowKitTemplateCoverage0to1: nullableRate(lifecycle.agentWorkflowKitTemplateCoverage0to1),
    minAgentWorkflowKitTemplateCoverage0to1: nullableRate(lifecycle.minAgentWorkflowKitTemplateCoverage0to1),
    agentWorkflowKitDocsCheckPassRate0to1: nullableRate(lifecycle.agentWorkflowKitDocsCheckPassRate0to1),
    minAgentWorkflowKitDocsCheckPassRate0to1: nullableRate(lifecycle.minAgentWorkflowKitDocsCheckPassRate0to1),
    agentWorkflowKitReplayPassRate0to1: nullableRate(lifecycle.agentWorkflowKitReplayPassRate0to1),
    minAgentWorkflowKitReplayPassRate0to1: nullableRate(lifecycle.minAgentWorkflowKitReplayPassRate0to1),
  };
}

function hasCompleteSkillAxisScores(row: ReplayBenchmarkCorpusManifestRow): boolean {
  const axisScores = row.skillLifecycle?.axisScores;
  return Boolean(axisScores)
    && axisScores?.discovery !== null
    && axisScores?.clarity !== null
    && axisScores?.efficiency !== null
    && axisScores?.robustness !== null
    && axisScores?.completeness !== null;
}

function hasAgentWorkflowKitSignal(lifecycle: ReplayBenchmarkSkillLifecycleReceipt): boolean {
  return [
    lifecycle.agentWorkflowKitSourceRefHash,
    lifecycle.agentWorkflowKitRepositorySnapshotHash,
    lifecycle.agentWorkflowKitLicenseRefHash,
    lifecycle.agentWorkflowKitGuideHash,
    lifecycle.agentWorkflowKitSkillPackageManifestHash,
    lifecycle.agentWorkflowKitTemplateManifestHash,
    lifecycle.agentWorkflowKitRiskScoringRubricHash,
    lifecycle.agentWorkflowKitWorkflowLevelPolicyHash,
    lifecycle.agentWorkflowKitSpecLayerPolicyHash,
    lifecycle.agentWorkflowKitApprovalPolicyHash,
    lifecycle.agentWorkflowKitVerificationCommandManifestHash,
    lifecycle.agentWorkflowKitDocsCheckWorkflowHash,
    lifecycle.agentWorkflowKitEvaluationManifestHash,
    lifecycle.agentWorkflowKitReplayCommandHash,
    lifecycle.agentWorkflowKitRecommendedLevel,
    lifecycle.agentWorkflowKitAppliedLevel,
  ].some((value) => value !== null)
    || [
      lifecycle.agentWorkflowKitRiskScore0to16,
      lifecycle.agentWorkflowKitWorkflowLevelMatchesRisk,
      lifecycle.agentWorkflowKitSpecLayerDecisionValid,
      lifecycle.agentWorkflowKitExternalApprovalRequired,
      lifecycle.agentWorkflowKitExternalApprovalGatePresent,
      lifecycle.agentWorkflowKitDeterministicSeed,
      lifecycle.agentWorkflowKitVerificationPassRate0to1,
      lifecycle.minAgentWorkflowKitVerificationPassRate0to1,
      lifecycle.agentWorkflowKitTemplateCoverage0to1,
      lifecycle.minAgentWorkflowKitTemplateCoverage0to1,
      lifecycle.agentWorkflowKitDocsCheckPassRate0to1,
      lifecycle.minAgentWorkflowKitDocsCheckPassRate0to1,
      lifecycle.agentWorkflowKitReplayPassRate0to1,
      lifecycle.minAgentWorkflowKitReplayPassRate0to1,
    ].some((value) => value !== null);
}

function isAgentWorkflowKitRegressionIssue(issue: string): boolean {
  return [
    "skill agent workflow kit workflow level mismatch",
    "skill agent workflow kit spec layer decision invalid",
    "skill agent workflow kit external approval gate missing",
    "skill agent workflow kit verification pass rate below threshold",
    "skill agent workflow kit template coverage below threshold",
    "skill agent workflow kit docs check pass rate below threshold",
    "skill agent workflow kit replay pass rate below threshold",
  ].includes(issue);
}

function isRagEvalFlowRegressionIssue(issue: string): boolean {
  return [
    "rag eval flow sample size below threshold",
    "rag eval flow score regression exceeds threshold",
    "rag eval flow replay pass rate below threshold",
    "rag eval flow metric coverage below threshold",
  ].includes(issue);
}

function isRagEvalDatasetRegressionIssue(issue: string): boolean {
  return [
    "rag eval dataset question count below threshold",
    "rag eval dataset endpoint count below threshold",
    "rag eval dataset score regression exceeds threshold",
    "rag eval dataset replay pass rate below threshold",
    "rag eval dataset endpoint response coverage below threshold",
  ].includes(issue);
}

function appendAgentWorkflowKitMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`skill agent workflow kit ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`skill agent workflow kit ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`skill agent workflow kit ${label} below threshold`);
  }
}

function isSkillLifecycleFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("skill lifecycle mode missing")
    || row.issues.includes("skill architecture pattern missing")
    || row.issues.includes("skill tdd baseline hash invalid")
    || row.issues.includes("skill candidate artifact hash invalid")
    || row.issues.includes("skill grader report hash invalid")
    || row.issues.includes("skill comparator report hash invalid")
    || row.issues.includes("skill analyzer report hash invalid")
    || row.issues.includes("skill blind comparison hash invalid")
    || row.issues.includes("skill benchmark summary hash invalid")
    || row.issues.includes("skill package artifact hash invalid")
    || row.issues.includes("skill package artifact missing")
    || row.issues.includes("skill axis score missing")
    || row.issues.includes("skill axis score below threshold")
    || row.issues.some((issue) => issue.startsWith("skill agent workflow kit "));
}

function buildSkillLifecycleSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkSkillLifecycleSummary {
  const lifecycleRows = rows.filter((row) => row.skillLifecycle);
  const agentWorkflowKitRows = lifecycleRows.filter((row) => (
    row.skillLifecycle ? hasAgentWorkflowKitSignal(row.skillLifecycle) : false
  ));
  const averages = lifecycleRows
    .map((row) => row.skillLifecycle?.averageAxisScore0to10 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: lifecycleRows.length,
    modes: unique(
      lifecycleRows
        .map((row) => row.skillLifecycle?.lifecycleMode ?? "")
        .filter((value): value is ReplayBenchmarkSkillLifecycleMode => skillLifecycleModes.includes(value as ReplayBenchmarkSkillLifecycleMode)),
    ) as ReplayBenchmarkSkillLifecycleMode[],
    architecturePatterns: unique(
      lifecycleRows
        .map((row) => row.skillLifecycle?.architecturePattern ?? "")
        .filter((value): value is ReplayBenchmarkSkillArchitecturePattern => skillArchitecturePatterns.includes(value as ReplayBenchmarkSkillArchitecturePattern)),
    ) as ReplayBenchmarkSkillArchitecturePattern[],
    failedRowIds: lifecycleRows.filter(isSkillLifecycleFailure).map((row) => row.rowId),
    belowThresholdRowIds: lifecycleRows
      .filter((row) => row.issues.includes("skill axis score below threshold"))
      .map((row) => row.rowId),
    packagedRowCount: lifecycleRows.filter((row) => Boolean(row.skillLifecycle?.packageArtifactHash)).length,
    agentWorkflowKitRowCount: agentWorkflowKitRows.length,
    agentWorkflowKitRecommendedLevels: unique(
      agentWorkflowKitRows
        .map((row) => row.skillLifecycle?.agentWorkflowKitRecommendedLevel ?? "")
        .filter((value): value is ReplayBenchmarkAgentWorkflowKitLevel => (
          agentWorkflowKitLevels.includes(value as ReplayBenchmarkAgentWorkflowKitLevel)
        )),
    ) as ReplayBenchmarkAgentWorkflowKitLevel[],
    agentWorkflowKitAppliedLevels: unique(
      agentWorkflowKitRows
        .map((row) => row.skillLifecycle?.agentWorkflowKitAppliedLevel ?? "")
        .filter((value): value is ReplayBenchmarkAgentWorkflowKitLevel => (
          agentWorkflowKitLevels.includes(value as ReplayBenchmarkAgentWorkflowKitLevel)
        )),
    ) as ReplayBenchmarkAgentWorkflowKitLevel[],
    failedAgentWorkflowKitRowIds: agentWorkflowKitRows
      .filter((row) => row.issues.some((issue) => issue.startsWith("skill agent workflow kit ")))
      .map((row) => row.rowId),
    averageAgentWorkflowKitRiskScore0to16: averageNullable(
      agentWorkflowKitRows.map((row) => row.skillLifecycle?.agentWorkflowKitRiskScore0to16 ?? null),
    ),
    averageAgentWorkflowKitVerificationPassRate0to1: averageNullable(
      agentWorkflowKitRows.map((row) => row.skillLifecycle?.agentWorkflowKitVerificationPassRate0to1 ?? null),
    ),
    averageAgentWorkflowKitReplayPassRate0to1: averageNullable(
      agentWorkflowKitRows.map((row) => row.skillLifecycle?.agentWorkflowKitReplayPassRate0to1 ?? null),
    ),
    averageAxisScore0to10: averages.length === 0 ? null : round(averages.reduce((sum, value) => sum + value, 0) / averages.length),
  };
}

function buildSkillBenchmarkRegressionReceipt(
