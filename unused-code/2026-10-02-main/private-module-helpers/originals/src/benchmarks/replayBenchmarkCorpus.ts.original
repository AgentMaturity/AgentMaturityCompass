function appendMiniAppBenchMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`agent benchmark replay miniappbench ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay miniappbench ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`agent benchmark replay miniappbench ${label} below threshold`);
  }
}

function appendMiniAppBenchIssues(
  issues: string[],
  replay: ReplayBenchmarkAgentBenchmarkReplayReceipt,
): void {
  if (!hasMiniAppBenchSignal(replay)) {
    return;
  }
  if (!replay.miniAppBenchBenchmarkId) {
    issues.push("agent benchmark replay miniappbench benchmark id missing");
  }
  for (const [label, hash] of [
    ["source ref", replay.miniAppBenchSourceRefHash],
    ["repository snapshot", replay.miniAppBenchRepositorySnapshotHash],
    ["license review", replay.miniAppBenchLicenseReviewHash],
    ["dataset manifest", replay.miniAppBenchDatasetManifestHash],
    ["query set", replay.miniAppBenchQuerySetHash],
    ["evaluation reference manifest", replay.miniAppBenchEvaluationReferenceManifestHash],
    ["generated miniapp manifest", replay.miniAppBenchGeneratedMiniAppManifestHash],
    ["generated source code", replay.miniAppBenchGeneratedSourceCodeHash],
    ["live instance manifest", replay.miniAppBenchLiveInstanceManifestHash],
    ["browser automation trace", replay.miniAppBenchBrowserAutomationTraceHash],
    ["interaction rubric", replay.miniAppBenchInteractionRubricHash],
    ["visual render report", replay.miniAppBenchVisualRenderReportHash],
    ["dynamic interaction report", replay.miniAppBenchDynamicInteractionReportHash],
    ["result manifest", replay.miniAppBenchResultManifestHash],
    ["replay command", replay.miniAppBenchReplayCommandHash],
    ["ci receipt", replay.miniAppBenchCiReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`agent benchmark replay miniappbench ${label} hash invalid`);
    }
  }
  appendMiniAppBenchCountIssue(
    issues,
    "task category count",
    replay.miniAppBenchTaskCategories.length,
    replay.minMiniAppBenchTaskCategoryCount,
  );
  appendMiniAppBenchMinimumIssue(
    issues,
    "query count",
    replay.miniAppBenchQueryCount,
    replay.minMiniAppBenchQueryCount,
  );
  if (replay.miniAppBenchDeterministicSeed === null) {
    issues.push("agent benchmark replay miniappbench deterministic seed missing");
  }
  if (replay.miniAppBenchWithheldReferencesRespected !== true) {
    issues.push("agent benchmark replay miniappbench withheld reference boundary not respected");
  }
  if (replay.miniAppBenchNoCopySourceBoundary !== true) {
    issues.push("agent benchmark replay miniappbench no-copy source boundary missing");
  }
  appendMiniAppBenchMinimumIssue(
    issues,
    "browser automation success",
    replay.miniAppBenchBrowserAutomationSuccessRate0to1,
    replay.minMiniAppBenchBrowserAutomationSuccessRate0to1,
  );
  appendMiniAppBenchMinimumIssue(
    issues,
    "interaction coverage",
    replay.miniAppBenchInteractionCoverage0to1,
    replay.minMiniAppBenchInteractionCoverage0to1,
  );
  appendMiniAppBenchMinimumIssue(
    issues,
    "human alignment",
    replay.miniAppBenchHumanAlignment0to1,
    replay.minMiniAppBenchHumanAlignment0to1,
  );
  appendMiniAppBenchMinimumIssue(
    issues,
    "replay pass rate",
    replay.miniAppBenchReplayPassRate0to1,
    replay.minMiniAppBenchReplayPassRate0to1,
  );
  if (replay.miniAppBenchBaselineScore0to1 === null) {
    issues.push("agent benchmark replay miniappbench baseline score missing");
  }
  if (replay.miniAppBenchCandidateScore0to1 === null) {
    issues.push("agent benchmark replay miniappbench candidate score missing");
  }
  if (replay.miniAppBenchScoreDelta0to1 === null) {
    issues.push("agent benchmark replay miniappbench score delta missing");
  }
  if (replay.maxMiniAppBenchScoreRegression0to1 === null) {
    issues.push("agent benchmark replay miniappbench score regression threshold missing");
  }
  if (
    replay.miniAppBenchScoreDelta0to1 !== null
    && replay.maxMiniAppBenchScoreRegression0to1 !== null
    && replay.miniAppBenchScoreDelta0to1 < -replay.maxMiniAppBenchScoreRegression0to1
  ) {
    issues.push("agent benchmark replay miniappbench score regression exceeds threshold");
  }
}

