function buildBenchLoopSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkBenchLoopSummary {
  const benchLoopRows = rows.filter((row) => row.benchLoop);
  const timeToFirstTokenValues = benchLoopRows
    .map((row) => row.benchLoop?.timeToFirstTokenMs ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: benchLoopRows.length,
    benchmarkIds: unique(
      benchLoopRows
        .map((row) => row.benchLoop?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    suites: unique(
      benchLoopRows
        .map((row) => row.benchLoop?.suite ?? "")
        .filter((value): value is ReplayBenchmarkBenchLoopSuite => (
          benchLoopSuites.includes(value as ReplayBenchmarkBenchLoopSuite)
        )),
    ) as ReplayBenchmarkBenchLoopSuite[],
    providers: unique(
      benchLoopRows
        .map((row) => row.benchLoop?.provider ?? "")
        .filter((value): value is ReplayBenchmarkBenchLoopProvider => (
          benchLoopProviders.includes(value as ReplayBenchmarkBenchLoopProvider)
        )),
    ) as ReplayBenchmarkBenchLoopProvider[],
    harnesses: unique(
      benchLoopRows
        .map((row) => row.benchLoop?.harness ?? "")
        .filter((value): value is ReplayBenchmarkBenchLoopHarness => (
          benchLoopHarnesses.includes(value as ReplayBenchmarkBenchLoopHarness)
        )),
    ) as ReplayBenchmarkBenchLoopHarness[],
    deploymentModes: unique(
      benchLoopRows
        .map((row) => row.benchLoop?.deploymentMode ?? "")
        .filter((value): value is ReplayBenchmarkBenchLoopDeploymentMode => (
          benchLoopDeploymentModes.includes(value as ReplayBenchmarkBenchLoopDeploymentMode)
        )),
    ) as ReplayBenchmarkBenchLoopDeploymentMode[],
    failedRowIds: benchLoopRows.filter(isBenchLoopFailure).map((row) => row.rowId),
    totalTaskCount: benchLoopRows.reduce((sum, row) => sum + (row.benchLoop?.taskCount ?? 0), 0),
    totalToolCount: benchLoopRows.reduce((sum, row) => sum + (row.benchLoop?.toolCount ?? 0), 0),
    averageOverallScore0to1: averageNullable(
      benchLoopRows.map((row) => row.benchLoop?.overallScore0to1 ?? null),
    ),
    averageAgentScore0to1: averageNullable(
      benchLoopRows.map((row) => row.benchLoop?.agentScore0to1 ?? null),
    ),
    averageReliabilityScore0to1: averageNullable(
      benchLoopRows.map((row) => row.benchLoop?.reliabilityScore0to1 ?? null),
    ),
    averageTokensPerSecond: averageNullable(
      benchLoopRows.map((row) => row.benchLoop?.tokensPerSecond ?? null),
    ),
    maxTimeToFirstTokenMs: timeToFirstTokenValues.length === 0
      ? null
      : Math.max(...timeToFirstTokenValues),
    averageReplayPassRate0to1: averageNullable(
      benchLoopRows.map((row) => row.benchLoop?.replayPassRate0to1 ?? null),
    ),
    averageScoreDelta0to1: averageNullable(
      benchLoopRows.map((row) => row.benchLoop?.scoreDelta0to1 ?? null),
    ),
  };
}

function buildScenarioSimulationReceipt(
  row: ReplayBenchmarkCorpusRowInput,
): ReplayBenchmarkScenarioSimulationReceipt | undefined {
  const scenario = row.fixture.scenarioSimulation;
  if (!scenario) return undefined;
  const explicitScoreDelta0to1 = nullableScoreDelta(scenario.scoreDelta0to1);
  return {
    benchmarkId: normalizeLabel(scenario.benchmarkId),
    benchmarkVersion: normalizeLabel(scenario.benchmarkVersion),
    repositorySnapshotHash: normalizeHashLabel(scenario.repositorySnapshotHash),
    sourceRefHash: normalizeHashLabel(scenario.sourceRefHash),
    scenarioProjectManifestHash: normalizeHashLabel(scenario.scenarioProjectManifestHash),
    sceneDefinitionHash: normalizeHashLabel(scenario.sceneDefinitionHash),
    roleDefinitionHash: normalizeHashLabel(scenario.roleDefinitionHash),
    agentRosterHash: normalizeHashLabel(scenario.agentRosterHash),
    humanParticipantPolicyHash: normalizeHashLabel(scenario.humanParticipantPolicyHash),
    llmAgentConfigHash: normalizeHashLabel(scenario.llmAgentConfigHash),
    evaluatorConfigHash: normalizeHashLabel(scenario.evaluatorConfigHash),
    actionSchemaHash: normalizeHashLabel(scenario.actionSchemaHash),
    taskDatasetHash: normalizeHashLabel(scenario.taskDatasetHash),
    webUiBuildHash: normalizeHashLabel(scenario.webUiBuildHash),
    serverConfigHash: normalizeHashLabel(scenario.serverConfigHash),
    containerImageHash: normalizeHashLabel(scenario.containerImageHash),
    persistenceStoreHash: normalizeHashLabel(scenario.persistenceStoreHash),
    checkpointManifestHash: normalizeHashLabel(scenario.checkpointManifestHash),
    runConfigHash: normalizeHashLabel(scenario.runConfigHash),
    eventLogHash: normalizeHashLabel(scenario.eventLogHash),
    actionTraceHash: normalizeHashLabel(scenario.actionTraceHash),
    evaluationReportHash: normalizeHashLabel(scenario.evaluationReportHash),
    visualizationArtifactHash: normalizeHashLabel(scenario.visualizationArtifactHash),
    replayCommandHash: normalizeHashLabel(scenario.replayCommandHash),
    deterministicSeed: nonNegativeInteger(scenario.deterministicSeed),
    agentMode: normalizeScenarioSimulationAgentMode(scenario.agentMode),
    evaluationMode: normalizeScenarioSimulationEvaluationMode(scenario.evaluationMode),
    visualizationMode: normalizeScenarioSimulationVisualizationMode(scenario.visualizationMode),
    scenarioCount: positiveInteger(scenario.scenarioCount),
    minScenarioCount: positiveInteger(scenario.minScenarioCount),
    agentCount: positiveInteger(scenario.agentCount),
    minAgentCount: positiveInteger(scenario.minAgentCount),
    actionCount: nonNegativeInteger(scenario.actionCount),
    minActionCount: nonNegativeInteger(scenario.minActionCount),
    evaluatedActionCount: nonNegativeInteger(scenario.evaluatedActionCount),
    minEvaluatedActionCount: nonNegativeInteger(scenario.minEvaluatedActionCount),
    actionEvaluationCoverage0to1: nullableRate(scenario.actionEvaluationCoverage0to1),
    minActionEvaluationCoverage0to1: nullableRate(scenario.minActionEvaluationCoverage0to1),
    taskSuccessRate0to1: nullableRate(scenario.taskSuccessRate0to1),
    minTaskSuccessRate0to1: nullableRate(scenario.minTaskSuccessRate0to1),
    actionScore0to1: nullableRate(scenario.actionScore0to1),
    minActionScore0to1: nullableRate(scenario.minActionScore0to1),
    replayPassRate0to1: nullableRate(scenario.replayPassRate0to1),
    minReplayPassRate0to1: nullableRate(scenario.minReplayPassRate0to1),
    scoreDelta0to1: explicitScoreDelta0to1 ?? round(row.candidate.score0to1 - row.baseline.score0to1),
    maxScoreRegression0to1: nonNegativeNumber(scenario.maxScoreRegression0to1),
    persistenceEnabled: typeof scenario.persistenceEnabled === "boolean" ? scenario.persistenceEnabled : null,
    checkpointResumeVerified: typeof scenario.checkpointResumeVerified === "boolean"
      ? scenario.checkpointResumeVerified
      : null,
  };
}

function appendScenarioSimulationIssues(
  issues: string[],
  scenario: ReplayBenchmarkScenarioSimulationReceipt | undefined,
): void {
  if (!scenario) return;
  if (!scenario.benchmarkId) {
    issues.push("scenario simulation benchmark id missing");
  }
  if (!scenario.benchmarkVersion) {
    issues.push("scenario simulation benchmark version missing");
  }
  if (!scenario.agentMode) {
    issues.push("scenario simulation agent mode missing");
  }
  if (!scenario.evaluationMode) {
    issues.push("scenario simulation evaluation mode missing");
  }
  if (!scenario.visualizationMode) {
    issues.push("scenario simulation visualization mode missing");
  }
  for (const [label, hash] of [
    ["repository snapshot", scenario.repositorySnapshotHash],
    ["source ref", scenario.sourceRefHash],
    ["scenario project manifest", scenario.scenarioProjectManifestHash],
    ["scene definition", scenario.sceneDefinitionHash],
    ["role definition", scenario.roleDefinitionHash],
    ["agent roster", scenario.agentRosterHash],
    ["human participant policy", scenario.humanParticipantPolicyHash],
    ["llm agent config", scenario.llmAgentConfigHash],
    ["evaluator config", scenario.evaluatorConfigHash],
    ["action schema", scenario.actionSchemaHash],
    ["task dataset", scenario.taskDatasetHash],
    ["web ui build", scenario.webUiBuildHash],
    ["server config", scenario.serverConfigHash],
    ["container image", scenario.containerImageHash],
    ["persistence store", scenario.persistenceStoreHash],
    ["checkpoint manifest", scenario.checkpointManifestHash],
    ["run config", scenario.runConfigHash],
    ["event log", scenario.eventLogHash],
    ["action trace", scenario.actionTraceHash],
    ["evaluation report", scenario.evaluationReportHash],
    ["visualization artifact", scenario.visualizationArtifactHash],
    ["replay command", scenario.replayCommandHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`scenario simulation ${label} hash invalid`);
    }
  }
  if (scenario.deterministicSeed === null) {
    issues.push("scenario simulation deterministic seed missing");
  }
  appendScenarioSimulationMinimumIssue(
    issues,
    "scenario count",
    scenario.scenarioCount,
    scenario.minScenarioCount,
  );
  appendScenarioSimulationMinimumIssue(issues, "agent count", scenario.agentCount, scenario.minAgentCount);
  appendScenarioSimulationMinimumIssue(issues, "action count", scenario.actionCount, scenario.minActionCount);
  appendScenarioSimulationMinimumIssue(
    issues,
    "evaluated action count",
    scenario.evaluatedActionCount,
    scenario.minEvaluatedActionCount,
  );
  appendScenarioSimulationMinimumIssue(
    issues,
    "action evaluation coverage",
    scenario.actionEvaluationCoverage0to1,
    scenario.minActionEvaluationCoverage0to1,
  );
  appendScenarioSimulationMinimumIssue(
    issues,
    "task success",
    scenario.taskSuccessRate0to1,
    scenario.minTaskSuccessRate0to1,
  );
  appendScenarioSimulationMinimumIssue(
    issues,
    "action score",
    scenario.actionScore0to1,
    scenario.minActionScore0to1,
  );
  appendScenarioSimulationMinimumIssue(
    issues,
    "replay pass rate",
    scenario.replayPassRate0to1,
    scenario.minReplayPassRate0to1,
  );
  if (scenario.scoreDelta0to1 === null) {
    issues.push("scenario simulation score delta missing");
  }
  if (scenario.maxScoreRegression0to1 === null) {
    issues.push("scenario simulation score regression threshold missing");
  }
  if (
    scenario.scoreDelta0to1 !== null
    && scenario.maxScoreRegression0to1 !== null
    && scenario.scoreDelta0to1 < -scenario.maxScoreRegression0to1
  ) {
    issues.push("scenario simulation score regression exceeds threshold");
  }
  if (scenario.persistenceEnabled === null) {
    issues.push("scenario simulation persistence flag missing");
  } else if (!scenario.persistenceEnabled) {
    issues.push("scenario simulation persistence disabled");
  }
  if (scenario.checkpointResumeVerified === null) {
    issues.push("scenario simulation checkpoint resume flag missing");
  } else if (!scenario.checkpointResumeVerified) {
    issues.push("scenario simulation checkpoint resume not verified");
  }
}

function appendScenarioSimulationMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`scenario simulation ${label} missing`);
    return;
  }
  if (minimum === null) {
    issues.push(`scenario simulation ${label} threshold missing`);
    return;
  }
  if (value < minimum) {
    issues.push(`scenario simulation ${label} below threshold`);
  }
}

function isScenarioSimulationFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("scenario simulation "));
}

function buildScenarioSimulationSummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkScenarioSimulationSummary {
  const scenarioRows = rows.filter((row) => row.scenarioSimulation);
  return {
    rowCount: scenarioRows.length,
    benchmarkIds: unique(
      scenarioRows
        .map((row) => row.scenarioSimulation?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    agentModes: unique(
      scenarioRows
        .map((row) => row.scenarioSimulation?.agentMode ?? "")
        .filter((value): value is ReplayBenchmarkScenarioSimulationAgentMode => (
          scenarioSimulationAgentModes.includes(value as ReplayBenchmarkScenarioSimulationAgentMode)
        )),
    ) as ReplayBenchmarkScenarioSimulationAgentMode[],
    evaluationModes: unique(
      scenarioRows
        .map((row) => row.scenarioSimulation?.evaluationMode ?? "")
        .filter((value): value is ReplayBenchmarkScenarioSimulationEvaluationMode => (
          scenarioSimulationEvaluationModes.includes(value as ReplayBenchmarkScenarioSimulationEvaluationMode)
        )),
    ) as ReplayBenchmarkScenarioSimulationEvaluationMode[],
    visualizationModes: unique(
      scenarioRows
        .map((row) => row.scenarioSimulation?.visualizationMode ?? "")
        .filter((value): value is ReplayBenchmarkScenarioSimulationVisualizationMode => (
          scenarioSimulationVisualizationModes.includes(value as ReplayBenchmarkScenarioSimulationVisualizationMode)
        )),
    ) as ReplayBenchmarkScenarioSimulationVisualizationMode[],
    failedRowIds: scenarioRows.filter(isScenarioSimulationFailure).map((row) => row.rowId),
    totalScenarioCount: scenarioRows.reduce((sum, row) => sum + (row.scenarioSimulation?.scenarioCount ?? 0), 0),
    totalActionCount: scenarioRows.reduce((sum, row) => sum + (row.scenarioSimulation?.actionCount ?? 0), 0),
    averageActionEvaluationCoverage0to1: averageNullable(
      scenarioRows.map((row) => row.scenarioSimulation?.actionEvaluationCoverage0to1 ?? null),
    ),
    averageTaskSuccessRate0to1: averageNullable(
      scenarioRows.map((row) => row.scenarioSimulation?.taskSuccessRate0to1 ?? null),
    ),
    averageReplayPassRate0to1: averageNullable(
      scenarioRows.map((row) => row.scenarioSimulation?.replayPassRate0to1 ?? null),
    ),
    averageScoreDelta0to1: averageNullable(
      scenarioRows.map((row) => row.scenarioSimulation?.scoreDelta0to1 ?? null),
    ),
    checkpointResumeVerifiedRowCount: scenarioRows.filter((row) => row.scenarioSimulation?.checkpointResumeVerified).length,
  };
}

