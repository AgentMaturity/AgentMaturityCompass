function ragModeUsesTextEvidence(mode: ReplayBenchmarkRagModalityMode | null): boolean {
  return mode === "text_only"
    || mode === "multimodal"
    || mode === "image_summary_multimodal"
    || mode === "correct_context"
    || mode === "custom";
}

function ragModeUsesImageEvidence(mode: ReplayBenchmarkRagModalityMode | null): boolean {
  return mode === "image_only"
    || mode === "multimodal"
    || mode === "image_summary_multimodal"
    || mode === "custom";
}

function ragModeRequiresMultimodalMetrics(mode: ReplayBenchmarkRagModalityMode | null): boolean {
  return mode === "multimodal" || mode === "image_summary_multimodal" || mode === "custom";
}

function isRagEvaluationFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("rag project id missing")
    || row.issues.includes("rag dataset id missing")
    || row.issues.includes("rag corpus document hash invalid")
    || row.issues.includes("rag modality mode missing")
    || row.issues.includes("rag vector store mode missing")
    || row.issues.includes("rag text corpus hash invalid")
    || row.issues.includes("rag image corpus hash invalid")
    || row.issues.includes("rag pdf extraction trace hash invalid")
    || row.issues.includes("rag image extraction trace hash invalid")
    || row.issues.includes("rag image summary hash invalid")
    || row.issues.includes("rag generated question set hash invalid")
    || row.issues.includes("rag reference answer set hash invalid")
    || row.issues.includes("rag retrieval trace hash invalid")
    || row.issues.includes("rag generation trace hash invalid")
    || row.issues.includes("rag scoring report hash invalid")
    || row.issues.includes("rag chunking config hash invalid")
    || row.issues.includes("rag text vector store hash invalid")
    || row.issues.includes("rag image vector store hash invalid")
    || row.issues.includes("rag combined vector store hash invalid")
    || row.issues.includes("rag multimodal embedding config hash invalid")
    || row.issues.includes("rag human review hash invalid")
    || row.issues.includes("rag baseline run hash invalid")
    || row.issues.includes("rag correct-context run hash invalid")
    || row.issues.includes("rag judge model id missing")
    || row.issues.includes("rag judge rubric hash invalid")
    || row.issues.includes("rag quality metric missing")
    || row.issues.includes("rag answer judge metric missing")
    || row.issues.includes("rag text judge metric missing")
    || row.issues.includes("rag image judge metric missing")
    || row.issues.includes("rag modality coverage metric missing")
    || row.issues.includes("rag eval flow source ref hash invalid")
    || row.issues.includes("rag eval flow repository snapshot hash invalid")
    || row.issues.includes("rag eval flow license ref hash invalid")
    || row.issues.includes("rag eval flow pipeline config hash invalid")
    || row.issues.includes("rag eval flow data source manifest hash invalid")
    || row.issues.includes("rag eval flow model config hash invalid")
    || row.issues.includes("rag eval flow judge config hash invalid")
    || row.issues.includes("rag eval flow metric definition hash invalid")
    || row.issues.includes("rag eval flow prompt template hash invalid")
    || row.issues.includes("rag eval flow eval pack manifest hash invalid")
    || row.issues.includes("rag eval flow fixture hash invalid")
    || row.issues.includes("rag eval flow replay command hash invalid")
    || row.issues.includes("rag eval flow result manifest hash invalid")
    || row.issues.includes("rag eval flow score delta report hash invalid")
    || row.issues.includes("rag eval flow ci receipt hash invalid")
    || row.issues.includes("rag eval flow pipeline id missing")
    || row.issues.includes("rag eval flow data format missing")
    || row.issues.includes("rag eval flow model backend missing")
    || row.issues.includes("rag eval flow judge backend missing")
    || row.issues.includes("rag eval flow metric ids missing")
    || row.issues.includes("rag eval flow sample size missing")
    || row.issues.includes("rag eval flow minimum sample size missing")
    || row.issues.includes("rag eval flow sample size below threshold")
    || row.issues.includes("rag eval flow deterministic seed missing")
    || row.issues.includes("rag eval flow baseline score missing")
    || row.issues.includes("rag eval flow candidate score missing")
    || row.issues.includes("rag eval flow score delta missing")
    || row.issues.includes("rag eval flow score regression threshold missing")
    || row.issues.includes("rag eval flow score regression exceeds threshold")
    || row.issues.includes("rag eval flow replay pass rate missing")
    || row.issues.includes("rag eval flow minimum replay pass rate missing")
    || row.issues.includes("rag eval flow replay pass rate below threshold")
    || row.issues.includes("rag eval flow metric coverage missing")
    || row.issues.includes("rag eval flow minimum metric coverage missing")
    || row.issues.includes("rag eval flow metric coverage below threshold")
    || row.issues.includes("rag eval dataset source ref hash invalid")
    || row.issues.includes("rag eval dataset repository snapshot hash invalid")
    || row.issues.includes("rag eval dataset license ref hash invalid")
    || row.issues.includes("rag eval dataset input document manifest hash invalid")
    || row.issues.includes("rag eval dataset processor config hash invalid")
    || row.issues.includes("rag eval dataset prompt template hash invalid")
    || row.issues.includes("rag eval dataset generator config hash invalid")
    || row.issues.includes("rag eval dataset qa dataset hash invalid")
    || row.issues.includes("rag eval dataset endpoint config hash invalid")
    || row.issues.includes("rag eval dataset endpoint response trace hash invalid")
    || row.issues.includes("rag eval dataset ranking report hash invalid")
    || row.issues.includes("rag eval dataset evaluation run hash invalid")
    || row.issues.includes("rag eval dataset replay command hash invalid")
    || row.issues.includes("rag eval dataset ci receipt hash invalid")
    || row.issues.includes("rag eval dataset id missing")
    || row.issues.includes("rag eval dataset data formats missing")
    || row.issues.includes("rag eval dataset endpoint modes missing")
    || row.issues.includes("rag eval dataset metric ids missing")
    || row.issues.includes("rag eval dataset question count missing")
    || row.issues.includes("rag eval dataset question count threshold missing")
    || row.issues.includes("rag eval dataset question count below threshold")
    || row.issues.includes("rag eval dataset endpoint count missing")
    || row.issues.includes("rag eval dataset endpoint count threshold missing")
    || row.issues.includes("rag eval dataset endpoint count below threshold")
    || row.issues.includes("rag eval dataset deterministic seed missing")
    || row.issues.includes("rag eval dataset baseline score missing")
    || row.issues.includes("rag eval dataset candidate score missing")
    || row.issues.includes("rag eval dataset score delta missing")
    || row.issues.includes("rag eval dataset score regression threshold missing")
    || row.issues.includes("rag eval dataset score regression exceeds threshold")
    || row.issues.includes("rag eval dataset replay pass rate missing")
    || row.issues.includes("rag eval dataset replay pass rate threshold missing")
    || row.issues.includes("rag eval dataset replay pass rate below threshold")
    || row.issues.includes("rag eval dataset endpoint response coverage missing")
    || row.issues.includes("rag eval dataset endpoint response coverage threshold missing")
    || row.issues.includes("rag eval dataset endpoint response coverage below threshold")
    || row.issues.includes("mirage source ref hash invalid")
    || row.issues.includes("mirage repository snapshot hash invalid")
    || row.issues.includes("mirage license ref hash invalid")
    || row.issues.includes("mirage input document manifest hash invalid")
    || row.issues.includes("mirage semantic chunk manifest hash invalid")
    || row.issues.includes("mirage multihop context graph hash invalid")
    || row.issues.includes("mirage domain expert role manifest hash invalid")
    || row.issues.includes("mirage generate-select-verify-correct trace hash invalid")
    || row.issues.includes("mirage multimodal carrier manifest hash invalid")
    || row.issues.includes("mirage backend config hash invalid")
    || row.issues.includes("mirage embedding config hash invalid")
    || row.issues.includes("mirage reranker config hash invalid")
    || row.issues.includes("mirage token usage trace hash invalid")
    || row.issues.includes("mirage checkpoint resume hash invalid")
    || row.issues.includes("mirage deduplication report hash invalid")
    || row.issues.includes("mirage evaluation report hash invalid")
    || row.issues.includes("mirage replay command hash invalid")
    || row.issues.includes("mirage output dataset hash invalid")
    || row.issues.includes("mirage visualization artifact hash invalid")
    || row.issues.includes("mirage dataset id missing")
    || row.issues.includes("mirage backend ids missing")
    || row.issues.includes("mirage modality ids missing")
    || row.issues.includes("mirage pipeline stage ids missing")
    || row.issues.includes("mirage question count missing")
    || row.issues.includes("mirage minimum question count missing")
    || row.issues.includes("mirage question count below threshold")
    || row.issues.includes("mirage deterministic seed missing")
    || row.issues.includes("mirage baseline quality missing")
    || row.issues.includes("mirage candidate quality missing")
    || row.issues.includes("mirage score delta missing")
    || row.issues.includes("mirage score regression threshold missing")
    || row.issues.includes("mirage score regression exceeds threshold")
    || row.issues.includes("mirage replay pass rate missing")
    || row.issues.includes("mirage minimum replay pass rate missing")
    || row.issues.includes("mirage replay pass rate below threshold")
    || row.issues.includes("mirage metric coverage missing")
    || row.issues.includes("mirage minimum metric coverage missing")
    || row.issues.includes("mirage metric coverage below threshold")
    || row.issues.some((issue) => issue.startsWith("encourage rag "))
    || row.issues.includes("rag performance metric missing");
}

function buildRagEvaluationSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkRagEvaluationSummary {
  const ragRows = rows.filter((row) => row.ragEvaluation);
  const qualityScores = ragRows
    .map((row) => row.ragEvaluation?.qualityScoreMean0to1 ?? null)
    .filter((value): value is number => value !== null);
  const multimodalJudgeScores = ragRows
    .map((row) => row.ragEvaluation?.multimodalJudgeScoreMean0to1 ?? null)
    .filter((value): value is number => value !== null);
  const modalityCoverageScores = ragRows
    .map((row) => row.ragEvaluation?.modalityCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const responseLatencies = ragRows
    .map((row) => row.ragEvaluation?.responseLatencyMs ?? null)
    .filter((value): value is number => value !== null);
  const throughputValues = ragRows
    .map((row) => row.ragEvaluation?.throughputQps ?? null)
    .filter((value): value is number => value !== null);
  const ragEvalFlowRows = ragRows.filter((row) => row.ragEvaluation && hasRagEvalFlowSignal(row.ragEvaluation));
  const ragEvalFlowScoreDeltas = ragEvalFlowRows
    .map((row) => row.ragEvaluation?.ragEvalFlowScoreDelta0to1 ?? null)
    .filter((value): value is number => value !== null);
  const ragEvalFlowReplayPassRates = ragEvalFlowRows
    .map((row) => row.ragEvaluation?.ragEvalFlowReplayPassRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const ragEvalFlowMetricCoverages = ragEvalFlowRows
    .map((row) => row.ragEvaluation?.ragEvalFlowMetricCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const ragEvalDatasetRows = ragRows.filter((row) => row.ragEvaluation && hasRagEvalDatasetReplaySignal(row.ragEvaluation));
  const ragEvalDatasetScoreDeltas = ragEvalDatasetRows
    .map((row) => row.ragEvaluation?.ragEvalDatasetScoreDelta0to1 ?? null)
    .filter((value): value is number => value !== null);
  const ragEvalDatasetReplayPassRates = ragEvalDatasetRows
    .map((row) => row.ragEvaluation?.ragEvalDatasetReplayPassRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const ragEvalDatasetEndpointResponseCoverages = ragEvalDatasetRows
    .map((row) => row.ragEvaluation?.ragEvalDatasetEndpointResponseCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const mirageRows = ragRows.filter((row) => row.ragEvaluation && hasMirageDatasetGenerationSignal(row.ragEvaluation));
  const mirageScoreDeltas = mirageRows
    .map((row) => row.ragEvaluation?.mirageScoreDelta0to1 ?? null)
    .filter((value): value is number => value !== null);
  const mirageReplayPassRates = mirageRows
    .map((row) => row.ragEvaluation?.mirageReplayPassRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const mirageMetricCoverages = mirageRows
    .map((row) => row.ragEvaluation?.mirageMetricCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const encourageRows = ragRows.filter((row) => row.ragEvaluation && hasEncourageRagSignal(row.ragEvaluation));
  const encourageScoreDeltas = encourageRows
    .map((row) => row.ragEvaluation?.encourageScoreDelta0to1 ?? null)
    .filter((value): value is number => value !== null);
  const encourageReplayPassRates = encourageRows
    .map((row) => row.ragEvaluation?.encourageReplayPassRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const encourageMetricCoverages = encourageRows
    .map((row) => row.ragEvaluation?.encourageMetricCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const modalityModes = unique(
    ragRows
      .map((row) => row.ragEvaluation?.ragModalityMode ?? "")
      .filter((value): value is ReplayBenchmarkRagModalityMode => ragModalityModes.includes(value as ReplayBenchmarkRagModalityMode)),
  ) as ReplayBenchmarkRagModalityMode[];
  const vectorStoreModes = unique(
    ragRows
      .map((row) => row.ragEvaluation?.vectorStoreMode ?? "")
      .filter((value): value is ReplayBenchmarkRagVectorStoreMode => ragVectorStoreModes.includes(value as ReplayBenchmarkRagVectorStoreMode)),
  ) as ReplayBenchmarkRagVectorStoreMode[];
  return {
    rowCount: ragRows.length,
    modalityModes,
    vectorStoreModes,
    failedRowIds: ragRows.filter(isRagEvaluationFailure).map((row) => row.rowId),
    humanReviewedRowCount: ragRows.filter((row) => Boolean(row.ragEvaluation?.humanReviewHash)).length,
    multimodalRowCount: ragRows.filter((row) => ragModeRequiresMultimodalMetrics(row.ragEvaluation?.ragModalityMode ?? null)).length,
    imageEvidenceRowCount: ragRows.filter((row) => Boolean(row.ragEvaluation?.imageCorpusHash || row.ragEvaluation?.imageExtractionTraceHash)).length,
    averageQualityScore0to1: qualityScores.length === 0
      ? null
      : round(qualityScores.reduce((sum, value) => sum + value, 0) / qualityScores.length),
    averageMultimodalJudgeScore0to1: multimodalJudgeScores.length === 0
      ? null
      : round(multimodalJudgeScores.reduce((sum, value) => sum + value, 0) / multimodalJudgeScores.length),
    averageModalityCoverage0to1: modalityCoverageScores.length === 0
      ? null
      : round(modalityCoverageScores.reduce((sum, value) => sum + value, 0) / modalityCoverageScores.length),
    averageResponseLatencyMs: responseLatencies.length === 0
      ? null
      : round(responseLatencies.reduce((sum, value) => sum + value, 0) / responseLatencies.length),
    averageThroughputQps: throughputValues.length === 0
      ? null
      : round(throughputValues.reduce((sum, value) => sum + value, 0) / throughputValues.length),
    ragEvalFlowRowCount: ragEvalFlowRows.length,
    ragEvalFlowDataFormats: unique(
      ragEvalFlowRows
        .map((row) => row.ragEvaluation?.ragEvalFlowDataFormat ?? "")
        .filter((value): value is ReplayBenchmarkRagEvalFlowDataFormat => ragEvalFlowDataFormats.includes(value as ReplayBenchmarkRagEvalFlowDataFormat)),
    ) as ReplayBenchmarkRagEvalFlowDataFormat[],
    ragEvalFlowModelBackends: unique(
      ragEvalFlowRows
        .map((row) => row.ragEvaluation?.ragEvalFlowModelBackend ?? "")
        .filter((value): value is ReplayBenchmarkRagEvalFlowModelBackend => ragEvalFlowModelBackends.includes(value as ReplayBenchmarkRagEvalFlowModelBackend)),
    ) as ReplayBenchmarkRagEvalFlowModelBackend[],
    ragEvalFlowJudgeBackends: unique(
      ragEvalFlowRows
        .map((row) => row.ragEvaluation?.ragEvalFlowJudgeBackend ?? "")
        .filter((value): value is ReplayBenchmarkRagEvalFlowJudgeBackend => ragEvalFlowJudgeBackends.includes(value as ReplayBenchmarkRagEvalFlowJudgeBackend)),
    ) as ReplayBenchmarkRagEvalFlowJudgeBackend[],
    failedRagEvalFlowRowIds: ragEvalFlowRows.filter(isRagEvaluationFailure).map((row) => row.rowId),
    totalRagEvalFlowSampleSize: ragEvalFlowRows.reduce(
      (sum, row) => sum + (row.ragEvaluation?.ragEvalFlowSampleSize ?? 0),
      0,
    ),
    averageRagEvalFlowScoreDelta0to1: ragEvalFlowScoreDeltas.length === 0
      ? null
      : round(ragEvalFlowScoreDeltas.reduce((sum, value) => sum + value, 0) / ragEvalFlowScoreDeltas.length),
    averageRagEvalFlowReplayPassRate0to1: ragEvalFlowReplayPassRates.length === 0
      ? null
      : round(ragEvalFlowReplayPassRates.reduce((sum, value) => sum + value, 0) / ragEvalFlowReplayPassRates.length),
    averageRagEvalFlowMetricCoverage0to1: ragEvalFlowMetricCoverages.length === 0
      ? null
      : round(ragEvalFlowMetricCoverages.reduce((sum, value) => sum + value, 0) / ragEvalFlowMetricCoverages.length),
    ragEvalDatasetReplayRowCount: ragEvalDatasetRows.length,
    ragEvalDatasetDataFormats: unique(
      ragEvalDatasetRows.flatMap((row) => row.ragEvaluation?.ragEvalDatasetDataFormats ?? []),
    ) as ReplayBenchmarkRagEvalDatasetDataFormat[],
    ragEvalDatasetEndpointModes: unique(
      ragEvalDatasetRows.flatMap((row) => row.ragEvaluation?.ragEvalDatasetEndpointModes ?? []),
    ) as ReplayBenchmarkRagEvalDatasetEndpointMode[],
    failedRagEvalDatasetReplayRowIds: ragEvalDatasetRows.filter(isRagEvaluationFailure).map((row) => row.rowId),
    totalRagEvalDatasetQuestionCount: ragEvalDatasetRows.reduce(
      (sum, row) => sum + (row.ragEvaluation?.ragEvalDatasetQuestionCount ?? 0),
      0,
    ),
    totalRagEvalDatasetEndpointCount: ragEvalDatasetRows.reduce(
      (sum, row) => sum + (row.ragEvaluation?.ragEvalDatasetEndpointCount ?? 0),
      0,
    ),
    averageRagEvalDatasetScoreDelta0to1: ragEvalDatasetScoreDeltas.length === 0
      ? null
      : round(ragEvalDatasetScoreDeltas.reduce((sum, value) => sum + value, 0) / ragEvalDatasetScoreDeltas.length),
    averageRagEvalDatasetReplayPassRate0to1: ragEvalDatasetReplayPassRates.length === 0
      ? null
      : round(ragEvalDatasetReplayPassRates.reduce((sum, value) => sum + value, 0) / ragEvalDatasetReplayPassRates.length),
    averageRagEvalDatasetEndpointResponseCoverage0to1: ragEvalDatasetEndpointResponseCoverages.length === 0
      ? null
      : round(
        ragEvalDatasetEndpointResponseCoverages.reduce((sum, value) => sum + value, 0)
        / ragEvalDatasetEndpointResponseCoverages.length,
      ),
    mirageDatasetGenerationRowCount: mirageRows.length,
    mirageBackendIds: unique(mirageRows.flatMap((row) => row.ragEvaluation?.mirageBackendIds ?? [])),
    mirageModalityIds: unique(mirageRows.flatMap((row) => row.ragEvaluation?.mirageModalityIds ?? [])),
    failedMirageDatasetGenerationRowIds: mirageRows.filter(isRagEvaluationFailure).map((row) => row.rowId),
    totalMirageQuestionCount: mirageRows.reduce(
      (sum, row) => sum + (row.ragEvaluation?.mirageQuestionCount ?? 0),
      0,
    ),
    averageMirageScoreDelta0to1: mirageScoreDeltas.length === 0
      ? null
      : round(mirageScoreDeltas.reduce((sum, value) => sum + value, 0) / mirageScoreDeltas.length),
    averageMirageReplayPassRate0to1: mirageReplayPassRates.length === 0
      ? null
      : round(mirageReplayPassRates.reduce((sum, value) => sum + value, 0) / mirageReplayPassRates.length),
    averageMirageMetricCoverage0to1: mirageMetricCoverages.length === 0
      ? null
      : round(mirageMetricCoverages.reduce((sum, value) => sum + value, 0) / mirageMetricCoverages.length),
    encourageRagReplayRowCount: encourageRows.length,
    encourageRagMethods: unique(
      encourageRows
        .map((row) => row.ragEvaluation?.encourageRagMethodId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    encourageInferenceBackends: unique(
      encourageRows
        .map((row) => row.ragEvaluation?.encourageInferenceBackend ?? "")
        .filter((value): value is ReplayBenchmarkEncourageInferenceBackend => (
          encourageInferenceBackends.includes(value as ReplayBenchmarkEncourageInferenceBackend)
        )),
    ) as ReplayBenchmarkEncourageInferenceBackend[],
    encourageVectorDbs: unique(
      encourageRows
        .map((row) => row.ragEvaluation?.encourageVectorDb ?? "")
        .filter((value): value is ReplayBenchmarkEncourageVectorDb => (
          encourageVectorDbs.includes(value as ReplayBenchmarkEncourageVectorDb)
        )),
    ) as ReplayBenchmarkEncourageVectorDb[],
    failedEncourageRagReplayRowIds: encourageRows.filter(isRagEvaluationFailure).map((row) => row.rowId),
    totalEncourageDocumentCount: encourageRows.reduce(
      (sum, row) => sum + (row.ragEvaluation?.encourageDocumentCount ?? 0),
      0,
    ),
    totalEncourageQuestionCount: encourageRows.reduce(
      (sum, row) => sum + (row.ragEvaluation?.encourageQuestionCount ?? 0),
      0,
    ),
    averageEncourageScoreDelta0to1: encourageScoreDeltas.length === 0
      ? null
      : round(encourageScoreDeltas.reduce((sum, value) => sum + value, 0) / encourageScoreDeltas.length),
    averageEncourageReplayPassRate0to1: encourageReplayPassRates.length === 0
      ? null
      : round(encourageReplayPassRates.reduce((sum, value) => sum + value, 0) / encourageReplayPassRates.length),
    averageEncourageMetricCoverage0to1: encourageMetricCoverages.length === 0
      ? null
      : round(encourageMetricCoverages.reduce((sum, value) => sum + value, 0) / encourageMetricCoverages.length),
  };
}

function buildChunkingStrategyEvaluationReceipt(
  row: ReplayBenchmarkCorpusRowInput,
): ReplayBenchmarkChunkingStrategyEvaluationReceipt | undefined {
  const chunking = row.fixture.chunkingStrategyEvaluation;
  if (!chunking) return undefined;
  const strategyKinds = unique((chunking.strategyKinds ?? [])
    .map((value) => normalizeChunkingStrategyKind(value))
    .filter((value): value is ReplayBenchmarkChunkingStrategyKind => value !== null));
  return {
    benchmarkId: normalizeLabel(chunking.benchmarkId),
    benchmarkVersion: normalizeLabel(chunking.benchmarkVersion),
    sourceRefHash: normalizeHashLabel(chunking.sourceRefHash),
    documentSetHash: normalizeHashLabel(chunking.documentSetHash),
    questionSetHash: normalizeHashLabel(chunking.questionSetHash),
    referenceAnswerSetHash: normalizeHashLabel(chunking.referenceAnswerSetHash),
    chunkerManifestHash: normalizeHashLabel(chunking.chunkerManifestHash),
    chunkingConfigHash: normalizeHashLabel(chunking.chunkingConfigHash),
    embedderConfigHash: normalizeHashLabel(chunking.embedderConfigHash),
    keywordIndexConfigHash: normalizeHashLabel(chunking.keywordIndexConfigHash),
    retrievalFusionConfigHash: normalizeHashLabel(chunking.retrievalFusionConfigHash),
    retrievalTraceHash: normalizeHashLabel(chunking.retrievalTraceHash),
    scoringConfigHash: normalizeHashLabel(chunking.scoringConfigHash),
    scoringReportHash: normalizeHashLabel(chunking.scoringReportHash),
    reportArtifactHash: normalizeHashLabel(chunking.reportArtifactHash),
    exportArtifactHash: normalizeHashLabel(chunking.exportArtifactHash),
    replayCommandHash: normalizeHashLabel(chunking.replayCommandHash),
    deterministicSeed: positiveInteger(chunking.deterministicSeed),
    documentCount: positiveInteger(chunking.documentCount),
    questionCount: positiveInteger(chunking.questionCount),
    minQuestionCount: positiveInteger(chunking.minQuestionCount),
    chunkerCount: positiveInteger(chunking.chunkerCount),
    minChunkerCount: positiveInteger(chunking.minChunkerCount),
    strategyKinds: strategyKinds as ReplayBenchmarkChunkingStrategyKind[],
    retrievalMode: normalizeChunkingRetrievalMode(chunking.retrievalMode),
    bestChunkerId: normalizeLabel(chunking.bestChunkerId),
    baselineCombinedScore0to1: nullableRate(chunking.baselineCombinedScore0to1),
    candidateCombinedScore0to1: nullableRate(chunking.candidateCombinedScore0to1),
    minCandidateCombinedScore0to1: nullableRate(chunking.minCandidateCombinedScore0to1),
    scoreDelta0to1: nullableScoreDelta(chunking.scoreDelta0to1),
    maxScoreRegression0to1: nullableRate(chunking.maxScoreRegression0to1),
    answerSpanCoverage0to1: nullableRate(chunking.answerSpanCoverage0to1),
    minAnswerSpanCoverage0to1: nullableRate(chunking.minAnswerSpanCoverage0to1),
    semanticFocus0to1: nullableRate(chunking.semanticFocus0to1),
    minSemanticFocus0to1: nullableRate(chunking.minSemanticFocus0to1),
  };
}

function isChunkingStrategyEvaluationFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("chunking strategy "));
}

function buildChunkingStrategyEvaluationSummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkChunkingStrategyEvaluationSummary {
  const chunkingRows = rows.filter((row) => row.chunkingStrategyEvaluation);
  const candidateScores = chunkingRows
    .map((row) => row.chunkingStrategyEvaluation?.candidateCombinedScore0to1 ?? null)
    .filter((value): value is number => value !== null);
  const scoreDeltas = chunkingRows
    .map((row) => row.chunkingStrategyEvaluation?.scoreDelta0to1 ?? null)
    .filter((value): value is number => value !== null);
  const answerSpanCoverages = chunkingRows
    .map((row) => row.chunkingStrategyEvaluation?.answerSpanCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const semanticFocusScores = chunkingRows
    .map((row) => row.chunkingStrategyEvaluation?.semanticFocus0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: chunkingRows.length,
    benchmarkIds: unique(
      chunkingRows
        .map((row) => row.chunkingStrategyEvaluation?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    retrievalModes: unique(
      chunkingRows
        .map((row) => row.chunkingStrategyEvaluation?.retrievalMode ?? "")
        .filter((value): value is ReplayBenchmarkChunkingRetrievalMode => (
          chunkingRetrievalModes.includes(value as ReplayBenchmarkChunkingRetrievalMode)
        )),
    ) as ReplayBenchmarkChunkingRetrievalMode[],
    strategyKinds: unique(
      chunkingRows.flatMap((row) => row.chunkingStrategyEvaluation?.strategyKinds ?? []),
    ) as ReplayBenchmarkChunkingStrategyKind[],
    failedRowIds: chunkingRows.filter(isChunkingStrategyEvaluationFailure).map((row) => row.rowId),
    totalDocumentCount: chunkingRows.reduce((sum, row) => sum + (row.chunkingStrategyEvaluation?.documentCount ?? 0), 0),
    totalQuestionCount: chunkingRows.reduce((sum, row) => sum + (row.chunkingStrategyEvaluation?.questionCount ?? 0), 0),
    totalChunkerCount: chunkingRows.reduce((sum, row) => sum + (row.chunkingStrategyEvaluation?.chunkerCount ?? 0), 0),
    averageCandidateCombinedScore0to1: candidateScores.length === 0
      ? null
      : round(candidateScores.reduce((sum, value) => sum + value, 0) / candidateScores.length),
    averageScoreDelta0to1: scoreDeltas.length === 0
      ? null
      : round(scoreDeltas.reduce((sum, value) => sum + value, 0) / scoreDeltas.length),
    averageAnswerSpanCoverage0to1: answerSpanCoverages.length === 0
      ? null
      : round(answerSpanCoverages.reduce((sum, value) => sum + value, 0) / answerSpanCoverages.length),
    averageSemanticFocus0to1: semanticFocusScores.length === 0
      ? null
      : round(semanticFocusScores.reduce((sum, value) => sum + value, 0) / semanticFocusScores.length),
  };
}

function buildAdvancedRagReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkAdvancedRagReceipt | undefined {
  const advanced = row.fixture.advancedRag;
  if (!advanced) return undefined;
  return {
    courseId: normalizeLabel(advanced.courseId),
    lessonId: normalizeAdvancedRagLesson(advanced.lessonId),
    retrievalVariant: normalizeAdvancedRagRetrievalVariant(advanced.retrievalVariant),
    notebookHash: normalizeHashLabel(advanced.notebookHash),
    notebookOutputHash: normalizeHashLabel(advanced.notebookOutputHash),
    environmentHash: normalizeHashLabel(advanced.environmentHash),
    dependencyLockHash: normalizeHashLabel(advanced.dependencyLockHash),
    corpusDocumentHash: normalizeHashLabel(advanced.corpusDocumentHash),
    indexConfigHash: normalizeHashLabel(advanced.indexConfigHash),
    querySetHash: normalizeHashLabel(advanced.querySetHash),
    referenceAnswerSetHash: normalizeHashLabel(advanced.referenceAnswerSetHash),
    retrievalTraceHash: normalizeHashLabel(advanced.retrievalTraceHash),
    generationTraceHash: normalizeHashLabel(advanced.generationTraceHash),
    evalConfigHash: normalizeHashLabel(advanced.evalConfigHash),
    evalTraceHash: normalizeHashLabel(advanced.evalTraceHash),
    observabilityTraceHash: normalizeHashLabel(advanced.observabilityTraceHash),
    replayCommandHash: normalizeHashLabel(advanced.replayCommandHash),
    deterministicSeed: positiveInteger(advanced.deterministicSeed),
    queryCount: positiveInteger(advanced.queryCount),
    minQueryCount: positiveInteger(advanced.minQueryCount),
    contextRelevance0to1: nullableRate(advanced.contextRelevance0to1),
    minContextRelevance0to1: nullableRate(advanced.minContextRelevance0to1),
    groundedness0to1: nullableRate(advanced.groundedness0to1),
    minGroundedness0to1: nullableRate(advanced.minGroundedness0to1),
    answerRelevance0to1: nullableRate(advanced.answerRelevance0to1),
    minAnswerRelevance0to1: nullableRate(advanced.minAnswerRelevance0to1),
  };
}

function isAdvancedRagFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("advanced rag "));
}

function buildAdvancedRagSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkAdvancedRagSummary {
  const advancedRows = rows.filter((row) => row.advancedRag);
  const contextScores = advancedRows
    .map((row) => row.advancedRag?.contextRelevance0to1 ?? null)
    .filter((value): value is number => value !== null);
  const groundednessScores = advancedRows
    .map((row) => row.advancedRag?.groundedness0to1 ?? null)
    .filter((value): value is number => value !== null);
  const answerScores = advancedRows
    .map((row) => row.advancedRag?.answerRelevance0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: advancedRows.length,
    courseIds: unique(
      advancedRows
        .map((row) => row.advancedRag?.courseId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    lessonIds: unique(
      advancedRows
        .map((row) => row.advancedRag?.lessonId ?? "")
        .filter((value): value is ReplayBenchmarkAdvancedRagLesson => advancedRagLessons.includes(value as ReplayBenchmarkAdvancedRagLesson)),
    ) as ReplayBenchmarkAdvancedRagLesson[],
    retrievalVariants: unique(
      advancedRows
        .map((row) => row.advancedRag?.retrievalVariant ?? "")
        .filter((value): value is ReplayBenchmarkAdvancedRagRetrievalVariant => (
          advancedRagRetrievalVariants.includes(value as ReplayBenchmarkAdvancedRagRetrievalVariant)
        )),
    ) as ReplayBenchmarkAdvancedRagRetrievalVariant[],
    failedRowIds: advancedRows.filter(isAdvancedRagFailure).map((row) => row.rowId),
    totalQueryCount: advancedRows.reduce((sum, row) => sum + (row.advancedRag?.queryCount ?? 0), 0),
    averageContextRelevance0to1: contextScores.length === 0
      ? null
      : round(contextScores.reduce((sum, value) => sum + value, 0) / contextScores.length),
    averageGroundedness0to1: groundednessScores.length === 0
      ? null
      : round(groundednessScores.reduce((sum, value) => sum + value, 0) / groundednessScores.length),
    averageAnswerRelevance0to1: answerScores.length === 0
      ? null
      : round(answerScores.reduce((sum, value) => sum + value, 0) / answerScores.length),
  };
}

function buildDocThinkerDocumentRagReceipt(
  row: ReplayBenchmarkCorpusRowInput,
): ReplayBenchmarkDocThinkerDocumentRagReceipt | undefined {
