function hasRealTalkSignal(memory: ReplayBenchmarkLongTermMemoryReceipt): boolean {
  return memory.realTalkTask !== null
    || [
      memory.realTalkPaperRefHash,
      memory.realTalkDatasetLicenseRefHash,
      memory.realTalkRawExportManifestHash,
      memory.realTalkPreprocessedConversationHash,
      memory.realTalkParticipantManifestHash,
      memory.realTalkSpeakerManifestHash,
      memory.realTalkTemporalSplitHash,
      memory.realTalkPrivacyConsentHash,
      memory.realTalkLocomoComparisonHash,
      memory.realTalkQuestionAnswerManifestHash,
      memory.realTalkOpenAiBoundaryHash,
      memory.realTalkEvaluatorConfigHash,
      memory.realTalkGptScoreArtifactHash,
      memory.realTalkLexicalF1ArtifactHash,
      memory.realTalkEiAnnotationHash,
      memory.realTalkEiMetricsHash,
      memory.realTalkPersonaSimulationReleaseHash,
      memory.realTalkPersonaPromptHash,
      memory.realTalkPersonaEvalArtifactHash,
    ].some((value) => value !== null)
    || [
      memory.realTalkConversationDaySpan,
      memory.minRealTalkConversationDaySpan,
      memory.realTalkParticipantCount,
      memory.minRealTalkParticipantCount,
      memory.realTalkQuestionCount,
      memory.minRealTalkQuestionCount,
      memory.realTalkLexicalF1Score0to1,
      memory.minRealTalkLexicalF1Score0to1,
      memory.realTalkGptScore0to1,
      memory.minRealTalkGptScore0to1,
      memory.realTalkPersonaConsistency0to1,
      memory.minRealTalkPersonaConsistency0to1,
      memory.realTalkEiCoverage0to1,
      memory.minRealTalkEiCoverage0to1,
    ].some((value) => value !== null);
}

