function appendCostNavReplayIssues(
  issues: string[],
  replay: ReplayBenchmarkAgentBenchmarkReplayReceipt,
): void {
  if (!hasCostNavReplaySignal(replay)) {
    return;
  }
  if (!replay.costNavBenchmarkId) {
    issues.push("agent benchmark replay costnav benchmark id missing");
  }
  for (const [label, hash] of [
    ["source ref", replay.costNavSourceRefHash],
    ["repository snapshot", replay.costNavRepositorySnapshotHash],
    ["license ref", replay.costNavLicenseRefHash],
    ["benchmark spec", replay.costNavBenchmarkSpecHash],
    ["scenario manifest", replay.costNavScenarioManifestHash],
