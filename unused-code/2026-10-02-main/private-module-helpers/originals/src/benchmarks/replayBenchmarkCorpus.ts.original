    edgeAiScoreDelta0to1: nullableScoreDelta(replay.edgeAiScoreDelta0to1),
    minEdgeAiScoreDelta0to1: nullableScoreDelta(replay.minEdgeAiScoreDelta0to1),
  };
}

function hasAiAgentBenchmarkComparisonSignal(replay: ReplayBenchmarkAgentBenchmarkReplayReceipt): boolean {
  return [
    replay.aiAgentBenchmarkSourceRefHash,
    replay.aiAgentBenchmarkRepositorySnapshotHash,
    replay.aiAgentBenchmarkLicenseRefHash,
    replay.aiAgentBenchmarkAgentRosterHash,
    replay.aiAgentBenchmarkBenchmarkDatasetHash,
    replay.aiAgentBenchmarkSourceManifestHash,
    replay.aiAgentBenchmarkPricingSnapshotHash,
    replay.aiAgentBenchmarkUserReportManifestHash,
    replay.aiAgentBenchmarkLeaderboardSnapshotHash,
    replay.aiAgentBenchmarkScoreManifestHash,
    replay.aiAgentBenchmarkEvalPackManifestHash,
    replay.aiAgentBenchmarkFixtureHash,
    replay.aiAgentBenchmarkReplayCommandHash,
    replay.aiAgentBenchmarkResultManifestHash,
    replay.aiAgentBenchmarkScoreDeltaReportHash,
    replay.aiAgentBenchmarkCiReceiptHash,
    replay.aiAgentBenchmarkComparisonRunId,
    replay.aiAgentBenchmarkAgentUnderTestId,
    replay.aiAgentBenchmarkAgentCategory,
  ].some((value) => value !== null)
    || replay.aiAgentBenchmarkFamilies.length > 0
    || replay.aiAgentBenchmarkSourceCategories.length > 0
    || [
      replay.minAiAgentBenchmarkFamilyCount,
      replay.minAiAgentBenchmarkSourceCategoryCount,
      replay.aiAgentBenchmarkAgentCount,
      replay.minAiAgentBenchmarkAgentCount,
      replay.aiAgentBenchmarkSourceCount,
      replay.minAiAgentBenchmarkSourceCount,
      replay.aiAgentBenchmarkBenchmarkCount,
      replay.minAiAgentBenchmarkBenchmarkCount,
      replay.aiAgentBenchmarkDeterministicSeed,
      replay.aiAgentBenchmarkBaselineScore0to1,
      replay.aiAgentBenchmarkCandidateScore0to1,
      replay.aiAgentBenchmarkScoreDelta0to1,
      replay.maxAiAgentBenchmarkScoreRegression0to1,
      replay.aiAgentBenchmarkReplayPassRate0to1,
      replay.minAiAgentBenchmarkReplayPassRate0to1,
      replay.aiAgentBenchmarkSourceCoverage0to1,
      replay.minAiAgentBenchmarkSourceCoverage0to1,
      replay.aiAgentBenchmarkPricingCoverage0to1,
      replay.minAiAgentBenchmarkPricingCoverage0to1,
      replay.aiAgentBenchmarkUserReportCoverage0to1,
      replay.minAiAgentBenchmarkUserReportCoverage0to1,
    ].some((value) => value !== null);
}

function isAiAgentBenchmarkComparisonRegressionIssue(issue: string): boolean {
  return [
    "agent benchmark replay ai-agent benchmark family count below threshold",
    "agent benchmark replay ai-agent source category count below threshold",
    "agent benchmark replay ai-agent agent count below threshold",
    "agent benchmark replay ai-agent source count below threshold",
    "agent benchmark replay ai-agent benchmark count below threshold",
    "agent benchmark replay ai-agent score regression exceeds threshold",
    "agent benchmark replay ai-agent replay pass rate below threshold",
    "agent benchmark replay ai-agent source coverage below threshold",
    "agent benchmark replay ai-agent pricing coverage below threshold",
    "agent benchmark replay ai-agent user-report coverage below threshold",
  ].includes(issue);
}

function hasGaiaAgentReplaySignal(replay: ReplayBenchmarkAgentBenchmarkReplayReceipt): boolean {
  return [
    replay.gaiaAgentSourceRefHash,
    replay.gaiaAgentRepositorySnapshotHash,
    replay.gaiaAgentLicenseRefHash,
    replay.gaiaAgentReadmeBlobHash,
    replay.gaiaAgentPackageManifestHash,
    replay.gaiaAgentLockfileHash,
    replay.gaiaAgentBenchmarkTreeHash,
    replay.gaiaAgentBenchmarkDownloaderHash,
    replay.gaiaAgentBenchmarkRunnerHash,
    replay.gaiaAgentBenchmarkEvaluatorHash,
    replay.gaiaAgentReflectionEvaluatorHash,
    replay.gaiaAgentReporterHash,
    replay.gaiaAgentBenchmarkWorkflowHash,
    replay.gaiaAgentBenchmarkDocsHash,
    replay.gaiaAgentBenchmarkResultsHash,
    replay.gaiaAgentValidationDocsHash,
    replay.gaiaAgentSourceTreeHash,
    replay.gaiaAgentTestTreeHash,
    replay.gaiaAgentTaskManifestHash,
    replay.gaiaAgentDatasetSnapshotHash,
    replay.gaiaAgentFixedSeed,
    replay.gaiaAgentProviderConfigHash,
    replay.gaiaAgentModelRouteHash,
    replay.gaiaAgentRunConfigHash,
    replay.gaiaAgentRunOutputHash,
    replay.gaiaAgentScoreReportHash,
    replay.gaiaAgentReplayCommandHash,
    replay.gaiaAgentCiReceiptHash,
  ].some((value) => value !== null)
    || replay.gaiaAgentToolSurfaces.length > 0
    || [
      replay.minGaiaAgentToolSurfaceCount,
      replay.gaiaAgentSampleCount,
      replay.minGaiaAgentSampleCount,
      replay.gaiaAgentReplayPassRate0to1,
      replay.minGaiaAgentReplayPassRate0to1,
      replay.gaiaAgentScoreDelta0to1,
      replay.minGaiaAgentScoreDelta0to1,
      replay.gaiaAgentEvaluatorAgreement0to1,
      replay.minGaiaAgentEvaluatorAgreement0to1,
      replay.gaiaAgentToolTraceCoverage0to1,
      replay.minGaiaAgentToolTraceCoverage0to1,
      replay.gaiaAgentResultCoverage0to1,
      replay.minGaiaAgentResultCoverage0to1,
    ].some((value) => value !== null);
}

function isGaiaAgentReplayRegressionIssue(issue: string): boolean {
  return [
    "agent benchmark replay gaia-agent tool surface count below threshold",
    "agent benchmark replay gaia-agent sample count below threshold",
    "agent benchmark replay gaia-agent replay pass rate below threshold",
    "agent benchmark replay gaia-agent score delta below threshold",
    "agent benchmark replay gaia-agent evaluator agreement below threshold",
    "agent benchmark replay gaia-agent tool trace coverage below threshold",
    "agent benchmark replay gaia-agent result coverage below threshold",
  ].includes(issue);
}

function appendGaiaAgentCountIssue(
  issues: string[],
  label: string,
  count: number,
  minimum: number | null,
): void {
  if (count === 0) {
    issues.push(`agent benchmark replay gaia-agent ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay gaia-agent ${label} threshold missing`);
  }
  if (minimum !== null && count < minimum) {
    issues.push(`agent benchmark replay gaia-agent ${label} below threshold`);
  }
}

function appendGaiaAgentMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`agent benchmark replay gaia-agent ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay gaia-agent ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`agent benchmark replay gaia-agent ${label} below threshold`);
  }
}

function appendGaiaAgentReplayIssues(
  issues: string[],
  replay: ReplayBenchmarkAgentBenchmarkReplayReceipt,
): void {
  if (!hasGaiaAgentReplaySignal(replay)) {
    return;
  }
  for (const [label, hash] of [
    ["source ref", replay.gaiaAgentSourceRefHash],
    ["repository snapshot", replay.gaiaAgentRepositorySnapshotHash],
    ["license ref", replay.gaiaAgentLicenseRefHash],
    ["readme blob", replay.gaiaAgentReadmeBlobHash],
    ["package manifest", replay.gaiaAgentPackageManifestHash],
    ["lockfile", replay.gaiaAgentLockfileHash],
    ["benchmark tree", replay.gaiaAgentBenchmarkTreeHash],
    ["benchmark downloader", replay.gaiaAgentBenchmarkDownloaderHash],
    ["benchmark runner", replay.gaiaAgentBenchmarkRunnerHash],
    ["benchmark evaluator", replay.gaiaAgentBenchmarkEvaluatorHash],
    ["reflection evaluator", replay.gaiaAgentReflectionEvaluatorHash],
    ["reporter", replay.gaiaAgentReporterHash],
    ["benchmark workflow", replay.gaiaAgentBenchmarkWorkflowHash],
    ["benchmark docs", replay.gaiaAgentBenchmarkDocsHash],
    ["benchmark results", replay.gaiaAgentBenchmarkResultsHash],
    ["validation docs", replay.gaiaAgentValidationDocsHash],
    ["source tree", replay.gaiaAgentSourceTreeHash],
    ["test tree", replay.gaiaAgentTestTreeHash],
    ["task manifest", replay.gaiaAgentTaskManifestHash],
    ["dataset snapshot", replay.gaiaAgentDatasetSnapshotHash],
    ["provider config", replay.gaiaAgentProviderConfigHash],
    ["model route", replay.gaiaAgentModelRouteHash],
    ["run config", replay.gaiaAgentRunConfigHash],
    ["run output", replay.gaiaAgentRunOutputHash],
    ["score report", replay.gaiaAgentScoreReportHash],
    ["replay command", replay.gaiaAgentReplayCommandHash],
    ["ci receipt", replay.gaiaAgentCiReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`agent benchmark replay gaia-agent ${label} hash invalid`);
    }
  }
  if (!replay.gaiaAgentFixedSeed) {
    issues.push("agent benchmark replay gaia-agent fixed seed missing");
  }
  appendGaiaAgentCountIssue(
    issues,
    "tool surface count",
    replay.gaiaAgentToolSurfaces.length,
    replay.minGaiaAgentToolSurfaceCount,
  );
  appendGaiaAgentMinimumIssue(
    issues,
    "sample count",
    replay.gaiaAgentSampleCount,
    replay.minGaiaAgentSampleCount,
  );
  appendGaiaAgentMinimumIssue(
    issues,
    "replay pass rate",
    replay.gaiaAgentReplayPassRate0to1,
    replay.minGaiaAgentReplayPassRate0to1,
  );
  appendGaiaAgentMinimumIssue(
    issues,
    "score delta",
    replay.gaiaAgentScoreDelta0to1,
    replay.minGaiaAgentScoreDelta0to1,
  );
  appendGaiaAgentMinimumIssue(
    issues,
    "evaluator agreement",
    replay.gaiaAgentEvaluatorAgreement0to1,
    replay.minGaiaAgentEvaluatorAgreement0to1,
  );
  appendGaiaAgentMinimumIssue(
    issues,
    "tool trace coverage",
    replay.gaiaAgentToolTraceCoverage0to1,
    replay.minGaiaAgentToolTraceCoverage0to1,
  );
  appendGaiaAgentMinimumIssue(
    issues,
    "result coverage",
    replay.gaiaAgentResultCoverage0to1,
    replay.minGaiaAgentResultCoverage0to1,
  );
}

