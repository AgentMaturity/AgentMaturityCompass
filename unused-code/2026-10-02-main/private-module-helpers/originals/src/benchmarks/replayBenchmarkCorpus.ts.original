      replay.llmEvaluationSystemEvaluationCaseCount,
      replay.minLlmEvaluationSystemEvaluationCaseCount,
      replay.llmEvaluationSystemDeterministicSeed,
      replay.llmEvaluationSystemBaselineJuryScore0to1,
      replay.llmEvaluationSystemCandidateJuryScore0to1,
      replay.llmEvaluationSystemJuryScoreDelta0to1,
      replay.maxLlmEvaluationSystemJuryScoreRegression0to1,
      replay.llmEvaluationSystemBinaryScoringCoverage0to1,
      replay.minLlmEvaluationSystemBinaryScoringCoverage0to1,
      replay.llmEvaluationSystemJudgeAgreement0to1,
      replay.minLlmEvaluationSystemJudgeAgreement0to1,
