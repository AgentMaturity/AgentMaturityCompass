    bioKgBenchEvaluationScriptHash: normalizeHashLabel(evaluation.bioKgBenchEvaluationScriptHash),
    bioKgBenchResultManifestHash: normalizeHashLabel(evaluation.bioKgBenchResultManifestHash),
    bioKgBenchErrorDiscoveryReportHash: normalizeHashLabel(evaluation.bioKgBenchErrorDiscoveryReportHash),
    bioKgBenchReplayCommandHash: normalizeHashLabel(evaluation.bioKgBenchReplayCommandHash),
    bioKgBenchCiReceiptHash: normalizeHashLabel(evaluation.bioKgBenchCiReceiptHash),
    bioKgBenchTaskKinds: unique(
      (evaluation.bioKgBenchTaskKinds ?? [])
        .map(normalizeBioKgBenchTaskKind)
        .filter((value): value is ReplayBenchmarkBioKgBenchTaskKind => value !== null),
    ) as ReplayBenchmarkBioKgBenchTaskKind[],
    minBioKgBenchTaskKindCount: positiveInteger(evaluation.minBioKgBenchTaskKindCount),
    bioKgBenchDeterministicSeed: nonNegativeInteger(evaluation.bioKgBenchDeterministicSeed),
    bioKgBenchDatasetSampleCount: nonNegativeInteger(evaluation.bioKgBenchDatasetSampleCount),
    minBioKgBenchDatasetSampleCount: nonNegativeInteger(evaluation.minBioKgBenchDatasetSampleCount),
    bioKgBenchKgCheckAnnotatedCount: nonNegativeInteger(evaluation.bioKgBenchKgCheckAnnotatedCount),
    minBioKgBenchKgCheckAnnotatedCount: nonNegativeInteger(evaluation.minBioKgBenchKgCheckAnnotatedCount),
    bioKgBenchKgQaTestCount: nonNegativeInteger(evaluation.bioKgBenchKgQaTestCount),
    minBioKgBenchKgQaTestCount: nonNegativeInteger(evaluation.minBioKgBenchKgQaTestCount),
    bioKgBenchScvTestCount: nonNegativeInteger(evaluation.bioKgBenchScvTestCount),
    minBioKgBenchScvTestCount: nonNegativeInteger(evaluation.minBioKgBenchScvTestCount),
    bioKgBenchKgCheckAccuracy0to1: nullableRate(evaluation.bioKgBenchKgCheckAccuracy0to1),
    minBioKgBenchKgCheckAccuracy0to1: nullableRate(evaluation.minBioKgBenchKgCheckAccuracy0to1),
    bioKgBenchKgQaAccuracy0to1: nullableRate(evaluation.bioKgBenchKgQaAccuracy0to1),
    minBioKgBenchKgQaAccuracy0to1: nullableRate(evaluation.minBioKgBenchKgQaAccuracy0to1),
    bioKgBenchScvAccuracy0to1: nullableRate(evaluation.bioKgBenchScvAccuracy0to1),
    minBioKgBenchScvAccuracy0to1: nullableRate(evaluation.minBioKgBenchScvAccuracy0to1),
    bioKgBenchErrorDiscoveryCount: nonNegativeInteger(evaluation.bioKgBenchErrorDiscoveryCount),
    minBioKgBenchErrorDiscoveryCount: nonNegativeInteger(evaluation.minBioKgBenchErrorDiscoveryCount),
    bioKgBenchReplayPassRate0to1: nullableRate(evaluation.bioKgBenchReplayPassRate0to1),
    minBioKgBenchReplayPassRate0to1: nullableRate(evaluation.minBioKgBenchReplayPassRate0to1),
    bioKgBenchScoreDelta0to1: nullableScoreDelta(evaluation.bioKgBenchScoreDelta0to1),
    maxBioKgBenchScoreRegression0to1: nonNegativeNumber(evaluation.maxBioKgBenchScoreRegression0to1),
    bioMedArenaSourceRefHash: normalizeHashLabel(evaluation.bioMedArenaSourceRefHash),
    bioMedArenaRepositorySnapshotHash: normalizeHashLabel(evaluation.bioMedArenaRepositorySnapshotHash),
    bioMedArenaLicenseRefHash: normalizeHashLabel(evaluation.bioMedArenaLicenseRefHash),
    bioMedArenaReadmeHash: normalizeHashLabel(evaluation.bioMedArenaReadmeHash),
    bioMedArenaPyprojectHash: normalizeHashLabel(evaluation.bioMedArenaPyprojectHash),
    bioMedArenaConfigHash: normalizeHashLabel(evaluation.bioMedArenaConfigHash),
    bioMedArenaMatrixConfigHash: normalizeHashLabel(evaluation.bioMedArenaMatrixConfigHash),
    bioMedArenaHarnessTreeHash: normalizeHashLabel(evaluation.bioMedArenaHarnessTreeHash),
    bioMedArenaHarnessCliHash: normalizeHashLabel(evaluation.bioMedArenaHarnessCliHash),
    bioMedArenaBenchmarkConfigHash: normalizeHashLabel(evaluation.bioMedArenaBenchmarkConfigHash),
    bioMedArenaEvalSuiteHash: normalizeHashLabel(evaluation.bioMedArenaEvalSuiteHash),
    bioMedArenaAdapterRegistryHash: normalizeHashLabel(evaluation.bioMedArenaAdapterRegistryHash),
    bioMedArenaToolRegistryHash: normalizeHashLabel(evaluation.bioMedArenaToolRegistryHash),
    bioMedArenaVendorManifestHash: normalizeHashLabel(evaluation.bioMedArenaVendorManifestHash),
    bioMedArenaBaselineAgentHash: normalizeHashLabel(evaluation.bioMedArenaBaselineAgentHash),
    bioMedArenaQuickRunHash: normalizeHashLabel(evaluation.bioMedArenaQuickRunHash),
    bioMedArenaReleaseGateHash: normalizeHashLabel(evaluation.bioMedArenaReleaseGateHash),
