    gtoWizardPokerReplayRowCount: manifest.agentBenchmarkReplaySummary.gtoWizardPokerReplayRowCount,
    failedGtoWizardPokerReplayRowIds: manifest.agentBenchmarkReplaySummary.failedGtoWizardPokerReplayRowIds,
    costNavReplayRowCount: manifest.agentBenchmarkReplaySummary.costNavReplayRowCount,
    failedCostNavRowIds: manifest.agentBenchmarkReplaySummary.failedCostNavRowIds,
    researchHarnessRowCount: manifest.agentBenchmarkReplaySummary.researchHarnessRowCount,
    failedResearchHarnessRowIds: manifest.agentBenchmarkReplaySummary.failedResearchHarnessRowIds,
    agentMontRowCount: manifest.agentBenchmarkReplaySummary.agentMontRowCount,
    failedAgentMontRowIds: manifest.agentBenchmarkReplaySummary.failedAgentMontRowIds,
    miniAppBenchRowCount: manifest.agentBenchmarkReplaySummary.miniAppBenchRowCount,
