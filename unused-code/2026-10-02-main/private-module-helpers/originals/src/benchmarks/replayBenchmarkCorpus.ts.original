function isDeepMathAgentReplayFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("deepmath agent replay "));
}

function averageNullable(values: Array<number | null>): number | null {
  const numeric = values.filter((value): value is number => value !== null);
  return numeric.length === 0 ? null : round(numeric.reduce((sum, value) => sum + value, 0) / numeric.length);
}

function buildDeepMathAgentReplaySummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkDeepMathAgentReplaySummary {
  const replayRows = rows.filter((row) => row.deepMathAgentReplay);
  const sandboxRates = replayRows
    .map((row) => row.deepMathAgentReplay?.sandboxViolationRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const timeoutRates = replayRows
    .map((row) => row.deepMathAgentReplay?.executionTimeoutRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: replayRows.length,
    benchmarkIds: unique(
      replayRows
        .map((row) => row.deepMathAgentReplay?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    datasetFamilies: unique(
      replayRows
        .map((row) => row.deepMathAgentReplay?.datasetFamily ?? "")
        .filter((value): value is ReplayBenchmarkDeepMathDatasetFamily => (
          deepMathDatasetFamilies.includes(value as ReplayBenchmarkDeepMathDatasetFamily)
        )),
    ) as ReplayBenchmarkDeepMathDatasetFamily[],
    runModes: unique(
      replayRows
        .map((row) => row.deepMathAgentReplay?.runMode ?? "")
        .filter((value): value is ReplayBenchmarkDeepMathRunMode => (
          deepMathRunModes.includes(value as ReplayBenchmarkDeepMathRunMode)
        )),
    ) as ReplayBenchmarkDeepMathRunMode[],
    failedRowIds: replayRows.filter(isDeepMathAgentReplayFailure).map((row) => row.rowId),
    totalSampleCount: replayRows.reduce((sum, row) => sum + (row.deepMathAgentReplay?.sampleCount ?? 0), 0),
    averageMajorityAt16Accuracy0to1: averageNullable(
      replayRows.map((row) => row.deepMathAgentReplay?.majorityAt16Accuracy0to1 ?? null),
    ),
    averageExactAnswerAccuracy0to1: averageNullable(
      replayRows.map((row) => row.deepMathAgentReplay?.exactAnswerAccuracy0to1 ?? null),
    ),
    averageCodeSnippetUseRate0to1: averageNullable(
      replayRows.map((row) => row.deepMathAgentReplay?.codeSnippetUseRate0to1 ?? null),
    ),
    maxSandboxViolationRate0to1: sandboxRates.length === 0 ? null : Math.max(...sandboxRates),
    maxExecutionTimeoutRate0to1: timeoutRates.length === 0 ? null : Math.max(...timeoutRates),
    averageMeanOutputTokenReduction0to1: averageNullable(
      replayRows.map((row) => row.deepMathAgentReplay?.meanOutputTokenReduction0to1 ?? null),
    ),
    averageReplayPassRate0to1: averageNullable(
      replayRows.map((row) => row.deepMathAgentReplay?.replayPassRate0to1 ?? null),
    ),
    averageScoreDelta0to1: averageNullable(
      replayRows.map((row) => row.deepMathAgentReplay?.scoreDelta0to1 ?? null),
    ),
  };
}

function buildJudgeItReplayReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkJudgeItReplayReceipt | undefined {
  const replay = row.fixture.judgeItReplay;
  if (!replay) return undefined;
  const baselineMetric0to1 = nullableRate(replay.baselineMetric0to1);
  const candidateMetric0to1 = nullableRate(replay.candidateMetric0to1);
  const explicitScoreDelta0to1 = nullableScoreDelta(replay.scoreDelta0to1);
  return {
    benchmarkId: normalizeLabel(replay.benchmarkId),
    benchmarkVersion: normalizeLabel(replay.benchmarkVersion),
    repositorySnapshotHash: normalizeHashLabel(replay.repositorySnapshotHash),
    datasetManifestHash: normalizeHashLabel(replay.datasetManifestHash),
    goldenTextManifestHash: normalizeHashLabel(replay.goldenTextManifestHash),
    generatedTextManifestHash: normalizeHashLabel(replay.generatedTextManifestHash),
    pipelineConfigHash: normalizeHashLabel(replay.pipelineConfigHash),
    judgeModelConfigHash: normalizeHashLabel(replay.judgeModelConfigHash),
    judgePromptRubricHash: normalizeHashLabel(replay.judgePromptRubricHash),
    humanEvalReferenceHash: normalizeHashLabel(replay.humanEvalReferenceHash),
    evaluationConfigHash: normalizeHashLabel(replay.evaluationConfigHash),
    batchRunConfigHash: normalizeHashLabel(replay.batchRunConfigHash),
    resultExportHash: normalizeHashLabel(replay.resultExportHash),
    metricsReportHash: normalizeHashLabel(replay.metricsReportHash),
    replayCommandHash: normalizeHashLabel(replay.replayCommandHash),
    deterministicSeed: nonNegativeInteger(replay.deterministicSeed),
    pipelineType: normalizeJudgeItPipelineType(replay.pipelineType),
    scoringMode: normalizeJudgeItScoringMode(replay.scoringMode),
    sampleCount: positiveInteger(replay.sampleCount),
    minSampleCount: positiveInteger(replay.minSampleCount),
    baselineMetric0to1,
    candidateMetric0to1,
    scoreDelta0to1: explicitScoreDelta0to1 ?? (
      baselineMetric0to1 === null || candidateMetric0to1 === null
        ? null
        : round(candidateMetric0to1 - baselineMetric0to1)
    ),
    maxScoreRegression0to1: nonNegativeNumber(replay.maxScoreRegression0to1),
    precision0to1: nullableRate(replay.precision0to1),
    minPrecision0to1: nullableRate(replay.minPrecision0to1),
    recall0to1: nullableRate(replay.recall0to1),
    minRecall0to1: nullableRate(replay.minRecall0to1),
    f10to1: nullableRate(replay.f10to1),
    minF10to1: nullableRate(replay.minF10to1),
    humanAgreementF10to1: nullableRate(replay.humanAgreementF10to1),
    minHumanAgreementF10to1: nullableRate(replay.minHumanAgreementF10to1),
    falseNegativeRate0to1: nullableRate(replay.falseNegativeRate0to1),
    maxFalseNegativeRate0to1: nullableRate(replay.maxFalseNegativeRate0to1),
    replayPassRate0to1: nullableRate(replay.replayPassRate0to1),
    minReplayPassRate0to1: nullableRate(replay.minReplayPassRate0to1),
    blackboxScore0to1: nullableRate(replay.blackboxScore0to1),
    minBlackboxScore0to1: nullableRate(replay.minBlackboxScore0to1),
    whiteboxTraceValid: typeof replay.whiteboxTraceValid === "boolean" ? replay.whiteboxTraceValid : null,
    negativeTestingHarmfulRate0to1: nullableRate(replay.negativeTestingHarmfulRate0to1),
    maxNegativeTestingHarmfulRate0to1: nullableRate(replay.maxNegativeTestingHarmfulRate0to1),
  };
}

