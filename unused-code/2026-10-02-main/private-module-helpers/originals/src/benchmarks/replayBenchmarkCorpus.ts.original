    ragEvalDatasetEndpointModes: unique((rag.ragEvalDatasetEndpointModes ?? [])
      .map((mode) => normalizeRagEvalDatasetEndpointMode(mode))
      .filter((mode): mode is ReplayBenchmarkRagEvalDatasetEndpointMode => mode !== null)),
    ragEvalDatasetMetricIds: unique((rag.ragEvalDatasetMetricIds ?? [])
      .map((metricId) => normalizeLabel(metricId))
      .filter((metricId): metricId is string => Boolean(metricId))),
    ragEvalDatasetQuestionCount: positiveInteger(rag.ragEvalDatasetQuestionCount),
    ragEvalDatasetMinQuestionCount: positiveInteger(rag.ragEvalDatasetMinQuestionCount),
