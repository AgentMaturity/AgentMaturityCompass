function hasMiniAppBenchSignal(replay: ReplayBenchmarkAgentBenchmarkReplayReceipt): boolean {
  return [
    replay.miniAppBenchBenchmarkId,
    replay.miniAppBenchSourceRefHash,
    replay.miniAppBenchRepositorySnapshotHash,
    replay.miniAppBenchLicenseReviewHash,
    replay.miniAppBenchDatasetManifestHash,
    replay.miniAppBenchQuerySetHash,
    replay.miniAppBenchEvaluationReferenceManifestHash,
    replay.miniAppBenchGeneratedMiniAppManifestHash,
    replay.miniAppBenchGeneratedSourceCodeHash,
    replay.miniAppBenchLiveInstanceManifestHash,
    replay.miniAppBenchBrowserAutomationTraceHash,
    replay.miniAppBenchInteractionRubricHash,
    replay.miniAppBenchVisualRenderReportHash,
    replay.miniAppBenchDynamicInteractionReportHash,
    replay.miniAppBenchResultManifestHash,
    replay.miniAppBenchReplayCommandHash,
    replay.miniAppBenchCiReceiptHash,
  ].some((value) => value !== null)
    || replay.miniAppBenchTaskCategories.length > 0
    || [
      replay.minMiniAppBenchTaskCategoryCount,
      replay.miniAppBenchQueryCount,
      replay.minMiniAppBenchQueryCount,
      replay.miniAppBenchDeterministicSeed,
      replay.miniAppBenchWithheldReferencesRespected,
      replay.miniAppBenchNoCopySourceBoundary,
      replay.miniAppBenchBrowserAutomationSuccessRate0to1,
      replay.minMiniAppBenchBrowserAutomationSuccessRate0to1,
      replay.miniAppBenchInteractionCoverage0to1,
      replay.minMiniAppBenchInteractionCoverage0to1,
      replay.miniAppBenchHumanAlignment0to1,
      replay.minMiniAppBenchHumanAlignment0to1,
      replay.miniAppBenchReplayPassRate0to1,
      replay.minMiniAppBenchReplayPassRate0to1,
      replay.miniAppBenchBaselineScore0to1,
      replay.miniAppBenchCandidateScore0to1,
      replay.miniAppBenchScoreDelta0to1,
      replay.maxMiniAppBenchScoreRegression0to1,
    ].some((value) => value !== null);
}

function appendMiniAppBenchCountIssue(
  issues: string[],
  label: string,
  count: number,
  minimum: number | null,
): void {
  if (count === 0) {
    issues.push(`agent benchmark replay miniappbench ${label} missing`);
  }
