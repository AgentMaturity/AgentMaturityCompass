    sourceLinkCoverage0to1: nullableRate(webSearch.sourceLinkCoverage0to1),
    minSourceLinkCoverage0to1: nullableRate(webSearch.minSourceLinkCoverage0to1),
    finalScore0to1: nullableRate(webSearch.finalScore0to1),
    contentCoverage0to1: nullableRate(webSearch.contentCoverage0to1),
    relevance0to1: nullableRate(webSearch.relevance0to1),
    answerSimilarity0to1: nullableRate(webSearch.answerSimilarity0to1),
    citationQuality0to1: nullableRate(webSearch.citationQuality0to1),
    passRate0to1: nullableRate(webSearch.passRate0to1),
  };
}

function isWebSearchEvaluationFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("web search benchmark id missing")
    || row.issues.includes("web search dataset id/version missing")
    || row.issues.includes("web search dataset spec hash invalid")
    || row.issues.includes("web search source-link manifest hash invalid")
    || row.issues.includes("web search engine config hash invalid")
    || row.issues.includes("web search agent framework config hash invalid")
    || row.issues.includes("web search model config hash invalid")
    || row.issues.includes("web search evaluator config hash invalid")
    || row.issues.includes("web search benchmark run config hash invalid")
    || row.issues.includes("web search result jsonl hash invalid")
    || row.issues.includes("web search metrics report hash invalid")
    || row.issues.includes("web search navigation trace hash invalid")
    || row.issues.includes("web search operation trace hash invalid")
    || row.issues.includes("web search citation trace hash invalid")
    || row.issues.includes("web search sample count missing")
    || row.issues.includes("web search domains missing")
    || row.issues.includes("web search question types missing")
    || row.issues.includes("web search domain coverage missing")
    || row.issues.includes("web search domain coverage below threshold")
    || row.issues.includes("web search question-type coverage missing")
    || row.issues.includes("web search question-type coverage below threshold")
    || row.issues.includes("web search source-link coverage missing")
    || row.issues.includes("web search source-link coverage below threshold")
    || row.issues.includes("web search final score missing")
    || row.issues.includes("web search component metric missing");
}

function buildWebSearchEvaluationSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkWebSearchEvaluationSummary {
  const webSearchRows = rows.filter((row) => row.webSearchEvaluation);
  const finalScores = webSearchRows
    .map((row) => row.webSearchEvaluation?.finalScore0to1 ?? null)
    .filter((value): value is number => value !== null);
  const passRates = webSearchRows
    .map((row) => row.webSearchEvaluation?.passRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const sourceLinkCoverages = webSearchRows
    .map((row) => row.webSearchEvaluation?.sourceLinkCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: webSearchRows.length,
    domains: unique(
      webSearchRows.flatMap((row) => row.webSearchEvaluation?.domains ?? []),
    ) as ReplayBenchmarkWebSearchDomain[],
    questionTypes: unique(
      webSearchRows.flatMap((row) => row.webSearchEvaluation?.questionTypes ?? []),
    ) as ReplayBenchmarkWebSearchQuestionType[],
    failedRowIds: webSearchRows.filter(isWebSearchEvaluationFailure).map((row) => row.rowId),
    totalSampleCount: webSearchRows.reduce((sum, row) => sum + (row.webSearchEvaluation?.sampleCount ?? 0), 0),
    sourceLinkedRowCount: webSearchRows.filter((row) => {
      const hash = row.webSearchEvaluation?.sourceLinkManifestHash;
      return Boolean(hash && isSha256(hash));
    }).length,
    averageFinalScore0to1: finalScores.length === 0
      ? null
      : round(finalScores.reduce((sum, value) => sum + value, 0) / finalScores.length),
    averagePassRate0to1: passRates.length === 0
      ? null
      : round(passRates.reduce((sum, value) => sum + value, 0) / passRates.length),
    averageSourceLinkCoverage0to1: sourceLinkCoverages.length === 0
      ? null
      : round(sourceLinkCoverages.reduce((sum, value) => sum + value, 0) / sourceLinkCoverages.length),
  };
}

function buildBinaryAuditReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkBinaryAuditReceipt | undefined {
  const audit = row.fixture.binaryAudit;
  if (!audit) return undefined;
  return {
    taskId: normalizeLabel(audit.taskId),
    targetApplication: normalizeLabel(audit.targetApplication),
    category: normalizeBinaryAuditCategory(audit.category),
    architecture: normalizeLabel(audit.architecture),
    binaryArtifactHash: normalizeHashLabel(audit.binaryArtifactHash),
    binaryMetadataHash: normalizeHashLabel(audit.binaryMetadataHash),
    taskConfigHash: normalizeHashLabel(audit.taskConfigHash),
    containerImageHash: normalizeHashLabel(audit.containerImageHash),
    reverseEngineeringToolchainHash: normalizeHashLabel(audit.reverseEngineeringToolchainHash),
    analysisTraceHash: normalizeHashLabel(audit.analysisTraceHash),
    findingReportHash: normalizeHashLabel(audit.findingReportHash),
    groundTruthHash: normalizeHashLabel(audit.groundTruthHash),
    expectedDecision: normalizeLabel(audit.expectedDecision),
    actualDecision: normalizeLabel(audit.actualDecision),
    strippedBinary: typeof audit.strippedBinary === "boolean" ? audit.strippedBinary : null,
    multiBinary: typeof audit.multiBinary === "boolean" ? audit.multiBinary : null,
    attemptCount: positiveInteger(audit.attemptCount),
    successRate0to1: nullableRate(audit.successRate0to1),
    falsePositiveRate0to1: nullableRate(audit.falsePositiveRate0to1),
    maxFalsePositiveRate0to1: nullableRate(audit.maxFalsePositiveRate0to1),
  };
}

function isBinaryAuditFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("binary audit task id missing")
    || row.issues.includes("binary audit target application missing")
    || row.issues.includes("binary audit category missing")
    || row.issues.includes("binary audit architecture missing")
    || row.issues.includes("binary audit binary artifact hash invalid")
    || row.issues.includes("binary audit binary metadata hash invalid")
    || row.issues.includes("binary audit task config hash invalid")
    || row.issues.includes("binary audit container image hash invalid")
    || row.issues.includes("binary audit reverse engineering toolchain hash invalid")
    || row.issues.includes("binary audit analysis trace hash invalid")
    || row.issues.includes("binary audit finding report hash invalid")
    || row.issues.includes("binary audit ground truth hash invalid")
    || row.issues.includes("binary audit expected decision missing")
    || row.issues.includes("binary audit actual decision missing")
    || row.issues.includes("binary audit expected decision not met")
    || row.issues.includes("binary audit stripped flag missing")
    || row.issues.includes("binary audit multi-binary flag missing")
    || row.issues.includes("binary audit attempt count missing")
    || row.issues.includes("binary audit success rate missing")
    || row.issues.includes("binary audit false positive rate missing")
    || row.issues.includes("binary audit false positive rate above threshold");
}

function buildBinaryAuditSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkBinaryAuditSummary {
  const auditRows = rows.filter((row) => row.binaryAudit);
  const successRates = auditRows
    .map((row) => row.binaryAudit?.successRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const falsePositiveRates = auditRows
    .map((row) => row.binaryAudit?.falsePositiveRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: auditRows.length,
    categories: unique(
      auditRows
        .map((row) => row.binaryAudit?.category ?? "")
        .filter((value): value is ReplayBenchmarkBinaryAuditCategory => binaryAuditCategories.includes(value as ReplayBenchmarkBinaryAuditCategory)),
    ) as ReplayBenchmarkBinaryAuditCategory[],
    targetApplications: unique(
      auditRows
        .map((row) => row.binaryAudit?.targetApplication ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    failedRowIds: auditRows.filter(isBinaryAuditFailure).map((row) => row.rowId),
    cleanNegativeRowCount: auditRows.filter((row) => row.binaryAudit?.category === "clean_negative").length,
    backdoorRowCount: auditRows.filter((row) => row.binaryAudit?.category === "backdoor_detection").length,
    timebombRowCount: auditRows.filter((row) => row.binaryAudit?.category === "timebomb_detection").length,
    averageSuccessRate0to1: successRates.length === 0
      ? null
      : round(successRates.reduce((sum, value) => sum + value, 0) / successRates.length),
    maxFalsePositiveRate0to1: falsePositiveRates.length === 0 ? null : Math.max(...falsePositiveRates),
  };
}

