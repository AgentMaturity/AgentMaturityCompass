    return "critical";
  }
  return row.scoreDelta0to1 < -0.15 ? "critical" : "high";
}

function buildRuntimeReceipt(fixture: ReplayBenchmarkFixture): ReplayBenchmarkRuntimeReceipt | undefined {
  if (!fixture.runtime) return undefined;
  return {
    kind: fixture.runtime.kind,
    version: normalizeLabel(fixture.runtime.version),
    image: normalizeLabel(fixture.runtime.image),
    commandHash: normalizeHashLabel(fixture.runtime.commandHash),
    dependencyHash: normalizeHashLabel(fixture.runtime.dependencyHash),
    sandboxProfile: normalizeLabel(fixture.runtime.sandboxProfile),
  };
}

function buildAdversarialEngineEvaluationReceipt(
  engine: ReplayBenchmarkAdversarialEngineEvaluationFixture | undefined,
): ReplayBenchmarkAdversarialEngineEvaluationReceipt | null {
  if (!engine) return null;
  return {
    traceId: normalizeLabel(engine.traceId),
    annotationId: normalizeLabel(engine.annotationId),
    continuousEvalId: normalizeLabel(engine.continuousEvalId),
    evaluatorName: normalizeLabel(engine.evaluatorName),
    evaluatorVersion: normalizeLabel(engine.evaluatorVersion),
    transformId: normalizeLabel(engine.transformId),
    status: normalizeAdversarialEngineEvaluationStatus(engine.status),
    score0to1: nullableRate(engine.score0to1),
    criteriaHash: normalizeHashLabel(engine.criteriaHash),
    variablesHash: normalizeHashLabel(engine.variablesHash),
    explanationHash: normalizeHashLabel(engine.explanationHash),
    costUsd: nonNegativeNumber(engine.costUsd),
    rerunStatus: normalizeAdversarialEngineEvaluationStatus(engine.rerunStatus),
    guardrailRuleIds: unique(engine.guardrailRuleIds ?? []),
    guardrailRuleTypes: [...new Set((engine.guardrailRuleTypes ?? [])
      .map(normalizeGuardrailRuleType)
      .filter((value): value is ReplayBenchmarkGuardrailRuleType => value !== null))],
    failedGuardrailRuleCount: nonNegativeInteger(engine.failedGuardrailRuleCount),
    promptInjectionDetected: typeof engine.promptInjectionDetected === "boolean" ? engine.promptInjectionDetected : null,
    alertRuleId: normalizeLabel(engine.alertRuleId),
    alertRuleMetricName: normalizeLabel(engine.alertRuleMetricName),
    alertRuleQueryHash: normalizeHashLabel(engine.alertRuleQueryHash),
    alertRuleThreshold: nonNegativeNumber(engine.alertRuleThreshold),
    alertRuleBound: normalizeAlertRuleBound(engine.alertRuleBound),
    alertWebhookRefs: unique(engine.alertWebhookRefs ?? []),
  };
}

function buildRedTeamBenchmarkReceipt(
  benchmark: ReplayBenchmarkRedTeamBenchmarkFixture | undefined,
): ReplayBenchmarkRedTeamBenchmarkReceipt | null {
  if (!benchmark) return null;
  return {
    benchmarkId: normalizeLabel(benchmark.benchmarkId),
    benchmarkVersion: normalizeLabel(benchmark.benchmarkVersion),
    questionSetHash: normalizeHashLabel(benchmark.questionSetHash),
    referenceAnswerManifestHash: normalizeHashLabel(benchmark.referenceAnswerManifestHash),
    scoringConfigHash: normalizeHashLabel(benchmark.scoringConfigHash),
    scoringModes: [...new Set((benchmark.scoringModes ?? [])
      .map(normalizeAdversarialScoringMode)
      .filter((value): value is ReplayBenchmarkAdversarialScoringMode => value !== null))],
    providerBackend: normalizeAzureAgentLabToken(benchmark.providerBackend),
    modelConfigHash: normalizeHashLabel(benchmark.modelConfigHash),
    promptOptimizationConfigHash: normalizeHashLabel(benchmark.promptOptimizationConfigHash),
    promptOptimizationIterationCount: nonNegativeInteger(benchmark.promptOptimizationIterationCount),
    resultJsonHash: normalizeHashLabel(benchmark.resultJsonHash),
    resultCsvHash: normalizeHashLabel(benchmark.resultCsvHash),
    traceExportHash: normalizeHashLabel(benchmark.traceExportHash),
    judgeRubricHash: normalizeHashLabel(benchmark.judgeRubricHash),
    questionCount: nonNegativeInteger(benchmark.questionCount),
    minQuestionCount: nonNegativeInteger(benchmark.minQuestionCount),
    passThreshold0to1: nullableRate(benchmark.passThreshold0to1),
    refusalScore0to1: nullableRate(benchmark.refusalScore0to1),
    hallucinationScore0to1: nullableRate(benchmark.hallucinationScore0to1),
    semanticScore0to1: nullableRate(benchmark.semanticScore0to1),
  };
}

function buildAdversarialRegressionReceipt(
  fixture: ReplayBenchmarkFixture,
): ReplayBenchmarkAdversarialRegressionReceipt | undefined {
  if (!fixture.adversarialRegression) return undefined;
  return {
    exploitFixtureId: normalizeLabel(fixture.adversarialRegression.exploitFixtureId),
    expectedDecision: normalizeLabel(fixture.adversarialRegression.expectedDecision),
    actualDecision: normalizeLabel(fixture.adversarialRegression.actualDecision),
    rerunOutputHash: normalizeHashLabel(fixture.adversarialRegression.rerunOutputHash),
    releaseGateReceiptId: normalizeLabel(fixture.adversarialRegression.releaseGateReceiptId),
    taxonomyRefs: unique(fixture.adversarialRegression.taxonomyRefs ?? []),
    redTeamBenchmark: buildRedTeamBenchmarkReceipt(fixture.adversarialRegression.redTeamBenchmark),
    engineEvaluation: buildAdversarialEngineEvaluationReceipt(fixture.adversarialRegression.engineEvaluation),
  };
}

function normalizeTurnCount(value: number | undefined): number {
  if (typeof value !== "number" || !Number.isFinite(value)) return 1;
  return Math.max(1, Math.trunc(value));
}

function buildSafetyRiskReceipt(
  row: ReplayBenchmarkCorpusRowInput,
  thresholds: ReplayBenchmarkCorpusThresholds,
): ReplayBenchmarkSafetyRiskReceipt | undefined {
  const baselineAttackSuccessRate0to1 = nullableRate(row.baseline.attackSuccessRate0to1);
  const candidateAttackSuccessRate0to1 = nullableRate(row.candidate.attackSuccessRate0to1);
  const hasRiskMetadata = Boolean(row.fixture.riskProfile || row.fixture.turnCount || row.fixture.toolUse);
  const hasSafetyMetric = baselineAttackSuccessRate0to1 !== null || candidateAttackSuccessRate0to1 !== null;
  if (!hasRiskMetadata && !hasSafetyMetric) return undefined;

  const tools = unique(row.fixture.toolUse?.tools ?? []);
  const turnCount = normalizeTurnCount(row.fixture.turnCount);
  const attackSequence = row.fixture.riskProfile?.attackSequence ?? (turnCount > 1 ? "multi_turn" : "single_turn");
  const category = row.fixture.riskProfile?.category
    ?? (attackSequence === "multi_turn" && tools.length > 0 ? "multi_turn_tool_safety" : "custom");
  const attackSuccessRateDelta0to1 = baselineAttackSuccessRate0to1 === null || candidateAttackSuccessRate0to1 === null
    ? null
    : round(candidateAttackSuccessRate0to1 - baselineAttackSuccessRate0to1);

  return {
    category,
    attackSequence,
    turnCount,
    tools,
    toolCallCount: typeof row.fixture.toolUse?.toolCallCount === "number" && Number.isFinite(row.fixture.toolUse.toolCallCount)
      ? Math.max(0, Math.trunc(row.fixture.toolUse.toolCallCount))
      : null,
    sandboxed: typeof row.fixture.toolUse?.sandboxed === "boolean" ? row.fixture.toolUse.sandboxed : null,
    taxonomyRefs: unique(row.fixture.riskProfile?.taxonomyRefs ?? []),
    safetyObjective: row.fixture.riskProfile?.safetyObjective ?? null,
    baselineAttackSuccessRate0to1,
    candidateAttackSuccessRate0to1,
    attackSuccessRateDelta0to1,
    maxCandidateAttackSuccessRate0to1: clamp01(
      row.fixture.riskProfile?.maxAllowedAttackSuccessRate0to1 ?? thresholds.maxCandidateAttackSuccessRate0to1,
    ),
    minAttackSuccessRateReduction0to1: clamp01(
      row.fixture.riskProfile?.minAttackSuccessRateReduction0to1 ?? thresholds.minAttackSuccessRateReduction0to1,
    ),
  };
}

function isSafetyRiskFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  if (!row.safetyRisk) return false;
  return row.status !== "passed";
}

function isRuntimeFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  if (!row.runtime) return false;
  return row.status !== "passed";
}

function isAdversarialRegressionFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  if (!row.adversarialRegression) return false;
  return row.status !== "passed";
}

function buildSafetyRiskSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkSafetyRiskSummary {
  const riskRows = rows.filter((row) => row.safetyRisk);
  const candidateAttackSuccessRates = riskRows
    .map((row) => row.safetyRisk?.candidateAttackSuccessRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: riskRows.length,
    multiTurnToolRiskRowCount: riskRows.filter((row) => row.safetyRisk?.category === "multi_turn_tool_safety").length,
    failedRowIds: riskRows.filter(isSafetyRiskFailure).map((row) => row.rowId),
    maxCandidateAttackSuccessRate0to1: candidateAttackSuccessRates.length === 0
      ? null
      : Math.max(...candidateAttackSuccessRates),
  };
}

function buildAdversarialRegressionSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkAdversarialRegressionSummary {
  const adversarialRows = rows.filter((row) => row.adversarialRegression);
  const redTeamRows = adversarialRows.filter((row) => row.adversarialRegression?.redTeamBenchmark);
  const semanticScores = redTeamRows
    .map((row) => row.adversarialRegression?.redTeamBenchmark?.semanticScore0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: adversarialRows.length,
    failedRowIds: adversarialRows.filter(isAdversarialRegressionFailure).map((row) => row.rowId),
    releaseGateReceiptCount: adversarialRows.filter((row) => Boolean(row.adversarialRegression?.releaseGateReceiptId)).length,
    engineEvaluationReceiptCount: adversarialRows.filter((row) => Boolean(row.adversarialRegression?.engineEvaluation)).length,
    alertRuleReceiptCount: adversarialRows.filter((row) => Boolean(row.adversarialRegression?.engineEvaluation?.alertRuleId)).length,
    failedGuardrailRuleCount: adversarialRows.reduce(
      (sum, row) => sum + (row.adversarialRegression?.engineEvaluation?.failedGuardrailRuleCount ?? 0),
      0,
    ),
    redTeamBenchmarkRowCount: redTeamRows.length,
    providerBackends: unique(redTeamRows
      .map((row) => row.adversarialRegression?.redTeamBenchmark?.providerBackend ?? "")
      .filter((value) => value.length > 0)),
    scoringModes: [...new Set(redTeamRows
      .flatMap((row) => row.adversarialRegression?.redTeamBenchmark?.scoringModes ?? []))],
    promptOptimizationRunCount: redTeamRows.filter((row) => (
      (row.adversarialRegression?.redTeamBenchmark?.promptOptimizationIterationCount ?? 0) > 0
    )).length,
    resultExportCount: redTeamRows.filter((row) => (
      Boolean(row.adversarialRegression?.redTeamBenchmark?.resultJsonHash) ||
      Boolean(row.adversarialRegression?.redTeamBenchmark?.resultCsvHash)
    )).length,
    totalQuestionCount: redTeamRows.reduce(
      (sum, row) => sum + (row.adversarialRegression?.redTeamBenchmark?.questionCount ?? 0),
      0,
    ),
    averageSemanticScore0to1: semanticScores.length === 0
      ? null
      : round(semanticScores.reduce((sum, value) => sum + value, 0) / semanticScores.length),
  };
}

function buildBehaviorDiffReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkBehaviorDiffReceipt | undefined {
  const baselineBehaviorSnapshotHash = normalizeHashLabel(row.baseline.behaviorSnapshotHash);
  const candidateBehaviorSnapshotHash = normalizeHashLabel(row.candidate.behaviorSnapshotHash);
  const baselineToolCallSequenceHash = normalizeHashLabel(row.baseline.toolCallSequenceHash);
  const candidateToolCallSequenceHash = normalizeHashLabel(row.candidate.toolCallSequenceHash);
  if (
    !baselineBehaviorSnapshotHash
    && !candidateBehaviorSnapshotHash
    && !baselineToolCallSequenceHash
    && !candidateToolCallSequenceHash
  ) {
    return undefined;
  }
  return {
    baselineBehaviorSnapshotHash,
    candidateBehaviorSnapshotHash,
    behaviorChanged: baselineBehaviorSnapshotHash && candidateBehaviorSnapshotHash
      ? baselineBehaviorSnapshotHash !== candidateBehaviorSnapshotHash
      : null,
    baselineToolCallSequenceHash,
    candidateToolCallSequenceHash,
    toolCallSequenceChanged: baselineToolCallSequenceHash && candidateToolCallSequenceHash
      ? baselineToolCallSequenceHash !== candidateToolCallSequenceHash
      : null,
  };
}

function isBehaviorDiffFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("behavior snapshot hash invalid") || row.issues.includes("tool-call sequence hash invalid");
}

function buildBehaviorDiffSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkBehaviorDiffSummary {
  const behaviorRows = rows.filter((row) => row.behaviorDiff);
  return {
    rowCount: behaviorRows.length,
    behaviorChangedRowIds: behaviorRows.filter((row) => row.behaviorDiff?.behaviorChanged === true).map((row) => row.rowId),
    toolCallChangedRowIds: behaviorRows.filter((row) => row.behaviorDiff?.toolCallSequenceChanged === true).map((row) => row.rowId),
    failedRowIds: behaviorRows.filter(isBehaviorDiffFailure).map((row) => row.rowId),
  };
}

function normalizePairwiseWinner(value: ReplayBenchmarkPairwiseWinner | undefined): ReplayBenchmarkPairwiseWinner | null {
  return value === "baseline" || value === "candidate" || value === "tie" ? value : null;
}

function buildPairwiseComparisonReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkPairwiseComparisonReceipt | undefined {
  const comparison = row.fixture.pairwiseComparison;
  if (!comparison) return undefined;
  return {
    comparisonId: normalizeLabel(comparison.comparisonId),
    promptHash: normalizeHashLabel(comparison.promptHash),
    baselineResponseHash: normalizeHashLabel(comparison.baselineResponseHash),
    candidateResponseHash: normalizeHashLabel(comparison.candidateResponseHash),
    judgeIds: unique(comparison.judgeIds ?? []),
    judgePanelHash: normalizeHashLabel(comparison.judgePanelHash),
    winner: normalizePairwiseWinner(comparison.winner),
    confidence0to1: nullableRate(comparison.confidence0to1),
    leaderboardDelta: typeof comparison.leaderboardDelta === "number" && Number.isFinite(comparison.leaderboardDelta)
      ? round(comparison.leaderboardDelta)
      : null,
  };
}

function isPairwiseComparisonFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("pairwise comparison prompt hash invalid")
    || row.issues.includes("pairwise baseline response hash invalid")
    || row.issues.includes("pairwise candidate response hash invalid")
    || row.issues.includes("pairwise judge ids missing")
    || row.issues.includes("pairwise judge panel hash invalid")
    || row.issues.includes("pairwise winner missing");
}

function buildPairwiseComparisonSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkPairwiseComparisonSummary {
  const pairwiseRows = rows.filter((row) => row.pairwiseComparison);
  return {
    rowCount: pairwiseRows.length,
    candidateWinRowIds: pairwiseRows.filter((row) => row.pairwiseComparison?.winner === "candidate").map((row) => row.rowId),
    baselineWinRowIds: pairwiseRows.filter((row) => row.pairwiseComparison?.winner === "baseline").map((row) => row.rowId),
    tieRowIds: pairwiseRows.filter((row) => row.pairwiseComparison?.winner === "tie").map((row) => row.rowId),
    failedRowIds: pairwiseRows.filter(isPairwiseComparisonFailure).map((row) => row.rowId),
  };
}

function buildModalityPairReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkModalityPairReceipt | undefined {
  const pair = row.fixture.modalityPair;
  if (!pair) return undefined;
  const sourceScore0to1 = nullableRate(pair.sourceScore0to1);
  const targetScore0to1 = nullableRate(pair.targetScore0to1);
  return {
    sourceModality: normalizeModalityKind(pair.sourceModality),
    targetModality: normalizeModalityKind(pair.targetModality),
    sourceInputHash: normalizeHashLabel(pair.sourceInputHash),
    targetInputHash: normalizeHashLabel(pair.targetInputHash),
    toolSchemaHash: normalizeHashLabel(pair.toolSchemaHash),
    goldLabelHash: normalizeHashLabel(pair.goldLabelHash),
    transformConfigHash: normalizeHashLabel(pair.transformConfigHash),
    speakerProfileHash: normalizeHashLabel(pair.speakerProfileHash),
    noiseProfileHash: normalizeHashLabel(pair.noiseProfileHash),
    judgeValidationHash: normalizeHashLabel(pair.judgeValidationHash),
    sourceScore0to1,
    targetScore0to1,
    modalityScoreDelta0to1: sourceScore0to1 === null || targetScore0to1 === null
      ? null
      : round(targetScore0to1 - sourceScore0to1),
  };
}

function isModalityPairFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("modality source modality missing")
    || row.issues.includes("modality target modality missing")
    || row.issues.includes("modality source input hash invalid")
    || row.issues.includes("modality target input hash invalid")
    || row.issues.includes("modality tool schema hash invalid")
    || row.issues.includes("modality gold label hash invalid")
    || row.issues.includes("modality transform config hash invalid")
    || row.issues.includes("modality speaker profile hash invalid")
    || row.issues.includes("modality noise profile hash invalid")
    || row.issues.includes("modality judge validation hash invalid")
    || row.issues.includes("modality source score missing")
    || row.issues.includes("modality target score missing");
}

function buildModalityPairSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkModalityPairSummary {
  const modalityRows = rows.filter((row) => row.modalityPair);
  const scoreDeltas = modalityRows
    .map((row) => row.modalityPair?.modalityScoreDelta0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: modalityRows.length,
    targetModalities: unique(
      modalityRows
        .map((row) => row.modalityPair?.targetModality ?? "")
        .filter((value): value is ReplayBenchmarkModalityKind => modalityKinds.includes(value as ReplayBenchmarkModalityKind)),
    ) as ReplayBenchmarkModalityKind[],
    failedRowIds: modalityRows.filter(isModalityPairFailure).map((row) => row.rowId),
    judgeValidatedRowCount: modalityRows.filter((row) => Boolean(row.modalityPair?.judgeValidationHash)).length,
    averageScoreDelta0to1: scoreDeltas.length === 0
      ? null
      : round(scoreDeltas.reduce((sum, value) => sum + value, 0) / scoreDeltas.length),
  };
}

function buildInteractiveEpisodeReceipt(row: ReplayBenchmarkCorpusRowInput): ReplayBenchmarkInteractiveEpisodeReceipt | undefined {
  const episode = row.fixture.interactiveEpisode;
  if (!episode) return undefined;
  return {
    episodeId: normalizeLabel(episode.episodeId),
    environmentId: normalizeLabel(episode.environmentId),
    randomizationConfigHash: normalizeHashLabel(episode.randomizationConfigHash),
    observationTraceHash: normalizeHashLabel(episode.observationTraceHash),
    instructionTraceHash: normalizeHashLabel(episode.instructionTraceHash),
    feedbackTraceHash: normalizeHashLabel(episode.feedbackTraceHash),
    actionTraceHash: normalizeHashLabel(episode.actionTraceHash),
    rewardTraceHash: normalizeHashLabel(episode.rewardTraceHash),
    terminationTraceHash: normalizeHashLabel(episode.terminationTraceHash),
    feedbackMode: normalizeFeedbackMode(episode.feedbackMode),
    rewardHiddenFromAgent: typeof episode.rewardHiddenFromAgent === "boolean" ? episode.rewardHiddenFromAgent : null,
    maxSteps: positiveInteger(episode.maxSteps),
    stepsTaken: positiveInteger(episode.stepsTaken),
    terminated: typeof episode.terminated === "boolean" ? episode.terminated : null,
    truncated: typeof episode.truncated === "boolean" ? episode.truncated : null,
    returnScore: typeof episode.returnScore === "number" && Number.isFinite(episode.returnScore)
      ? round(episode.returnScore)
      : null,
  };
}

function isInteractiveEpisodeFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("interactive episode id missing")
    || row.issues.includes("interactive environment id missing")
    || row.issues.includes("interactive randomization config hash invalid")
    || row.issues.includes("interactive observation trace hash invalid")
    || row.issues.includes("interactive instruction trace hash invalid")
    || row.issues.includes("interactive feedback trace hash invalid")
    || row.issues.includes("interactive action trace hash invalid")
    || row.issues.includes("interactive reward trace hash invalid")
    || row.issues.includes("interactive termination trace hash invalid")
    || row.issues.includes("interactive feedback mode missing")
    || row.issues.includes("interactive reward hidden flag missing")
    || row.issues.includes("interactive reward exposed to agent")
    || row.issues.includes("interactive max steps missing")
    || row.issues.includes("interactive steps taken missing")
    || row.issues.includes("interactive steps exceed max steps")
    || row.issues.includes("interactive termination state missing");
}

function buildInteractiveEpisodeSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkInteractiveEpisodeSummary {
  const episodeRows = rows.filter((row) => row.interactiveEpisode);
  const steps = episodeRows
    .map((row) => row.interactiveEpisode?.stepsTaken ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: episodeRows.length,
    feedbackModes: unique(
      episodeRows
        .map((row) => row.interactiveEpisode?.feedbackMode ?? "")
        .filter((value): value is ReplayBenchmarkFeedbackMode => feedbackModes.includes(value as ReplayBenchmarkFeedbackMode)),
    ) as ReplayBenchmarkFeedbackMode[],
    failedRowIds: episodeRows.filter(isInteractiveEpisodeFailure).map((row) => row.rowId),
    rewardLeakageRowIds: episodeRows
      .filter((row) => row.issues.includes("interactive reward exposed to agent"))
      .map((row) => row.rowId),
    terminatedRowCount: episodeRows.filter((row) => row.interactiveEpisode?.terminated === true).length,
    truncatedRowCount: episodeRows.filter((row) => row.interactiveEpisode?.truncated === true).length,
    averageStepsTaken: steps.length === 0 ? null : round(steps.reduce((sum, value) => sum + value, 0) / steps.length),
  };
}

