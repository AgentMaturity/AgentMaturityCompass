    multimodalJudgeScoreMean0to1: multimodalJudgeScores.length === 0
      ? null
      : round(multimodalJudgeScores.reduce((sum, value) => sum + value, 0) / multimodalJudgeScores.length),
    responseLatencyMs: nonNegativeNumber(rag.responseLatencyMs),
    firstTokenLatencyMs: nonNegativeNumber(rag.firstTokenLatencyMs),
    averageCharLatencyMs: nonNegativeNumber(rag.averageCharLatencyMs),
    throughputQps: nonNegativeNumber(rag.throughputQps),
