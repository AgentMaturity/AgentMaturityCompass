  }
  for (const [label, hash] of [
    ["source ref", replay.innovatorBenchSourceRefHash],
    ["repository snapshot", replay.innovatorBenchRepositorySnapshotHash],
    ["license ref", replay.innovatorBenchLicenseRefHash],
