function appendLlmEvaluationSystemIssues(
  issues: string[],
  replay: ReplayBenchmarkAgentBenchmarkReplayReceipt,
): void {
  if (!hasLlmEvaluationSystemSignal(replay)) {
    return;
  }
  if (!replay.llmEvaluationSystemBenchmarkId) {
    issues.push("agent benchmark replay llm-evaluation-system benchmark id missing");
  }
  for (const [label, hash] of [
    ["source ref", replay.llmEvaluationSystemSourceRefHash],
    ["repository snapshot", replay.llmEvaluationSystemRepositorySnapshotHash],
    ["license ref", replay.llmEvaluationSystemLicenseRefHash],
    ["package version ref", replay.llmEvaluationSystemPackageVersionRefHash],
    ["mcp install manifest", replay.llmEvaluationSystemMcpInstallManifestHash],
    ["dataset manifest", replay.llmEvaluationSystemDatasetManifestHash],
    ["synthetic qa manifest", replay.llmEvaluationSystemSyntheticQaManifestHash],
    ["document grounding manifest", replay.llmEvaluationSystemDocumentGroundingManifestHash],
    ["judge config", replay.llmEvaluationSystemJudgeConfigHash],
    ["jury roster", replay.llmEvaluationSystemJuryRosterHash],
    ["criteria manifest", replay.llmEvaluationSystemCriteriaManifestHash],
    ["binary scoring policy", replay.llmEvaluationSystemBinaryScoringPolicyHash],
    ["execution manifest", replay.llmEvaluationSystemExecutionManifestHash],
    ["agent trace manifest", replay.llmEvaluationSystemAgentTraceManifestHash],
    ["opentelemetry trace", replay.llmEvaluationSystemOpenTelemetryTraceHash],
    ["bedrock access boundary", replay.llmEvaluationSystemBedrockAccessBoundaryHash],
    ["result manifest", replay.llmEvaluationSystemResultManifestHash],
    ["analysis report", replay.llmEvaluationSystemAnalysisReportHash],
    ["pdf report", replay.llmEvaluationSystemPdfReportHash],
    ["s3 sync receipt", replay.llmEvaluationSystemS3SyncReceiptHash],
    ["replay command", replay.llmEvaluationSystemReplayCommandHash],
    ["ci receipt", replay.llmEvaluationSystemCiReceiptHash],
    ["no config-only boundary", replay.llmEvaluationSystemNoConfigOnlyBoundaryHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`agent benchmark replay llm-evaluation-system ${label} hash invalid`);
    }
  }
  appendLlmEvaluationSystemCountIssue(
    issues,
    "mode count",
    replay.llmEvaluationSystemModes.length,
    replay.minLlmEvaluationSystemModeCount,
  );
  appendLlmEvaluationSystemCountIssue(
    issues,
    "judge family count",
    replay.llmEvaluationSystemJudgeFamilies.length,
    replay.minLlmEvaluationSystemJudgeFamilyCount,
  );
  appendLlmEvaluationSystemMinimumIssue(
    issues,
    "dataset count",
    replay.llmEvaluationSystemDatasetCount,
    replay.minLlmEvaluationSystemDatasetCount,
  );
  appendLlmEvaluationSystemMinimumIssue(
    issues,
    "judge count",
    replay.llmEvaluationSystemJudgeCount,
    replay.minLlmEvaluationSystemJudgeCount,
  );
  appendLlmEvaluationSystemMinimumIssue(
    issues,
    "criteria count",
    replay.llmEvaluationSystemCriteriaCount,
    replay.minLlmEvaluationSystemCriteriaCount,
  );
  appendLlmEvaluationSystemMinimumIssue(
    issues,
    "evaluation case count",
    replay.llmEvaluationSystemEvaluationCaseCount,
    replay.minLlmEvaluationSystemEvaluationCaseCount,
  );
  if (replay.llmEvaluationSystemDeterministicSeed === null) {
    issues.push("agent benchmark replay llm-evaluation-system deterministic seed missing");
  }
  if (replay.llmEvaluationSystemBaselineJuryScore0to1 === null) {
    issues.push("agent benchmark replay llm-evaluation-system baseline jury score missing");
  }
  if (replay.llmEvaluationSystemCandidateJuryScore0to1 === null) {
    issues.push("agent benchmark replay llm-evaluation-system candidate jury score missing");
  }
  if (replay.llmEvaluationSystemJuryScoreDelta0to1 === null) {
    issues.push("agent benchmark replay llm-evaluation-system jury score delta missing");
  }
  if (replay.maxLlmEvaluationSystemJuryScoreRegression0to1 === null) {
    issues.push("agent benchmark replay llm-evaluation-system jury score regression threshold missing");
  }
  if (
    replay.llmEvaluationSystemJuryScoreDelta0to1 !== null
    && replay.maxLlmEvaluationSystemJuryScoreRegression0to1 !== null
    && replay.llmEvaluationSystemJuryScoreDelta0to1 < -replay.maxLlmEvaluationSystemJuryScoreRegression0to1
  ) {
    issues.push("agent benchmark replay llm-evaluation-system jury score regression exceeds threshold");
  }
  appendLlmEvaluationSystemMinimumIssue(
    issues,
    "binary scoring coverage",
    replay.llmEvaluationSystemBinaryScoringCoverage0to1,
    replay.minLlmEvaluationSystemBinaryScoringCoverage0to1,
  );
  appendLlmEvaluationSystemMinimumIssue(
    issues,
    "judge agreement",
    replay.llmEvaluationSystemJudgeAgreement0to1,
    replay.minLlmEvaluationSystemJudgeAgreement0to1,
  );
  appendLlmEvaluationSystemMinimumIssue(
    issues,
    "replay pass rate",
    replay.llmEvaluationSystemReplayPassRate0to1,
    replay.minLlmEvaluationSystemReplayPassRate0to1,
  );
  appendLlmEvaluationSystemMinimumIssue(
    issues,
    "report coverage",
    replay.llmEvaluationSystemReportCoverage0to1,
    replay.minLlmEvaluationSystemReportCoverage0to1,
  );
  appendLlmEvaluationSystemMinimumIssue(
    issues,
    "agent trace coverage",
    replay.llmEvaluationSystemAgentTraceCoverage0to1,
    replay.minLlmEvaluationSystemAgentTraceCoverage0to1,
  );
  if (replay.llmEvaluationSystemNoSyntheticDataCopyBoundary === null) {
    issues.push("agent benchmark replay llm-evaluation-system no synthetic data copy boundary flag missing");
  } else if (!replay.llmEvaluationSystemNoSyntheticDataCopyBoundary) {
    issues.push("agent benchmark replay llm-evaluation-system no synthetic data copy boundary disabled");
  }
  if (replay.llmEvaluationSystemNoPdfReportOnlyBoundary === null) {
    issues.push("agent benchmark replay llm-evaluation-system pdf-report-only boundary flag missing");
  } else if (!replay.llmEvaluationSystemNoPdfReportOnlyBoundary) {
    issues.push("agent benchmark replay llm-evaluation-system pdf-report-only boundary missing");
  }
}

