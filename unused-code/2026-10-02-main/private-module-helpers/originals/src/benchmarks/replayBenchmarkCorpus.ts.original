    }
    if (freshStackRetrieval.deterministicSeed === null) {
      issues.push("freshstack retrieval deterministic seed missing");
    }
    if (freshStackRetrieval.queryCount === null) {
      issues.push("freshstack retrieval query count missing");
    }
    if (freshStackRetrieval.minQueryCount === null) {
      issues.push("freshstack retrieval query count threshold missing");
    }
    if (
      freshStackRetrieval.queryCount !== null
      && freshStackRetrieval.minQueryCount !== null
      && freshStackRetrieval.queryCount < freshStackRetrieval.minQueryCount
    ) {
      issues.push("freshstack retrieval query count below threshold");
    }
    if (freshStackRetrieval.corpusDocumentCount === null) {
      issues.push("freshstack retrieval corpus document count missing");
    }
    if (freshStackRetrieval.minCorpusDocumentCount === null) {
      issues.push("freshstack retrieval corpus document count threshold missing");
    }
    if (
      freshStackRetrieval.corpusDocumentCount !== null
      && freshStackRetrieval.minCorpusDocumentCount !== null
      && freshStackRetrieval.corpusDocumentCount < freshStackRetrieval.minCorpusDocumentCount
    ) {
      issues.push("freshstack retrieval corpus document count below threshold");
    }
    if (freshStackRetrieval.topicCoverageCount === null) {
      issues.push("freshstack retrieval topic coverage missing");
    }
    if (freshStackRetrieval.minTopicCoverageCount === null) {
      issues.push("freshstack retrieval topic coverage threshold missing");
    }
    if (
      freshStackRetrieval.topicCoverageCount !== null
      && freshStackRetrieval.minTopicCoverageCount !== null
      && freshStackRetrieval.topicCoverageCount < freshStackRetrieval.minTopicCoverageCount
    ) {
      issues.push("freshstack retrieval topic coverage below threshold");
    }
    if (freshStackRetrieval.baselineMetric0to1 === null) {
      issues.push("freshstack retrieval baseline metric missing");
    }
    if (freshStackRetrieval.candidateMetric0to1 === null) {
      issues.push("freshstack retrieval candidate metric missing");
    }
    if (freshStackRetrieval.scoreDelta0to1 === null) {
      issues.push("freshstack retrieval score delta missing");
    }
    if (freshStackRetrieval.maxScoreRegression0to1 === null) {
      issues.push("freshstack retrieval score regression threshold missing");
    }
    if (
      freshStackRetrieval.scoreDelta0to1 !== null
      && freshStackRetrieval.maxScoreRegression0to1 !== null
      && freshStackRetrieval.scoreDelta0to1 < -freshStackRetrieval.maxScoreRegression0to1
    ) {
      issues.push("freshstack retrieval score regression exceeds threshold");
    }
    if (freshStackRetrieval.alphaNdcgAt10_0to1 === null) {
      issues.push("freshstack retrieval alpha-nDCG@10 missing");
    }
    if (freshStackRetrieval.minAlphaNdcgAt10_0to1 === null) {
      issues.push("freshstack retrieval alpha-nDCG@10 threshold missing");
    }
    if (
      freshStackRetrieval.alphaNdcgAt10_0to1 !== null
      && freshStackRetrieval.minAlphaNdcgAt10_0to1 !== null
      && freshStackRetrieval.alphaNdcgAt10_0to1 < freshStackRetrieval.minAlphaNdcgAt10_0to1
    ) {
      issues.push("freshstack retrieval alpha-nDCG@10 below threshold");
    }
    if (freshStackRetrieval.coverageAt20_0to1 === null) {
      issues.push("freshstack retrieval coverage@20 missing");
    }
    if (freshStackRetrieval.minCoverageAt20_0to1 === null) {
      issues.push("freshstack retrieval coverage@20 threshold missing");
    }
    if (
      freshStackRetrieval.coverageAt20_0to1 !== null
      && freshStackRetrieval.minCoverageAt20_0to1 !== null
      && freshStackRetrieval.coverageAt20_0to1 < freshStackRetrieval.minCoverageAt20_0to1
    ) {
      issues.push("freshstack retrieval coverage@20 below threshold");
    }
    if (freshStackRetrieval.recallAt50_0to1 === null) {
      issues.push("freshstack retrieval recall@50 missing");
    }
    if (freshStackRetrieval.minRecallAt50_0to1 === null) {
      issues.push("freshstack retrieval recall@50 threshold missing");
    }
    if (
      freshStackRetrieval.recallAt50_0to1 !== null
      && freshStackRetrieval.minRecallAt50_0to1 !== null
      && freshStackRetrieval.recallAt50_0to1 < freshStackRetrieval.minRecallAt50_0to1
    ) {
      issues.push("freshstack retrieval recall@50 below threshold");
    }
    if (freshStackRetrieval.replayPassRate0to1 === null) {
      issues.push("freshstack retrieval replay pass rate missing");
    }
    if (freshStackRetrieval.minReplayPassRate0to1 === null) {
      issues.push("freshstack retrieval replay pass rate threshold missing");
    }
    if (
      freshStackRetrieval.replayPassRate0to1 !== null
      && freshStackRetrieval.minReplayPassRate0to1 !== null
      && freshStackRetrieval.replayPassRate0to1 < freshStackRetrieval.minReplayPassRate0to1
    ) {
      issues.push("freshstack retrieval replay pass rate below threshold");
    }
  }
  if (dbContextEnrichment) {
    if (!dbContextEnrichment.benchmarkId) {
      issues.push("db context enrichment benchmark id missing");
    }
    if (!dbContextEnrichment.benchmarkVersion) {
      issues.push("db context enrichment benchmark version missing");
    }
    if (!dbContextEnrichment.databaseEngine) {
      issues.push("db context enrichment database engine missing");
    }
    if (!dbContextEnrichment.contextArtifactMode) {
      issues.push("db context enrichment artifact mode missing");
    }
    if (!dbContextEnrichment.workflowStage) {
      issues.push("db context enrichment workflow stage missing");
    }
    for (const [label, hash] of [
      ["repository snapshot", dbContextEnrichment.repositorySnapshotHash],
      ["extension manifest", dbContextEnrichment.extensionManifestHash],
      ["database schema", dbContextEnrichment.databaseSchemaHash],
      ["schema discovery trace", dbContextEnrichment.schemaDiscoveryTraceHash],
      ["context set", dbContextEnrichment.contextSetHash],
      ["template set", dbContextEnrichment.templateSetHash],
      ["facet set", dbContextEnrichment.facetSetHash],
      ["value search set", dbContextEnrichment.valueSearchSetHash],
      ["golden dataset", dbContextEnrichment.goldenDatasetHash],
      ["evaluation result", dbContextEnrichment.evaluationResultHash],
      ["failure case manifest", dbContextEnrichment.failureCaseManifestHash],
      ["hillclimb plan", dbContextEnrichment.hillclimbPlanHash],
      ["context mutation patch", dbContextEnrichment.contextMutationPatchHash],
      ["final validation", dbContextEnrichment.finalValidationResultHash],
      ["replay command", dbContextEnrichment.replayCommandHash],
    ] as const) {
      if (!hash || !isSha256(hash)) {
        issues.push(`db context enrichment ${label} hash invalid`);
      }
    }
    if (
      !dbContextEnrichment.evalbenchDbConfigHash
      || !isSha256(dbContextEnrichment.evalbenchDbConfigHash)
      || !dbContextEnrichment.evalbenchModelConfigHash
      || !isSha256(dbContextEnrichment.evalbenchModelConfigHash)
      || !dbContextEnrichment.evalbenchRunConfigHash
      || !isSha256(dbContextEnrichment.evalbenchRunConfigHash)
      || !dbContextEnrichment.llmRaterConfigHash
      || !isSha256(dbContextEnrichment.llmRaterConfigHash)
    ) {
      issues.push("db context enrichment evalbench config hash invalid");
    }
    if (dbContextEnrichment.deterministicSeed === null) {
      issues.push("db context enrichment deterministic seed missing");
    }
    if (dbContextEnrichment.goldenQuestionCount === null) {
      issues.push("db context enrichment golden question count missing");
    }
    if (dbContextEnrichment.minGoldenQuestionCount === null) {
      issues.push("db context enrichment golden question count threshold missing");
    }
    if (
      dbContextEnrichment.goldenQuestionCount !== null
      && dbContextEnrichment.minGoldenQuestionCount !== null
      && dbContextEnrichment.goldenQuestionCount < dbContextEnrichment.minGoldenQuestionCount
    ) {
      issues.push("db context enrichment golden question count below threshold");
    }
    if (dbContextEnrichment.contextItemCount === null) {
      issues.push("db context enrichment context item count missing");
    }
    if (dbContextEnrichment.minContextItemCount === null) {
      issues.push("db context enrichment context item count threshold missing");
    }
    if (
      dbContextEnrichment.contextItemCount !== null
      && dbContextEnrichment.minContextItemCount !== null
      && dbContextEnrichment.contextItemCount < dbContextEnrichment.minContextItemCount
    ) {
      issues.push("db context enrichment context item count below threshold");
    }
    if (dbContextEnrichment.baselineSqlAccuracy0to1 === null) {
      issues.push("db context enrichment baseline sql accuracy missing");
    }
    if (dbContextEnrichment.candidateSqlAccuracy0to1 === null) {
      issues.push("db context enrichment candidate sql accuracy missing");
    }
    if (dbContextEnrichment.minCandidateSqlAccuracy0to1 === null) {
      issues.push("db context enrichment candidate sql accuracy threshold missing");
    }
    if (
      dbContextEnrichment.candidateSqlAccuracy0to1 !== null
      && dbContextEnrichment.minCandidateSqlAccuracy0to1 !== null
      && dbContextEnrichment.candidateSqlAccuracy0to1 < dbContextEnrichment.minCandidateSqlAccuracy0to1
    ) {
      issues.push("db context enrichment candidate sql accuracy below threshold");
    }
    if (dbContextEnrichment.contextReuseCoverage0to1 === null) {
      issues.push("db context enrichment context reuse coverage missing");
    }
    if (dbContextEnrichment.minContextReuseCoverage0to1 === null) {
      issues.push("db context enrichment context reuse coverage threshold missing");
    }
    if (
      dbContextEnrichment.contextReuseCoverage0to1 !== null
      && dbContextEnrichment.minContextReuseCoverage0to1 !== null
      && dbContextEnrichment.contextReuseCoverage0to1 < dbContextEnrichment.minContextReuseCoverage0to1
    ) {
      issues.push("db context enrichment context reuse coverage below threshold");
    }
    if (dbContextEnrichment.executableSqlRate0to1 === null) {
      issues.push("db context enrichment executable sql rate missing");
    }
    if (dbContextEnrichment.minExecutableSqlRate0to1 === null) {
      issues.push("db context enrichment executable sql rate threshold missing");
    }
    if (
      dbContextEnrichment.executableSqlRate0to1 !== null
      && dbContextEnrichment.minExecutableSqlRate0to1 !== null
      && dbContextEnrichment.executableSqlRate0to1 < dbContextEnrichment.minExecutableSqlRate0to1
    ) {
      issues.push("db context enrichment executable sql rate below threshold");
    }
    if (dbContextEnrichment.hallucinatedColumnRate0to1 === null) {
      issues.push("db context enrichment hallucinated column rate missing");
    }
    if (dbContextEnrichment.maxHallucinatedColumnRate0to1 === null) {
      issues.push("db context enrichment hallucinated column threshold missing");
    }
    if (
      dbContextEnrichment.hallucinatedColumnRate0to1 !== null
      && dbContextEnrichment.maxHallucinatedColumnRate0to1 !== null
      && dbContextEnrichment.hallucinatedColumnRate0to1 > dbContextEnrichment.maxHallucinatedColumnRate0to1
    ) {
      issues.push("db context enrichment hallucinated column rate above threshold");
    }
    if (dbContextEnrichment.scoreDelta0to1 === null) {
      issues.push("db context enrichment score delta missing");
    }
    if (dbContextEnrichment.maxScoreRegression0to1 === null) {
      issues.push("db context enrichment score regression threshold missing");
    }
    if (
      dbContextEnrichment.scoreDelta0to1 !== null
      && dbContextEnrichment.maxScoreRegression0to1 !== null
      && dbContextEnrichment.scoreDelta0to1 < -dbContextEnrichment.maxScoreRegression0to1
    ) {
      issues.push("db context enrichment score regression exceeds threshold");
    }
    if (dbContextEnrichment.replayPassRate0to1 === null) {
      issues.push("db context enrichment replay pass rate missing");
    }
    if (dbContextEnrichment.minReplayPassRate0to1 === null) {
      issues.push("db context enrichment replay pass rate threshold missing");
    }
    if (
      dbContextEnrichment.replayPassRate0to1 !== null
      && dbContextEnrichment.minReplayPassRate0to1 !== null
      && dbContextEnrichment.replayPassRate0to1 < dbContextEnrichment.minReplayPassRate0to1
    ) {
      issues.push("db context enrichment replay pass rate below threshold");
    }
  }

  const payload = {
    rowId: row.rowId,
    surfaces: row.surfaces ?? ["Score", "Shield", "Watch"],
    fixtureHash: rowFixtureHash,
    baselineScore0to1,
    candidateScore0to1,
    scoreDelta0to1,
    status: statusFromIssues(issues),
    safetyRisk,
    runtime,
    adversarialRegression,
    behaviorDiff,
    pairwiseComparison,
    modalityPair,
    interactiveEpisode,
    videoPostProduction,
    pawBenchEvaluation,
    terminalWorld,
    codingAgentReport,
    benchmarkHackabilityAudit,
    logicBenchmark,
    skillLifecycle,
    skillBenchmarkRegression,
    ragEvaluation,
    chunkingStrategyEvaluation,
    advancedRag,
    docThinkerDocumentRag,
    gageEvaluation,
    vlaWorldModel,
    aiResearchTask,
    scientificEvaluation,
    toolSandbox,
    platformEvaluation,
    azureAgentLab,
    clawEnvKit,
    deepResearch,
    webSearchEvaluation,
    binaryAudit,
    longTermMemory,
    streamingImprovement,
    enterpriseToolCalling,
    biomedicalAgentEvaluation,
    mlDevBenchmark,
    text2SqlAgent,
    agentBenchmarkReplay,
    deepMathAgentReplay,
    judgeItReplay,
    benchLoop,
    scenarioSimulation,
    warehouseNativeLlmEval,
    adGenSocDataset,
    freshStackRetrieval,
    dbContextEnrichment,
    outputArtifactHashes,
    evidenceRefs,
    signedEvidenceRefs,
    issues,
  } satisfies Omit<ReplayBenchmarkCorpusManifestRow, "rowHash">;

  return {
    ...payload,
    rowHash: sha256Hex(canonicalize(payload)),
  };
}

function buildManifestHashPayload(manifest: Omit<ReplayBenchmarkCorpusManifest, "manifestHash">): string {
  return sha256Hex(canonicalize(manifest));
}

export function computeReplayBenchmarkManifestHash(manifest: Omit<ReplayBenchmarkCorpusManifest, "manifestHash">): string {
  return buildManifestHashPayload(manifest);
}

export function runReplayBenchmarkCorpus(input: ReplayBenchmarkCorpusInput): ReplayBenchmarkCorpusResult {
  const createdAt = (input.now ?? new Date()).toISOString();
  const thresholds: ReplayBenchmarkCorpusThresholds = {
    ...defaultReplayBenchmarkThresholds,
    ...input.thresholds,
  };
  const rows = input.rows
    .map((row) => buildManifestRow(row, thresholds))
    .sort((a, b) => a.rowId.localeCompare(b.rowId));
  const scoreDelta0to1 = rows.length === 0
    ? 0
    : round(rows.reduce((sum, row) => sum + row.scoreDelta0to1, 0) / rows.length);
  const fixtureHashAggregate = sha256Hex(canonicalize(rows.map((row) => ({ rowId: row.rowId, fixtureHash: row.fixtureHash }))));
  const safetyRiskSummary = buildSafetyRiskSummary(rows);
  const runtimeSummary = buildRuntimeSummary(rows);
  const adversarialRegressionSummary = buildAdversarialRegressionSummary(rows);
  const behaviorDiffSummary = buildBehaviorDiffSummary(rows);
  const pairwiseComparisonSummary = buildPairwiseComparisonSummary(rows);
  const modalityPairSummary = buildModalityPairSummary(rows);
  const interactiveEpisodeSummary = buildInteractiveEpisodeSummary(rows);
  const videoPostProductionSummary = buildVideoPostProductionSummary(rows);
  const pawBenchEvaluationSummary = buildPawBenchEvaluationSummary(rows);
  const terminalWorldSummary = buildTerminalWorldSummary(rows);
  const codingAgentReportSummary = buildCodingAgentReportSummary(rows);
  const benchmarkHackabilityAuditSummary = buildBenchmarkHackabilityAuditSummary(rows);
  const logicBenchmarkSummary = buildLogicBenchmarkSummary(rows);
  const skillLifecycleSummary = buildSkillLifecycleSummary(rows);
  const skillBenchmarkRegressionSummary = buildSkillBenchmarkRegressionSummary(rows);
  const ragEvaluationSummary = buildRagEvaluationSummary(rows);
  const chunkingStrategyEvaluationSummary = buildChunkingStrategyEvaluationSummary(rows);
  const advancedRagSummary = buildAdvancedRagSummary(rows);
  const docThinkerDocumentRagSummary = buildDocThinkerDocumentRagSummary(rows);
  const gageEvaluationSummary = buildGageEvaluationSummary(rows);
  const vlaWorldModelSummary = buildVlaWorldModelSummary(rows);
  const aiResearchTaskSummary = buildAiResearchTaskSummary(rows);
  const scientificEvaluationSummary = buildScientificEvaluationSummary(rows);
  const toolSandboxSummary = buildToolSandboxSummary(rows);
  const platformEvaluationSummary = buildPlatformEvaluationSummary(rows);
  const azureAgentLabSummary = buildAzureAgentLabSummary(rows);
  const clawEnvKitSummary = buildClawEnvKitSummary(rows);
  const deepResearchSummary = buildDeepResearchSummary(rows);
  const webSearchEvaluationSummary = buildWebSearchEvaluationSummary(rows);
  const binaryAuditSummary = buildBinaryAuditSummary(rows);
  const longTermMemorySummary = buildLongTermMemorySummary(rows);
  const streamingImprovementSummary = buildStreamingImprovementSummary(rows);
  const enterpriseToolCallingSummary = buildEnterpriseToolCallingSummary(rows);
  const biomedicalAgentEvaluationSummary = buildBiomedicalAgentEvaluationSummary(rows);
  const mlDevBenchmarkSummary = buildMlDevBenchmarkSummary(rows);
  const text2SqlAgentSummary = buildText2SqlAgentSummary(rows);
  const agentBenchmarkReplaySummary = buildAgentBenchmarkReplaySummary(rows);
  const deepMathAgentReplaySummary = buildDeepMathAgentReplaySummary(rows);
  const judgeItReplaySummary = buildJudgeItReplaySummary(rows);
  const benchLoopSummary = buildBenchLoopSummary(rows);
  const scenarioSimulationSummary = buildScenarioSimulationSummary(rows);
  const warehouseNativeLlmEvalSummary = buildWarehouseNativeLlmEvalSummary(rows);
  const adGenSocDatasetSummary = buildAdGenSocDatasetSummary(rows);
  const freshStackRetrievalSummary = buildFreshStackRetrievalSummary(rows);
  const dbContextEnrichmentSummary = buildDbContextEnrichmentSummary(rows);
  const safetyRiskRowsHaveMetrics = rows.every((row) => !row.safetyRisk || (
    row.safetyRisk.baselineAttackSuccessRate0to1 !== null
    && row.safetyRisk.candidateAttackSuccessRate0to1 !== null
  ));
  const runtimeRowsHaveArtifacts = rows.every((row) => !row.runtime || (
    !thresholds.requireOutputArtifactHashForRuntimeRows
    || (
      row.outputArtifactHashes.length > 0
      && !row.issues.includes("output artifact hash invalid")
      && !row.issues.includes("runtime command hash invalid")
      && !row.issues.includes("runtime dependency hash invalid")
    )
  ));
  const adversarialRegressionRowsHaveReceipts = rows.every((row) => !row.adversarialRegression || (
    Boolean(row.adversarialRegression.exploitFixtureId)
    && Boolean(row.adversarialRegression.expectedDecision)
    && Boolean(row.adversarialRegression.actualDecision)
    && Boolean(row.adversarialRegression.rerunOutputHash)
    && Boolean(row.adversarialRegression.releaseGateReceiptId)
    && Boolean(row.adversarialRegression.engineEvaluation?.traceId)
    && Boolean(row.adversarialRegression.engineEvaluation?.annotationId)
    && Boolean(row.adversarialRegression.engineEvaluation?.continuousEvalId)
    && Boolean(row.adversarialRegression.engineEvaluation?.evaluatorName)
    && Boolean(row.adversarialRegression.engineEvaluation?.evaluatorVersion)
    && Boolean(row.adversarialRegression.engineEvaluation?.transformId)
    && Boolean(row.adversarialRegression.engineEvaluation?.status)
    && row.adversarialRegression.engineEvaluation?.score0to1 !== null
    && Boolean(row.adversarialRegression.engineEvaluation?.criteriaHash)
    && Boolean(row.adversarialRegression.engineEvaluation?.variablesHash)
    && Boolean(row.adversarialRegression.engineEvaluation?.explanationHash)
    && Boolean(row.adversarialRegression.engineEvaluation?.rerunStatus)
    && (row.adversarialRegression.engineEvaluation?.guardrailRuleIds.length ?? 0) > 0
    && (row.adversarialRegression.engineEvaluation?.guardrailRuleTypes.length ?? 0) > 0
    && row.adversarialRegression.engineEvaluation?.failedGuardrailRuleCount !== null
    && Boolean(row.adversarialRegression.engineEvaluation?.alertRuleId)
    && Boolean(row.adversarialRegression.engineEvaluation?.alertRuleMetricName)
    && Boolean(row.adversarialRegression.engineEvaluation?.alertRuleQueryHash)
    && row.adversarialRegression.engineEvaluation?.alertRuleThreshold !== null
    && Boolean(row.adversarialRegression.engineEvaluation?.alertRuleBound)
    && !row.issues.includes("adversarial rerun output hash invalid")
    && !row.issues.includes("adversarial engine evaluation did not complete")
    && !row.issues.includes("adversarial engine rerun did not complete")
    && !row.issues.some((issue) => issue.startsWith("adversarial engine") && issue.endsWith("hash invalid"))
    && !row.issues.includes("adversarial alert rule query hash invalid")
    && (
      !row.adversarialRegression.redTeamBenchmark ||
      !row.issues.some((issue) => issue.startsWith("red-team benchmark "))
    )
  ));
  const behaviorDiffRowsHaveValidHashes = rows.every((row) => !row.behaviorDiff || !isBehaviorDiffFailure(row));
  const pairwiseComparisonRowsHaveValidReceipts = rows.every((row) => !row.pairwiseComparison || !isPairwiseComparisonFailure(row));
  const modalityPairRowsHaveValidReceipts = rows.every((row) => !row.modalityPair || !isModalityPairFailure(row));
  const interactiveEpisodeRowsHaveValidReceipts = rows.every((row) => !row.interactiveEpisode || !isInteractiveEpisodeFailure(row));
  const videoPostProductionRowsHaveValidReceipts = rows.every((row) => (
    !row.videoPostProduction || !isVideoPostProductionFailure(row)
  ));
  const pawBenchEvaluationRowsHaveValidReceipts = rows.every((row) => (
    !row.pawBenchEvaluation || !isPawBenchEvaluationFailure(row)
  ));
  const terminalWorldRowsHaveValidReceipts = rows.every((row) => !row.terminalWorld || !isTerminalWorldFailure(row));
  const codingAgentReportRowsHaveValidReceipts = rows.every((row) => (
    !row.codingAgentReport || !isCodingAgentReportFailure(row)
  ));
  const benchmarkHackabilityAuditRowsHaveValidReceipts = rows.every((row) => (
    !row.benchmarkHackabilityAudit || !isBenchmarkHackabilityAuditFailure(row)
  ));
  const logicBenchmarkRowsHaveValidReceipts = rows.every((row) => !row.logicBenchmark || !isLogicBenchmarkFailure(row));
  const skillLifecycleRowsHaveValidReceipts = rows.every((row) => !row.skillLifecycle || !isSkillLifecycleFailure(row));
  const skillBenchmarkRegressionRowsHaveValidReceipts = rows.every((row) => (
    !row.skillBenchmarkRegression || !isSkillBenchmarkRegressionFailure(row)
  ));
  const ragEvaluationRowsHaveValidReceipts = rows.every((row) => !row.ragEvaluation || !isRagEvaluationFailure(row));
  const chunkingStrategyEvaluationRowsHaveValidReceipts = rows.every((row) => (
    !row.chunkingStrategyEvaluation || !isChunkingStrategyEvaluationFailure(row)
  ));
  const advancedRagRowsHaveValidReceipts = rows.every((row) => !row.advancedRag || !isAdvancedRagFailure(row));
  const docThinkerDocumentRagRowsHaveValidReceipts = rows.every((row) => (
    !row.docThinkerDocumentRag || !isDocThinkerDocumentRagFailure(row)
  ));
  const gageEvaluationRowsHaveValidReceipts = rows.every((row) => !row.gageEvaluation || !isGageEvaluationFailure(row));
  const vlaWorldModelRowsHaveValidReceipts = rows.every((row) => !row.vlaWorldModel || !isVlaWorldModelFailure(row));
  const aiResearchTaskRowsHaveValidReceipts = rows.every((row) => !row.aiResearchTask || !isAiResearchTaskFailure(row));
  const scientificEvaluationRowsHaveValidReceipts = rows.every((row) => (
    !row.scientificEvaluation || !isScientificEvaluationFailure(row)
  ));
  const toolSandboxRowsHaveValidReceipts = rows.every((row) => !row.toolSandbox || !isToolSandboxFailure(row));
  const platformEvaluationRowsHaveValidReceipts = rows.every((row) => !row.platformEvaluation || !isPlatformEvaluationFailure(row));
  const azureAgentLabRowsHaveValidReceipts = rows.every((row) => !row.azureAgentLab || !isAzureAgentLabFailure(row));
  const clawEnvKitRowsHaveValidReceipts = rows.every((row) => !row.clawEnvKit || !isClawEnvKitFailure(row));
  const deepResearchRowsHaveValidReceipts = rows.every((row) => !row.deepResearch || !isDeepResearchFailure(row));
  const webSearchEvaluationRowsHaveValidReceipts = rows.every((row) => (
    !row.webSearchEvaluation || !isWebSearchEvaluationFailure(row)
  ));
  const binaryAuditRowsHaveValidReceipts = rows.every((row) => !row.binaryAudit || !isBinaryAuditFailure(row));
  const longTermMemoryRowsHaveValidReceipts = rows.every((row) => !row.longTermMemory || !isLongTermMemoryFailure(row));
  const streamingImprovementRowsHaveValidReceipts = rows.every((row) => (
    !row.streamingImprovement || !isStreamingImprovementFailure(row)
  ));
  const enterpriseToolCallingRowsHaveValidReceipts = rows.every((row) => (
    !row.enterpriseToolCalling || !isEnterpriseToolCallingFailure(row)
  ));
  const biomedicalAgentEvaluationRowsHaveValidReceipts = rows.every((row) => (
    !row.biomedicalAgentEvaluation || !isBiomedicalAgentEvaluationFailure(row)
  ));
  const mlDevBenchmarkRowsHaveValidReceipts = rows.every((row) => !row.mlDevBenchmark || !isMlDevBenchmarkFailure(row));
  const text2SqlAgentRowsHaveValidReceipts = rows.every((row) => !row.text2SqlAgent || !isText2SqlAgentFailure(row));
  const agentBenchmarkReplayRowsHaveValidReceipts = rows.every((row) => (
    !row.agentBenchmarkReplay || !isAgentBenchmarkReplayFailure(row)
  ));
  const deepMathAgentReplayRowsHaveValidReceipts = rows.every((row) => (
    !row.deepMathAgentReplay || !isDeepMathAgentReplayFailure(row)
  ));
  const judgeItReplayRowsHaveValidReceipts = rows.every((row) => !row.judgeItReplay || !isJudgeItReplayFailure(row));
  const benchLoopRowsHaveValidReceipts = rows.every((row) => !row.benchLoop || !isBenchLoopFailure(row));
  const scenarioSimulationRowsHaveValidReceipts = rows.every((row) => (
    !row.scenarioSimulation || !isScenarioSimulationFailure(row)
  ));
  const warehouseNativeLlmEvalRowsHaveValidReceipts = rows.every((row) => (
    !row.warehouseNativeLlmEval || !isWarehouseNativeLlmEvalFailure(row)
  ));
  const adGenSocDatasetRowsHaveValidReceipts = rows.every((row) => (
    !row.adGenSocDataset || !isAdGenSocDatasetFailure(row)
  ));
  const freshStackRetrievalRowsHaveValidReceipts = rows.every((row) => (
    !row.freshStackRetrieval || !isFreshStackRetrievalFailure(row)
  ));
  const dbContextEnrichmentRowsHaveValidReceipts = rows.every((row) => (
    !row.dbContextEnrichment || !isDbContextEnrichmentFailure(row)
  ));
  const replayable = rows.length > 0
    && safetyRiskRowsHaveMetrics
    && runtimeRowsHaveArtifacts
    && adversarialRegressionRowsHaveReceipts
    && behaviorDiffRowsHaveValidHashes
    && pairwiseComparisonRowsHaveValidReceipts
    && modalityPairRowsHaveValidReceipts
    && interactiveEpisodeRowsHaveValidReceipts
    && videoPostProductionRowsHaveValidReceipts
    && pawBenchEvaluationRowsHaveValidReceipts
    && terminalWorldRowsHaveValidReceipts
    && codingAgentReportRowsHaveValidReceipts
    && benchmarkHackabilityAuditRowsHaveValidReceipts
    && logicBenchmarkRowsHaveValidReceipts
    && skillLifecycleRowsHaveValidReceipts
    && skillBenchmarkRegressionRowsHaveValidReceipts
    && ragEvaluationRowsHaveValidReceipts
    && chunkingStrategyEvaluationRowsHaveValidReceipts
    && advancedRagRowsHaveValidReceipts
    && docThinkerDocumentRagRowsHaveValidReceipts
    && gageEvaluationRowsHaveValidReceipts
    && vlaWorldModelRowsHaveValidReceipts
    && aiResearchTaskRowsHaveValidReceipts
    && scientificEvaluationRowsHaveValidReceipts
    && toolSandboxRowsHaveValidReceipts
    && platformEvaluationRowsHaveValidReceipts
    && azureAgentLabRowsHaveValidReceipts
    && clawEnvKitRowsHaveValidReceipts
    && deepResearchRowsHaveValidReceipts
    && webSearchEvaluationRowsHaveValidReceipts
    && binaryAuditRowsHaveValidReceipts
    && longTermMemoryRowsHaveValidReceipts
    && streamingImprovementRowsHaveValidReceipts
    && enterpriseToolCallingRowsHaveValidReceipts
    && biomedicalAgentEvaluationRowsHaveValidReceipts
    && mlDevBenchmarkRowsHaveValidReceipts
    && text2SqlAgentRowsHaveValidReceipts
    && agentBenchmarkReplayRowsHaveValidReceipts
    && deepMathAgentReplayRowsHaveValidReceipts
    && judgeItReplayRowsHaveValidReceipts
    && benchLoopRowsHaveValidReceipts
    && scenarioSimulationRowsHaveValidReceipts
    && warehouseNativeLlmEvalRowsHaveValidReceipts
    && adGenSocDatasetRowsHaveValidReceipts
    && freshStackRetrievalRowsHaveValidReceipts
    && dbContextEnrichmentRowsHaveValidReceipts
    && rows.every((row) => isSha256(row.fixtureHash) && row.evidenceRefs.length > 0 && row.signedEvidenceRefs.length >= thresholds.minSignedEvidenceRefs);

  const manifestWithoutHash: Omit<ReplayBenchmarkCorpusManifest, "manifestHash"> = {
    schemaVersion: "2026-06-13",
    manifestId: `replay-corpus:${input.agentId}:${input.corpusId}:${input.corpusVersion}`,
    agentId: input.agentId,
    corpusId: input.corpusId,
    corpusVersion: input.corpusVersion,
    baselineRunId: input.baselineRunId,
    candidateRunId: input.candidateRunId,
    createdAt,
    fixtureHash: fixtureHashAggregate,
    scoreDelta0to1,
    rowCount: rows.length,
    thresholds,
    safetyRiskSummary,
    runtimeSummary,
    adversarialRegressionSummary,
    behaviorDiffSummary,
    pairwiseComparisonSummary,
    modalityPairSummary,
    interactiveEpisodeSummary,
    videoPostProductionSummary,
    pawBenchEvaluationSummary,
    terminalWorldSummary,
    codingAgentReportSummary,
    benchmarkHackabilityAuditSummary,
    logicBenchmarkSummary,
    skillLifecycleSummary,
    skillBenchmarkRegressionSummary,
    ragEvaluationSummary,
    chunkingStrategyEvaluationSummary,
    advancedRagSummary,
    docThinkerDocumentRagSummary,
    gageEvaluationSummary,
    vlaWorldModelSummary,
    aiResearchTaskSummary,
    scientificEvaluationSummary,
    toolSandboxSummary,
    platformEvaluationSummary,
    azureAgentLabSummary,
    clawEnvKitSummary,
    deepResearchSummary,
    webSearchEvaluationSummary,
    binaryAuditSummary,
    longTermMemorySummary,
    streamingImprovementSummary,
    enterpriseToolCallingSummary,
    biomedicalAgentEvaluationSummary,
    mlDevBenchmarkSummary,
    text2SqlAgentSummary,
    agentBenchmarkReplaySummary,
    deepMathAgentReplaySummary,
    judgeItReplaySummary,
    benchLoopSummary,
    scenarioSimulationSummary,
    warehouseNativeLlmEvalSummary,
    adGenSocDatasetSummary,
    freshStackRetrievalSummary,
    dbContextEnrichmentSummary,
    sourceRefs: input.sourceRefs ?? [],
    replayable,
    rows,
  };
  const manifest: ReplayBenchmarkCorpusManifest = {
    ...manifestWithoutHash,
    manifestHash: computeReplayBenchmarkManifestHash(manifestWithoutHash),
  };
  const ciReceipt = buildReplayBenchmarkCiReceipt(manifest, input.gateMode ?? "ci");

  return {
    manifest,
    ciReceipt,
    watchAlerts: buildReplayBenchmarkWatchAlerts(manifest, ciReceipt),
  };
}

export function buildReplayBenchmarkCiReceipt(
  manifest: ReplayBenchmarkCorpusManifest,
  mode: ReplayBenchmarkGateMode = "ci",
): ReplayBenchmarkCiReceipt {
  const failedRows = manifest.rows.filter((row) => row.status !== "passed");
  const failedSafetyRiskRows = manifest.rows.filter(isSafetyRiskFailure);
  const failedRuntimeRows = manifest.rows.filter(isRuntimeFailure);
  const failedAdversarialRegressionRows = manifest.rows.filter(isAdversarialRegressionFailure);
  const failedBehaviorDiffRows = manifest.rows.filter(isBehaviorDiffFailure);
  const failedPairwiseComparisonRows = manifest.rows.filter(isPairwiseComparisonFailure);
  const failedModalityPairRows = manifest.rows.filter(isModalityPairFailure);
  const failedInteractiveEpisodeRows = manifest.rows.filter(isInteractiveEpisodeFailure);
  const failedVideoPostProductionRows = manifest.rows.filter(isVideoPostProductionFailure);
  const failedPawBenchEvaluationRows = manifest.rows.filter(isPawBenchEvaluationFailure);
  const failedTerminalWorldRows = manifest.rows.filter(isTerminalWorldFailure);
  const failedCodingAgentReportRows = manifest.rows.filter(isCodingAgentReportFailure);
  const failedBenchmarkHackabilityAuditRows = manifest.rows.filter(isBenchmarkHackabilityAuditFailure);
  const failedLogicBenchmarkRows = manifest.rows.filter(isLogicBenchmarkFailure);
  const failedSkillLifecycleRows = manifest.rows.filter(isSkillLifecycleFailure);
  const failedSkillBenchmarkRegressionRows = manifest.rows.filter(isSkillBenchmarkRegressionFailure);
  const failedRagEvaluationRows = manifest.rows.filter(isRagEvaluationFailure);
  const failedChunkingStrategyEvaluationRows = manifest.rows.filter(isChunkingStrategyEvaluationFailure);
  const failedAdvancedRagRows = manifest.rows.filter(isAdvancedRagFailure);
  const failedDocThinkerDocumentRagRows = manifest.rows.filter(isDocThinkerDocumentRagFailure);
  const failedGageEvaluationRows = manifest.rows.filter(isGageEvaluationFailure);
  const failedVlaWorldModelRows = manifest.rows.filter(isVlaWorldModelFailure);
