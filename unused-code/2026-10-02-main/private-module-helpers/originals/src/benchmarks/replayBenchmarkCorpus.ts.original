    replay.paperArenaPaperCorpusHash,
    replay.paperArenaQaManifestHash,
    replay.paperArenaResultManifestHash,
    replay.paperArenaScoreReportHash,
    replay.paperArenaReplayCommandHash,
    replay.paperArenaCiReceiptHash,
  ].some((value) => value !== null)
    || replay.paperArenaToolSurfaces.length > 0
    || [
      replay.minPaperArenaToolSurfaceCount,
      replay.paperArenaQuestionCount,
      replay.minPaperArenaQuestionCount,
      replay.paperArenaPaperCount,
      replay.minPaperArenaPaperCount,
      replay.paperArenaToolCount,
      replay.minPaperArenaToolCount,
      replay.paperArenaRunScriptCount,
      replay.minPaperArenaRunScriptCount,
      replay.paperArenaDeterministicSeed,
      replay.paperArenaMaxSteps,
      replay.minPaperArenaMaxSteps,
      replay.paperArenaReplayPassRate0to1,
      replay.minPaperArenaReplayPassRate0to1,
      replay.paperArenaScoreDelta0to1,
      replay.minPaperArenaScoreDelta0to1,
      replay.paperArenaEvaluatorAgreement0to1,
      replay.minPaperArenaEvaluatorAgreement0to1,
      replay.paperArenaToolTraceCoverage0to1,
      replay.minPaperArenaToolTraceCoverage0to1,
      replay.paperArenaResultCoverage0to1,
      replay.minPaperArenaResultCoverage0to1,
    ].some((value) => value !== null);
}

function appendPaperArenaCountIssue(
  issues: string[],
  label: string,
  count: number,
  minimum: number | null,
): void {
  if (count === 0) {
    issues.push(`agent benchmark replay paperarena ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay paperarena ${label} threshold missing`);
  }
  if (minimum !== null && count < minimum) {
    issues.push(`agent benchmark replay paperarena ${label} below threshold`);
  }
}

function appendPaperArenaMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`agent benchmark replay paperarena ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay paperarena ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`agent benchmark replay paperarena ${label} below threshold`);
  }
}

function appendPaperArenaReplayIssues(
  issues: string[],
  replay: ReplayBenchmarkAgentBenchmarkReplayReceipt,
): void {
  if (!hasPaperArenaReplaySignal(replay)) {
    return;
  }
  for (const [label, hash] of [
    ["source ref", replay.paperArenaSourceRefHash],
    ["repository snapshot", replay.paperArenaRepositorySnapshotHash],
    ["no-license boundary", replay.paperArenaNoLicenseBoundaryHash],
    ["readme blob", replay.paperArenaReadmeBlobHash],
    ["requirements", replay.paperArenaRequirementsHash],
    ["hub config", replay.paperArenaHubConfigHash],
    ["hub runner", replay.paperArenaHubRunnerHash],
    ["result recorder", replay.paperArenaResultRecorderHash],
    ["data loader", replay.paperArenaDataLoaderHash],
    ["scorer", replay.paperArenaScorerHash],
    ["dataset builder tree", replay.paperArenaDatasetBuilderTreeHash],
    ["tool tree", replay.paperArenaToolTreeHash],
    ["rag tree", replay.paperArenaRagTreeHash],
    ["reflector tree", replay.paperArenaReflectorTreeHash],
    ["run script tree", replay.paperArenaRunScriptTreeHash],
    ["hf dataset snapshot", replay.paperArenaHfDatasetSnapshotHash],
    ["dataset manifest", replay.paperArenaDatasetManifestHash],
    ["paper corpus", replay.paperArenaPaperCorpusHash],
    ["qa manifest", replay.paperArenaQaManifestHash],
    ["result manifest", replay.paperArenaResultManifestHash],
    ["score report", replay.paperArenaScoreReportHash],
    ["replay command", replay.paperArenaReplayCommandHash],
    ["ci receipt", replay.paperArenaCiReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`agent benchmark replay paperarena ${label} hash invalid`);
    }
  }
  appendPaperArenaCountIssue(
    issues,
    "tool surface count",
    replay.paperArenaToolSurfaces.length,
    replay.minPaperArenaToolSurfaceCount,
  );
  appendPaperArenaMinimumIssue(
    issues,
    "question count",
    replay.paperArenaQuestionCount,
    replay.minPaperArenaQuestionCount,
  );
  appendPaperArenaMinimumIssue(
    issues,
    "paper count",
    replay.paperArenaPaperCount,
    replay.minPaperArenaPaperCount,
  );
  appendPaperArenaMinimumIssue(
    issues,
    "tool count",
    replay.paperArenaToolCount,
    replay.minPaperArenaToolCount,
  );
  appendPaperArenaMinimumIssue(
    issues,
    "run script count",
    replay.paperArenaRunScriptCount,
    replay.minPaperArenaRunScriptCount,
  );
  if (replay.paperArenaDeterministicSeed === null) {
    issues.push("agent benchmark replay paperarena deterministic seed missing");
  }
  appendPaperArenaMinimumIssue(
    issues,
    "max steps",
    replay.paperArenaMaxSteps,
    replay.minPaperArenaMaxSteps,
  );
  appendPaperArenaMinimumIssue(
    issues,
    "replay pass rate",
    replay.paperArenaReplayPassRate0to1,
    replay.minPaperArenaReplayPassRate0to1,
  );
  appendPaperArenaMinimumIssue(
    issues,
    "score delta",
    replay.paperArenaScoreDelta0to1,
    replay.minPaperArenaScoreDelta0to1,
  );
  appendPaperArenaMinimumIssue(
    issues,
    "evaluator agreement",
    replay.paperArenaEvaluatorAgreement0to1,
    replay.minPaperArenaEvaluatorAgreement0to1,
  );
  appendPaperArenaMinimumIssue(
    issues,
    "tool trace coverage",
    replay.paperArenaToolTraceCoverage0to1,
    replay.minPaperArenaToolTraceCoverage0to1,
  );
  appendPaperArenaMinimumIssue(
    issues,
    "result coverage",
    replay.paperArenaResultCoverage0to1,
    replay.minPaperArenaResultCoverage0to1,
  );
}

