    issues.push(`encourage rag ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`encourage rag ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`encourage rag ${label} below threshold`);
  }
}

function appendEncourageRagIssues(
  issues: string[],
  ragEvaluation: ReplayBenchmarkRagEvaluationReceipt,
): void {
  if (!hasEncourageRagSignal(ragEvaluation)) {
    return;
  }
  for (const [label, hash] of [
    ["source ref", ragEvaluation.encourageSourceRefHash],
    ["repository snapshot", ragEvaluation.encourageRepositorySnapshotHash],
    ["license ref", ragEvaluation.encourageLicenseRefHash],
    ["package version", ragEvaluation.encouragePackageVersionHash],
    ["dependency lock", ragEvaluation.encourageDependencyLockHash],
    ["method manifest", ragEvaluation.encourageRagMethodManifestHash],
    ["inference runner config", ragEvaluation.encourageInferenceRunnerConfigHash],
    ["template manifest", ragEvaluation.encourageTemplateManifestHash],
    ["vector db config", ragEvaluation.encourageVectorDbConfigHash],
    ["dataset manifest", ragEvaluation.encourageDatasetManifestHash],
    ["query set", ragEvaluation.encourageQuerySetHash],
    ["reference answer set", ragEvaluation.encourageReferenceAnswerSetHash],
    ["metric suite", ragEvaluation.encourageMetricSuiteHash],
    ["mlflow run", ragEvaluation.encourageMlflowRunHash],
    ["result manifest", ragEvaluation.encourageResultManifestHash],
    ["replay command", ragEvaluation.encourageReplayCommandHash],
    ["ci receipt", ragEvaluation.encourageCiReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`encourage rag ${label} hash invalid`);
    }
  }
  if (!ragEvaluation.encourageRagMethodId) {
    issues.push("encourage rag method id missing");
  }
  if (!ragEvaluation.encourageInferenceBackend) {
    issues.push("encourage rag inference backend missing");
  }
  if (!ragEvaluation.encourageVectorDb) {
    issues.push("encourage rag vector db missing");
  }
  if (ragEvaluation.encourageMetricIds.length === 0) {
    issues.push("encourage rag metric ids missing");
  }
  appendEncourageMinimumIssue(
    issues,
    "document count",
    ragEvaluation.encourageDocumentCount,
    ragEvaluation.encourageMinDocumentCount,
  );
  appendEncourageMinimumIssue(
    issues,
    "question count",
    ragEvaluation.encourageQuestionCount,
    ragEvaluation.encourageMinQuestionCount,
  );
  if (ragEvaluation.encourageDeterministicSeed === null) {
    issues.push("encourage rag deterministic seed missing");
  }
  if (ragEvaluation.encourageBaselineScore0to1 === null) {
    issues.push("encourage rag baseline score missing");
  }
  if (ragEvaluation.encourageCandidateScore0to1 === null) {
    issues.push("encourage rag candidate score missing");
  }
  if (ragEvaluation.encourageScoreDelta0to1 === null) {
    issues.push("encourage rag score delta missing");
  }
  if (ragEvaluation.encourageMaxScoreRegression0to1 === null) {
    issues.push("encourage rag score regression threshold missing");
  }
  if (
    ragEvaluation.encourageScoreDelta0to1 !== null
    && ragEvaluation.encourageMaxScoreRegression0to1 !== null
    && ragEvaluation.encourageScoreDelta0to1 < -ragEvaluation.encourageMaxScoreRegression0to1
  ) {
    issues.push("encourage rag score regression exceeds threshold");
  }
  appendEncourageMinimumIssue(
    issues,
    "replay pass rate",
    ragEvaluation.encourageReplayPassRate0to1,
    ragEvaluation.encourageMinReplayPassRate0to1,
  );
  appendEncourageMinimumIssue(
    issues,
    "metric coverage",
    ragEvaluation.encourageMetricCoverage0to1,
    ragEvaluation.encourageMinMetricCoverage0to1,
  );
  if (ragEvaluation.encourageMlflowLogged === null) {
    issues.push("encourage rag mlflow logged flag missing");
  } else if (!ragEvaluation.encourageMlflowLogged) {
    issues.push("encourage rag mlflow logging missing");
  }
}

function buildManifestRow(
  row: ReplayBenchmarkCorpusRowInput,
  thresholds: ReplayBenchmarkCorpusThresholds,
): ReplayBenchmarkCorpusManifestRow {
  const rowFixtureHash = fixtureHash(row.fixture);
  const baselineScore0to1 = clamp01(row.baseline.score0to1);
  const candidateScore0to1 = clamp01(row.candidate.score0to1);
  const scoreDelta0to1 = round(candidateScore0to1 - baselineScore0to1);
  const evidenceRefs = unique([...(row.baseline.evidenceRefs ?? []), ...(row.candidate.evidenceRefs ?? [])]);
  const signedEvidenceRefs = unique([...(row.baseline.signedEvidenceRefs ?? []), ...(row.candidate.signedEvidenceRefs ?? [])]);
  const safetyRisk = buildSafetyRiskReceipt(row, thresholds);
  const runtime = buildRuntimeReceipt(row.fixture);
  const adversarialRegression = buildAdversarialRegressionReceipt(row.fixture);
  const behaviorDiff = buildBehaviorDiffReceipt(row);
  const pairwiseComparison = buildPairwiseComparisonReceipt(row);
  const modalityPair = buildModalityPairReceipt(row);
  const interactiveEpisode = buildInteractiveEpisodeReceipt(row);
  const videoPostProduction = buildVideoPostProductionReceipt(row);
  const pawBenchEvaluation = buildPawBenchEvaluationReceipt(row);
  const terminalWorld = buildTerminalWorldReceipt(row);
  const codingAgentReport = buildCodingAgentReportReceipt(row);
  const benchmarkHackabilityAudit = buildBenchmarkHackabilityAuditReceipt(row);
  const logicBenchmark = buildLogicBenchmarkReceipt(row);
  const skillLifecycle = buildSkillLifecycleReceipt(row);
  const skillBenchmarkRegression = buildSkillBenchmarkRegressionReceipt(row);
  const ragEvaluation = buildRagEvaluationReceipt(row);
  const chunkingStrategyEvaluation = buildChunkingStrategyEvaluationReceipt(row);
  const advancedRag = buildAdvancedRagReceipt(row);
  const docThinkerDocumentRag = buildDocThinkerDocumentRagReceipt(row);
  const gageEvaluation = buildGageEvaluationReceipt(row);
  const vlaWorldModel = buildVlaWorldModelReceipt(row);
  const aiResearchTask = buildAiResearchTaskReceipt(row);
  const scientificEvaluation = buildScientificEvaluationReceipt(row);
  const toolSandbox = buildToolSandboxReceipt(row);
  const platformEvaluation = buildPlatformEvaluationReceipt(row);
  const azureAgentLab = buildAzureAgentLabReceipt(row);
  const clawEnvKit = buildClawEnvKitReceipt(row);
  const deepResearch = buildDeepResearchReceipt(row);
  const webSearchEvaluation = buildWebSearchEvaluationReceipt(row);
  const binaryAudit = buildBinaryAuditReceipt(row);
  const longTermMemory = buildLongTermMemoryReceipt(row);
  const streamingImprovement = buildStreamingImprovementReceipt(row);
  const enterpriseToolCalling = buildEnterpriseToolCallingReceipt(row);
  const biomedicalAgentEvaluation = buildBiomedicalAgentEvaluationReceipt(row);
  const mlDevBenchmark = buildMlDevBenchmarkReceipt(row);
  const text2SqlAgent = buildText2SqlAgentReceipt(row);
  const agentBenchmarkReplay = buildAgentBenchmarkReplayReceipt(row);
  const deepMathAgentReplay = buildDeepMathAgentReplayReceipt(row);
  const judgeItReplay = buildJudgeItReplayReceipt(row);
  const benchLoop = buildBenchLoopReceipt(row);
  const scenarioSimulation = buildScenarioSimulationReceipt(row);
  const warehouseNativeLlmEval = buildWarehouseNativeLlmEvalReceipt(row);
  const adGenSocDataset = buildAdGenSocDatasetReceipt(row);
  const freshStackRetrieval = buildFreshStackRetrievalReceipt(row);
  const dbContextEnrichment = buildDbContextEnrichmentReceipt(row);
  const outputArtifactHashResult = normalizeHashes(row.fixture.outputArtifactHashes);
  const outputArtifactHashes = outputArtifactHashResult.valid;
  const issues: string[] = [];

  if (evidenceRefs.length === 0) {
    issues.push("evidence refs missing");
  }
  if (signedEvidenceRefs.length < thresholds.minSignedEvidenceRefs) {
    issues.push("signed evidence refs below threshold");
  }
  if (scoreDelta0to1 < -thresholds.maxScoreRegression0to1) {
    issues.push("candidate score regressed beyond threshold");
  }
  if (runtime && thresholds.requireOutputArtifactHashForRuntimeRows && outputArtifactHashes.length === 0) {
    issues.push("output artifact hashes missing for runtime row");
  }
  if (outputArtifactHashResult.invalid.length > 0) {
    issues.push("output artifact hash invalid");
  }
  if (runtime?.commandHash && !isSha256(runtime.commandHash)) {
    issues.push("runtime command hash invalid");
  }
  if (runtime?.dependencyHash && !isSha256(runtime.dependencyHash)) {
    issues.push("runtime dependency hash invalid");
  }
  if (safetyRisk) {
    if (
      thresholds.requireAttackSuccessRateForRiskRows
      && (safetyRisk.baselineAttackSuccessRate0to1 === null || safetyRisk.candidateAttackSuccessRate0to1 === null)
    ) {
      issues.push("attack success rate metric missing");
    }
    if (
      safetyRisk.candidateAttackSuccessRate0to1 !== null
      && safetyRisk.candidateAttackSuccessRate0to1 > safetyRisk.maxCandidateAttackSuccessRate0to1
    ) {
      issues.push("candidate attack success rate above safety threshold");
    }
    if (
      safetyRisk.attackSuccessRateDelta0to1 !== null
      && safetyRisk.attackSuccessRateDelta0to1 > thresholds.maxAttackSuccessRateRegression0to1
    ) {
      issues.push("attack success rate regressed beyond threshold");
    }
    if (
      safetyRisk.attackSuccessRateDelta0to1 !== null
      && safetyRisk.minAttackSuccessRateReduction0to1 > 0
      && -safetyRisk.attackSuccessRateDelta0to1 < safetyRisk.minAttackSuccessRateReduction0to1
    ) {
      issues.push("attack success rate reduction below threshold");
    }
  }
  if (adversarialRegression) {
    if (!adversarialRegression.exploitFixtureId) {
      issues.push("adversarial exploit fixture missing");
    }
    if (!adversarialRegression.expectedDecision) {
      issues.push("adversarial expected decision missing");
    }
    if (!adversarialRegression.actualDecision) {
      issues.push("adversarial actual decision missing");
    }
    if (!adversarialRegression.rerunOutputHash) {
      issues.push("adversarial rerun output hash missing");
    } else if (!isSha256(adversarialRegression.rerunOutputHash)) {
      issues.push("adversarial rerun output hash invalid");
    }
    if (!adversarialRegression.releaseGateReceiptId) {
      issues.push("adversarial release gate receipt missing");
    }
    if (
      adversarialRegression.expectedDecision
      && adversarialRegression.actualDecision
      && adversarialRegression.expectedDecision !== adversarialRegression.actualDecision
    ) {
      issues.push("adversarial expected decision not met");
    }
    const redTeamBenchmark = adversarialRegression.redTeamBenchmark;
    if (redTeamBenchmark) {
      if (!redTeamBenchmark.benchmarkId) {
        issues.push("red-team benchmark id missing");
      }
      if (!redTeamBenchmark.benchmarkVersion) {
        issues.push("red-team benchmark version missing");
      }
      for (const [label, hash] of [
        ["question set", redTeamBenchmark.questionSetHash],
        ["reference answer manifest", redTeamBenchmark.referenceAnswerManifestHash],
        ["scoring config", redTeamBenchmark.scoringConfigHash],
        ["model config", redTeamBenchmark.modelConfigHash],
      ] as const) {
        if (!hash) {
          issues.push(`red-team benchmark ${label} hash missing`);
        } else if (!isSha256(hash)) {
          issues.push(`red-team benchmark ${label} hash invalid`);
        }
      }
      if (!redTeamBenchmark.providerBackend) {
        issues.push("red-team benchmark provider backend missing");
      }
      const resultExportHashes = [
        redTeamBenchmark.resultJsonHash,
        redTeamBenchmark.resultCsvHash,
      ].filter((hash): hash is string => Boolean(hash));
      if (resultExportHashes.length === 0) {
        issues.push("red-team benchmark result export hash missing");
      } else if (resultExportHashes.some((hash) => !isSha256(hash))) {
        issues.push("red-team benchmark result export hash invalid");
      }
      if (redTeamBenchmark.traceExportHash && !isSha256(redTeamBenchmark.traceExportHash)) {
        issues.push("red-team benchmark trace export hash invalid");
      }
      if (redTeamBenchmark.scoringModes.length === 0) {
        issues.push("red-team benchmark scoring mode missing");
      }
      if (redTeamBenchmark.questionCount === null) {
        issues.push("red-team benchmark question count missing");
      }
      if (
        redTeamBenchmark.questionCount !== null &&
        redTeamBenchmark.minQuestionCount !== null &&
        redTeamBenchmark.questionCount < redTeamBenchmark.minQuestionCount
      ) {
        issues.push("red-team benchmark question count below minimum");
      }
      if (redTeamBenchmark.passThreshold0to1 === null) {
        issues.push("red-team benchmark pass threshold missing");
      }
      if (redTeamBenchmark.refusalScore0to1 === null) {
        issues.push("red-team benchmark refusal score missing");
      }
      if (redTeamBenchmark.hallucinationScore0to1 === null) {
        issues.push("red-team benchmark hallucination score missing");
      }
      if (redTeamBenchmark.scoringModes.includes("semantic_similarity") && redTeamBenchmark.semanticScore0to1 === null) {
        issues.push("red-team benchmark semantic score missing");
      }
      if (redTeamBenchmark.scoringModes.includes("llm_judge")) {
        if (!redTeamBenchmark.judgeRubricHash) {
          issues.push("red-team benchmark judge rubric hash missing");
        } else if (!isSha256(redTeamBenchmark.judgeRubricHash)) {
          issues.push("red-team benchmark judge rubric hash invalid");
        }
      }
      if (
        redTeamBenchmark.promptOptimizationIterationCount !== null &&
        redTeamBenchmark.promptOptimizationIterationCount > 0
      ) {
        if (!redTeamBenchmark.promptOptimizationConfigHash) {
          issues.push("red-team benchmark prompt optimization config hash missing");
        } else if (!isSha256(redTeamBenchmark.promptOptimizationConfigHash)) {
          issues.push("red-team benchmark prompt optimization config hash invalid");
        }
      } else if (redTeamBenchmark.promptOptimizationConfigHash && !isSha256(redTeamBenchmark.promptOptimizationConfigHash)) {
        issues.push("red-team benchmark prompt optimization config hash invalid");
      }
    }
    const engineEvaluation = adversarialRegression.engineEvaluation;
    if (!engineEvaluation) {
      issues.push("adversarial engine evaluation evidence missing");
    } else {
      if (!engineEvaluation.traceId) {
        issues.push("adversarial engine trace id missing");
      }
      if (!engineEvaluation.annotationId) {
        issues.push("adversarial engine annotation id missing");
      }
      if (!engineEvaluation.continuousEvalId) {
        issues.push("adversarial continuous eval id missing");
      }
      if (!engineEvaluation.evaluatorName || !engineEvaluation.evaluatorVersion) {
        issues.push("adversarial evaluator name/version missing");
      }
      if (!engineEvaluation.transformId) {
        issues.push("adversarial transform id missing");
      }
      if (!engineEvaluation.status) {
        issues.push("adversarial engine evaluation status missing");
      } else if (["skipped", "error", "pending"].includes(engineEvaluation.status)) {
        issues.push("adversarial engine evaluation did not complete");
      }
      if (engineEvaluation.score0to1 === null) {
        issues.push("adversarial engine evaluation score missing");
      }
      for (const [label, hash] of [
        ["criteria", engineEvaluation.criteriaHash],
        ["variables", engineEvaluation.variablesHash],
        ["explanation", engineEvaluation.explanationHash],
      ] as const) {
        if (!hash) {
          issues.push(`adversarial engine ${label} hash missing`);
        } else if (!isSha256(hash)) {
          issues.push(`adversarial engine ${label} hash invalid`);
        }
      }
      if (!engineEvaluation.rerunStatus) {
        issues.push("adversarial engine rerun status missing");
      } else if (["skipped", "error", "pending"].includes(engineEvaluation.rerunStatus)) {
        issues.push("adversarial engine rerun did not complete");
      }
      if (engineEvaluation.guardrailRuleIds.length === 0 || engineEvaluation.guardrailRuleTypes.length === 0) {
        issues.push("adversarial guardrail rule evidence missing");
      }
      if (engineEvaluation.failedGuardrailRuleCount === null) {
        issues.push("adversarial guardrail failed rule count missing");
      }
      if (engineEvaluation.promptInjectionDetected === true && !engineEvaluation.guardrailRuleTypes.includes("prompt_injection")) {
        issues.push("prompt injection detection missing matching guardrail rule");
      }
      if (!engineEvaluation.alertRuleId || !engineEvaluation.alertRuleMetricName) {
        issues.push("adversarial alert rule evidence missing");
      }
      if (!engineEvaluation.alertRuleQueryHash) {
        issues.push("adversarial alert rule query hash missing");
      } else if (!isSha256(engineEvaluation.alertRuleQueryHash)) {
        issues.push("adversarial alert rule query hash invalid");
      }
      if (engineEvaluation.alertRuleThreshold === null) {
        issues.push("adversarial alert rule threshold missing");
      }
      if (!engineEvaluation.alertRuleBound) {
        issues.push("adversarial alert rule bound missing");
      }
    }
  }
  if (behaviorDiff) {
    const behaviorHashes = [
      behaviorDiff.baselineBehaviorSnapshotHash,
      behaviorDiff.candidateBehaviorSnapshotHash,
    ].filter((hash): hash is string => Boolean(hash));
    if (behaviorHashes.some((hash) => !isSha256(hash))) {
      issues.push("behavior snapshot hash invalid");
    }
    const toolCallHashes = [
      behaviorDiff.baselineToolCallSequenceHash,
      behaviorDiff.candidateToolCallSequenceHash,
    ].filter((hash): hash is string => Boolean(hash));
    if (toolCallHashes.some((hash) => !isSha256(hash))) {
      issues.push("tool-call sequence hash invalid");
    }
  }
  if (pairwiseComparison) {
    if (!pairwiseComparison.promptHash || !isSha256(pairwiseComparison.promptHash)) {
      issues.push("pairwise comparison prompt hash invalid");
    }
    if (!pairwiseComparison.baselineResponseHash || !isSha256(pairwiseComparison.baselineResponseHash)) {
      issues.push("pairwise baseline response hash invalid");
    }
    if (!pairwiseComparison.candidateResponseHash || !isSha256(pairwiseComparison.candidateResponseHash)) {
      issues.push("pairwise candidate response hash invalid");
    }
    if (pairwiseComparison.judgeIds.length === 0) {
      issues.push("pairwise judge ids missing");
    }
    if (pairwiseComparison.judgePanelHash && !isSha256(pairwiseComparison.judgePanelHash)) {
      issues.push("pairwise judge panel hash invalid");
    }
    if (!pairwiseComparison.winner) {
      issues.push("pairwise winner missing");
    }
  }
  if (modalityPair) {
    if (!modalityPair.sourceModality) {
      issues.push("modality source modality missing");
    }
    if (!modalityPair.targetModality) {
      issues.push("modality target modality missing");
    }
    if (!modalityPair.sourceInputHash || !isSha256(modalityPair.sourceInputHash)) {
      issues.push("modality source input hash invalid");
    }
    if (!modalityPair.targetInputHash || !isSha256(modalityPair.targetInputHash)) {
      issues.push("modality target input hash invalid");
    }
    if (!modalityPair.toolSchemaHash || !isSha256(modalityPair.toolSchemaHash)) {
      issues.push("modality tool schema hash invalid");
    }
    if (!modalityPair.goldLabelHash || !isSha256(modalityPair.goldLabelHash)) {
      issues.push("modality gold label hash invalid");
    }
    if (!modalityPair.transformConfigHash || !isSha256(modalityPair.transformConfigHash)) {
      issues.push("modality transform config hash invalid");
    }
    if (modalityPair.speakerProfileHash && !isSha256(modalityPair.speakerProfileHash)) {
      issues.push("modality speaker profile hash invalid");
    }
    if (modalityPair.noiseProfileHash && !isSha256(modalityPair.noiseProfileHash)) {
      issues.push("modality noise profile hash invalid");
    }
    if (modalityPair.judgeValidationHash && !isSha256(modalityPair.judgeValidationHash)) {
      issues.push("modality judge validation hash invalid");
    }
    if (modalityPair.sourceScore0to1 === null) {
      issues.push("modality source score missing");
    }
    if (modalityPair.targetScore0to1 === null) {
      issues.push("modality target score missing");
    }
  }
  if (interactiveEpisode) {
    if (!interactiveEpisode.episodeId) {
      issues.push("interactive episode id missing");
    }
    if (!interactiveEpisode.environmentId) {
      issues.push("interactive environment id missing");
    }
    if (!interactiveEpisode.randomizationConfigHash || !isSha256(interactiveEpisode.randomizationConfigHash)) {
      issues.push("interactive randomization config hash invalid");
    }
    if (!interactiveEpisode.observationTraceHash || !isSha256(interactiveEpisode.observationTraceHash)) {
      issues.push("interactive observation trace hash invalid");
    }
    if (!interactiveEpisode.instructionTraceHash || !isSha256(interactiveEpisode.instructionTraceHash)) {
      issues.push("interactive instruction trace hash invalid");
    }
    if (!interactiveEpisode.feedbackTraceHash || !isSha256(interactiveEpisode.feedbackTraceHash)) {
      issues.push("interactive feedback trace hash invalid");
    }
    if (!interactiveEpisode.actionTraceHash || !isSha256(interactiveEpisode.actionTraceHash)) {
      issues.push("interactive action trace hash invalid");
    }
    if (!interactiveEpisode.rewardTraceHash || !isSha256(interactiveEpisode.rewardTraceHash)) {
      issues.push("interactive reward trace hash invalid");
    }
    if (!interactiveEpisode.terminationTraceHash || !isSha256(interactiveEpisode.terminationTraceHash)) {
      issues.push("interactive termination trace hash invalid");
    }
    if (!interactiveEpisode.feedbackMode) {
      issues.push("interactive feedback mode missing");
    }
    if (interactiveEpisode.rewardHiddenFromAgent === null) {
      issues.push("interactive reward hidden flag missing");
    } else if (!interactiveEpisode.rewardHiddenFromAgent) {
      issues.push("interactive reward exposed to agent");
    }
    if (interactiveEpisode.maxSteps === null) {
      issues.push("interactive max steps missing");
    }
    if (interactiveEpisode.stepsTaken === null) {
      issues.push("interactive steps taken missing");
    }
    if (
      interactiveEpisode.maxSteps !== null
      && interactiveEpisode.stepsTaken !== null
      && interactiveEpisode.stepsTaken > interactiveEpisode.maxSteps
    ) {
      issues.push("interactive steps exceed max steps");
    }
    if (interactiveEpisode.terminated === null || interactiveEpisode.truncated === null) {
      issues.push("interactive termination state missing");
    }
  }
  if (videoPostProduction) {
    if (!videoPostProduction.benchmarkId) {
      issues.push("video post-production benchmark id missing");
    }
    if (!videoPostProduction.taskFamily) {
      issues.push("video post-production task family missing");
    }
    if (!videoPostProduction.taskId) {
      issues.push("video post-production task id missing");
    }
    for (const [label, hash] of [
      ["task instruction", videoPostProduction.taskInstructionHash],
      ["source media manifest", videoPostProduction.sourceMediaManifestHash],
      ["candidate media manifest", videoPostProduction.candidateMediaManifestHash],
      ["expected output spec", videoPostProduction.expectedOutputSpecHash],
      ["verifier design", videoPostProduction.verifierDesignHash],
      ["verifier reward json", videoPostProduction.verifierRewardJsonHash],
      ["verifier metric breakdown", videoPostProduction.verifierMetricBreakdownHash],
      ["agent trajectory", videoPostProduction.agentTrajectoryHash],
      ["harbor result", videoPostProduction.harborResultHash],
      ["trial log", videoPostProduction.trialLogHash],
      ["sandbox image", videoPostProduction.sandboxImageHash],
    ] as const) {
      if (!hash || !isSha256(hash)) {
        issues.push(`video post-production ${label} hash invalid`);
      }
    }
    for (const [label, hash] of [
      ["oracle solver", videoPostProduction.oracleSolverHash],
      ["baseline solver", videoPostProduction.baselineSolverHash],
      ["leaderboard submission", videoPostProduction.leaderboardSubmissionHash],
      ["human expert review", videoPostProduction.humanExpertReviewHash],
    ] as const) {
      if (hash && !isSha256(hash)) {
        issues.push(`video post-production ${label} hash invalid`);
      }
    }
    if (!videoPostProduction.executor) {
      issues.push("video post-production executor missing");
    }
    if (!videoPostProduction.judgeMode) {
      issues.push("video post-production judge mode missing");
    }
    if (videoPostProduction.deterministicVerifier === null) {
      issues.push("video post-production deterministic verifier flag missing");
    } else if (videoPostProduction.judgeMode === "deterministic" && !videoPostProduction.deterministicVerifier) {
      issues.push("video post-production deterministic judge missing deterministic verifier");
    }
    if (
      videoPostProduction.judgeMode === "deterministic"
      && (!videoPostProduction.oracleSolverHash || !videoPostProduction.baselineSolverHash)
    ) {
      issues.push("video post-production oracle/baseline solver proof missing");
    }
    if (
      (videoPostProduction.judgeMode === "rubric_llm" || videoPostProduction.judgeMode === "hybrid")
      && videoPostProduction.rubricJudgeCount === null
    ) {
      issues.push("video post-production rubric judge count missing");
    }
    if (videoPostProduction.taskCount === null) {
      issues.push("video post-production task count missing");
    }
    if (videoPostProduction.mediaClipCount === null) {
      issues.push("video post-production media clip count missing");
    }
    if (videoPostProduction.reward0to1 === null) {
      issues.push("video post-production reward missing");
    }
    if (
      videoPostProduction.reward0to1 !== null
      && videoPostProduction.minReward0to1 !== null
      && videoPostProduction.reward0to1 < videoPostProduction.minReward0to1
    ) {
      issues.push("video post-production reward below threshold");
    }
  }
  if (pawBenchEvaluation) {
    if (!pawBenchEvaluation.benchmarkId) {
      issues.push("pawbench benchmark id missing");
    }
    if (!pawBenchEvaluation.benchmarkVersion) {
      issues.push("pawbench benchmark version missing");
    }
    if (!pawBenchEvaluation.taskId) {
      issues.push("pawbench task id missing");
    }
    if (!pawBenchEvaluation.taskSource) {
      issues.push("pawbench task source missing");
    }
    if (!pawBenchEvaluation.scenario) {
      issues.push("pawbench scenario missing");
    }
    if (!pawBenchEvaluation.capability) {
      issues.push("pawbench capability missing");
    }
    if (!pawBenchEvaluation.complexity) {
      issues.push("pawbench complexity missing");
    }
    if (!pawBenchEvaluation.modality) {
      issues.push("pawbench modality missing");
    }
    if (!pawBenchEvaluation.environment) {
      issues.push("pawbench environment missing");
    }
    if (!pawBenchEvaluation.gradingMode) {
      issues.push("pawbench grading mode missing");
