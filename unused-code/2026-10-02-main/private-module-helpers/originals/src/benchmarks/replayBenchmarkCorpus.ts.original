    "agent benchmark replay agentkernelarena replay pass rate below threshold",
    "agent benchmark replay agentkernelarena result coverage below threshold",
    "agent benchmark replay agentkernelarena workspace isolation disabled",
    "agent benchmark replay agentkernelarena leaderboard-only boundary missing",
  ].includes(issue);
}

function appendAgentKernelArenaCountIssue(
  issues: string[],
  label: string,
  count: number,
  minimum: number | null,
): void {
  if (count === 0) {
    issues.push(`agent benchmark replay agentkernelarena ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay agentkernelarena ${label} threshold missing`);
  }
  if (minimum !== null && count < minimum) {
    issues.push(`agent benchmark replay agentkernelarena ${label} below threshold`);
  }
}

function appendAgentKernelArenaMinimumIssue(
  issues: string[],
