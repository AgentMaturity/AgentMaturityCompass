function isAdGenSocDatasetFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("adgen soc dataset "));
}

function buildAdGenSocDatasetSummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkAdGenSocDatasetSummary {
  const adGenRows = rows.filter((row) => row.adGenSocDataset);
  const unknownTacticRates = adGenRows
    .map((row) => row.adGenSocDataset?.unknownTacticRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const unknownTechniqueRates = adGenRows
    .map((row) => row.adGenSocDataset?.unknownTechniqueRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: adGenRows.length,
    benchmarkIds: unique(
      adGenRows
        .map((row) => row.adGenSocDataset?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    environments: unique(
      adGenRows
        .map((row) => row.adGenSocDataset?.environment ?? "")
        .filter((value): value is ReplayBenchmarkAdGenEnvironment => (
          adGenEnvironments.includes(value as ReplayBenchmarkAdGenEnvironment)
        )),
    ) as ReplayBenchmarkAdGenEnvironment[],
    labelSources: unique(
      adGenRows
        .map((row) => row.adGenSocDataset?.labelSource ?? "")
        .filter((value): value is ReplayBenchmarkAdGenLabelSource => (
          adGenLabelSources.includes(value as ReplayBenchmarkAdGenLabelSource)
        )),
    ) as ReplayBenchmarkAdGenLabelSource[],
    failedRowIds: adGenRows.filter(isAdGenSocDatasetFailure).map((row) => row.rowId),
    totalRawEventCount: adGenRows.reduce((sum, row) => sum + (row.adGenSocDataset?.rawEventCount ?? 0), 0),
    totalValidatedRecordCount: adGenRows.reduce(
      (sum, row) => sum + (row.adGenSocDataset?.validatedRecordCount ?? 0),
      0,
    ),
    totalSupportedActionCount: adGenRows.reduce(
      (sum, row) => sum + (row.adGenSocDataset?.supportedActionCount ?? 0),
      0,
    ),
    averageSchemaValidity0to1: averageNullable(
      adGenRows.map((row) => row.adGenSocDataset?.schemaValidity0to1 ?? null),
    ),
    averageVerdictConsistency0to1: averageNullable(
      adGenRows.map((row) => row.adGenSocDataset?.verdictConsistency0to1 ?? null),
    ),
    maxUnknownTacticRate0to1: unknownTacticRates.length === 0 ? null : Math.max(...unknownTacticRates),
    maxUnknownTechniqueRate0to1: unknownTechniqueRates.length === 0 ? null : Math.max(...unknownTechniqueRates),
    averageReplayPassRate0to1: averageNullable(
      adGenRows.map((row) => row.adGenSocDataset?.replayPassRate0to1 ?? null),
    ),
    averageScoreDelta0to1: averageNullable(
      adGenRows.map((row) => row.adGenSocDataset?.scoreDelta0to1 ?? null),
    ),
  };
}

