    ["metrics report", replay.costNavMetricsReportHash],
    ["replay command", replay.costNavReplayCommandHash],
    ["ci receipt", replay.costNavCiReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`agent benchmark replay costnav ${label} hash invalid`);
    }
  }
  if (replay.costNavRouteTypes.length === 0) {
    issues.push("agent benchmark replay costnav route types missing");
  }
  if (replay.minCostNavRouteTypeCount === null) {
    issues.push("agent benchmark replay costnav route type count threshold missing");
  }
  if (
    replay.minCostNavRouteTypeCount !== null
    && replay.costNavRouteTypes.length < replay.minCostNavRouteTypeCount
  ) {
    issues.push("agent benchmark replay costnav route type count below threshold");
  }
  appendCostNavMinimumIssue(issues, "scenario count", replay.costNavScenarioCount, replay.minCostNavScenarioCount);
  if (replay.costNavDeterministicSeed === null) {
    issues.push("agent benchmark replay costnav deterministic seed missing");
  }
  if (replay.costNavBaselineEconomicCost === null) {
    issues.push("agent benchmark replay costnav baseline economic cost missing");
  }
  if (replay.costNavCandidateEconomicCost === null) {
    issues.push("agent benchmark replay costnav candidate economic cost missing");
  }
  if (replay.costNavEconomicCostDelta === null) {
    issues.push("agent benchmark replay costnav economic cost delta missing");
  }
  if (replay.maxCostNavEconomicCostIncrease === null) {
    issues.push("agent benchmark replay costnav economic cost increase threshold missing");
  }
  if (
    replay.costNavEconomicCostDelta !== null
    && replay.maxCostNavEconomicCostIncrease !== null
    && replay.costNavEconomicCostDelta > replay.maxCostNavEconomicCostIncrease
  ) {
    issues.push("agent benchmark replay costnav economic cost increase exceeds threshold");
  }
  appendCostNavMinimumIssue(
    issues,
    "navigation success rate",
    replay.costNavNavigationSuccessRate0to1,
    replay.minCostNavNavigationSuccessRate0to1,
  );
  appendCostNavMinimumIssue(
    issues,
    "replay pass rate",
    replay.costNavReplayPassRate0to1,
    replay.minCostNavReplayPassRate0to1,
  );
  if (replay.costNavScoreDelta0to1 === null) {
    issues.push("agent benchmark replay costnav score delta missing");
  }
  if (replay.maxCostNavScoreRegression0to1 === null) {
    issues.push("agent benchmark replay costnav score regression threshold missing");
  }
  if (
    replay.costNavScoreDelta0to1 !== null
    && replay.maxCostNavScoreRegression0to1 !== null
    && replay.costNavScoreDelta0to1 < -replay.maxCostNavScoreRegression0to1
  ) {
    issues.push("agent benchmark replay costnav score regression exceeds threshold");
  }
}

