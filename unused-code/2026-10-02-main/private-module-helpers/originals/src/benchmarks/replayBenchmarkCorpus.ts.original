function isNucliaRagTriadRegressionIssue(issue: string): boolean {
  return [
    "agent benchmark replay nuclia rag triad query count below threshold",
    "agent benchmark replay nuclia rag triad context piece count below threshold",
    "agent benchmark replay nuclia rag triad metric count below threshold",
    "agent benchmark replay nuclia rag triad answer relevance below threshold",
    "agent benchmark replay nuclia rag triad context relevance below threshold",
    "agent benchmark replay nuclia rag triad groundedness below threshold",
    "agent benchmark replay nuclia rag triad composite regression exceeds threshold",
    "agent benchmark replay nuclia rag triad replay pass rate below threshold",
  ].includes(issue);
}

function appendNucliaRagTriadMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`agent benchmark replay nuclia rag triad ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay nuclia rag triad ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`agent benchmark replay nuclia rag triad ${label} below threshold`);
  }
}

function appendNucliaRagTriadIssues(
  issues: string[],
  replay: ReplayBenchmarkAgentBenchmarkReplayReceipt,
): void {
  if (!hasNucliaRagTriadSignal(replay)) {
    return;
  }
  if (!replay.nucliaRagTriadBenchmarkId) {
    issues.push("agent benchmark replay nuclia rag triad benchmark id missing");
  }
  for (const [label, hash] of [
    ["source ref", replay.nucliaRagTriadSourceRefHash],
    ["repository snapshot", replay.nucliaRagTriadRepositorySnapshotHash],
    ["license ref", replay.nucliaRagTriadLicenseRefHash],
    ["package version", replay.nucliaRagTriadPackageVersionHash],
    ["model card ref", replay.nucliaRagTriadModelCardRefHash],
    ["model cache policy", replay.nucliaRagTriadModelCachePolicyHash],
    ["hf auth boundary", replay.nucliaRagTriadHfAuthBoundaryHash],
    ["evaluator config", replay.nucliaRagTriadEvaluatorConfigHash],
    ["dataset manifest", replay.nucliaRagTriadDatasetManifestHash],
    ["qa context manifest", replay.nucliaRagTriadQaContextManifestHash],
    ["metric manifest", replay.nucliaRagTriadMetricManifestHash],
    ["answer relevance trace", replay.nucliaRagTriadAnswerRelevanceTraceHash],
    ["context relevance trace", replay.nucliaRagTriadContextRelevanceTraceHash],
    ["groundedness trace", replay.nucliaRagTriadGroundednessTraceHash],
    ["result manifest", replay.nucliaRagTriadResultManifestHash],
    ["replay command", replay.nucliaRagTriadReplayCommandHash],
    ["ci receipt", replay.nucliaRagTriadCiReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`agent benchmark replay nuclia rag triad ${label} hash invalid`);
    }
  }
  appendNucliaRagTriadMinimumIssue(
    issues,
    "query count",
    replay.nucliaRagTriadQueryCount,
    replay.minNucliaRagTriadQueryCount,
  );
  appendNucliaRagTriadMinimumIssue(
    issues,
    "context piece count",
    replay.nucliaRagTriadContextPieceCount,
    replay.minNucliaRagTriadContextPieceCount,
  );
  appendNucliaRagTriadMinimumIssue(
    issues,
    "metric count",
    replay.nucliaRagTriadMetricCount,
    replay.minNucliaRagTriadMetricCount,
  );
  if (replay.nucliaRagTriadDeterministicSeed === null) {
    issues.push("agent benchmark replay nuclia rag triad deterministic seed missing");
  }
  if (replay.nucliaRagTriadBaselineAnswerRelevance0to1 === null) {
    issues.push("agent benchmark replay nuclia rag triad baseline answer relevance missing");
  }
  appendNucliaRagTriadMinimumIssue(
    issues,
    "answer relevance",
    replay.nucliaRagTriadCandidateAnswerRelevance0to1,
    replay.minNucliaRagTriadAnswerRelevance0to1,
  );
  if (replay.nucliaRagTriadBaselineContextRelevance0to1 === null) {
    issues.push("agent benchmark replay nuclia rag triad baseline context relevance missing");
  }
  appendNucliaRagTriadMinimumIssue(
    issues,
    "context relevance",
    replay.nucliaRagTriadCandidateContextRelevance0to1,
    replay.minNucliaRagTriadContextRelevance0to1,
  );
  if (replay.nucliaRagTriadBaselineGroundedness0to1 === null) {
    issues.push("agent benchmark replay nuclia rag triad baseline groundedness missing");
  }
  appendNucliaRagTriadMinimumIssue(
    issues,
    "groundedness",
    replay.nucliaRagTriadCandidateGroundedness0to1,
    replay.minNucliaRagTriadGroundedness0to1,
  );
  if (replay.nucliaRagTriadBaselineComposite0to1 === null) {
    issues.push("agent benchmark replay nuclia rag triad baseline composite missing");
  }
  if (replay.nucliaRagTriadCandidateComposite0to1 === null) {
    issues.push("agent benchmark replay nuclia rag triad candidate composite missing");
  }
  if (replay.nucliaRagTriadCompositeDelta0to1 === null) {
    issues.push("agent benchmark replay nuclia rag triad composite delta missing");
  }
  if (replay.maxNucliaRagTriadCompositeRegression0to1 === null) {
    issues.push("agent benchmark replay nuclia rag triad composite regression threshold missing");
  }
  if (
    replay.nucliaRagTriadCompositeDelta0to1 !== null
    && replay.maxNucliaRagTriadCompositeRegression0to1 !== null
    && replay.nucliaRagTriadCompositeDelta0to1 < -replay.maxNucliaRagTriadCompositeRegression0to1
  ) {
    issues.push("agent benchmark replay nuclia rag triad composite regression exceeds threshold");
  }
  appendNucliaRagTriadMinimumIssue(
    issues,
    "replay pass rate",
    replay.nucliaRagTriadReplayPassRate0to1,
    replay.minNucliaRagTriadReplayPassRate0to1,
  );
  if (replay.nucliaRagTriadModelAccessBoundary !== true) {
    issues.push("agent benchmark replay nuclia rag triad model access boundary missing");
  }
  if (replay.nucliaRagTriadNoRawContextCopyBoundary !== true) {
    issues.push("agent benchmark replay nuclia rag triad no raw context copy boundary missing");
  }
}

function hasEdgeAiAgentSignal(replay: ReplayBenchmarkAgentBenchmarkReplayReceipt): boolean {
  return [
    replay.edgeAiBenchmarkId,
    replay.edgeAiSourceRefHash,
    replay.edgeAiRepositorySnapshotHash,
    replay.edgeAiLicenseRefHash,
    replay.edgeAiDeviceProfileHash,
    replay.edgeAiRuntimeManifestHash,
    replay.edgeAiOptimizationManifestHash,
    replay.edgeAiBenchmarkDatasetHash,
    replay.edgeAiTaskManifestHash,
    replay.edgeAiAppScenarioHash,
    replay.edgeAiReplayCommandHash,
    replay.edgeAiMetricsReportHash,
  ].some((value) => value !== null)
    || replay.edgeAiDeviceClasses.length > 0
    || replay.edgeAiModalities.length > 0
    || replay.edgeAiRuntimeKinds.length > 0
    || [
      replay.minEdgeAiDeviceClassCount,
      replay.minEdgeAiModalityCount,
      replay.minEdgeAiRuntimeKindCount,
      replay.edgeAiOnDeviceOnly,
      replay.edgeAiOfflineCapable,
      replay.edgeAiPrivacyBoundaryPreserved,
      replay.edgeAiLatencyMsP95,
      replay.maxEdgeAiLatencyMsP95,
      replay.edgeAiMemoryMbP95,
      replay.maxEdgeAiMemoryMbP95,
      replay.edgeAiEnergyJoulesPerTask,
      replay.maxEdgeAiEnergyJoulesPerTask,
      replay.edgeAiAccuracy0to1,
      replay.minEdgeAiAccuracy0to1,
      replay.edgeAiReplayPassRate0to1,
      replay.minEdgeAiReplayPassRate0to1,
      replay.edgeAiScoreDelta0to1,
      replay.minEdgeAiScoreDelta0to1,
    ].some((value) => value !== null);
}

function appendEdgeAiCountIssue(
  issues: string[],
  label: string,
  count: number,
  minimum: number | null,
): void {
  if (count === 0) {
    issues.push(`agent benchmark replay edgeai ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay edgeai ${label} threshold missing`);
  }
  if (minimum !== null && count < minimum) {
    issues.push(`agent benchmark replay edgeai ${label} below threshold`);
  }
}

function appendEdgeAiMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`agent benchmark replay edgeai ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`agent benchmark replay edgeai ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`agent benchmark replay edgeai ${label} below threshold`);
  }
}

function appendEdgeAiMaximumIssue(
  issues: string[],
  label: string,
  value: number | null,
  maximum: number | null,
): void {
  if (value === null) {
    issues.push(`agent benchmark replay edgeai ${label} missing`);
  }
  if (maximum === null) {
    issues.push(`agent benchmark replay edgeai ${label} threshold missing`);
  }
  if (value !== null && maximum !== null && value > maximum) {
    issues.push(`agent benchmark replay edgeai ${label} above threshold`);
  }
}

function isAgentBenchmarkReplayFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("agent benchmark replay "));
}

function buildAgentBenchmarkReplaySummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkAgentBenchmarkReplaySummary {
  const replayRows = rows.filter((row) => row.agentBenchmarkReplay);
  const aiAgentBenchmarkComparisonRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasAiAgentBenchmarkComparisonSignal(row.agentBenchmarkReplay) : false
  ));
  const gaiaAgentRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasGaiaAgentReplaySignal(row.agentBenchmarkReplay) : false
  ));
  const paperArenaRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasPaperArenaReplaySignal(row.agentBenchmarkReplay) : false
  ));
  const socialReasoningBenchRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasSocialReasoningBenchSignal(row.agentBenchmarkReplay) : false
  ));
  const bestTesterRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasBestTesterSignal(row.agentBenchmarkReplay) : false
  ));
  const agentKernelArenaRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasAgentKernelArenaSignal(row.agentBenchmarkReplay) : false
  ));
  const llmEvaluationSystemRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasLlmEvaluationSystemSignal(row.agentBenchmarkReplay) : false
  ));
  const innovatorBenchRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasInnovatorBenchSignal(row.agentBenchmarkReplay) : false
  ));
  const gtoWizardPokerReplayRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasGtoWizardPokerReplaySignal(row.agentBenchmarkReplay) : false
  ));
  const costNavRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasCostNavReplaySignal(row.agentBenchmarkReplay) : false
  ));
  const researchHarnessRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasResearchHarnessSignal(row.agentBenchmarkReplay) : false
  ));
  const agentMontRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasAgentMontSignal(row.agentBenchmarkReplay) : false
  ));
  const miniAppBenchRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasMiniAppBenchSignal(row.agentBenchmarkReplay) : false
  ));
  const knowlyticsAiRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasKnowlyticsAiSignal(row.agentBenchmarkReplay) : false
  ));
  const spentSessionCostRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasSpentSessionCostSignal(row.agentBenchmarkReplay) : false
  ));
  const fireFactCheckingRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasFireFactCheckingSignal(row.agentBenchmarkReplay) : false
  ));
  const nucliaRagTriadRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasNucliaRagTriadSignal(row.agentBenchmarkReplay) : false
  ));
  const edgeAiAgentRows = replayRows.filter((row) => (
    row.agentBenchmarkReplay ? hasEdgeAiAgentSignal(row.agentBenchmarkReplay) : false
  ));
  const baselineMetrics = replayRows
    .map((row) => row.agentBenchmarkReplay?.baselineMetric0to1 ?? null)
    .filter((value): value is number => value !== null);
  const candidateMetrics = replayRows
    .map((row) => row.agentBenchmarkReplay?.candidateMetric0to1 ?? null)
    .filter((value): value is number => value !== null);
  const scoreDeltas = replayRows
    .map((row) => row.agentBenchmarkReplay?.scoreDelta0to1 ?? null)
    .filter((value): value is number => value !== null);
  const replayPassRates = replayRows
    .map((row) => row.agentBenchmarkReplay?.replayPassRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const traceCoverages = replayRows
    .map((row) => row.agentBenchmarkReplay?.traceCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: replayRows.length,
    benchmarkIds: unique(
      replayRows
        .map((row) => row.agentBenchmarkReplay?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    architectures: unique(
      replayRows
        .map((row) => row.agentBenchmarkReplay?.architecture ?? "")
        .filter((value): value is ReplayBenchmarkAgentBenchmarkArchitecture => (
          agentBenchmarkArchitectures.includes(value as ReplayBenchmarkAgentBenchmarkArchitecture)
        )),
    ) as ReplayBenchmarkAgentBenchmarkArchitecture[],
    workloads: unique(
      replayRows
        .map((row) => row.agentBenchmarkReplay?.workload ?? "")
        .filter((value): value is ReplayBenchmarkAgentBenchmarkWorkload => (
          agentBenchmarkWorkloads.includes(value as ReplayBenchmarkAgentBenchmarkWorkload)
        )),
    ) as ReplayBenchmarkAgentBenchmarkWorkload[],
    aiAgentBenchmarkComparisonRowCount: aiAgentBenchmarkComparisonRows.length,
    aiAgentBenchmarkFamilies: unique(
      aiAgentBenchmarkComparisonRows.flatMap((row) => row.agentBenchmarkReplay?.aiAgentBenchmarkFamilies ?? []),
