    || rag.ragEvalDatasetId
    || rag.ragEvalDatasetDataFormats.length > 0
    || rag.ragEvalDatasetEndpointModes.length > 0
    || rag.ragEvalDatasetMetricIds.length > 0
    || [
      rag.ragEvalDatasetQuestionCount,
      rag.ragEvalDatasetMinQuestionCount,
      rag.ragEvalDatasetEndpointCount,
      rag.ragEvalDatasetMinEndpointCount,
      rag.ragEvalDatasetDeterministicSeed,
      rag.ragEvalDatasetBaselineScore0to1,
