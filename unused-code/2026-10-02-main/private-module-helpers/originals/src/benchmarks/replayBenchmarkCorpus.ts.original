    encourageInferenceBackend: normalizeEncourageInferenceBackend(rag.encourageInferenceBackend),
    encourageVectorDb: normalizeEncourageVectorDb(rag.encourageVectorDb),
    encourageMetricIds: unique((rag.encourageMetricIds ?? [])
      .map((metricId) => normalizeLabel(metricId))
      .filter((metricId): metricId is string => Boolean(metricId))),
    encourageDocumentCount: positiveInteger(rag.encourageDocumentCount),
    encourageMinDocumentCount: positiveInteger(rag.encourageMinDocumentCount),
    encourageQuestionCount: positiveInteger(rag.encourageQuestionCount),
    encourageMinQuestionCount: positiveInteger(rag.encourageMinQuestionCount),
    encourageDeterministicSeed: nonNegativeInteger(rag.encourageDeterministicSeed),
    encourageBaselineScore0to1,
    encourageCandidateScore0to1,
    encourageScoreDelta0to1: explicitEncourageScoreDelta0to1 ?? (
      encourageBaselineScore0to1 === null || encourageCandidateScore0to1 === null
        ? null
        : round(encourageCandidateScore0to1 - encourageBaselineScore0to1)
    ),
    encourageMaxScoreRegression0to1: nullableRate(rag.encourageMaxScoreRegression0to1),
    encourageReplayPassRate0to1: nullableRate(rag.encourageReplayPassRate0to1),
    encourageMinReplayPassRate0to1: nullableRate(rag.encourageMinReplayPassRate0to1),
    encourageMetricCoverage0to1: nullableRate(rag.encourageMetricCoverage0to1),
    encourageMinMetricCoverage0to1: nullableRate(rag.encourageMinMetricCoverage0to1),
    encourageMlflowLogged: typeof rag.encourageMlflowLogged === "boolean" ? rag.encourageMlflowLogged : null,
  };
}

function hasIndustrialRagSignal(rag: ReplayBenchmarkRagEvaluationReceipt): boolean {
  return Boolean(
    rag.ragModalityMode
    || rag.vectorStoreMode
    || rag.textCorpusHash
    || rag.imageCorpusHash
    || rag.pdfExtractionTraceHash
    || rag.imageExtractionTraceHash
    || rag.imageSummaryHash
    || rag.textVectorStoreHash
    || rag.imageVectorStoreHash
    || rag.combinedVectorStoreHash
    || rag.multimodalEmbeddingConfigHash
    || rag.baselineRunHash
    || rag.correctContextRunHash
    || rag.judgeModelId
    || rag.judgeRubricHash
    || rag.answerCorrectness0to1 !== null
    || rag.answerRelevancy0to1 !== null
    || rag.textContextRelevancy0to1 !== null
    || rag.imageContextRelevancy0to1 !== null
    || rag.textFaithfulness0to1 !== null
    || rag.imageFaithfulness0to1 !== null
    || rag.modalityCoverage0to1 !== null,
  );
}

function hasRagEvalFlowSignal(rag: ReplayBenchmarkRagEvaluationReceipt): boolean {
  return Boolean(
    rag.ragEvalFlowSourceRefHash
    || rag.ragEvalFlowRepositorySnapshotHash
    || rag.ragEvalFlowLicenseRefHash
    || rag.ragEvalFlowPipelineConfigHash
    || rag.ragEvalFlowDataSourceManifestHash
    || rag.ragEvalFlowModelConfigHash
    || rag.ragEvalFlowJudgeConfigHash
    || rag.ragEvalFlowMetricDefinitionHash
    || rag.ragEvalFlowPromptTemplateHash
    || rag.ragEvalFlowEvalPackManifestHash
    || rag.ragEvalFlowFixtureHash
    || rag.ragEvalFlowReplayCommandHash
    || rag.ragEvalFlowResultManifestHash
    || rag.ragEvalFlowScoreDeltaReportHash
    || rag.ragEvalFlowCiReceiptHash
    || rag.ragEvalFlowPipelineId
    || rag.ragEvalFlowDataFormat
    || rag.ragEvalFlowModelBackend
    || rag.ragEvalFlowJudgeBackend
    || rag.ragEvalFlowMetricIds.length > 0
    || [
      rag.ragEvalFlowSampleSize,
      rag.ragEvalFlowMinSampleSize,
      rag.ragEvalFlowDeterministicSeed,
      rag.ragEvalFlowBaselineScore0to1,
      rag.ragEvalFlowCandidateScore0to1,
      rag.ragEvalFlowScoreDelta0to1,
      rag.ragEvalFlowMaxScoreRegression0to1,
      rag.ragEvalFlowReplayPassRate0to1,
      rag.ragEvalFlowMinReplayPassRate0to1,
      rag.ragEvalFlowMetricCoverage0to1,
      rag.ragEvalFlowMinMetricCoverage0to1,
    ].some((value) => value !== null),
  );
}

function hasRagEvalDatasetReplaySignal(rag: ReplayBenchmarkRagEvaluationReceipt): boolean {
  return Boolean(
    rag.ragEvalDatasetSourceRefHash
    || rag.ragEvalDatasetRepositorySnapshotHash
    || rag.ragEvalDatasetLicenseRefHash
    || rag.ragEvalDatasetInputDocumentManifestHash
