function isText2SqlAgentFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("text2sql agent "));
}

function buildText2SqlAgentSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkText2SqlAgentSummary {
  const text2SqlRows = rows.filter((row) => row.text2SqlAgent);
  const executionScores = text2SqlRows
    .map((row) => row.text2SqlAgent?.executionAccuracy0to1 ?? null)
    .filter((value): value is number => value !== null);
  const exactMatchScores = text2SqlRows
    .map((row) => row.text2SqlAgent?.exactMatch0to1 ?? null)
    .filter((value): value is number => value !== null);
  const retrievalScores = text2SqlRows
    .map((row) => row.text2SqlAgent?.retrievalGrounding0to1 ?? null)
    .filter((value): value is number => value !== null);
  const unsafeRates = text2SqlRows
    .map((row) => row.text2SqlAgent?.unsafeSqlRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  const rlsRates = text2SqlRows
    .map((row) => row.text2SqlAgent?.rlsViolationRate0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: text2SqlRows.length,
    benchmarkIds: unique(
      text2SqlRows
        .map((row) => row.text2SqlAgent?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    databaseEngines: unique(
      text2SqlRows
        .map((row) => row.text2SqlAgent?.databaseEngine ?? "")
        .filter((value): value is ReplayBenchmarkText2SqlDatabaseEngine => (
          text2SqlDatabaseEngines.includes(value as ReplayBenchmarkText2SqlDatabaseEngine)
        )),
    ) as ReplayBenchmarkText2SqlDatabaseEngine[],
    schemaRetrievalModes: unique(
      text2SqlRows
        .map((row) => row.text2SqlAgent?.schemaRetrievalMode ?? "")
        .filter((value): value is ReplayBenchmarkText2SqlSchemaRetrievalMode => (
          text2SqlSchemaRetrievalModes.includes(value as ReplayBenchmarkText2SqlSchemaRetrievalMode)
        )),
    ) as ReplayBenchmarkText2SqlSchemaRetrievalMode[],
    failedRowIds: text2SqlRows.filter(isText2SqlAgentFailure).map((row) => row.rowId),
    totalQueryCount: text2SqlRows.reduce((sum, row) => sum + (row.text2SqlAgent?.queryCount ?? 0), 0),
    averageExecutionAccuracy0to1: executionScores.length === 0
      ? null
      : round(executionScores.reduce((sum, value) => sum + value, 0) / executionScores.length),
    averageExactMatch0to1: exactMatchScores.length === 0
      ? null
      : round(exactMatchScores.reduce((sum, value) => sum + value, 0) / exactMatchScores.length),
    averageRetrievalGrounding0to1: retrievalScores.length === 0
      ? null
      : round(retrievalScores.reduce((sum, value) => sum + value, 0) / retrievalScores.length),
    maxUnsafeSqlRate0to1: unsafeRates.length === 0 ? null : Math.max(...unsafeRates),
    maxRlsViolationRate0to1: rlsRates.length === 0 ? null : Math.max(...rlsRates),
  };
}

