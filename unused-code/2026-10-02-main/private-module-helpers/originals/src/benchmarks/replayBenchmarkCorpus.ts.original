    bioMedArenaBenchmarkCoverage0to1: nullableRate(evaluation.bioMedArenaBenchmarkCoverage0to1),
    minBioMedArenaBenchmarkCoverage0to1: nullableRate(evaluation.minBioMedArenaBenchmarkCoverage0to1),
    bioMedArenaToolSandboxVerified: typeof evaluation.bioMedArenaToolSandboxVerified === "boolean"
      ? evaluation.bioMedArenaToolSandboxVerified
      : null,
  };
}

function buildEnterpriseToolCallingReceipt(
  row: ReplayBenchmarkCorpusRowInput,
): ReplayBenchmarkEnterpriseToolCallingReceipt | undefined {
  const enterprise = row.fixture.enterpriseToolCalling;
  if (!enterprise) return undefined;
  return {
    benchmarkId: normalizeLabel(enterprise.benchmarkId),
    benchmarkVersion: normalizeLabel(enterprise.benchmarkVersion),
    capability: normalizeEnterpriseToolCapability(enterprise.capability),
    sourceMode: normalizeEnterpriseToolSourceMode(enterprise.sourceMode),
    domainId: normalizeLabel(enterprise.domainId),
    capabilityDomainHash: normalizeHashLabel(enterprise.capabilityDomainHash),
    inputDatasetHash: normalizeHashLabel(enterprise.inputDatasetHash),
    expectedOutputHash: normalizeHashLabel(enterprise.expectedOutputHash),
    localApiManifestHash: normalizeHashLabel(enterprise.localApiManifestHash),
    databaseSnapshotHash: normalizeHashLabel(enterprise.databaseSnapshotHash),
    documentCollectionHash: normalizeHashLabel(enterprise.documentCollectionHash),
    mcpServerConfigHash: normalizeHashLabel(enterprise.mcpServerConfigHash),
    toolSchemaManifestHash: normalizeHashLabel(enterprise.toolSchemaManifestHash),
    policyConstraintHash: normalizeHashLabel(enterprise.policyConstraintHash),
    agentConfigHash: normalizeHashLabel(enterprise.agentConfigHash),
    trajectoryReplayHash: normalizeHashLabel(enterprise.trajectoryReplayHash),
    toolCallTraceHash: normalizeHashLabel(enterprise.toolCallTraceHash),
    toolResponseTraceHash: normalizeHashLabel(enterprise.toolResponseTraceHash),
    retrievedEvidenceTraceHash: normalizeHashLabel(enterprise.retrievedEvidenceTraceHash),
    outputValidationHash: normalizeHashLabel(enterprise.outputValidationHash),
    evaluatorConfigHash: normalizeHashLabel(enterprise.evaluatorConfigHash),
    leaderboardSubmissionHash: normalizeHashLabel(enterprise.leaderboardSubmissionHash),
    domainCount: positiveInteger(enterprise.domainCount),
    sampleCount: positiveInteger(enterprise.sampleCount),
    apiCount: positiveInteger(enterprise.apiCount),
    documentCollectionCount: nonNegativeInteger(enterprise.documentCollectionCount),
    reasoningStepCount: nonNegativeInteger(enterprise.reasoningStepCount),
    minReasoningStepCount: nonNegativeInteger(enterprise.minReasoningStepCount),
    maxReasoningStepCount: positiveInteger(enterprise.maxReasoningStepCount),
    toolCallCount: nonNegativeInteger(enterprise.toolCallCount),
    minToolCallCount: nonNegativeInteger(enterprise.minToolCallCount),
    policyAdherence0to1: nullableRate(enterprise.policyAdherence0to1),
    minPolicyAdherence0to1: nullableRate(enterprise.minPolicyAdherence0to1),
    groundedness0to1: nullableRate(enterprise.groundedness0to1),
    minGroundedness0to1: nullableRate(enterprise.minGroundedness0to1),
    exactToolResponseMatch0to1: nullableRate(enterprise.exactToolResponseMatch0to1),
    minExactToolResponseMatch0to1: nullableRate(enterprise.minExactToolResponseMatch0to1),
    finalAnswerScore0to1: nullableRate(enterprise.finalAnswerScore0to1),
    minFinalAnswerScore0to1: nullableRate(enterprise.minFinalAnswerScore0to1),
    deterministicReplay: typeof enterprise.deterministicReplay === "boolean" ? enterprise.deterministicReplay : null,
    outputValidated: typeof enterprise.outputValidated === "boolean" ? enterprise.outputValidated : null,
  };
}

function isEnterpriseToolCallingFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("enterprise tool calling "));
}

function buildEnterpriseToolCallingSummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkEnterpriseToolCallingSummary {
  const enterpriseRows = rows.filter((row) => row.enterpriseToolCalling);
  const finalScores = enterpriseRows
    .map((row) => row.enterpriseToolCalling?.finalAnswerScore0to1 ?? null)
    .filter((value): value is number => value !== null);
  const policyScores = enterpriseRows
    .map((row) => row.enterpriseToolCalling?.policyAdherence0to1 ?? null)
    .filter((value): value is number => value !== null);
  const groundednessScores = enterpriseRows
    .map((row) => row.enterpriseToolCalling?.groundedness0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: enterpriseRows.length,
    capabilities: unique(
      enterpriseRows
        .map((row) => row.enterpriseToolCalling?.capability ?? "")
        .filter((value): value is ReplayBenchmarkEnterpriseToolCapability => (
          enterpriseToolCapabilities.includes(value as ReplayBenchmarkEnterpriseToolCapability)
        )),
    ) as ReplayBenchmarkEnterpriseToolCapability[],
    sourceModes: unique(
      enterpriseRows
        .map((row) => row.enterpriseToolCalling?.sourceMode ?? "")
        .filter((value): value is ReplayBenchmarkEnterpriseToolSourceMode => (
          enterpriseToolSourceModes.includes(value as ReplayBenchmarkEnterpriseToolSourceMode)
        )),
    ) as ReplayBenchmarkEnterpriseToolSourceMode[],
    failedRowIds: enterpriseRows.filter(isEnterpriseToolCallingFailure).map((row) => row.rowId),
    totalDomainCount: enterpriseRows.reduce((sum, row) => sum + (row.enterpriseToolCalling?.domainCount ?? 0), 0),
    totalSampleCount: enterpriseRows.reduce((sum, row) => sum + (row.enterpriseToolCalling?.sampleCount ?? 0), 0),
    totalApiCount: enterpriseRows.reduce((sum, row) => sum + (row.enterpriseToolCalling?.apiCount ?? 0), 0),
    deterministicReplayRowCount: enterpriseRows.filter((row) => row.enterpriseToolCalling?.deterministicReplay === true).length,
    outputValidatedRowCount: enterpriseRows.filter((row) => row.enterpriseToolCalling?.outputValidated === true).length,
    averageFinalAnswerScore0to1: finalScores.length === 0
      ? null
      : round(finalScores.reduce((sum, value) => sum + value, 0) / finalScores.length),
    averagePolicyAdherence0to1: policyScores.length === 0
      ? null
      : round(policyScores.reduce((sum, value) => sum + value, 0) / policyScores.length),
    averageGroundedness0to1: groundednessScores.length === 0
      ? null
      : round(groundednessScores.reduce((sum, value) => sum + value, 0) / groundednessScores.length),
  };
}

function isBiomedicalAgentEvaluationFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("biomedical agent evaluation "));
}

function hasMedAskSignal(evaluation: ReplayBenchmarkBiomedicalAgentEvaluationReceipt): boolean {
  return [
    evaluation.medAskSourceRefHash,
    evaluation.medAskRepositorySnapshotHash,
    evaluation.medAskLicenseRefHash,
    evaluation.medAskRequirementsHash,
    evaluation.medAskSetupHash,
    evaluation.medAskSymptomCheckVignetteManifestHash,
    evaluation.medAskTriageVignetteManifestHash,
    evaluation.medAskSymptomCheckEvaluationScriptHash,
    evaluation.medAskTriageEvaluationScriptHash,
    evaluation.medAskPatientSimulatorConfigHash,
    evaluation.medAskDoctorModelConfigHash,
    evaluation.medAskTriageModelConfigHash,
    evaluation.medAskSymptomCheckResultManifestHash,
    evaluation.medAskTriageResultManifestHash,
    evaluation.medAskPairedAnalysisHash,
    evaluation.medAskRunCommandHash,
    evaluation.medAskReplayCommandHash,
  ].some((value) => value !== null)
    || evaluation.medAskClinicalTasks.length > 0
    || [
      evaluation.minMedAskClinicalTaskCount,
      evaluation.medAskDeterministicSeed,
      evaluation.medAskSymptomVignetteCount,
      evaluation.minMedAskSymptomVignetteCount,
      evaluation.medAskTriageVignetteCount,
      evaluation.minMedAskTriageVignetteCount,
      evaluation.medAskTop5DiagnosticAccuracy0to1,
      evaluation.minMedAskTop5DiagnosticAccuracy0to1,
      evaluation.medAskTriageAccuracy0to1,
      evaluation.minMedAskTriageAccuracy0to1,
      evaluation.medAskUrgencyClassCoverage0to1,
      evaluation.minMedAskUrgencyClassCoverage0to1,
      evaluation.medAskReplayPassRate0to1,
      evaluation.minMedAskReplayPassRate0to1,
      evaluation.medAskScoreDelta0to1,
      evaluation.maxMedAskScoreRegression0to1,
    ].some((value) => value !== null);
}

function hasBioKgBenchSignal(evaluation: ReplayBenchmarkBiomedicalAgentEvaluationReceipt): boolean {
  return [
    evaluation.bioKgBenchSourceRefHash,
    evaluation.bioKgBenchRepositorySnapshotHash,
    evaluation.bioKgBenchPaperRefHash,
    evaluation.bioKgBenchLicenseRefHash,
    evaluation.bioKgBenchDatasetReleaseHash,
    evaluation.bioKgBenchKnowledgeGraphManifestHash,
    evaluation.bioKgBenchKgBuildConfigHash,
    evaluation.bioKgBenchTaskManifestHash,
    evaluation.bioKgBenchKgCheckManifestHash,
    evaluation.bioKgBenchKgQaManifestHash,
    evaluation.bioKgBenchScvManifestHash,
    evaluation.bioKgBenchAgentConfigHash,
    evaluation.bioKgBenchRagConfigHash,
    evaluation.bioKgBenchNeo4jConfigHash,
    evaluation.bioKgBenchEvaluationScriptHash,
    evaluation.bioKgBenchResultManifestHash,
    evaluation.bioKgBenchErrorDiscoveryReportHash,
    evaluation.bioKgBenchReplayCommandHash,
    evaluation.bioKgBenchCiReceiptHash,
  ].some((value) => value !== null)
    || evaluation.bioKgBenchTaskKinds.length > 0
    || [
      evaluation.minBioKgBenchTaskKindCount,
      evaluation.bioKgBenchDeterministicSeed,
      evaluation.bioKgBenchDatasetSampleCount,
      evaluation.minBioKgBenchDatasetSampleCount,
      evaluation.bioKgBenchKgCheckAnnotatedCount,
      evaluation.minBioKgBenchKgCheckAnnotatedCount,
      evaluation.bioKgBenchKgQaTestCount,
      evaluation.minBioKgBenchKgQaTestCount,
      evaluation.bioKgBenchScvTestCount,
      evaluation.minBioKgBenchScvTestCount,
      evaluation.bioKgBenchKgCheckAccuracy0to1,
      evaluation.minBioKgBenchKgCheckAccuracy0to1,
      evaluation.bioKgBenchKgQaAccuracy0to1,
      evaluation.minBioKgBenchKgQaAccuracy0to1,
      evaluation.bioKgBenchScvAccuracy0to1,
      evaluation.minBioKgBenchScvAccuracy0to1,
      evaluation.bioKgBenchErrorDiscoveryCount,
      evaluation.minBioKgBenchErrorDiscoveryCount,
      evaluation.bioKgBenchReplayPassRate0to1,
      evaluation.minBioKgBenchReplayPassRate0to1,
      evaluation.bioKgBenchScoreDelta0to1,
      evaluation.maxBioKgBenchScoreRegression0to1,
    ].some((value) => value !== null);
}

function appendMedAskCountIssue(
  issues: string[],
  label: string,
  count: number,
  minimum: number | null,
): void {
  if (count === 0) {
    issues.push(`biomedical agent evaluation medask ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`biomedical agent evaluation medask ${label} threshold missing`);
  }
  if (minimum !== null && count < minimum) {
    issues.push(`biomedical agent evaluation medask ${label} below threshold`);
  }
}

function appendMedAskMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`biomedical agent evaluation medask ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`biomedical agent evaluation medask ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`biomedical agent evaluation medask ${label} below threshold`);
  }
}

function appendBioKgBenchCountIssue(
  issues: string[],
  label: string,
  count: number,
  minimum: number | null,
): void {
  if (count === 0) {
    issues.push(`biomedical agent evaluation biokgbench ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`biomedical agent evaluation biokgbench ${label} threshold missing`);
  }
  if (minimum !== null && count < minimum) {
    issues.push(`biomedical agent evaluation biokgbench ${label} below threshold`);
  }
}

function appendBioKgBenchMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`biomedical agent evaluation biokgbench ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`biomedical agent evaluation biokgbench ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`biomedical agent evaluation biokgbench ${label} below threshold`);
  }
}

function appendBioKgBenchIssues(
  issues: string[],
  biomedicalAgentEvaluation: ReplayBenchmarkBiomedicalAgentEvaluationReceipt,
): void {
  if (!hasBioKgBenchSignal(biomedicalAgentEvaluation)) return;
  for (const [label, hash] of [
    ["source ref", biomedicalAgentEvaluation.bioKgBenchSourceRefHash],
    ["repository snapshot", biomedicalAgentEvaluation.bioKgBenchRepositorySnapshotHash],
    ["paper ref", biomedicalAgentEvaluation.bioKgBenchPaperRefHash],
    ["license ref", biomedicalAgentEvaluation.bioKgBenchLicenseRefHash],
    ["dataset release", biomedicalAgentEvaluation.bioKgBenchDatasetReleaseHash],
    ["knowledge graph manifest", biomedicalAgentEvaluation.bioKgBenchKnowledgeGraphManifestHash],
    ["kg build config", biomedicalAgentEvaluation.bioKgBenchKgBuildConfigHash],
    ["task manifest", biomedicalAgentEvaluation.bioKgBenchTaskManifestHash],
    ["kgcheck manifest", biomedicalAgentEvaluation.bioKgBenchKgCheckManifestHash],
    ["kgqa manifest", biomedicalAgentEvaluation.bioKgBenchKgQaManifestHash],
    ["scv manifest", biomedicalAgentEvaluation.bioKgBenchScvManifestHash],
    ["agent config", biomedicalAgentEvaluation.bioKgBenchAgentConfigHash],
    ["rag config", biomedicalAgentEvaluation.bioKgBenchRagConfigHash],
    ["neo4j config", biomedicalAgentEvaluation.bioKgBenchNeo4jConfigHash],
    ["evaluation script", biomedicalAgentEvaluation.bioKgBenchEvaluationScriptHash],
    ["result manifest", biomedicalAgentEvaluation.bioKgBenchResultManifestHash],
    ["error discovery report", biomedicalAgentEvaluation.bioKgBenchErrorDiscoveryReportHash],
    ["replay command", biomedicalAgentEvaluation.bioKgBenchReplayCommandHash],
    ["ci receipt", biomedicalAgentEvaluation.bioKgBenchCiReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`biomedical agent evaluation biokgbench ${label} hash invalid`);
    }
  }
  appendBioKgBenchCountIssue(
    issues,
    "task kind count",
    biomedicalAgentEvaluation.bioKgBenchTaskKinds.length,
    biomedicalAgentEvaluation.minBioKgBenchTaskKindCount,
  );
  if (biomedicalAgentEvaluation.bioKgBenchDeterministicSeed === null) {
    issues.push("biomedical agent evaluation biokgbench deterministic seed missing");
  }
  appendBioKgBenchMinimumIssue(
    issues,
    "dataset sample count",
    biomedicalAgentEvaluation.bioKgBenchDatasetSampleCount,
    biomedicalAgentEvaluation.minBioKgBenchDatasetSampleCount,
  );
  appendBioKgBenchMinimumIssue(
    issues,
    "kgcheck annotated count",
    biomedicalAgentEvaluation.bioKgBenchKgCheckAnnotatedCount,
    biomedicalAgentEvaluation.minBioKgBenchKgCheckAnnotatedCount,
  );
  appendBioKgBenchMinimumIssue(
    issues,
    "kgqa test count",
    biomedicalAgentEvaluation.bioKgBenchKgQaTestCount,
    biomedicalAgentEvaluation.minBioKgBenchKgQaTestCount,
  );
  appendBioKgBenchMinimumIssue(
    issues,
    "scv test count",
    biomedicalAgentEvaluation.bioKgBenchScvTestCount,
    biomedicalAgentEvaluation.minBioKgBenchScvTestCount,
  );
  appendBioKgBenchMinimumIssue(
    issues,
    "kgcheck accuracy",
    biomedicalAgentEvaluation.bioKgBenchKgCheckAccuracy0to1,
    biomedicalAgentEvaluation.minBioKgBenchKgCheckAccuracy0to1,
  );
  appendBioKgBenchMinimumIssue(
    issues,
    "kgqa accuracy",
    biomedicalAgentEvaluation.bioKgBenchKgQaAccuracy0to1,
    biomedicalAgentEvaluation.minBioKgBenchKgQaAccuracy0to1,
  );
  appendBioKgBenchMinimumIssue(
    issues,
    "scv accuracy",
    biomedicalAgentEvaluation.bioKgBenchScvAccuracy0to1,
    biomedicalAgentEvaluation.minBioKgBenchScvAccuracy0to1,
  );
  appendBioKgBenchMinimumIssue(
    issues,
    "error discovery count",
    biomedicalAgentEvaluation.bioKgBenchErrorDiscoveryCount,
    biomedicalAgentEvaluation.minBioKgBenchErrorDiscoveryCount,
  );
  appendBioKgBenchMinimumIssue(
    issues,
    "replay pass rate",
    biomedicalAgentEvaluation.bioKgBenchReplayPassRate0to1,
    biomedicalAgentEvaluation.minBioKgBenchReplayPassRate0to1,
  );
  if (biomedicalAgentEvaluation.bioKgBenchScoreDelta0to1 === null) {
    issues.push("biomedical agent evaluation biokgbench score delta missing");
  }
  if (biomedicalAgentEvaluation.maxBioKgBenchScoreRegression0to1 === null) {
    issues.push("biomedical agent evaluation biokgbench score regression threshold missing");
  }
  if (
    biomedicalAgentEvaluation.bioKgBenchScoreDelta0to1 !== null
    && biomedicalAgentEvaluation.maxBioKgBenchScoreRegression0to1 !== null
    && biomedicalAgentEvaluation.bioKgBenchScoreDelta0to1 < -biomedicalAgentEvaluation.maxBioKgBenchScoreRegression0to1
  ) {
    issues.push("biomedical agent evaluation biokgbench score regression exceeds threshold");
  }
}

function hasBioMedArenaSignal(evaluation: ReplayBenchmarkBiomedicalAgentEvaluationReceipt): boolean {
  return [
    evaluation.bioMedArenaSourceRefHash,
    evaluation.bioMedArenaRepositorySnapshotHash,
    evaluation.bioMedArenaLicenseRefHash,
    evaluation.bioMedArenaReadmeHash,
    evaluation.bioMedArenaPyprojectHash,
    evaluation.bioMedArenaConfigHash,
    evaluation.bioMedArenaMatrixConfigHash,
    evaluation.bioMedArenaHarnessTreeHash,
    evaluation.bioMedArenaHarnessCliHash,
    evaluation.bioMedArenaBenchmarkConfigHash,
    evaluation.bioMedArenaEvalSuiteHash,
    evaluation.bioMedArenaAdapterRegistryHash,
    evaluation.bioMedArenaToolRegistryHash,
    evaluation.bioMedArenaVendorManifestHash,
    evaluation.bioMedArenaBaselineAgentHash,
    evaluation.bioMedArenaQuickRunHash,
    evaluation.bioMedArenaReleaseGateHash,
    evaluation.bioMedArenaResultManifestHash,
    evaluation.bioMedArenaReplayCommandHash,
    evaluation.bioMedArenaCiReceiptHash,
  ].some((value) => value !== null)
    || evaluation.bioMedArenaBenchmarkFamilies.length > 0
    || evaluation.bioMedArenaToolModes.length > 0
    || evaluation.bioMedArenaToolSandboxVerified !== null
    || [
      evaluation.bioMedArenaDeterministicSeed,
      evaluation.bioMedArenaBenchmarkCount,
      evaluation.bioMedArenaToolCount,
      evaluation.bioMedArenaAdapterCount,
      evaluation.bioMedArenaVendorCount,
      evaluation.bioMedArenaBaselineScore0to1,
      evaluation.bioMedArenaCandidateScore0to1,
      evaluation.bioMedArenaScoreDelta0to1,
      evaluation.maxBioMedArenaScoreRegression0to1,
      evaluation.bioMedArenaReplayPassRate0to1,
      evaluation.bioMedArenaToolCoverage0to1,
      evaluation.bioMedArenaBenchmarkCoverage0to1,
    ].some((value) => value !== null);
}

function appendBioMedArenaCountIssue(
  issues: string[],
  label: string,
  count: number,
  minimum: number | null,
): void {
  if (count === 0) {
    issues.push(`biomedical agent evaluation biomedarena ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`biomedical agent evaluation biomedarena ${label} threshold missing`);
  }
  if (minimum !== null && count < minimum) {
    issues.push(`biomedical agent evaluation biomedarena ${label} below threshold`);
  }
}

function appendBioMedArenaMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`biomedical agent evaluation biomedarena ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`biomedical agent evaluation biomedarena ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`biomedical agent evaluation biomedarena ${label} below threshold`);
  }
}

function appendBioMedArenaIssues(
  issues: string[],
  biomedicalAgentEvaluation: ReplayBenchmarkBiomedicalAgentEvaluationReceipt,
): void {
  if (!hasBioMedArenaSignal(biomedicalAgentEvaluation)) return;
  for (const [label, hash] of [
    ["source ref", biomedicalAgentEvaluation.bioMedArenaSourceRefHash],
    ["repository snapshot", biomedicalAgentEvaluation.bioMedArenaRepositorySnapshotHash],
    ["license ref", biomedicalAgentEvaluation.bioMedArenaLicenseRefHash],
    ["readme", biomedicalAgentEvaluation.bioMedArenaReadmeHash],
    ["pyproject", biomedicalAgentEvaluation.bioMedArenaPyprojectHash],
    ["config", biomedicalAgentEvaluation.bioMedArenaConfigHash],
    ["matrix config", biomedicalAgentEvaluation.bioMedArenaMatrixConfigHash],
    ["harness tree", biomedicalAgentEvaluation.bioMedArenaHarnessTreeHash],
    ["harness cli", biomedicalAgentEvaluation.bioMedArenaHarnessCliHash],
    ["benchmark config", biomedicalAgentEvaluation.bioMedArenaBenchmarkConfigHash],
    ["eval suite", biomedicalAgentEvaluation.bioMedArenaEvalSuiteHash],
    ["adapter registry", biomedicalAgentEvaluation.bioMedArenaAdapterRegistryHash],
    ["tool registry", biomedicalAgentEvaluation.bioMedArenaToolRegistryHash],
    ["vendor manifest", biomedicalAgentEvaluation.bioMedArenaVendorManifestHash],
    ["baseline agent", biomedicalAgentEvaluation.bioMedArenaBaselineAgentHash],
    ["quick run", biomedicalAgentEvaluation.bioMedArenaQuickRunHash],
    ["release gate", biomedicalAgentEvaluation.bioMedArenaReleaseGateHash],
    ["result manifest", biomedicalAgentEvaluation.bioMedArenaResultManifestHash],
    ["replay command", biomedicalAgentEvaluation.bioMedArenaReplayCommandHash],
    ["ci receipt", biomedicalAgentEvaluation.bioMedArenaCiReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`biomedical agent evaluation biomedarena ${label} hash invalid`);
    }
  }
  appendBioMedArenaCountIssue(
    issues,
    "benchmark family count",
    biomedicalAgentEvaluation.bioMedArenaBenchmarkFamilies.length,
    biomedicalAgentEvaluation.minBioMedArenaBenchmarkFamilyCount,
  );
  appendBioMedArenaCountIssue(
    issues,
    "tool mode count",
    biomedicalAgentEvaluation.bioMedArenaToolModes.length,
    biomedicalAgentEvaluation.minBioMedArenaToolModeCount,
  );
  if (biomedicalAgentEvaluation.bioMedArenaDeterministicSeed === null) {
    issues.push("biomedical agent evaluation biomedarena deterministic seed missing");
  }
  appendBioMedArenaMinimumIssue(
    issues,
    "benchmark count",
    biomedicalAgentEvaluation.bioMedArenaBenchmarkCount,
    biomedicalAgentEvaluation.minBioMedArenaBenchmarkCount,
  );
  appendBioMedArenaMinimumIssue(
    issues,
    "tool count",
    biomedicalAgentEvaluation.bioMedArenaToolCount,
    biomedicalAgentEvaluation.minBioMedArenaToolCount,
  );
  appendBioMedArenaMinimumIssue(
    issues,
    "adapter count",
    biomedicalAgentEvaluation.bioMedArenaAdapterCount,
    biomedicalAgentEvaluation.minBioMedArenaAdapterCount,
  );
  appendBioMedArenaMinimumIssue(
    issues,
    "vendor count",
    biomedicalAgentEvaluation.bioMedArenaVendorCount,
    biomedicalAgentEvaluation.minBioMedArenaVendorCount,
  );
  if (biomedicalAgentEvaluation.bioMedArenaBaselineScore0to1 === null) {
    issues.push("biomedical agent evaluation biomedarena baseline score missing");
  }
  if (biomedicalAgentEvaluation.bioMedArenaCandidateScore0to1 === null) {
    issues.push("biomedical agent evaluation biomedarena candidate score missing");
  }
  if (biomedicalAgentEvaluation.bioMedArenaScoreDelta0to1 === null) {
    issues.push("biomedical agent evaluation biomedarena score delta missing");
  }
  if (biomedicalAgentEvaluation.maxBioMedArenaScoreRegression0to1 === null) {
    issues.push("biomedical agent evaluation biomedarena score regression threshold missing");
  }
  if (
    biomedicalAgentEvaluation.bioMedArenaScoreDelta0to1 !== null
    && biomedicalAgentEvaluation.maxBioMedArenaScoreRegression0to1 !== null
    && biomedicalAgentEvaluation.bioMedArenaScoreDelta0to1 < -biomedicalAgentEvaluation.maxBioMedArenaScoreRegression0to1
  ) {
    issues.push("biomedical agent evaluation biomedarena score regression exceeds threshold");
  }
  appendBioMedArenaMinimumIssue(
    issues,
    "replay pass rate",
    biomedicalAgentEvaluation.bioMedArenaReplayPassRate0to1,
    biomedicalAgentEvaluation.minBioMedArenaReplayPassRate0to1,
  );
  appendBioMedArenaMinimumIssue(
    issues,
    "tool coverage",
    biomedicalAgentEvaluation.bioMedArenaToolCoverage0to1,
    biomedicalAgentEvaluation.minBioMedArenaToolCoverage0to1,
  );
  appendBioMedArenaMinimumIssue(
    issues,
    "benchmark coverage",
    biomedicalAgentEvaluation.bioMedArenaBenchmarkCoverage0to1,
    biomedicalAgentEvaluation.minBioMedArenaBenchmarkCoverage0to1,
  );
  if (biomedicalAgentEvaluation.bioMedArenaToolSandboxVerified === null) {
    issues.push("biomedical agent evaluation biomedarena tool sandbox proof missing");
  } else if (!biomedicalAgentEvaluation.bioMedArenaToolSandboxVerified) {
    issues.push("biomedical agent evaluation biomedarena tool sandbox not verified");
  }
}

function appendBiomedicalAgentEvaluationIssues(
  issues: string[],
  biomedicalAgentEvaluation: ReplayBenchmarkBiomedicalAgentEvaluationReceipt | undefined,
): void {
  if (!biomedicalAgentEvaluation) return;
  if (!biomedicalAgentEvaluation.benchmarkId) {
    issues.push("biomedical agent evaluation benchmark id missing");
  }
  if (!biomedicalAgentEvaluation.benchmarkVersion) {
    issues.push("biomedical agent evaluation benchmark version missing");
  }
  if (!biomedicalAgentEvaluation.taskType) {
    issues.push("biomedical agent evaluation task type missing");
  }
  if (!biomedicalAgentEvaluation.workflowType) {
    issues.push("biomedical agent evaluation workflow type missing");
  }
  for (const [label, hash] of [
    ["task manifest", biomedicalAgentEvaluation.taskManifestHash],
    ["dataset spec", biomedicalAgentEvaluation.datasetSpecHash],
    ["knowledge base manifest", biomedicalAgentEvaluation.knowledgeBaseManifestHash],
    ["tool registry", biomedicalAgentEvaluation.toolRegistryHash],
    ["workflow graph", biomedicalAgentEvaluation.workflowGraphHash],
    ["model config", biomedicalAgentEvaluation.modelConfigHash],
    ["sandbox config", biomedicalAgentEvaluation.sandboxConfigHash],
    ["execution trace", biomedicalAgentEvaluation.executionTraceHash],
    ["code execution trace", biomedicalAgentEvaluation.codeExecutionTraceHash],
    ["structured result", biomedicalAgentEvaluation.structuredResultHash],
    ["report artifact", biomedicalAgentEvaluation.reportArtifactHash],
    ["generated artifact manifest", biomedicalAgentEvaluation.generatedArtifactManifestHash],
    ["evaluator config", biomedicalAgentEvaluation.evaluatorConfigHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`biomedical agent evaluation ${label} hash invalid`);
    }
  }
  if (biomedicalAgentEvaluation.taskCount === null) {
    issues.push("biomedical agent evaluation task count missing");
  }
  if (biomedicalAgentEvaluation.completedTaskCount === null) {
    issues.push("biomedical agent evaluation completed task count missing");
  }
  if (
    biomedicalAgentEvaluation.taskCount !== null
    && biomedicalAgentEvaluation.completedTaskCount !== null
    && biomedicalAgentEvaluation.completedTaskCount > biomedicalAgentEvaluation.taskCount
  ) {
    issues.push("biomedical agent evaluation completed task count exceeds task count");
  }
  if (biomedicalAgentEvaluation.knowledgeBaseCount === null) {
    issues.push("biomedical agent evaluation knowledge base count missing");
  }
  if (biomedicalAgentEvaluation.generatedArtifactCount === null) {
    issues.push("biomedical agent evaluation generated artifact count missing");
  }
  if (biomedicalAgentEvaluation.score0to1 === null) {
    issues.push("biomedical agent evaluation score missing");
  }
  if (
    biomedicalAgentEvaluation.score0to1 !== null
    && biomedicalAgentEvaluation.minScore0to1 !== null
    && biomedicalAgentEvaluation.score0to1 < biomedicalAgentEvaluation.minScore0to1
  ) {
    issues.push("biomedical agent evaluation score below threshold");
  }
  if (biomedicalAgentEvaluation.safeCodeExecutionEnabled === null) {
    issues.push("biomedical agent evaluation safe code execution flag missing");
  } else if (!biomedicalAgentEvaluation.safeCodeExecutionEnabled) {
    issues.push("biomedical agent evaluation safe code execution disabled");
  }
  if (hasMedAskSignal(biomedicalAgentEvaluation)) {
    for (const [label, hash] of [
      ["medask source ref", biomedicalAgentEvaluation.medAskSourceRefHash],
      ["medask repository snapshot", biomedicalAgentEvaluation.medAskRepositorySnapshotHash],
      ["medask license ref", biomedicalAgentEvaluation.medAskLicenseRefHash],
      ["medask requirements", biomedicalAgentEvaluation.medAskRequirementsHash],
      ["medask setup", biomedicalAgentEvaluation.medAskSetupHash],
      ["medask symptomcheck vignette manifest", biomedicalAgentEvaluation.medAskSymptomCheckVignetteManifestHash],
      ["medask triage vignette manifest", biomedicalAgentEvaluation.medAskTriageVignetteManifestHash],
      ["medask symptomcheck evaluation script", biomedicalAgentEvaluation.medAskSymptomCheckEvaluationScriptHash],
      ["medask triage evaluation script", biomedicalAgentEvaluation.medAskTriageEvaluationScriptHash],
      ["medask patient simulator config", biomedicalAgentEvaluation.medAskPatientSimulatorConfigHash],
      ["medask doctor model config", biomedicalAgentEvaluation.medAskDoctorModelConfigHash],
      ["medask triage model config", biomedicalAgentEvaluation.medAskTriageModelConfigHash],
      ["medask symptomcheck result manifest", biomedicalAgentEvaluation.medAskSymptomCheckResultManifestHash],
      ["medask triage result manifest", biomedicalAgentEvaluation.medAskTriageResultManifestHash],
      ["medask paired analysis", biomedicalAgentEvaluation.medAskPairedAnalysisHash],
      ["medask run command", biomedicalAgentEvaluation.medAskRunCommandHash],
      ["medask replay command", biomedicalAgentEvaluation.medAskReplayCommandHash],
    ] as const) {
      if (!hash || !isSha256(hash)) {
        issues.push(`biomedical agent evaluation ${label} hash invalid`);
      }
    }
    appendMedAskCountIssue(
      issues,
      "clinical task count",
      biomedicalAgentEvaluation.medAskClinicalTasks.length,
      biomedicalAgentEvaluation.minMedAskClinicalTaskCount,
    );
    if (biomedicalAgentEvaluation.medAskDeterministicSeed === null) {
      issues.push("biomedical agent evaluation medask deterministic seed missing");
    }
    appendMedAskMinimumIssue(
      issues,
      "symptom vignette count",
      biomedicalAgentEvaluation.medAskSymptomVignetteCount,
      biomedicalAgentEvaluation.minMedAskSymptomVignetteCount,
    );
    appendMedAskMinimumIssue(
      issues,
      "triage vignette count",
      biomedicalAgentEvaluation.medAskTriageVignetteCount,
      biomedicalAgentEvaluation.minMedAskTriageVignetteCount,
    );
    appendMedAskMinimumIssue(
      issues,
      "top5 diagnostic accuracy",
      biomedicalAgentEvaluation.medAskTop5DiagnosticAccuracy0to1,
      biomedicalAgentEvaluation.minMedAskTop5DiagnosticAccuracy0to1,
    );
    appendMedAskMinimumIssue(
      issues,
      "triage accuracy",
      biomedicalAgentEvaluation.medAskTriageAccuracy0to1,
      biomedicalAgentEvaluation.minMedAskTriageAccuracy0to1,
    );
    appendMedAskMinimumIssue(
      issues,
      "urgency class coverage",
      biomedicalAgentEvaluation.medAskUrgencyClassCoverage0to1,
      biomedicalAgentEvaluation.minMedAskUrgencyClassCoverage0to1,
    );
    appendMedAskMinimumIssue(
      issues,
      "replay pass rate",
      biomedicalAgentEvaluation.medAskReplayPassRate0to1,
      biomedicalAgentEvaluation.minMedAskReplayPassRate0to1,
    );
    if (biomedicalAgentEvaluation.medAskScoreDelta0to1 === null) {
      issues.push("biomedical agent evaluation medask score delta missing");
    }
    if (biomedicalAgentEvaluation.maxMedAskScoreRegression0to1 === null) {
      issues.push("biomedical agent evaluation medask score regression threshold missing");
    }
    if (
      biomedicalAgentEvaluation.medAskScoreDelta0to1 !== null
      && biomedicalAgentEvaluation.maxMedAskScoreRegression0to1 !== null
      && biomedicalAgentEvaluation.medAskScoreDelta0to1 < -biomedicalAgentEvaluation.maxMedAskScoreRegression0to1
    ) {
      issues.push("biomedical agent evaluation medask score regression exceeds threshold");
    }
  }
  appendBioKgBenchIssues(issues, biomedicalAgentEvaluation);
  appendBioMedArenaIssues(issues, biomedicalAgentEvaluation);
}

function buildBiomedicalAgentEvaluationSummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkBiomedicalAgentEvaluationSummary {
  const evaluationRows = rows.filter((row) => row.biomedicalAgentEvaluation);
  const medAskRows = evaluationRows.filter((row) => (
    row.biomedicalAgentEvaluation ? hasMedAskSignal(row.biomedicalAgentEvaluation) : false
  ));
  const bioKgBenchRows = evaluationRows.filter((row) => (
    row.biomedicalAgentEvaluation ? hasBioKgBenchSignal(row.biomedicalAgentEvaluation) : false
  ));
  const bioMedArenaRows = evaluationRows.filter((row) => (
    row.biomedicalAgentEvaluation ? hasBioMedArenaSignal(row.biomedicalAgentEvaluation) : false
  ));
  const scores = evaluationRows
    .map((row) => row.biomedicalAgentEvaluation?.score0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: evaluationRows.length,
    taskTypes: [...new Set(evaluationRows
      .map((row) => row.biomedicalAgentEvaluation?.taskType)
      .filter((value): value is ReplayBenchmarkBiomedicalAgentTaskType => value !== null && value !== undefined))],
    workflowTypes: [...new Set(evaluationRows
      .map((row) => row.biomedicalAgentEvaluation?.workflowType)
      .filter((value): value is ReplayBenchmarkBiomedicalAgentWorkflowType => value !== null && value !== undefined))],
    failedRowIds: evaluationRows.filter(isBiomedicalAgentEvaluationFailure).map((row) => row.rowId),
    totalTaskCount: evaluationRows.reduce((sum, row) => sum + (row.biomedicalAgentEvaluation?.taskCount ?? 0), 0),
    totalCompletedTaskCount: evaluationRows.reduce((sum, row) => sum + (row.biomedicalAgentEvaluation?.completedTaskCount ?? 0), 0),
    totalKnowledgeBaseCount: evaluationRows.reduce((sum, row) => sum + (row.biomedicalAgentEvaluation?.knowledgeBaseCount ?? 0), 0),
    totalGeneratedArtifactCount: evaluationRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.generatedArtifactCount ?? 0)
    ), 0),
    averageScore0to1: scores.length === 0 ? null : round(scores.reduce((sum, value) => sum + value, 0) / scores.length),
    safeCodeExecutionRowCount: evaluationRows.filter((row) => (
      row.biomedicalAgentEvaluation?.safeCodeExecutionEnabled === true
    )).length,
    medAskRowCount: medAskRows.length,
    medAskClinicalTasks: unique(
      medAskRows.flatMap((row) => row.biomedicalAgentEvaluation?.medAskClinicalTasks ?? []),
    ) as ReplayBenchmarkMedAskClinicalTask[],
    failedMedAskRowIds: medAskRows
      .filter((row) => row.issues.some((issue) => issue.startsWith("biomedical agent evaluation medask ")))
      .map((row) => row.rowId),
    totalMedAskSymptomVignetteCount: medAskRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.medAskSymptomVignetteCount ?? 0)
    ), 0),
    totalMedAskTriageVignetteCount: medAskRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.medAskTriageVignetteCount ?? 0)
    ), 0),
    averageMedAskTop5DiagnosticAccuracy0to1: averageNullable(
      medAskRows.map((row) => row.biomedicalAgentEvaluation?.medAskTop5DiagnosticAccuracy0to1 ?? null),
    ),
    averageMedAskTriageAccuracy0to1: averageNullable(
      medAskRows.map((row) => row.biomedicalAgentEvaluation?.medAskTriageAccuracy0to1 ?? null),
    ),
    averageMedAskReplayPassRate0to1: averageNullable(
      medAskRows.map((row) => row.biomedicalAgentEvaluation?.medAskReplayPassRate0to1 ?? null),
    ),
    bioKgBenchRowCount: bioKgBenchRows.length,
    bioKgBenchTaskKinds: unique(
      bioKgBenchRows.flatMap((row) => row.biomedicalAgentEvaluation?.bioKgBenchTaskKinds ?? []),
    ) as ReplayBenchmarkBioKgBenchTaskKind[],
    failedBioKgBenchRowIds: bioKgBenchRows
      .filter((row) => row.issues.some((issue) => issue.startsWith("biomedical agent evaluation biokgbench ")))
      .map((row) => row.rowId),
    totalBioKgBenchDatasetSampleCount: bioKgBenchRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.bioKgBenchDatasetSampleCount ?? 0)
    ), 0),
    totalBioKgBenchKgCheckAnnotatedCount: bioKgBenchRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.bioKgBenchKgCheckAnnotatedCount ?? 0)
    ), 0),
    totalBioKgBenchKgQaTestCount: bioKgBenchRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.bioKgBenchKgQaTestCount ?? 0)
    ), 0),
    totalBioKgBenchScvTestCount: bioKgBenchRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.bioKgBenchScvTestCount ?? 0)
    ), 0),
    totalBioKgBenchErrorDiscoveryCount: bioKgBenchRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.bioKgBenchErrorDiscoveryCount ?? 0)
    ), 0),
    averageBioKgBenchKgCheckAccuracy0to1: averageNullable(
      bioKgBenchRows.map((row) => row.biomedicalAgentEvaluation?.bioKgBenchKgCheckAccuracy0to1 ?? null),
    ),
    averageBioKgBenchKgQaAccuracy0to1: averageNullable(
      bioKgBenchRows.map((row) => row.biomedicalAgentEvaluation?.bioKgBenchKgQaAccuracy0to1 ?? null),
    ),
    averageBioKgBenchScvAccuracy0to1: averageNullable(
      bioKgBenchRows.map((row) => row.biomedicalAgentEvaluation?.bioKgBenchScvAccuracy0to1 ?? null),
    ),
    averageBioKgBenchReplayPassRate0to1: averageNullable(
      bioKgBenchRows.map((row) => row.biomedicalAgentEvaluation?.bioKgBenchReplayPassRate0to1 ?? null),
    ),
    bioMedArenaRowCount: bioMedArenaRows.length,
    bioMedArenaBenchmarkFamilies: unique(
      bioMedArenaRows.flatMap((row) => row.biomedicalAgentEvaluation?.bioMedArenaBenchmarkFamilies ?? []),
    ) as ReplayBenchmarkBioMedArenaBenchmarkFamily[],
    bioMedArenaToolModes: unique(
      bioMedArenaRows.flatMap((row) => row.biomedicalAgentEvaluation?.bioMedArenaToolModes ?? []),
    ) as ReplayBenchmarkBioMedArenaToolMode[],
    failedBioMedArenaRowIds: bioMedArenaRows
      .filter((row) => row.issues.some((issue) => issue.startsWith("biomedical agent evaluation biomedarena ")))
      .map((row) => row.rowId),
    totalBioMedArenaBenchmarkCount: bioMedArenaRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.bioMedArenaBenchmarkCount ?? 0)
    ), 0),
    totalBioMedArenaToolCount: bioMedArenaRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.bioMedArenaToolCount ?? 0)
    ), 0),
    totalBioMedArenaAdapterCount: bioMedArenaRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.bioMedArenaAdapterCount ?? 0)
    ), 0),
    totalBioMedArenaVendorCount: bioMedArenaRows.reduce((sum, row) => (
      sum + (row.biomedicalAgentEvaluation?.bioMedArenaVendorCount ?? 0)
    ), 0),
    averageBioMedArenaScoreDelta0to1: averageNullable(
      bioMedArenaRows.map((row) => row.biomedicalAgentEvaluation?.bioMedArenaScoreDelta0to1 ?? null),
    ),
    averageBioMedArenaReplayPassRate0to1: averageNullable(
      bioMedArenaRows.map((row) => row.biomedicalAgentEvaluation?.bioMedArenaReplayPassRate0to1 ?? null),
    ),
    averageBioMedArenaToolCoverage0to1: averageNullable(
      bioMedArenaRows.map((row) => row.biomedicalAgentEvaluation?.bioMedArenaToolCoverage0to1 ?? null),
    ),
    averageBioMedArenaBenchmarkCoverage0to1: averageNullable(
      bioMedArenaRows.map((row) => row.biomedicalAgentEvaluation?.bioMedArenaBenchmarkCoverage0to1 ?? null),
    ),
    bioMedArenaToolSandboxVerifiedRowCount: bioMedArenaRows.filter((row) => (
      row.biomedicalAgentEvaluation?.bioMedArenaToolSandboxVerified === true
    )).length,
  };
}

function buildRuntimeSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkRuntimeSummary {
  const runtimeRows = rows.filter((row) => row.runtime);
  return {
    rowCount: runtimeRows.length,
    failedRowIds: runtimeRows.filter(isRuntimeFailure).map((row) => row.rowId),
    outputArtifactHashCount: runtimeRows.reduce((sum, row) => sum + row.outputArtifactHashes.length, 0),
  };
}

function appendBenchLoopMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`benchloop replay ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`benchloop replay ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`benchloop replay ${label} below threshold`);
  }
}

function appendBenchLoopMaximumIssue(
  issues: string[],
  label: string,
  value: number | null,
  maximum: number | null,
): void {
  if (value === null) {
    issues.push(`benchloop replay ${label} missing`);
  }
  if (maximum === null) {
    issues.push(`benchloop replay ${label} threshold missing`);
  }
  if (value !== null && maximum !== null && value > maximum) {
    issues.push(`benchloop replay ${label} above threshold`);
  }
}

function appendBenchLoopIssues(
  issues: string[],
  row: ReplayBenchmarkCorpusRowInput,
  benchLoop: ReplayBenchmarkBenchLoopReceipt | undefined,
): void {
  if (!benchLoop) return;
  if (!benchLoop.benchmarkId) {
    issues.push("benchloop replay benchmark id missing");
  }
  if (!benchLoop.benchmarkVersion) {
    issues.push("benchloop replay benchmark version missing");
  }
  if (!benchLoop.suite) {
    issues.push("benchloop replay suite missing");
  }
  if (!benchLoop.provider) {
    issues.push("benchloop replay provider missing");
  }
  if (!benchLoop.harness) {
    issues.push("benchloop replay harness missing");
  }
  if (!benchLoop.deploymentMode) {
    issues.push("benchloop replay deployment mode missing");
  }
  for (const [label, hash] of [
    ["repository snapshot", benchLoop.repositorySnapshotHash],
    ["package version", benchLoop.packageVersionHash],
    ["suite manifest", benchLoop.suiteManifestHash],
    ["task manifest", benchLoop.taskManifestHash],
    ["frozen task set", benchLoop.frozenTaskSetHash],
    ["scorer config", benchLoop.scorerConfigHash],
    ["harness config", benchLoop.harnessConfigHash],
    ["provider config", benchLoop.providerConfigHash],
    ["endpoint config", benchLoop.endpointConfigHash],
    ["model config", benchLoop.modelConfigHash],
    ["machine profile", benchLoop.machineProfileHash],
    ["dependency lock", benchLoop.dependencyLockHash],
    ["run config", benchLoop.runConfigHash],
    ["run output manifest", benchLoop.runOutputManifestHash],
    ["metrics report", benchLoop.metricsReportHash],
    ["agent loop trace", benchLoop.agentLoopTraceHash],
    ["tool call trace", benchLoop.toolCallTraceHash],
    ["token latency trace", benchLoop.tokenLatencyTraceHash],
    ["run persistence", benchLoop.runPersistenceHash],
    ["export artifact", benchLoop.exportArtifactHash],
    ["replay command", benchLoop.replayCommandHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`benchloop replay ${label} hash invalid`);
    }
  }
  if (row.fixture.benchLoop?.gpuProfileHash && !isSha256(row.fixture.benchLoop.gpuProfileHash)) {
    issues.push("benchloop replay gpu profile hash invalid");
  }
  if (
    row.fixture.benchLoop?.leaderboardSubmissionHash
    && !isSha256(row.fixture.benchLoop.leaderboardSubmissionHash)
  ) {
    issues.push("benchloop replay leaderboard submission hash invalid");
  }
  if (benchLoop.deterministicSeed === null) {
    issues.push("benchloop replay deterministic seed missing");
  }
  appendBenchLoopMinimumIssue(issues, "task count", benchLoop.taskCount, benchLoop.minTaskCount);
  appendBenchLoopMinimumIssue(issues, "tool count", benchLoop.toolCount, benchLoop.minToolCount);
  appendBenchLoopMinimumIssue(issues, "average turn count", benchLoop.averageTurnCount, benchLoop.minAverageTurnCount);
  appendBenchLoopMinimumIssue(issues, "overall score", benchLoop.overallScore0to1, benchLoop.minOverallScore0to1);
  appendBenchLoopMinimumIssue(issues, "quality score", benchLoop.qualityScore0to1, benchLoop.minQualityScore0to1);
