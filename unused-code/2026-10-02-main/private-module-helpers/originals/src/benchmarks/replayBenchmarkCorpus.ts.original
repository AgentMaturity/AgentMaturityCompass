  appendBenchLoopMinimumIssue(issues, "reliability score", benchLoop.reliabilityScore0to1, benchLoop.minReliabilityScore0to1);
  appendBenchLoopMinimumIssue(issues, "agent score", benchLoop.agentScore0to1, benchLoop.minAgentScore0to1);
  appendBenchLoopMinimumIssue(issues, "pass rate", benchLoop.passRate0to1, benchLoop.minPassRate0to1);
  appendBenchLoopMinimumIssue(issues, "tokens per second", benchLoop.tokensPerSecond, benchLoop.minTokensPerSecond);
  appendBenchLoopMaximumIssue(issues, "time to first token", benchLoop.timeToFirstTokenMs, benchLoop.maxTimeToFirstTokenMs);
  if (benchLoop.scoreDelta0to1 === null) {
    issues.push("benchloop replay score delta missing");
  }
  if (benchLoop.maxScoreRegression0to1 === null) {
    issues.push("benchloop replay score regression threshold missing");
  }
  if (
    benchLoop.scoreDelta0to1 !== null
    && benchLoop.maxScoreRegression0to1 !== null
    && benchLoop.scoreDelta0to1 < -benchLoop.maxScoreRegression0to1
  ) {
    issues.push("benchloop replay score regression exceeds threshold");
  }
  appendBenchLoopMinimumIssue(issues, "replay pass rate", benchLoop.replayPassRate0to1, benchLoop.minReplayPassRate0to1);
}

function appendAdGenMinimumIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`adgen soc dataset ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`adgen soc dataset ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`adgen soc dataset ${label} below threshold`);
  }
}

function appendAdGenMaximumIssue(
  issues: string[],
  label: string,
  value: number | null,
  maximum: number | null,
): void {
  if (value === null) {
    issues.push(`adgen soc dataset ${label} missing`);
  }
  if (maximum === null) {
    issues.push(`adgen soc dataset ${label} threshold missing`);
  }
  if (value !== null && maximum !== null && value > maximum) {
    issues.push(`adgen soc dataset ${label} above threshold`);
  }
}

function appendAdGenSocDatasetIssues(
  issues: string[],
  adGen: ReplayBenchmarkAdGenSocDatasetReceipt | undefined,
): void {
  if (!adGen) return;
  if (!adGen.benchmarkId) {
    issues.push("adgen soc dataset benchmark id missing");
  }
  if (!adGen.benchmarkVersion) {
    issues.push("adgen soc dataset benchmark version missing");
  }
  if (!adGen.environment) {
    issues.push("adgen soc dataset environment missing");
  }
  if (!adGen.labelSource) {
    issues.push("adgen soc dataset label source missing");
  }
  for (const [label, hash] of [
    ["repository snapshot", adGen.repositorySnapshotHash],
    ["release manifest", adGen.releaseManifestHash],
    ["source corpus manifest", adGen.sourceCorpusManifestHash],
    ["lab dataset", adGen.labDatasetHash],
    ["real dataset", adGen.realDatasetHash],
    ["conversion script", adGen.conversionScriptHash],
    ["labeling prompt", adGen.labelingPromptHash],
    ["output schema", adGen.outputSchemaHash],
    ["attack mapping", adGen.attackMappingHash],
    ["action schema", adGen.actionSchemaHash],
    ["validation report", adGen.validationReportHash],
    ["label quality report", adGen.labelQualityReportHash],
    ["cross-model audit report", adGen.crossModelAuditReportHash],
    ["dataset license ref", adGen.datasetLicenseRefHash],
    ["code license ref", adGen.codeLicenseRefHash],
    ["replay command", adGen.replayCommandHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`adgen soc dataset ${label} hash invalid`);
    }
  }
  if (adGen.deterministicSeed === null) {
    issues.push("adgen soc dataset deterministic seed missing");
  }
  appendAdGenMinimumIssue(issues, "raw event count", adGen.rawEventCount, adGen.minRawEventCount);
  appendAdGenMinimumIssue(issues, "validated record count", adGen.validatedRecordCount, adGen.minValidatedRecordCount);
  appendAdGenMinimumIssue(issues, "risk class count", adGen.riskClassCount, adGen.minRiskClassCount);
  appendAdGenMinimumIssue(issues, "mitre tactic count", adGen.mitreTacticCount, adGen.minMitreTacticCount);
  appendAdGenMinimumIssue(issues, "supported action count", adGen.supportedActionCount, adGen.minSupportedActionCount);
  appendAdGenMinimumIssue(issues, "parse success", adGen.parseSuccessRate0to1, adGen.minParseSuccessRate0to1);
  appendAdGenMinimumIssue(issues, "schema validity", adGen.schemaValidity0to1, adGen.minSchemaValidity0to1);
  appendAdGenMinimumIssue(
    issues,
    "verdict consistency",
    adGen.verdictConsistency0to1,
    adGen.minVerdictConsistency0to1,
  );
  appendAdGenMaximumIssue(issues, "unknown tactic rate", adGen.unknownTacticRate0to1, adGen.maxUnknownTacticRate0to1);
  appendAdGenMaximumIssue(
    issues,
    "unknown technique rate",
    adGen.unknownTechniqueRate0to1,
    adGen.maxUnknownTechniqueRate0to1,
  );
  appendAdGenMaximumIssue(issues, "invalid action count", adGen.invalidActionCount, adGen.maxInvalidActionCount);
  appendAdGenMinimumIssue(
    issues,
    "evidence support",
    adGen.evidenceSupportScore0to1,
    adGen.minEvidenceSupportScore0to1,
  );
  appendAdGenMinimumIssue(
    issues,
    "attack alignment",
    adGen.attackAlignmentScore0to1,
    adGen.minAttackAlignmentScore0to1,
  );
  if (adGen.scoreDelta0to1 === null) {
    issues.push("adgen soc dataset score delta missing");
  }
  if (adGen.maxScoreRegression0to1 === null) {
    issues.push("adgen soc dataset score regression threshold missing");
  }
  if (
    adGen.scoreDelta0to1 !== null
    && adGen.maxScoreRegression0to1 !== null
    && adGen.scoreDelta0to1 < -adGen.maxScoreRegression0to1
  ) {
    issues.push("adgen soc dataset score regression exceeds threshold");
  }
  appendAdGenMinimumIssue(issues, "replay pass rate", adGen.replayPassRate0to1, adGen.minReplayPassRate0to1);
}

