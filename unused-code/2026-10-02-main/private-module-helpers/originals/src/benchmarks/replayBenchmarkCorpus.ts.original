  "benchloop replay overall score below threshold",
  "benchloop replay quality score below threshold",
  "benchloop replay speed score below threshold",
  "benchloop replay reliability score below threshold",
  "benchloop replay agent score below threshold",
  "benchloop replay pass rate below threshold",
  "benchloop replay tokens per second below threshold",
  "benchloop replay time to first token above threshold",
  "benchloop replay replay pass rate below threshold",
  "benchloop replay score regression exceeds threshold",
] as const;

function isBenchLoopRegressionIssue(issue: string): boolean {
  return benchLoopRegressionIssues.includes(issue as typeof benchLoopRegressionIssues[number]);
}

