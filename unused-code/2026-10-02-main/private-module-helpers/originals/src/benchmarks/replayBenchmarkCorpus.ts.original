    ragEvalFlowSampleSize: positiveInteger(rag.ragEvalFlowSampleSize),
    ragEvalFlowMinSampleSize: positiveInteger(rag.ragEvalFlowMinSampleSize),
    ragEvalFlowDeterministicSeed: nonNegativeInteger(rag.ragEvalFlowDeterministicSeed),
