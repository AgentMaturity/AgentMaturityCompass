function buildGageEvaluationSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkGageEvaluationSummary {
  const gageRows = rows.filter((row) => row.gageEvaluation);
  const coverageScores = gageRows
    .map((row) => row.gageEvaluation?.replayArtifactCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  const scoreMeans = gageRows
    .map((row) => row.gageEvaluation?.scoreMean0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: gageRows.length,
    engineVersions: unique(
      gageRows
        .map((row) => row.gageEvaluation?.engineVersion ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    modalities: unique(
      gageRows
        .map((row) => row.gageEvaluation?.modality ?? "")
        .filter((value): value is ReplayBenchmarkGageEvaluationModality => (
          gageEvaluationModalities.includes(value as ReplayBenchmarkGageEvaluationModality)
        )),
    ) as ReplayBenchmarkGageEvaluationModality[],
    harnessModes: unique(
      gageRows
        .map((row) => row.gageEvaluation?.harnessMode ?? "")
        .filter((value): value is ReplayBenchmarkGageHarnessMode => (
          gageHarnessModes.includes(value as ReplayBenchmarkGageHarnessMode)
        )),
    ) as ReplayBenchmarkGageHarnessMode[],
    failedRowIds: gageRows.filter(isGageEvaluationFailure).map((row) => row.rowId),
    totalSampleCount: gageRows.reduce((sum, row) => sum + (row.gageEvaluation?.sampleCount ?? 0), 0),
    totalMetricCount: gageRows.reduce((sum, row) => sum + (row.gageEvaluation?.metricCount ?? 0), 0),
    totalArtifactCount: gageRows.reduce((sum, row) => sum + (row.gageEvaluation?.artifactCount ?? 0), 0),
    averageReplayArtifactCoverage0to1: coverageScores.length === 0
      ? null
      : round(coverageScores.reduce((sum, value) => sum + value, 0) / coverageScores.length),
    averageScoreMean0to1: scoreMeans.length === 0
      ? null
      : round(scoreMeans.reduce((sum, value) => sum + value, 0) / scoreMeans.length),
  };
}

