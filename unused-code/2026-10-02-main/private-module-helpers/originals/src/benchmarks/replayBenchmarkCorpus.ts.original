function isToolSandboxFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.includes("tool sandbox id missing")
    || row.issues.includes("tool sandbox protocol missing")
    || row.issues.includes("tool sandbox retrieval mode missing")
    || row.issues.includes("tool sandbox count missing")
    || row.issues.includes("tool sandbox tool count missing")
    || row.issues.includes("tool sandbox registry hash invalid")
    || row.issues.includes("tool sandbox dependency graph hash invalid")
    || row.issues.includes("tool sandbox initial state hash invalid")
    || row.issues.includes("tool sandbox seed state hash invalid")
    || row.issues.includes("tool sandbox api failure schedule hash invalid")
    || row.issues.includes("tool sandbox environment verification trace hash invalid")
    || row.issues.includes("tool sandbox trajectory trace hash invalid")
    || row.issues.includes("tool sandbox retrieval trace hash invalid")
    || row.issues.includes("tool sandbox retrieval recall missing")
    || row.issues.includes("tool sandbox verification coverage missing")
    || row.issues.includes("tool sandbox verification coverage below threshold");
}

function buildToolSandboxSummary(rows: ReplayBenchmarkCorpusManifestRow[]): ReplayBenchmarkToolSandboxSummary {
  const sandboxRows = rows.filter((row) => row.toolSandbox);
  const retrievalRecallValues = sandboxRows
    .map((row) => row.toolSandbox?.toolRetrievalRecall0to1 ?? null)
    .filter((value): value is number => value !== null);
  const verificationCoverageValues = sandboxRows
    .map((row) => row.toolSandbox?.verificationStepCoverage0to1 ?? null)
    .filter((value): value is number => value !== null);
  return {
    rowCount: sandboxRows.length,
    protocols: unique(
      sandboxRows
        .map((row) => row.toolSandbox?.protocol ?? "")
        .filter((value): value is ReplayBenchmarkToolSandboxProtocol => toolSandboxProtocols.includes(value as ReplayBenchmarkToolSandboxProtocol)),
    ) as ReplayBenchmarkToolSandboxProtocol[],
    retrievalModes: unique(
      sandboxRows
        .map((row) => row.toolSandbox?.retrievalMode ?? "")
        .filter((value): value is ReplayBenchmarkToolSandboxRetrievalMode => toolSandboxRetrievalModes.includes(value as ReplayBenchmarkToolSandboxRetrievalMode)),
    ) as ReplayBenchmarkToolSandboxRetrievalMode[],
    failedRowIds: sandboxRows.filter(isToolSandboxFailure).map((row) => row.rowId),
    totalToolCount: sandboxRows.reduce((sum, row) => sum + (row.toolSandbox?.toolCount ?? 0), 0),
    averageToolRetrievalRecall0to1: retrievalRecallValues.length === 0
      ? null
      : round(retrievalRecallValues.reduce((sum, value) => sum + value, 0) / retrievalRecallValues.length),
    averageVerificationStepCoverage0to1: verificationCoverageValues.length === 0
      ? null
      : round(verificationCoverageValues.reduce((sum, value) => sum + value, 0) / verificationCoverageValues.length),
    totalRecoveryAttemptCount: sandboxRows.reduce((sum, row) => sum + (row.toolSandbox?.recoveryAttemptCount ?? 0), 0),
  };
}

