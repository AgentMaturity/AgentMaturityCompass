    staticAnalysisConfigHash: normalizeHashLabel(benchmark.staticAnalysisConfigHash),
    securityScanReportHash: normalizeHashLabel(benchmark.securityScanReportHash),
    baselineOutputHash: normalizeHashLabel(benchmark.baselineOutputHash),
    withSkillOutputHash: normalizeHashLabel(benchmark.withSkillOutputHash),
    rerunOutputHash: normalizeHashLabel(benchmark.rerunOutputHash),
    resultReportHash: normalizeHashLabel(benchmark.resultReportHash),
    replayCommandHash: normalizeHashLabel(benchmark.replayCommandHash),
    releaseGateReceiptId: normalizeLabel(benchmark.releaseGateReceiptId),
    expectedDecision: normalizeSkillBenchmarkDecision(benchmark.expectedDecision),
