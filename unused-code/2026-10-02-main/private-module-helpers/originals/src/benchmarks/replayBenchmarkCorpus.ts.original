    publicRecordingManifestHash: normalizeHashLabel(terminalWorld.publicRecordingManifestHash),
    recordingMetadataManifestHash: normalizeHashLabel(terminalWorld.recordingMetadataManifestHash),
    recordingPrivacyFilterReportHash: normalizeHashLabel(terminalWorld.recordingPrivacyFilterReportHash),
    recordingQualityFilterReportHash: normalizeHashLabel(terminalWorld.recordingQualityFilterReportHash),
    synthesizedInstructionHash: normalizeHashLabel(terminalWorld.synthesizedInstructionHash),
    referenceSolutionHash: normalizeHashLabel(terminalWorld.referenceSolutionHash),
    taskMetadataHash: normalizeHashLabel(terminalWorld.taskMetadataHash),
    dockerfileHash: normalizeHashLabel(terminalWorld.dockerfileHash),
    dockerComposeHash: normalizeHashLabel(terminalWorld.dockerComposeHash),
    dockerImageDigestHash: normalizeHashLabel(terminalWorld.dockerImageDigestHash),
    environmentReproductionLogHash: normalizeHashLabel(terminalWorld.environmentReproductionLogHash),
    preExecutionSnapshotHash: normalizeHashLabel(terminalWorld.preExecutionSnapshotHash),
    postExecutionSnapshotHash: normalizeHashLabel(terminalWorld.postExecutionSnapshotHash),
    stateTestSuiteHash: normalizeHashLabel(terminalWorld.stateTestSuiteHash),
    stateTestResultHash: normalizeHashLabel(terminalWorld.stateTestResultHash),
    allPassingTrialHash: normalizeHashLabel(terminalWorld.allPassingTrialHash),
    nopTrialHash: normalizeHashLabel(terminalWorld.nopTrialHash),
    partialTrialHash: normalizeHashLabel(terminalWorld.partialTrialHash),
    agentRunTraceHash: normalizeHashLabel(terminalWorld.agentRunTraceHash),
    resultManifestHash: normalizeHashLabel(terminalWorld.resultManifestHash),
    replayCommandHash: normalizeHashLabel(terminalWorld.replayCommandHash),
    ciReceiptHash: normalizeHashLabel(terminalWorld.ciReceiptHash),
    humanVerificationManifestHash: normalizeHashLabel(terminalWorld.humanVerificationManifestHash),
    categoryIds: unique(terminalWorld.categoryIds ?? []),
    commandIds: unique(terminalWorld.commandIds ?? []),
    taskCount: positiveInteger(terminalWorld.taskCount),
    minTaskCount: positiveInteger(terminalWorld.minTaskCount),
    categoryCount: positiveInteger(terminalWorld.categoryCount),
    minCategoryCount: positiveInteger(terminalWorld.minCategoryCount),
    uniqueCommandCount: positiveInteger(terminalWorld.uniqueCommandCount),
    minUniqueCommandCount: positiveInteger(terminalWorld.minUniqueCommandCount),
    reproducedEnvironmentCount: positiveInteger(terminalWorld.reproducedEnvironmentCount),
    minReproducedEnvironmentCount: positiveInteger(terminalWorld.minReproducedEnvironmentCount),
    deterministicSeed: nonNegativeInteger(terminalWorld.deterministicSeed),
    allPassingPassRate0to1: nullableRate(terminalWorld.allPassingPassRate0to1),
    minAllPassingPassRate0to1: nullableRate(terminalWorld.minAllPassingPassRate0to1),
    nopFailureRate0to1: nullableRate(terminalWorld.nopFailureRate0to1),
    minNopFailureRate0to1: nullableRate(terminalWorld.minNopFailureRate0to1),
    partialFailureRate0to1: nullableRate(terminalWorld.partialFailureRate0to1),
    minPartialFailureRate0to1: nullableRate(terminalWorld.minPartialFailureRate0to1),
    stateAssertionCoverage0to1: nullableRate(terminalWorld.stateAssertionCoverage0to1),
    minStateAssertionCoverage0to1: nullableRate(terminalWorld.minStateAssertionCoverage0to1),
    replayPassRate0to1: nullableRate(terminalWorld.replayPassRate0to1),
    minReplayPassRate0to1: nullableRate(terminalWorld.minReplayPassRate0to1),
    scoreDelta0to1: explicitScoreDelta0to1 ?? round(clamp01(row.candidate.score0to1) - clamp01(row.baseline.score0to1)),
    maxScoreRegression0to1: nonNegativeNumber(terminalWorld.maxScoreRegression0to1 ?? undefined),
  };
}

function isTerminalWorldFailure(row: ReplayBenchmarkCorpusManifestRow): boolean {
  return row.issues.some((issue) => issue.startsWith("terminalworld "));
}

function appendTerminalWorldCountIssue(
  issues: string[],
  label: string,
  count: number | null,
  minimum: number | null,
): void {
  if (count === null) {
    issues.push(`terminalworld ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`terminalworld ${label} threshold missing`);
  }
  if (count !== null && minimum !== null && count < minimum) {
    issues.push(`terminalworld ${label} below threshold`);
  }
}

function appendTerminalWorldRateIssue(
  issues: string[],
  label: string,
  value: number | null,
  minimum: number | null,
): void {
  if (value === null) {
    issues.push(`terminalworld ${label} missing`);
  }
  if (minimum === null) {
    issues.push(`terminalworld ${label} threshold missing`);
  }
  if (value !== null && minimum !== null && value < minimum) {
    issues.push(`terminalworld ${label} below threshold`);
  }
}

function appendTerminalWorldIssues(
  issues: string[],
  terminalWorld: ReplayBenchmarkTerminalWorldReceipt | undefined,
): void {
  if (!terminalWorld) return;
  if (!terminalWorld.benchmarkId) {
    issues.push("terminalworld benchmark id missing");
  }
  if (!terminalWorld.benchmarkVersion) {
    issues.push("terminalworld benchmark version missing");
  }
  if (!terminalWorld.subset) {
    issues.push("terminalworld subset missing");
  }
  if (!terminalWorld.recordingSource) {
    issues.push("terminalworld recording source missing");
  }
  for (const [label, hash] of [
    ["source ref", terminalWorld.sourceRefHash],
    ["repository snapshot", terminalWorld.repositorySnapshotHash],
    ["paper ref", terminalWorld.paperRefHash],
    ["dataset snapshot", terminalWorld.datasetSnapshotHash],
    ["dataset license", terminalWorld.datasetLicenseRefHash],
    ["code license", terminalWorld.codeLicenseRefHash],
    ["public recording manifest", terminalWorld.publicRecordingManifestHash],
    ["recording metadata", terminalWorld.recordingMetadataManifestHash],
    ["recording privacy filter report", terminalWorld.recordingPrivacyFilterReportHash],
    ["recording quality filter report", terminalWorld.recordingQualityFilterReportHash],
    ["synthesized instruction", terminalWorld.synthesizedInstructionHash],
    ["reference solution", terminalWorld.referenceSolutionHash],
    ["task metadata", terminalWorld.taskMetadataHash],
    ["dockerfile", terminalWorld.dockerfileHash],
    ["docker image digest", terminalWorld.dockerImageDigestHash],
    ["environment reproduction log", terminalWorld.environmentReproductionLogHash],
    ["pre-execution snapshot", terminalWorld.preExecutionSnapshotHash],
    ["post-execution snapshot", terminalWorld.postExecutionSnapshotHash],
    ["state test suite", terminalWorld.stateTestSuiteHash],
    ["state test result", terminalWorld.stateTestResultHash],
    ["allpassing trial", terminalWorld.allPassingTrialHash],
    ["nop trial", terminalWorld.nopTrialHash],
    ["partial trial", terminalWorld.partialTrialHash],
    ["agent run trace", terminalWorld.agentRunTraceHash],
    ["result manifest", terminalWorld.resultManifestHash],
    ["replay command", terminalWorld.replayCommandHash],
    ["ci receipt", terminalWorld.ciReceiptHash],
  ] as const) {
    if (!hash || !isSha256(hash)) {
      issues.push(`terminalworld ${label} hash invalid`);
    }
  }
  if (terminalWorld.dockerComposeHash && !isSha256(terminalWorld.dockerComposeHash)) {
    issues.push("terminalworld docker compose hash invalid");
  }
  if (terminalWorld.humanVerificationManifestHash && !isSha256(terminalWorld.humanVerificationManifestHash)) {
    issues.push("terminalworld human verification manifest hash invalid");
  }
  if (terminalWorld.subset === "verified" && !terminalWorld.humanVerificationManifestHash) {
    issues.push("terminalworld verified subset human verification proof missing");
  }
  if (terminalWorld.categoryIds.length === 0) {
    issues.push("terminalworld category ids missing");
  }
  if (terminalWorld.commandIds.length === 0) {
    issues.push("terminalworld command ids missing");
  }
  appendTerminalWorldCountIssue(issues, "task count", terminalWorld.taskCount, terminalWorld.minTaskCount);
  appendTerminalWorldCountIssue(issues, "category count", terminalWorld.categoryCount, terminalWorld.minCategoryCount);
  appendTerminalWorldCountIssue(
    issues,
    "unique command count",
    terminalWorld.uniqueCommandCount,
    terminalWorld.minUniqueCommandCount,
  );
  appendTerminalWorldCountIssue(
    issues,
    "reproduced environment count",
    terminalWorld.reproducedEnvironmentCount,
    terminalWorld.minReproducedEnvironmentCount,
  );
  if (terminalWorld.deterministicSeed === null) {
    issues.push("terminalworld deterministic seed missing");
  }
  appendTerminalWorldRateIssue(
    issues,
    "allpassing pass rate",
    terminalWorld.allPassingPassRate0to1,
    terminalWorld.minAllPassingPassRate0to1,
  );
  appendTerminalWorldRateIssue(
    issues,
    "nop failure rate",
    terminalWorld.nopFailureRate0to1,
    terminalWorld.minNopFailureRate0to1,
  );
  appendTerminalWorldRateIssue(
    issues,
    "partial failure rate",
    terminalWorld.partialFailureRate0to1,
    terminalWorld.minPartialFailureRate0to1,
  );
  appendTerminalWorldRateIssue(
    issues,
    "state assertion coverage",
    terminalWorld.stateAssertionCoverage0to1,
    terminalWorld.minStateAssertionCoverage0to1,
  );
  appendTerminalWorldRateIssue(
    issues,
    "replay pass rate",
    terminalWorld.replayPassRate0to1,
    terminalWorld.minReplayPassRate0to1,
  );
  if (terminalWorld.scoreDelta0to1 === null) {
    issues.push("terminalworld score delta missing");
  }
  if (terminalWorld.maxScoreRegression0to1 === null) {
    issues.push("terminalworld score regression threshold missing");
  }
  if (
    terminalWorld.scoreDelta0to1 !== null
    && terminalWorld.maxScoreRegression0to1 !== null
    && terminalWorld.scoreDelta0to1 < -terminalWorld.maxScoreRegression0to1
  ) {
    issues.push("terminalworld score regression exceeds threshold");
  }
}

function buildTerminalWorldSummary(
  rows: ReplayBenchmarkCorpusManifestRow[],
): ReplayBenchmarkTerminalWorldSummary {
  const terminalWorldRows = rows.filter((row) => row.terminalWorld);
  return {
    rowCount: terminalWorldRows.length,
    benchmarkIds: unique(terminalWorldRows.map((row) => row.terminalWorld?.benchmarkId ?? "")),
    subsets: unique(
      terminalWorldRows
        .map((row) => row.terminalWorld?.subset ?? "")
        .filter((value): value is ReplayBenchmarkTerminalWorldSubset => (
          terminalWorldSubsets.includes(value as ReplayBenchmarkTerminalWorldSubset)
        )),
    ) as ReplayBenchmarkTerminalWorldSubset[],
    recordingSources: unique(
      terminalWorldRows
        .map((row) => row.terminalWorld?.recordingSource ?? "")
        .filter((value): value is ReplayBenchmarkTerminalWorldRecordingSource => (
          terminalWorldRecordingSources.includes(value as ReplayBenchmarkTerminalWorldRecordingSource)
        )),
    ) as ReplayBenchmarkTerminalWorldRecordingSource[],
    failedRowIds: terminalWorldRows.filter(isTerminalWorldFailure).map((row) => row.rowId),
    verifiedSubsetRowCount: terminalWorldRows.filter((row) => row.terminalWorld?.subset === "verified").length,
    humanVerifiedRowCount: terminalWorldRows.filter((row) => Boolean(row.terminalWorld?.humanVerificationManifestHash)).length,
    totalTaskCount: terminalWorldRows.reduce((sum, row) => sum + (row.terminalWorld?.taskCount ?? 0), 0),
    totalReproducedEnvironmentCount: terminalWorldRows.reduce(
      (sum, row) => sum + (row.terminalWorld?.reproducedEnvironmentCount ?? 0),
      0,
    ),
    totalUniqueCommandCount: terminalWorldRows.reduce((sum, row) => sum + (row.terminalWorld?.uniqueCommandCount ?? 0), 0),
    averageReplayPassRate0to1: averageNullable(
      terminalWorldRows.map((row) => row.terminalWorld?.replayPassRate0to1 ?? null),
    ),
    averageStateAssertionCoverage0to1: averageNullable(
      terminalWorldRows.map((row) => row.terminalWorld?.stateAssertionCoverage0to1 ?? null),
    ),
    averageScoreDelta0to1: averageNullable(
      terminalWorldRows.map((row) => row.terminalWorld?.scoreDelta0to1 ?? null),
    ),
  };
}

