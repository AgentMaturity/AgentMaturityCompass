function isResearchHarnessRegressionIssue(issue: string): boolean {
  return [
    "agent benchmark replay researchharness model family count below threshold",
    "agent benchmark replay researchharness tool kind count below threshold",
    "agent benchmark replay researchharness task mode count below threshold",
    "agent benchmark replay researchharness native tool calling disabled",
    "agent benchmark replay researchharness openai-compatible api disabled",
    "agent benchmark replay researchharness workspace boundary disabled",
    "agent benchmark replay researchharness human interaction policy not enforced",
    "agent benchmark replay researchharness trace event count below threshold",
    "agent benchmark replay researchharness replay pass rate below threshold",
    "agent benchmark replay researchharness trace coverage below threshold",
    "agent benchmark replay researchharness tool call validity below threshold",
    "agent benchmark replay researchharness workspace isolation below threshold",
    "agent benchmark replay researchharness api compatibility below threshold",
    "agent benchmark replay researchharness baseline agreement below threshold",
    "agent benchmark replay researchharness score delta below threshold",
  ].includes(issue);
}

