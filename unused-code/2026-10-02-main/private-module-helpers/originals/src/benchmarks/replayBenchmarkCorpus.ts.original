    benchmarkIds: unique(
      docThinkerRows
        .map((row) => row.docThinkerDocumentRag?.benchmarkId ?? "")
        .filter((value) => value.trim().length > 0),
    ),
    carrierModes: unique(
      docThinkerRows
        .map((row) => row.docThinkerDocumentRag?.carrierMode ?? "")
        .filter((value): value is ReplayBenchmarkDocThinkerCarrierMode => (
          docThinkerCarrierModes.includes(value as ReplayBenchmarkDocThinkerCarrierMode)
        )),
    ) as ReplayBenchmarkDocThinkerCarrierMode[],
    queryModes: (
      unique(docThinkerRows.flatMap((row) => row.docThinkerDocumentRag?.queryModes ?? []))
    ) as ReplayBenchmarkDocThinkerQueryMode[],
    memoryLayers: (
      unique(docThinkerRows.flatMap((row) => row.docThinkerDocumentRag?.memoryLayers ?? []))
    ) as ReplayBenchmarkDocThinkerMemoryLayer[],
    retrievalPaths: (
      unique(docThinkerRows.flatMap((row) => row.docThinkerDocumentRag?.retrievalPaths ?? []))
    ) as ReplayBenchmarkDocThinkerRetrievalPath[],
    failedRowIds: docThinkerRows.filter(isDocThinkerDocumentRagFailure).map((row) => row.rowId),
    totalDocumentCount: docThinkerRows.reduce((sum, row) => sum + (row.docThinkerDocumentRag?.documentCount ?? 0), 0),
    totalQueryCount: docThinkerRows.reduce((sum, row) => sum + (row.docThinkerDocumentRag?.queryCount ?? 0), 0),
    averageRoutingAccuracy0to1: averageNullable(
      docThinkerRows.map((row) => row.docThinkerDocumentRag?.routingAccuracy0to1 ?? null),
    ),
    averageEvidenceRecall0to1: averageNullable(
      docThinkerRows.map((row) => row.docThinkerDocumentRag?.evidenceRecall0to1 ?? null),
    ),
    averageAnswerAccuracy0to1: averageNullable(
      docThinkerRows.map((row) => row.docThinkerDocumentRag?.answerAccuracy0to1 ?? null),
    ),
    averageReplayPassRate0to1: averageNullable(
      docThinkerRows.map((row) => row.docThinkerDocumentRag?.replayPassRate0to1 ?? null),
    ),
    averageScoreDelta0to1: averageNullable(
      docThinkerRows.map((row) => row.docThinkerDocumentRag?.scoreDelta0to1 ?? null),
