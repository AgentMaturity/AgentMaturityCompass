  ].some((value) => value !== null)
    || replay.llmEvaluationSystemModes.length > 0
    || replay.llmEvaluationSystemJudgeFamilies.length > 0
    || [
      replay.minLlmEvaluationSystemModeCount,
      replay.minLlmEvaluationSystemJudgeFamilyCount,
