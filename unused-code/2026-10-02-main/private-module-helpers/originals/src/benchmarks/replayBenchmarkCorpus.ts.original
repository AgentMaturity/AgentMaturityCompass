    || row.issues.includes("ai research submission artifact hash invalid")
    || row.issues.includes("ai research evaluation script hash invalid")
    || row.issues.includes("ai research evaluator output hash invalid")
    || row.issues.includes("ai research normalized score missing")
    || row.issues.includes("ai research valid submission flag missing")
    || row.issues.includes("ai research valid submission false");
