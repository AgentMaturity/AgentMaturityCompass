  lines.push(`Tool Sandbox Protocols: ${manifest.toolSandboxSummary.protocols.join(", ") || "none"}`);
  lines.push(`Tool Sandbox Retrieval Modes: ${manifest.toolSandboxSummary.retrievalModes.join(", ") || "none"}`);
  lines.push(`Failed Tool Sandbox Rows: ${manifest.toolSandboxSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Platform Evaluation Rows: ${manifest.platformEvaluationSummary.rowCount}`);
  lines.push(`Platform Dataset Formats: ${manifest.platformEvaluationSummary.datasetFormats.join(", ") || "none"}`);
  lines.push(`Failed Platform Evaluation Rows: ${manifest.platformEvaluationSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Azure Agent Lab Rows: ${manifest.azureAgentLabSummary.rowCount}`);
  lines.push(`Azure Agent Lab Modules: ${manifest.azureAgentLabSummary.moduleIds.join(", ") || "none"}`);
  lines.push(`Failed Azure Agent Lab Rows: ${manifest.azureAgentLabSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`ClawEnvKit Rows: ${manifest.clawEnvKitSummary.rowCount}`);
  lines.push(`ClawEnvKit Harnesses: ${manifest.clawEnvKitSummary.harnessIds.join(", ") || "none"}`);
  lines.push(`Failed ClawEnvKit Rows: ${manifest.clawEnvKitSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`DeepResearch Rows: ${manifest.deepResearchSummary.rowCount}`);
  lines.push(`DeepResearch Tasks: ${manifest.deepResearchSummary.researchTaskIds.join(", ") || "none"}`);
  lines.push(`Failed DeepResearch Rows: ${manifest.deepResearchSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Web Search Evaluation Rows: ${manifest.webSearchEvaluationSummary.rowCount}`);
  lines.push(`Web Search Domains: ${manifest.webSearchEvaluationSummary.domains.join(", ") || "none"}`);
  lines.push(`Web Search Question Types: ${manifest.webSearchEvaluationSummary.questionTypes.join(", ") || "none"}`);
  lines.push(`Failed Web Search Evaluation Rows: ${manifest.webSearchEvaluationSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Binary Audit Rows: ${manifest.binaryAuditSummary.rowCount}`);
  lines.push(`Binary Audit Categories: ${manifest.binaryAuditSummary.categories.join(", ") || "none"}`);
  lines.push(`Failed Binary Audit Rows: ${manifest.binaryAuditSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Long-Term Memory Rows: ${manifest.longTermMemorySummary.rowCount}`);
  lines.push(`Long-Term Memory Versions: ${manifest.longTermMemorySummary.benchmarkVersions.join(", ") || "none"}`);
  lines.push(`REALTALK Rows: ${manifest.longTermMemorySummary.realTalkRowCount}`);
  lines.push(`REALTALK Tasks: ${manifest.longTermMemorySummary.realTalkTasks.join(", ") || "none"}`);
  lines.push(`CloneMem Rows: ${manifest.longTermMemorySummary.cloneMemRowCount}`);
  lines.push(`CloneMem Trace Kinds: ${manifest.longTermMemorySummary.cloneMemTraceKinds.join(", ") || "none"}`);
  lines.push(`CloneMem Task Categories: ${manifest.longTermMemorySummary.cloneMemTaskCategories.join(", ") || "none"}`);
  lines.push(`CloneMem Languages: ${manifest.longTermMemorySummary.cloneMemLanguageIds.join(", ") || "none"}`);
  lines.push(`MemEval Rows: ${manifest.longTermMemorySummary.memEvalRowCount}`);
  lines.push(`MemEval Benchmarks: ${manifest.longTermMemorySummary.memEvalBenchmarkIds.join(", ") || "none"}`);
  lines.push(`MemEval Memory Systems: ${manifest.longTermMemorySummary.memEvalMemorySystems.join(", ") || "none"}`);
  lines.push(`MemEval Metrics: ${manifest.longTermMemorySummary.memEvalMetricKinds.join(", ") || "none"}`);
  lines.push(`Failed Long-Term Memory Rows: ${manifest.longTermMemorySummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Streaming Improvement Rows: ${manifest.streamingImprovementSummary.rowCount}`);
  lines.push(`Streaming Improvement Datasets: ${manifest.streamingImprovementSummary.datasetIds.join(", ") || "none"}`);
  lines.push(`Failed Streaming Improvement Rows: ${manifest.streamingImprovementSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Enterprise Tool-Calling Rows: ${manifest.enterpriseToolCallingSummary.rowCount}`);
  lines.push(`Enterprise Tool-Calling Capabilities: ${manifest.enterpriseToolCallingSummary.capabilities.join(", ") || "none"}`);
  lines.push(`Failed Enterprise Tool-Calling Rows: ${manifest.enterpriseToolCallingSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Biomedical Agent Evaluation Rows: ${manifest.biomedicalAgentEvaluationSummary.rowCount}`);
  lines.push(`Biomedical Agent Task Types: ${manifest.biomedicalAgentEvaluationSummary.taskTypes.join(", ") || "none"}`);
  lines.push(`Biomedical Agent Workflow Types: ${manifest.biomedicalAgentEvaluationSummary.workflowTypes.join(", ") || "none"}`);
  lines.push(`MedAsk Rows: ${manifest.biomedicalAgentEvaluationSummary.medAskRowCount}`);
  lines.push(`MedAsk Clinical Tasks: ${manifest.biomedicalAgentEvaluationSummary.medAskClinicalTasks.join(", ") || "none"}`);
  lines.push(`BioKGBench Rows: ${manifest.biomedicalAgentEvaluationSummary.bioKgBenchRowCount}`);
  lines.push(`BioKGBench Task Kinds: ${manifest.biomedicalAgentEvaluationSummary.bioKgBenchTaskKinds.join(", ") || "none"}`);
  lines.push(`BioMedArena Rows: ${manifest.biomedicalAgentEvaluationSummary.bioMedArenaRowCount}`);
  lines.push(`BioMedArena Benchmark Families: ${manifest.biomedicalAgentEvaluationSummary.bioMedArenaBenchmarkFamilies.join(", ") || "none"}`);
  lines.push(`BioMedArena Tool Modes: ${manifest.biomedicalAgentEvaluationSummary.bioMedArenaToolModes.join(", ") || "none"}`);
  lines.push(`Failed Biomedical Agent Evaluation Rows: ${manifest.biomedicalAgentEvaluationSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Failed MedAsk Rows: ${manifest.biomedicalAgentEvaluationSummary.failedMedAskRowIds.join(", ") || "none"}`);
  lines.push(`Failed BioKGBench Rows: ${manifest.biomedicalAgentEvaluationSummary.failedBioKgBenchRowIds.join(", ") || "none"}`);
  lines.push(`Failed BioMedArena Rows: ${manifest.biomedicalAgentEvaluationSummary.failedBioMedArenaRowIds.join(", ") || "none"}`);
  lines.push("");
  lines.push("## Rows");
  lines.push("");
  lines.push("| Row | Status | Risk | Runtime | Adversarial Fixture | Behavior Changed | Tool Calls Changed | Pairwise Winner | Modality Pair | Modality Delta | Interactive Episode | Video Post-Production | PawBench | TerminalWorld | Coding Agent Report | Benchmark Hackability Audit | Logic Benchmark | Skill Lifecycle | SkillBench Regression | RAG Evaluation | RAG Chunking Strategy | Advanced RAG | DocThinker Document RAG | GAGE | VLA World Model | AI Research Task | ML-Dev Benchmark | Text2SQL Agent | Agent Benchmark Replay | DeepMath Agent Replay | JudgeIt Replay | BenchLoop | Scenario Simulation | Warehouse-Native LLM Eval | AD-GEN SOC Dataset | FreshStack Retrieval | DB Context Enrichment | Scientific Evaluation | Tool Sandbox | Platform Evaluation | Azure Agent Lab | ClawEnvKit | DeepResearch | Web Search Evaluation | Binary Audit | LTM | Streaming Improvement | Enterprise Tool-Calling | Biomedical Agent Evaluation | Artifacts | Fixture Hash | Baseline | Candidate | Delta | Candidate ASR | Signed Evidence | Issues |");
  lines.push("|---|---|---|---|---|---|---|---|---|---:|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---:|---|---:|---:|---:|---:|---:|---|");
  for (const row of manifest.rows) {
    const modalityPairLabel = row.modalityPair
      ? `${row.modalityPair.sourceModality ?? "unknown"}->${row.modalityPair.targetModality ?? "unknown"}`
      : "n/a";
    const interactiveEpisodeLabel = row.interactiveEpisode
      ? `${row.interactiveEpisode.environmentId ?? "unknown"}:${row.interactiveEpisode.stepsTaken ?? "?"}/${row.interactiveEpisode.maxSteps ?? "?"}`
      : "n/a";
    const videoPostProductionLabel = row.videoPostProduction
      ? `${row.videoPostProduction.taskFamily ?? "unknown"}:${row.videoPostProduction.reward0to1 ?? "?"}`
      : "n/a";
    const pawBenchLabel = row.pawBenchEvaluation
      ? `${row.pawBenchEvaluation.modelId ?? "unknown"}:${row.pawBenchEvaluation.harnessId ?? "unknown"}:${row.pawBenchEvaluation.taskId ?? "unknown"}`
      : "n/a";
    const terminalWorldLabel = row.terminalWorld
      ? `${row.terminalWorld.benchmarkId ?? "unknown"}:${row.terminalWorld.subset ?? "unknown"}:${row.terminalWorld.replayPassRate0to1 ?? "?"}`
      : "n/a";
    const codingAgentReportLabel = row.codingAgentReport
      ? `${row.codingAgentReport.reportId ?? "unknown"}:${row.codingAgentReport.agentUnderTestId ?? "unknown"}:${row.codingAgentReport.normalizedScore0to1 ?? "?"}`
      : "n/a";
    const benchmarkHackabilityAuditLabel = row.benchmarkHackabilityAudit
      ? `${row.benchmarkHackabilityAudit.scannerId ?? "unknown"}:${row.benchmarkHackabilityAudit.targetBenchmarkId ?? "unknown"}:${row.benchmarkHackabilityAudit.exploitabilityScore0to1 ?? "?"}`
      : "n/a";
    const logicBenchmarkLabel = row.logicBenchmark
      ? `${row.logicBenchmark.datasetId ?? "unknown"}:${row.logicBenchmark.logicAccuracy0to1 ?? "?"}:${row.logicBenchmark.replayPassRate0to1 ?? "?"}`
      : "n/a";
    const skillLifecycleLabel = row.skillLifecycle
      ? `${row.skillLifecycle.lifecycleMode ?? "unknown"}:${row.skillLifecycle.averageAxisScore0to10 ?? "?"}${
        hasAgentWorkflowKitSignal(row.skillLifecycle)
          ? `:agent-workflow-kit:${row.skillLifecycle.agentWorkflowKitRecommendedLevel ?? "?"}->${row.skillLifecycle.agentWorkflowKitAppliedLevel ?? "?"}`
          : ""
      }`
      : "n/a";
    const skillBenchmarkRegressionLabel = row.skillBenchmarkRegression
      ? `${row.skillBenchmarkRegression.benchmarkId ?? "unknown"}:${row.skillBenchmarkRegression.skillDomain ?? "unknown"}:${row.skillBenchmarkRegression.withSkillScore0to100 ?? "?"}`
      : "n/a";
    const ragEvaluationLabel = row.ragEvaluation
      ? hasEncourageRagSignal(row.ragEvaluation)
        ? `encourage:${row.ragEvaluation.encourageRagMethodId ?? "unknown"}:${row.ragEvaluation.encourageReplayPassRate0to1 ?? "?"}`
        : `${row.ragEvaluation.datasetId ?? "unknown"}:${row.ragEvaluation.ragModalityMode ?? "generic"}:${row.ragEvaluation.qualityScoreMean0to1 ?? row.ragEvaluation.multimodalJudgeScoreMean0to1 ?? "?"}`
      : "n/a";
    const chunkingStrategyEvaluationLabel = row.chunkingStrategyEvaluation
      ? `${row.chunkingStrategyEvaluation.benchmarkId ?? "unknown"}:${row.chunkingStrategyEvaluation.retrievalMode ?? "unknown"}:${row.chunkingStrategyEvaluation.candidateCombinedScore0to1 ?? "?"}`
      : "n/a";
    const advancedRagLabel = row.advancedRag
      ? `${row.advancedRag.lessonId ?? "unknown"}:${row.advancedRag.retrievalVariant ?? "unknown"}:${row.advancedRag.groundedness0to1 ?? "?"}`
      : "n/a";
    const docThinkerDocumentRagLabel = row.docThinkerDocumentRag
      ? `${row.docThinkerDocumentRag.benchmarkId ?? "unknown"}:${row.docThinkerDocumentRag.carrierMode ?? "unknown"}:${row.docThinkerDocumentRag.queryCount ?? "?"}:${row.docThinkerDocumentRag.answerAccuracy0to1 ?? "?"}`
      : "n/a";
    const gageEvaluationLabel = row.gageEvaluation
      ? `${row.gageEvaluation.modality ?? "unknown"}:${row.gageEvaluation.harnessMode ?? "unknown"}:${row.gageEvaluation.scoreMean0to1 ?? "?"}`
      : "n/a";
    const vlaWorldModelLabel = row.vlaWorldModel
      ? `${row.vlaWorldModel.paradigm ?? "unknown"}:${row.vlaWorldModel.metricFamily ?? "unknown"}:${row.vlaWorldModel.worldModelScore0to1 ?? "?"}`
      : "n/a";
    const aiResearchTaskLabel = row.aiResearchTask
      ? `${row.aiResearchTask.taskId ?? "unknown"}:${row.aiResearchTask.normalizedScore0to1 ?? "?"}`
      : "n/a";
    const mlDevBenchmarkLabel = row.mlDevBenchmark
      ? `${row.mlDevBenchmark.taskId ?? "unknown"}:${row.mlDevBenchmark.taskCategory ?? "unknown"}:${row.mlDevBenchmark.candidateMetric0to1 ?? "?"}`
      : "n/a";
    const text2SqlAgentLabel = row.text2SqlAgent
      ? `${row.text2SqlAgent.datasetId ?? "unknown"}:${row.text2SqlAgent.databaseEngine ?? "unknown"}:${row.text2SqlAgent.executionAccuracy0to1 ?? "?"}`
      : "n/a";
    const agentBenchmarkReplayLabel = row.agentBenchmarkReplay
      ? `${row.agentBenchmarkReplay.architecture ?? "unknown"}:${row.agentBenchmarkReplay.workload ?? "unknown"}:${
        hasAiAgentBenchmarkComparisonSignal(row.agentBenchmarkReplay)
          ? "ai-agent-comparison"
          : hasGaiaAgentReplaySignal(row.agentBenchmarkReplay)
            ? "gaia-agent"
          : hasPaperArenaReplaySignal(row.agentBenchmarkReplay)
            ? "paperarena"
          : hasSocialReasoningBenchSignal(row.agentBenchmarkReplay)
            ? "social-reasoning-bench"
          : hasBestTesterSignal(row.agentBenchmarkReplay)
            ? "besttester"
          : hasAgentKernelArenaSignal(row.agentBenchmarkReplay)
            ? "agentkernelarena"
          : hasLlmEvaluationSystemSignal(row.agentBenchmarkReplay)
            ? "llm-evaluation-system"
          : hasInnovatorBenchSignal(row.agentBenchmarkReplay)
            ? "innovatorbench"
          : hasGtoWizardPokerReplaySignal(row.agentBenchmarkReplay)
            ? "gto-wizard-poker"
          : hasCostNavReplaySignal(row.agentBenchmarkReplay)
            ? "costnav"
          : hasAgentMontSignal(row.agentBenchmarkReplay)
          ? "agentmont"
          : hasMiniAppBenchSignal(row.agentBenchmarkReplay)
            ? "miniappbench"
          : hasKnowlyticsAiSignal(row.agentBenchmarkReplay)
            ? "knowlytics-ai"
          : hasSpentSessionCostSignal(row.agentBenchmarkReplay)
            ? "spent"
          : hasFireFactCheckingSignal(row.agentBenchmarkReplay)
            ? "fire"
          : hasNucliaRagTriadSignal(row.agentBenchmarkReplay)
            ? "nuclia-rag-triad"
          : hasEdgeAiAgentSignal(row.agentBenchmarkReplay)
            ? "edgeai"
            : hasResearchHarnessSignal(row.agentBenchmarkReplay)
              ? "researchharness"
              : row.agentBenchmarkReplay.replayPassRate0to1 ?? "?"
      }`
      : "n/a";
    const deepMathAgentReplayLabel = row.deepMathAgentReplay
      ? `${row.deepMathAgentReplay.runMode ?? "unknown"}:${row.deepMathAgentReplay.datasetFamily ?? "unknown"}:${row.deepMathAgentReplay.replayPassRate0to1 ?? "?"}`
      : "n/a";
    const judgeItReplayLabel = row.judgeItReplay
      ? `${row.judgeItReplay.benchmarkId ?? "unknown"}:${row.judgeItReplay.pipelineType ?? "unknown"}:${row.judgeItReplay.replayPassRate0to1 ?? "?"}`
      : "n/a";
    const benchLoopLabel = row.benchLoop
      ? `${row.benchLoop.benchmarkId ?? "unknown"}:${row.benchLoop.suite ?? "unknown"}:${row.benchLoop.provider ?? "unknown"}:${row.benchLoop.harness ?? "unknown"}:${row.benchLoop.overallScore0to1 ?? "?"}`
      : "n/a";
    const scenarioSimulationLabel = row.scenarioSimulation
      ? `${row.scenarioSimulation.benchmarkId ?? "unknown"}:${row.scenarioSimulation.agentMode ?? "unknown"}:${row.scenarioSimulation.evaluationMode ?? "unknown"}:${row.scenarioSimulation.actionEvaluationCoverage0to1 ?? "?"}`
      : "n/a";
    const warehouseNativeLlmEvalLabel = row.warehouseNativeLlmEval
      ? `${row.warehouseNativeLlmEval.benchmarkId ?? "unknown"}:${row.warehouseNativeLlmEval.warehouse ?? "unknown"}:${row.warehouseNativeLlmEval.evaluationMode ?? "unknown"}:${row.warehouseNativeLlmEval.passRate0to1 ?? "?"}`
      : "n/a";
    const adGenSocDatasetLabel = row.adGenSocDataset
      ? `${row.adGenSocDataset.benchmarkId ?? "unknown"}:${row.adGenSocDataset.environment ?? "unknown"}:${row.adGenSocDataset.labelSource ?? "unknown"}:${row.adGenSocDataset.validatedRecordCount ?? "?"}`
      : "n/a";
    const freshStackRetrievalLabel = row.freshStackRetrieval
      ? `${row.freshStackRetrieval.benchmarkId ?? "unknown"}:${row.freshStackRetrieval.topic ?? "unknown"}:${row.freshStackRetrieval.retrieverKind ?? "unknown"}:${row.freshStackRetrieval.alphaNdcgAt10_0to1 ?? "?"}`
      : "n/a";
    const dbContextEnrichmentLabel = row.dbContextEnrichment
      ? `${row.dbContextEnrichment.benchmarkId ?? "unknown"}:${row.dbContextEnrichment.databaseEngine ?? "unknown"}:${row.dbContextEnrichment.workflowStage ?? "unknown"}:${row.dbContextEnrichment.candidateSqlAccuracy0to1 ?? "?"}`
      : "n/a";
    const scientificEvaluationLabel = row.scientificEvaluation
      ? `${row.scientificEvaluation.suiteId ?? "unknown"}:${row.scientificEvaluation.averageScore0to1 ?? "?"}`
      : "n/a";
    const toolSandboxLabel = row.toolSandbox
      ? `${row.toolSandbox.protocol ?? "unknown"}:${row.toolSandbox.toolCount ?? "?"}`
      : "n/a";
    const platformEvaluationLabel = row.platformEvaluation
      ? `${row.platformEvaluation.datasetFormat ?? "unknown"}:${row.platformEvaluation.evaluatedRowCount ?? "?"}`
      : "n/a";
    const azureAgentLabLabel = row.azureAgentLab
      ? `${row.azureAgentLab.moduleId ?? "unknown"}:${row.azureAgentLab.designPattern ?? "unknown"}:${row.azureAgentLab.evaluationScore0to1 ?? "?"}`
      : "n/a";
    const clawEnvKitLabel = row.clawEnvKit
      ? `${row.clawEnvKit.harnessId ?? "unknown"}:${row.clawEnvKit.harnessTier ?? "unknown"}:${row.clawEnvKit.finalScore0to1 ?? "?"}`
      : "n/a";
    const deepResearchLabel = row.deepResearch
      ? `${row.deepResearch.researchTaskId ?? "unknown"}:${row.deepResearch.searchProvider ?? "unknown"}:${row.deepResearch.finalReportScore0to1 ?? "?"}`
      : "n/a";
    const webSearchEvaluationLabel = row.webSearchEvaluation
      ? `${row.webSearchEvaluation.datasetId ?? "unknown"}:${row.webSearchEvaluation.finalScore0to1 ?? "?"}`
      : "n/a";
    const binaryAuditLabel = row.binaryAudit
      ? `${row.binaryAudit.category ?? "unknown"}:${row.binaryAudit.actualDecision ?? "?"}`
      : "n/a";
    const longTermMemoryMode = row.longTermMemory
      ? row.longTermMemory.realTalkTask
        ?? (hasCloneMemSignal(row.longTermMemory) ? "clonemem" : hasMemEvalSignal(row.longTermMemory) ? "memeval" : "generic")
      : "n/a";
    const longTermMemoryLabel = row.longTermMemory
      ? `${row.longTermMemory.benchmarkVersion ?? "unknown"}:${row.longTermMemory.memorySpanTokens ?? "?"}:${longTermMemoryMode}`
      : "n/a";
    const streamingImprovementLabel = row.streamingImprovement
      ? `${row.streamingImprovement.datasetId ?? "unknown"}:${row.streamingImprovement.improvementDelta0to1 ?? "?"}`
      : "n/a";
    const enterpriseToolCallingLabel = row.enterpriseToolCalling
      ? `${row.enterpriseToolCalling.capability ?? "unknown"}:${row.enterpriseToolCalling.domainId ?? "unknown"}:${row.enterpriseToolCalling.finalAnswerScore0to1 ?? "?"}`
      : "n/a";
    const biomedicalAgentEvaluationLabel = row.biomedicalAgentEvaluation
      ? `${row.biomedicalAgentEvaluation.benchmarkId ?? "unknown"}:${row.biomedicalAgentEvaluation.taskType ?? "unknown"}:${
        hasBioMedArenaSignal(row.biomedicalAgentEvaluation)
          ? `biomedarena:${row.biomedicalAgentEvaluation.bioMedArenaReplayPassRate0to1 ?? "?"}`
          : hasBioKgBenchSignal(row.biomedicalAgentEvaluation)
          ? `biokgbench:${row.biomedicalAgentEvaluation.bioKgBenchReplayPassRate0to1 ?? "?"}`
          : hasMedAskSignal(row.biomedicalAgentEvaluation)
          ? `medask:${row.biomedicalAgentEvaluation.medAskReplayPassRate0to1 ?? "?"}`
          : row.biomedicalAgentEvaluation.score0to1 ?? "?"
      }`
      : "n/a";
    lines.push(`| ${row.rowId} | ${row.status} | ${row.safetyRisk?.category ?? "none"} | ${row.runtime?.kind ?? "none"} | ${row.adversarialRegression?.exploitFixtureId ?? "none"} | ${row.behaviorDiff?.behaviorChanged ?? "n/a"} | ${row.behaviorDiff?.toolCallSequenceChanged ?? "n/a"} | ${row.pairwiseComparison?.winner ?? "n/a"} | ${modalityPairLabel} | ${row.modalityPair?.modalityScoreDelta0to1 ?? "n/a"} | ${interactiveEpisodeLabel} | ${videoPostProductionLabel} | ${pawBenchLabel} | ${terminalWorldLabel} | ${codingAgentReportLabel} | ${benchmarkHackabilityAuditLabel} | ${logicBenchmarkLabel} | ${skillLifecycleLabel} | ${skillBenchmarkRegressionLabel} | ${ragEvaluationLabel} | ${chunkingStrategyEvaluationLabel} | ${advancedRagLabel} | ${docThinkerDocumentRagLabel} | ${gageEvaluationLabel} | ${vlaWorldModelLabel} | ${aiResearchTaskLabel} | ${mlDevBenchmarkLabel} | ${text2SqlAgentLabel} | ${agentBenchmarkReplayLabel} | ${deepMathAgentReplayLabel} | ${judgeItReplayLabel} | ${benchLoopLabel} | ${scenarioSimulationLabel} | ${warehouseNativeLlmEvalLabel} | ${adGenSocDatasetLabel} | ${freshStackRetrievalLabel} | ${dbContextEnrichmentLabel} | ${scientificEvaluationLabel} | ${toolSandboxLabel} | ${platformEvaluationLabel} | ${azureAgentLabLabel} | ${clawEnvKitLabel} | ${deepResearchLabel} | ${webSearchEvaluationLabel} | ${binaryAuditLabel} | ${longTermMemoryLabel} | ${streamingImprovementLabel} | ${enterpriseToolCallingLabel} | ${biomedicalAgentEvaluationLabel} | ${row.outputArtifactHashes.length} | ${row.fixtureHash.slice(0, 12)} | ${row.baselineScore0to1} | ${row.candidateScore0to1} | ${row.scoreDelta0to1} | ${row.safetyRisk?.candidateAttackSuccessRate0to1 ?? "n/a"} | ${row.signedEvidenceRefs.length} | ${row.issues.join("; ") || "none"} |`);
  }
  lines.push("");
  lines.push("## CI Receipt");
  lines.push("");
  lines.push(`- Mode: ${ciReceipt.mode}`);
  lines.push(`- Passed: ${ciReceipt.passed ? "yes" : "no"}`);
  lines.push(`- Fail Closed: ${ciReceipt.failClosed ? "yes" : "no"}`);
  lines.push(`- Receipt Hash: ${ciReceipt.receiptHash}`);
  lines.push(`- Summary: ${ciReceipt.summary}`);
  return lines.join("\n");
}
