    failedSpentSessionCostReplayRowIds: manifest.agentBenchmarkReplaySummary.failedSpentSessionCostReplayRowIds,
    fireFactCheckingReplayRowCount: manifest.agentBenchmarkReplaySummary.fireFactCheckingReplayRowCount,
    failedFireFactCheckingReplayRowIds: manifest.agentBenchmarkReplaySummary.failedFireFactCheckingReplayRowIds,
    nucliaRagTriadReplayRowCount: manifest.agentBenchmarkReplaySummary.nucliaRagTriadReplayRowCount,
    failedNucliaRagTriadReplayRowIds: manifest.agentBenchmarkReplaySummary.failedNucliaRagTriadReplayRowIds,
    edgeAiAgentRowCount: manifest.agentBenchmarkReplaySummary.edgeAiAgentRowCount,
    failedEdgeAiAgentRowIds: manifest.agentBenchmarkReplaySummary.failedEdgeAiAgentRowIds,
    deepMathAgentReplayRowCount: manifest.deepMathAgentReplaySummary.rowCount,
    failedDeepMathAgentReplayRowIds: failedDeepMathAgentReplayRows.map((row) => row.rowId),
    judgeItReplayRowCount: manifest.judgeItReplaySummary.rowCount,
    failedJudgeItReplayRowIds: failedJudgeItReplayRows.map((row) => row.rowId),
    benchLoopRowCount: manifest.benchLoopSummary.rowCount,
    failedBenchLoopRowIds: failedBenchLoopRows.map((row) => row.rowId),
    scenarioSimulationRowCount: manifest.scenarioSimulationSummary.rowCount,
    failedScenarioSimulationRowIds: failedScenarioSimulationRows.map((row) => row.rowId),
    warehouseNativeLlmEvalRowCount: manifest.warehouseNativeLlmEvalSummary.rowCount,
    failedWarehouseNativeLlmEvalRowIds: failedWarehouseNativeLlmEvalRows.map((row) => row.rowId),
    adGenSocDatasetRowCount: manifest.adGenSocDatasetSummary.rowCount,
    failedAdGenSocDatasetRowIds: failedAdGenSocDatasetRows.map((row) => row.rowId),
    freshStackRetrievalRowCount: manifest.freshStackRetrievalSummary.rowCount,
    failedFreshStackRetrievalRowIds: failedFreshStackRetrievalRows.map((row) => row.rowId),
    dbContextEnrichmentRowCount: manifest.dbContextEnrichmentSummary.rowCount,
    failedDbContextEnrichmentRowIds: failedDbContextEnrichmentRows.map((row) => row.rowId),
    replayable: manifest.replayable,
    summary: passed
      ? `Replay corpus ${mode} gate passed for ${manifest.agentId}.`
      : `Replay corpus ${mode} gate blocked ${failedRows.length} row(s) for ${manifest.agentId}.`,
  };

  return {
    ...receiptWithoutHash,
    receiptHash: sha256Hex(canonicalize(receiptWithoutHash)),
  };
}

export function buildReplayBenchmarkWatchAlerts(
  manifest: ReplayBenchmarkCorpusManifest,
  ciReceipt: ReplayBenchmarkCiReceipt,
): ReplayBenchmarkWatchAlert[] {
  if (ciReceipt.passed) return [];
  return manifest.rows
    .filter((row) => row.status !== "passed")
    .map((row) => ({
      id: `watch:${ciReceipt.receiptId}:${row.rowId}`,
      agentId: manifest.agentId,
      source: "replay-benchmark-corpus",
      severity: rowSeverity(row),
      corpusId: manifest.corpusId,
      rowId: row.rowId,
      evidenceRefs: row.evidenceRefs,
      signedEvidenceRefs: row.signedEvidenceRefs,
      message: `Replay corpus row ${row.rowId} ${row.status}: ${row.issues.join("; ")}`,
      createdAt: manifest.createdAt,
    }));
}

export function verifyReplayBenchmarkCorpusReceipt(
  manifest: ReplayBenchmarkCorpusManifest,
  receipt: ReplayBenchmarkCiReceipt,
): ReplayBenchmarkReceiptVerification {
  const errors: string[] = [];
  const { manifestHash: providedManifestHash, ...manifestWithoutHash } = manifest;
  const expectedManifestHash = computeReplayBenchmarkManifestHash(manifestWithoutHash);
  if (expectedManifestHash !== providedManifestHash || receipt.manifestHash !== expectedManifestHash) {
    errors.push("manifest hash does not match receipt");
  }
  if (receipt.fixtureHash !== manifest.fixtureHash) {
    errors.push("fixture hash does not match receipt");
  }
  if (receipt.scoreDelta0to1 !== manifest.scoreDelta0to1) {
    errors.push("score delta does not match receipt");
  }
  const failedRowIds = manifest.rows.filter((row) => row.status !== "passed").map((row) => row.rowId);
  if (canonicalize(receipt.failedRowIds) !== canonicalize(failedRowIds)) {
    errors.push("failed row ids do not match manifest");
  }
  const expectedPassed = manifest.replayable && failedRowIds.length === 0;
  if (receipt.passed !== expectedPassed || receipt.failClosed !== !expectedPassed) {
    errors.push("gate state does not match manifest");
  }
  const { receiptHash, ...receiptWithoutHash } = receipt;
  if (sha256Hex(canonicalize(receiptWithoutHash)) !== receiptHash) {
    errors.push("receipt hash is invalid");
  }
  return {
    valid: errors.length === 0,
    errors,
  };
}

export function renderReplayBenchmarkCorpusMarkdown(
  manifest: ReplayBenchmarkCorpusManifest,
  ciReceipt: ReplayBenchmarkCiReceipt,
): string {
  const lines: string[] = [];
  lines.push("# Replay Benchmark Corpus");
  lines.push("");
  lines.push(`Agent: ${manifest.agentId}`);
  lines.push(`Corpus: ${manifest.corpusId}@${manifest.corpusVersion}`);
  lines.push(`Baseline Run: ${manifest.baselineRunId}`);
  lines.push(`Candidate Run: ${manifest.candidateRunId}`);
  lines.push(`Fixture Hash: ${manifest.fixtureHash}`);
  lines.push(`Manifest Hash: ${manifest.manifestHash}`);
  lines.push(`Replayable: ${manifest.replayable ? "yes" : "no"}`);
  lines.push(`Score Delta: ${manifest.scoreDelta0to1}`);
  lines.push(`Safety Risk Rows: ${manifest.safetyRiskSummary.rowCount}`);
  lines.push(`Failed Safety Risk Rows: ${manifest.safetyRiskSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Runtime Rows: ${manifest.runtimeSummary.rowCount}`);
  lines.push(`Failed Runtime Rows: ${manifest.runtimeSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Adversarial Regression Rows: ${manifest.adversarialRegressionSummary.rowCount}`);
  lines.push(`Failed Adversarial Regression Rows: ${manifest.adversarialRegressionSummary.failedRowIds.join(", ") || "none"}`);
  lines.push(`Adversarial Engine Eval Receipts: ${manifest.adversarialRegressionSummary.engineEvaluationReceiptCount}`);
  lines.push(`Adversarial Alert Rule Receipts: ${manifest.adversarialRegressionSummary.alertRuleReceiptCount}`);
  lines.push(`Adversarial Failed Guardrail Rules: ${manifest.adversarialRegressionSummary.failedGuardrailRuleCount}`);
  lines.push(`Adversarial Red-Team Benchmark Rows: ${manifest.adversarialRegressionSummary.redTeamBenchmarkRowCount}`);
  lines.push(`Adversarial Red-Team Providers: ${manifest.adversarialRegressionSummary.providerBackends.join(", ") || "none"}`);
  lines.push(`Adversarial Red-Team Scoring Modes: ${manifest.adversarialRegressionSummary.scoringModes.join(", ") || "none"}`);
