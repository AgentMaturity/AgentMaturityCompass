    ),
    ragEvalDatasetMaxScoreRegression0to1: nullableRate(rag.ragEvalDatasetMaxScoreRegression0to1),
    ragEvalDatasetReplayPassRate0to1: nullableRate(rag.ragEvalDatasetReplayPassRate0to1),
    ragEvalDatasetMinReplayPassRate0to1: nullableRate(rag.ragEvalDatasetMinReplayPassRate0to1),
    ragEvalDatasetEndpointResponseCoverage0to1: nullableRate(rag.ragEvalDatasetEndpointResponseCoverage0to1),
    ragEvalDatasetMinEndpointResponseCoverage0to1: nullableRate(rag.ragEvalDatasetMinEndpointResponseCoverage0to1),
    mirageSourceRefHash: normalizeHashLabel(rag.mirageSourceRefHash),
