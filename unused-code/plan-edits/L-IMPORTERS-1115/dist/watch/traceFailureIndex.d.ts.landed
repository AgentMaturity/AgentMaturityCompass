import type { DiagnosticReport } from "../types.js";
export type TraceFailureClass = "prompt_error" | "tool_misuse" | "invalid_schema" | "refusal_overreach" | "hallucinated_claim" | "unsafe_action" | "latency_timeout" | "cost_spike" | "retrieval_error" | "memory_error" | "human_review_gap" | "orchestration_dead_end" | "policy_violation" | "unknown_failure";
export type TraceFailureOutcome = "ok" | "warning" | "error" | "unknown";
