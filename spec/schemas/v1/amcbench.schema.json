{
  "$id": "https://agentmaturity.co/spec/schemas/v1/amcbench.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "benchId": {
      "pattern": "^bench_[a-zA-Z0-9_-]{8,}$",
      "type": "string"
    },
    "evidence": {
      "properties": {
        "correlationRatio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceCoverage": {
          "anyOf": [
            {
              "properties": {
                "attestedShare": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "observedShare": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "selfReportedShare": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "observedShare",
                "attestedShare",
                "selfReportedShare"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrityIndex": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "trustLabel": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "type": "string"
        },
        "window": {
          "properties": {
            "days": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "endTs": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "startTs": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "days",
            "startTs",
            "endTs"
          ],
          "type": "object"
        }
      },
      "required": [
        "window",
        "integrityIndex",
        "correlationRatio",
        "trustLabel",
        "evidenceCoverage"
      ],
      "type": "object"
    },
    "generatedTs": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "labels": {
      "default": {},
      "properties": {
        "agentType": {
          "enum": [
            "code-agent",
            "support-agent",
            "ops-agent",
            "research-agent",
            "sales-agent",
            "other"
          ],
          "type": "string"
        },
        "deployment": {
          "enum": [
            "single",
            "host",
            "k8s",
            "compose"
          ],
          "type": "string"
        },
        "industry": {
          "enum": [
            "software",
            "fintech",
            "health",
            "manufacturing",
            "other"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "metrics": {
      "properties": {
        "forecastSummary": {
          "properties": {
            "confidenceLabel": {
              "enum": [
                "HIGH",
                "MEDIUM",
                "LOW",
                "NONE"
              ],
              "type": "string"
            },
            "maturityDeltaShort": {
              "type": [
                "number",
                "null"
              ]
            },
            "reasons": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "riskDeltaShort": {
              "type": [
                "number",
                "null"
              ]
            },
            "status": {
              "enum": [
                "OK",
                "INSUFFICIENT_EVIDENCE"
              ],
              "type": "string"
            }
          },
          "required": [
            "status",
            "maturityDeltaShort",
            "riskDeltaShort",
            "confidenceLabel",
            "reasons"
          ],
          "type": "object"
        },
        "maturity": {
          "properties": {
            "fiveDimensions": {
              "properties": {
                "d1": {
                  "anyOf": [
                    {
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "d2": {
                  "anyOf": [
                    {
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "d3": {
                  "anyOf": [
                    {
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "d4": {
                  "anyOf": [
                    {
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "d5": {
                  "anyOf": [
                    {
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "d1",
                "d2",
                "d3",
                "d4",
                "d5"
              ],
              "type": "object"
            },
            "fiveLayers": {
              "properties": {
                "culture": {
                  "anyOf": [
                    {
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "leadership": {
                  "anyOf": [
                    {
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "resilience": {
                  "anyOf": [
                    {
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "skills": {
                  "anyOf": [
                    {
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "strategicOps": {
                  "anyOf": [
                    {
                      "maximum": 5,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "strategicOps",
                "leadership",
                "culture",
                "resilience",
                "skills"
              ],
              "type": "object"
            },
            "overall": {
              "anyOf": [
                {
                  "maximum": 5,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "questions42": {
              "items": {
                "properties": {
                  "qIdHash": {
                    "pattern": "^q_[a-f0-9]{8,64}$",
                    "type": "string"
                  },
                  "score": {
                    "maximum": 5,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "qIdHash",
                  "score"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "overall",
            "fiveLayers",
            "fiveDimensions"
          ],
          "type": "object"
        },
        "operatingHealth": {
          "properties": {
            "approvalsBacklogCount": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "approvalsMedianAgeHours": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "assurance": {
              "properties": {
                "exfilAttemptsDetected": {
                  "anyOf": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "injectionFailures": {
                  "anyOf": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "latestScore": {
                  "anyOf": [
                    {
                      "maximum": 100,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "latestScore",
                "injectionFailures",
                "exfilAttemptsDetected"
              ],
              "type": "object"
            },
            "budgetExceedEvents": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "freezeEvents": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "notary": {
              "properties": {
                "attestationAgeMinutes": {
                  "anyOf": [
                    {
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "downEvents": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "enabled",
                "downEvents",
                "attestationAgeMinutes"
              ],
              "type": "object"
            },
            "plugins": {
              "properties": {
                "installedCount": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "integrity": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "integrity",
                "installedCount"
              ],
              "type": "object"
            },
            "toolhubDenialRate": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "approvalsBacklogCount",
            "approvalsMedianAgeHours",
            "budgetExceedEvents",
            "toolhubDenialRate",
            "freezeEvents",
            "assurance",
            "plugins",
            "notary"
          ],
          "type": "object"
        },
        "strategyFailureRisks": {
          "properties": {
            "clarityPathRisk": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "digitalDualityRisk": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "economicSignificanceRisk": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "ecosystemFocusRisk": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "riskAssuranceRisk": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "ecosystemFocusRisk",
            "clarityPathRisk",
            "economicSignificanceRisk",
            "riskAssuranceRisk",
            "digitalDualityRisk"
          ],
          "type": "object"
        },
        "valueDimensions": {
          "properties": {
            "brandValue": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "economicValue": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "emotionalValue": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "functionalValue": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lifetimeValue": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "valueScore": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "emotionalValue",
            "functionalValue",
            "economicValue",
            "brandValue",
            "lifetimeValue"
          ],
          "type": "object"
        }
      },
      "required": [
        "maturity",
        "strategyFailureRisks",
        "valueDimensions",
        "operatingHealth",
        "forecastSummary"
      ],
      "type": "object"
    },
    "proofBindings": {
      "properties": {
        "calculationManifestSha256": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "includedEventKinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "includedEventProofIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "merkleRootSha256": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "transparencyRootSha256": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        }
      },
      "required": [
        "transparencyRootSha256",
        "merkleRootSha256",
        "includedEventKinds",
        "includedEventProofIds",
        "calculationManifestSha256"
      ],
      "type": "object"
    },
    "publisher": {
      "properties": {
        "attestation": {
          "properties": {
            "attestationLevel": {
              "enum": [
                "SOFTWARE",
                "HARDWARE",
                "NONE"
              ],
              "type": "string"
            },
            "lastAttestationTs": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "notaryFingerprint": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "minLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "trustMode": {
              "enum": [
                "LOCAL_VAULT",
                "NOTARY"
              ],
              "type": "string"
            }
          },
          "required": [
            "trustMode",
            "attestationLevel",
            "notaryFingerprint",
            "lastAttestationTs"
          ],
          "type": "object"
        },
        "hostInstanceHash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": [
            "ANONYMIZED",
            "NAMED"
          ],
          "type": "string"
        },
        "workspaceIdHash": {
          "pattern": "^[a-f0-9]{8,64}$",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "workspaceIdHash",
        "hostInstanceHash",
        "attestation"
      ],
      "type": "object"
    },
    "scope": {
      "properties": {
        "idHash": {
          "pattern": "^[a-f0-9]{8,64}$",
          "type": "string"
        },
        "type": {
          "enum": [
            "WORKSPACE",
            "NODE",
            "AGENT"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "idHash"
      ],
      "type": "object"
    },
    "v": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "v",
    "benchId",
    "generatedTs",
    "scope",
    "publisher",
    "evidence",
    "metrics",
    "proofBindings"
  ],
  "title": "AMC Bench Artifact",
  "type": "object"
}
