{
  "$id": "https://agentmaturity.co/spec/schemas/v1/catalog-lock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "controls": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "pack": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "pack",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generatedBy": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "agent-maturity-compass",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version"
      ],
      "type": "object"
    },
    "lockfileVersion": {
      "const": 1,
      "type": "number"
    },
    "packs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "support": {
            "enum": [
              "experimental",
              "reviewed",
              "qualified",
              "retired"
            ],
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "support",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "producers": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "digest"
      ],
      "type": "object"
    },
    "register": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "path": {
          "const": "src/compliance/regulatory/register.json",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        }
      },
      "required": [
        "path",
        "schemaVersion",
        "digest"
      ],
      "type": "object"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "citationKey": {
            "minLength": 1,
            "type": "string"
          },
          "controlId": {
            "minLength": 1,
            "type": "string"
          },
          "edition": {
            "minLength": 1,
            "type": "string"
          },
          "registerId": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrievedAt": {
            "anyOf": [
              {
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "controlId",
          "citationKey",
          "registerId",
          "url",
          "edition",
          "sha256",
          "retrievedAt"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "vocabulary": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "lockfileVersion",
    "generatedBy",
    "catalog",
    "packs",
    "controls",
    "sources",
    "register",
    "producers",
    "vocabulary"
  ],
  "title": "AMC Catalog Lockfile",
  "type": "object"
}
