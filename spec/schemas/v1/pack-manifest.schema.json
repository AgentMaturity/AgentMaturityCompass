{
  "$id": "https://agentmaturity.co/spec/schemas/v1/pack-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compilerCompat": {
      "minLength": 1,
      "type": "string"
    },
    "controls": {
      "items": {
        "pattern": "^L[0-3](-[A-Z0-9]{2,8}){1,2}-[0-9]{2,3}$",
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$",
      "type": "string"
    },
    "jurisdictions": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "type": "string"
      },
      "type": "array"
    },
    "layer": {
      "anyOf": [
        {
          "const": 0,
          "type": "number"
        },
        {
          "const": 1,
          "type": "number"
        },
        {
          "const": 2,
          "type": "number"
        },
        {
          "const": 3,
          "type": "number"
        }
      ]
    },
    "licence": {
      "pattern": "^[A-Za-z0-9.+-]+$",
      "type": "string"
    },
    "maintainers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "role"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "publisher": {
      "minLength": 1,
      "type": "string"
    },
    "stations": {
      "items": {
        "enum": [
          "education",
          "environment",
          "health",
          "wealth",
          "technology",
          "mobility",
          "governance"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "stewardship": {
      "additionalProperties": false,
      "properties": {
        "coverageDoc": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "partner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "triageTargetDays": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatePlan": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "partner",
        "updatePlan",
        "triageTargetDays",
        "coverageDoc"
      ],
      "type": "object"
    },
    "support": {
      "enum": [
        "experimental",
        "reviewed",
        "qualified",
        "retired"
      ],
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "layer",
    "title",
    "stations",
    "jurisdictions",
    "compilerCompat",
    "publisher",
    "maintainers",
    "licence",
    "support",
    "controls",
    "stewardship"
  ],
  "title": "AMC Catalog Pack Manifest",
  "type": "object"
}
