{
  "$id": "https://agentmaturity.co/spec/schemas/v1/a4-conformance-statement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim": {
      "additionalProperties": false,
      "properties": {
        "claimKind": {
          "enum": [
            "synthetic_example",
            "self_reported",
            "observed",
            "independently_reviewed"
          ],
          "type": "string"
        },
        "eligibleLevel": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "entitlement": {
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "boolean"
            }
          },
          "required": [
            "active"
          ],
          "type": "object"
        },
        "provenance": {
          "additionalProperties": false,
          "properties": {
            "evidenceRefs": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "legacy": {
              "additionalProperties": false,
              "properties": {
                "notice": {
                  "type": "string"
                },
                "originalTier": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "version"
              ],
              "type": "object"
            },
            "method": {
              "enum": [
                "synthetic",
                "numeric_self_answer",
                "keyword_match",
                "unkeyed_checksum",
                "path_presence",
                "runtime_observation",
                "executed_test",
                "human_review"
              ],
              "type": "string"
            },
            "producer": {
              "type": "string"
            }
          },
          "required": [
            "producer",
            "method",
            "evidenceRefs"
          ],
          "type": "object"
        },
        "reasons": {
          "items": {
            "enum": [
              "SYNTHETIC_VALUES",
              "SELF_REPORTED_NO_POSITIVE_STATUS",
              "SELF_REPORTED_LEVEL_CAP",
              "WEAK_METHOD",
              "EMPTY_EVIDENCE",
              "UNBOUND_EVIDENCE",
              "STALE_EVIDENCE",
              "CONTRADICTORY_EVIDENCE",
              "CROSS_SCOPE_EVIDENCE",
              "SIGNATURE_INVALID",
              "ISSUER_NOT_PINNED",
              "REVIEW_NOT_INDEPENDENT",
              "LEGACY_1X_UNVERIFIED",
              "NOT_APPLICABLE",
              "APPLICABILITY_UNRESOLVED",
              "EVIDENCE_NOT_CLAIM_READY",
              "RESULT_NOT_BOUND"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "statusDimensions": {
          "additionalProperties": false,
          "properties": {
            "applicability": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "applicable",
                      "type": "string"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "rationale": {
                      "type": "string"
                    },
                    "state": {
                      "const": "not_applicable",
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "rationale"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "reason": {
                      "type": "string"
                    },
                    "state": {
                      "const": "unresolved",
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "reason"
                  ],
                  "type": "object"
                }
              ]
            },
            "enforcement": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "none",
                      "type": "string"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "advisory",
                      "type": "string"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "observed",
                      "type": "string"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "boundary": {
                      "type": "string"
                    },
                    "state": {
                      "const": "enforced",
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "boundary"
                  ],
                  "type": "object"
                }
              ]
            },
            "evidence": {
              "enum": [
                "sufficient",
                "incomplete",
                "stale",
                "contradictory",
                "untrusted"
              ],
              "type": "string"
            },
            "result": {
              "enum": [
                "pass",
                "fail",
                "not_evaluated"
              ],
              "type": "string"
            },
            "review": {
              "enum": [
                "pending",
                "approved",
                "rejected",
                "expired"
              ],
              "type": "string"
            }
          },
          "required": [
            "applicability",
            "evidence",
            "result",
            "enforcement",
            "review"
          ],
          "type": "object"
        }
      },
      "required": [
        "claimKind",
        "statusDimensions",
        "provenance",
        "eligibleLevel",
        "reasons"
      ],
      "type": "object"
    },
    "claimBoundary": {
      "minLength": 1,
      "type": "string"
    },
    "controls": {
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "applicability": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "applicable",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "rationale": {
                        "type": "string"
                      },
                      "state": {
                        "const": "not_applicable",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state",
                      "rationale"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "reason": {
                        "type": "string"
                      },
                      "state": {
                        "const": "unresolved",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state",
                      "reason"
                    ],
                    "type": "object"
                  }
                ]
              },
              "claimKind": {
                "enum": [
                  "synthetic_example",
                  "self_reported",
                  "observed",
                  "independently_reviewed"
                ],
                "type": "string"
              },
              "controlId": {
                "minLength": 1,
                "type": "string"
              },
              "enforcement": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "none",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "advisory",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "observed",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "boundary": {
                        "type": "string"
                      },
                      "state": {
                        "const": "enforced",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state",
                      "boundary"
                    ],
                    "type": "object"
                  }
                ]
              },
              "evidence": {
                "enum": [
                  "sufficient",
                  "incomplete",
                  "stale",
                  "contradictory",
                  "untrusted"
                ],
                "type": "string"
              },
              "evidenceRefs": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "notEvaluatedReason": {
                "minLength": 1,
                "type": "string"
              },
              "result": {
                "const": "not_evaluated",
                "type": "string"
              },
              "review": {
                "enum": [
                  "pending",
                  "approved",
                  "rejected",
                  "expired"
                ],
                "type": "string"
              },
              "reviewStatus": {
                "minLength": 1,
                "type": "string"
              },
              "support": {
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "controlId",
              "version",
              "support",
              "reviewStatus",
              "applicability",
              "evidence",
              "enforcement",
              "review",
              "claimKind",
              "evidenceRefs",
              "result",
              "notEvaluatedReason"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "applicability": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "applicable",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "rationale": {
                        "type": "string"
                      },
                      "state": {
                        "const": "not_applicable",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state",
                      "rationale"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "reason": {
                        "type": "string"
                      },
                      "state": {
                        "const": "unresolved",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state",
                      "reason"
                    ],
                    "type": "object"
                  }
                ]
              },
              "claimKind": {
                "enum": [
                  "synthetic_example",
                  "self_reported",
                  "observed",
                  "independently_reviewed"
                ],
                "type": "string"
              },
              "controlId": {
                "minLength": 1,
                "type": "string"
              },
              "enforcement": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "none",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "advisory",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "const": "observed",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "boundary": {
                        "type": "string"
                      },
                      "state": {
                        "const": "enforced",
                        "type": "string"
                      }
                    },
                    "required": [
                      "state",
                      "boundary"
                    ],
                    "type": "object"
                  }
                ]
              },
              "evidence": {
                "enum": [
                  "sufficient",
                  "incomplete",
                  "stale",
                  "contradictory",
                  "untrusted"
                ],
                "type": "string"
              },
              "evidenceRefs": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "notEvaluatedReason": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "pass",
                  "fail"
                ],
                "type": "string"
              },
              "review": {
                "enum": [
                  "pending",
                  "approved",
                  "rejected",
                  "expired"
                ],
                "type": "string"
              },
              "reviewStatus": {
                "minLength": 1,
                "type": "string"
              },
              "support": {
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "controlId",
              "version",
              "support",
              "reviewStatus",
              "applicability",
              "evidence",
              "enforcement",
              "review",
              "claimKind",
              "evidenceRefs",
              "result"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "fail": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "not_applicable": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "not_evaluated": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "pass": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "unresolved": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pass",
        "fail",
        "not_evaluated",
        "not_applicable",
        "unresolved"
      ],
      "type": "object"
    },
    "evaluatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
    },
    "expertReview": {
      "additionalProperties": false,
      "properties": {
        "acknowledgement": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "by": {
                  "minLength": 1,
                  "type": "string"
                },
                "expiresTs": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "reason": {
                  "minLength": 1,
                  "type": "string"
                },
                "ts": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "by",
                "ts",
                "expiresTs",
                "reason"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "records": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "records",
        "acknowledgement"
      ],
      "type": "object"
    },
    "missingFacts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "ownerOutOfScope": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "minLength": 1,
            "type": "string"
          },
          "controlId": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "ts": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "controlId",
          "by",
          "ts",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "planDigest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "revisionDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "amc.a4-conformance-statement/v1",
      "type": "string"
    },
    "stage": {
      "enum": [
        "aspire",
        "assemble",
        "adapt",
        "activate"
      ],
      "type": "string"
    },
    "unsupported": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "stage",
    "revisionDigest",
    "planDigest",
    "evaluatedAt",
    "controls",
    "counts",
    "ownerOutOfScope",
    "unsupported",
    "missingFacts",
    "expertReview",
    "claim",
    "claimBoundary"
  ],
  "title": "AMC A4 Conformance Statement",
  "type": "object"
}
