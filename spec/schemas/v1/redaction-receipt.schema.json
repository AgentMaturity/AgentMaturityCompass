{
  "$id": "https://agentmaturity.co/spec/schemas/v1/redaction-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "callId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "declaredFields": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "detectorsVersion": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "dataClass": {
            "enum": [
              "phi",
              "pii",
              "card_number",
              "bank_account",
              "credential"
            ],
            "type": "string"
          },
          "detector": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "dataClass",
          "detector",
          "count"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "redactedDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "amc.redaction-receipt/v1",
      "type": "string"
    },
    "sessionId": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "enum": [
        "user/message",
        "user/attachment",
        "tool/result",
        "loop/inbox",
        "operator/compaction",
        "gateway",
        "bridge"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "sessionId",
    "source",
    "callId",
    "detectorsVersion",
    "findings",
    "declaredFields",
    "redactedDigest"
  ],
  "title": "AMC Redaction Receipt",
  "type": "object"
}
