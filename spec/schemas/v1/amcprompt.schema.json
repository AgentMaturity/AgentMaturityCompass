{
  "$id": "https://agentmaturity.co/spec/schemas/v1/amcprompt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agent": {
      "properties": {
        "agentIdHash": {
          "pattern": "^[a-f0-9]{8,64}$",
          "type": "string"
        },
        "agentType": {
          "enum": [
            "code-agent",
            "support-agent",
            "ops-agent",
            "research-agent",
            "sales-agent",
            "other"
          ],
          "type": "string"
        },
        "riskTier": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "type": "string"
        },
        "workspaceIdHash": {
          "pattern": "^[a-f0-9]{8,64}$",
          "type": "string"
        }
      },
      "required": [
        "agentIdHash",
        "agentType",
        "riskTier",
        "workspaceIdHash"
      ],
      "type": "object"
    },
    "allowlists": {
      "properties": {
        "highRiskTools": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "models": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "providers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "tools": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "providers",
        "models",
        "tools",
        "highRiskTools"
      ],
      "type": "object"
    },
    "bindings": {
      "properties": {
        "bankSha256": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "canonSha256": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "cgxPackSha256": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "mechanicTargetsSha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notaryFingerprint": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "promptPolicySha256": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "providerFilesSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "trustMode": {
          "enum": [
            "LOCAL_VAULT",
            "NOTARY"
          ],
          "type": "string"
        }
      },
      "required": [
        "cgxPackSha256",
        "promptPolicySha256",
        "canonSha256",
        "bankSha256",
        "trustMode"
      ],
      "type": "object"
    },
    "checkpoints": {
      "properties": {
        "currentAdvisories": {
          "items": {
            "properties": {
              "advisoryId": {
                "minLength": 1,
                "type": "string"
              },
              "category": {
                "minLength": 1,
                "type": "string"
              },
              "severity": {
                "enum": [
                  "INFO",
                  "WARN",
                  "CRITICAL"
                ],
                "type": "string"
              },
              "summary": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "advisoryId",
              "severity",
              "category",
              "summary"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "lessonTransfer": {
          "additionalProperties": false,
          "properties": {
            "lessons": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "category": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "correctionId": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "lessonHash": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "lessonId": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "provenance": {
                    "additionalProperties": false,
                    "properties": {
                      "baselineRunId": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "type": "string"
                      },
                      "candidateSha256": {
                        "pattern": "^[a-f0-9]{64}$",
                        "type": "string"
                      },
                      "cue": {
                        "maxLength": 500,
                        "minLength": 1,
                        "type": "string"
                      },
                      "domain": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "type": "string"
                      },
                      "experimentalMode": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "type": "string"
                      },
                      "libraryVersion": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "type": "string"
                      },
                      "outcome": {
                        "const": "VERIFIED_EFFECTIVE",
                        "type": "string"
                      },
                      "partition": {
                        "enum": [
                          "train",
                          "public",
                          "heldout"
                        ],
                        "type": "string"
                      },
                      "priorLessonHash": {
                        "pattern": "^[a-f0-9]{64}$",
                        "type": "string"
                      },
                      "priorLessonId": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "type": "string"
                      },
                      "recheckRequired": {
                        "const": true,
                        "type": "boolean"
                      },
                      "resourceSha256": {
                        "pattern": "^[a-f0-9]{64}$",
                        "type": "string"
                      },
                      "scope": {
                        "enum": [
                          "workspace",
                          "transferable"
                        ],
                        "type": "string"
                      },
                      "sourceFixtureIds": {
                        "items": {
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                          "type": "string"
                        },
                        "maxItems": 32,
                        "type": "array"
                      },
                      "sourceTaskIndex": {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      "verificationRunId": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "type": "string"
                      },
                      "verifiedTs": {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      "workspaceScope": {
                        "pattern": "^[a-f0-9]{16}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "cue",
                      "scope",
                      "domain",
                      "libraryVersion",
                      "experimentalMode",
                      "sourceTaskIndex",
                      "partition",
                      "workspaceScope",
                      "outcome",
                      "verifiedTs",
                      "baselineRunId",
                      "verificationRunId",
                      "recheckRequired"
                    ],
                    "type": "object"
                  },
                  "severity": {
                    "enum": [
                      "INFO",
                      "WARN",
                      "CRITICAL"
                    ],
                    "type": "string"
                  },
                  "sourceAgentId": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "summary": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "lessonId",
                  "lessonHash",
                  "sourceAgentId",
                  "correctionId",
                  "provenance",
                  "summary",
                  "severity",
                  "category"
                ],
                "type": "object"
              },
              "maxItems": 10,
              "type": "array"
            },
            "libraryDigestSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "request": {
              "additionalProperties": false,
              "properties": {
                "domain": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "experimentalMode": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "libraryVersion": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "maxLessons": {
                  "default": 10,
                  "maximum": 10,
                  "minimum": 1,
                  "type": "integer"
                },
                "runId": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "runStartTs": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "sourceAgentIds": {
                  "items": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  },
                  "maxItems": 16,
                  "minItems": 1,
                  "type": "array"
                },
                "taskIndex": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "runId",
                "runStartTs",
                "taskIndex",
                "domain",
                "libraryVersion",
                "experimentalMode"
              ],
              "type": "object"
            },
            "status": {
              "enum": [
                "SELECTED",
                "NO_ENTRY"
              ],
              "type": "string"
            }
          },
          "required": [
            "status",
            "request",
            "libraryDigestSha256",
            "lessons"
          ],
          "type": "object"
        },
        "topTransformTasks": {
          "items": {
            "properties": {
              "evidenceToVerify": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "taskId": {
                "minLength": 1,
                "type": "string"
              },
              "title": {
                "minLength": 1,
                "type": "string"
              },
              "why": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "taskId",
              "title",
              "why",
              "evidenceToVerify"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "topTransformTasks",
        "currentAdvisories"
      ],
      "type": "object"
    },
    "generatedTs": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "northstar": {
      "properties": {
        "constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "mission": {
          "properties": {
            "sources": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "summary": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "summary",
            "sources"
          ],
          "type": "object"
        },
        "outputContract": {
          "properties": {
            "jsonExample": {
              "properties": {
                "answer": {
                  "minLength": 1,
                  "type": "string"
                },
                "claims": {
                  "default": [],
                  "items": {
                    "properties": {
                      "evidenceRefs": {
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "text": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "nextActions": {
                  "default": [],
                  "items": {
                    "properties": {
                      "actionId": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "requiresApproval": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "actionId",
                      "requiresApproval"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "unknowns": {
                  "default": [],
                  "items": {
                    "properties": {
                      "text": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "v": {
                  "const": 1,
                  "type": "number"
                }
              },
              "required": [
                "v",
                "answer"
              ],
              "type": "object"
            },
            "schemaId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "schemaId",
            "jsonExample"
          ],
          "type": "object"
        },
        "recurrence": {
          "properties": {
            "cadenceHours": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "selfReflectionChecklist": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "cadenceHours",
            "selfReflectionChecklist"
          ],
          "type": "object"
        }
      },
      "required": [
        "mission",
        "constraints",
        "recurrence",
        "outputContract"
      ],
      "type": "object"
    },
    "packId": {
      "pattern": "^pp_[a-zA-Z0-9_-]{8,}$",
      "type": "string"
    },
    "templateId": {
      "minLength": 1,
      "type": "string"
    },
    "v": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "v",
    "packId",
    "generatedTs",
    "templateId",
    "agent",
    "bindings",
    "northstar",
    "allowlists",
    "checkpoints"
  ],
  "title": "AMC Prompt Pack",
  "type": "object"
}
