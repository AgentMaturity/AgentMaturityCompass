{
  "$id": "https://agentmaturity.co/spec/schemas/v1/conformance-results.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "diff": {
            "anyOf": [
              {
                "additionalProperties": {},
                "propertyNames": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "durationMs": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "normative": {
            "type": "boolean"
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "error",
              "skipped"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "normative",
          "outcome",
          "durationMs",
          "diff"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "class": {
      "enum": [
        "verifier",
        "producer",
        "adapter",
        "compiler",
        "a4-record"
      ],
      "type": "string"
    },
    "conformant": {
      "type": "boolean"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "os": {
          "minLength": 1,
          "type": "string"
        },
        "runtime": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "os",
        "runtime"
      ],
      "type": "object"
    },
    "fixtureSetDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "implementation": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "vendor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "vendor",
        "repository",
        "language"
      ],
      "type": "object"
    },
    "runAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
    },
    "signature": {
      "properties": {
        "alg": {
          "enum": [
            "ed25519",
            "ecdsa-p256-sha256"
          ],
          "type": "string"
        },
        "fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "pubkeyB64": {
          "minLength": 1,
          "type": "string"
        },
        "sigB64": {
          "minLength": 1,
          "type": "string"
        },
        "signedTs": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "signer": {
          "properties": {
            "attestationBasis": {
              "enum": [
                "configured",
                "provider-metadata",
                "provider-reported"
              ],
              "type": "string"
            },
            "attestationLevel": {
              "enum": [
                "SOFTWARE",
                "HARDWARE"
              ],
              "type": "string"
            },
            "notaryFingerprint": {
              "maxLength": 64,
              "minLength": 64,
              "type": "string"
            },
            "type": {
              "enum": [
                "VAULT",
                "NOTARY"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "attestationLevel"
          ],
          "type": "object"
        },
        "v": {
          "const": 1,
          "type": "number"
        }
      },
      "required": [
        "v",
        "alg",
        "pubkeyB64",
        "fingerprint",
        "sigB64",
        "signedTs",
        "signer"
      ],
      "type": "object"
    },
    "specVersion": {
      "pattern": "^\\d+\\.\\d+$",
      "type": "string"
    },
    "suiteVersion": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "normativePassed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "normativeTotal": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "normativePassed",
        "normativeTotal"
      ],
      "type": "object"
    }
  },
  "required": [
    "suiteVersion",
    "specVersion",
    "class",
    "fixtureSetDigest",
    "implementation",
    "environment",
    "runAt",
    "cases",
    "summary",
    "conformant"
  ],
  "title": "AMC Conformance Results",
  "type": "object"
}
