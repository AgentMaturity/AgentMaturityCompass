  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "type": "string"
        },
        "authorizationRecordDigest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_sha256": {
          "minLength": 1,
          "type": "string"
        },
        "enforcement": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "level": {
                  "enum": [
                    "none",
                    "advisory",
                    "observed"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "level"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "boundary": {
                  "minLength": 1,
                  "type": "string"
                },
                "level": {
                  "const": "enforced",
                  "type": "string"
                }
              },
              "required": [
                "level",
                "boundary"
              ],
              "type": "object"
            }
          ]
        },
        "event_hash": {
          "minLength": 1,
          "type": "string"
        },
        "executionId": {
          "minLength": 1,
          "type": "string"
        },
        "idempotencyKey": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "llm_request",
            "llm_response",
            "tool_action",
            "tool_result",
            "guard_check",
            "work_accepted",
            "action_state"
          ],
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerId": {
          "type": "string"
        },
        "receipt_id": {
          "minLength": 1,
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "requested",
            "authorized",
            "started",
            "outcome_unknown"
          ],
          "type": "string"
        },
        "ts": {
          "maximum": 9007199254740991,
