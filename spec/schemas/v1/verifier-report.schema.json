{
  "$id": "https://agentmaturity.co/spec/schemas/v1/verifier-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchoring": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "public": {
          "additionalProperties": false,
          "properties": {
            "backend": {
              "anyOf": [
                {
                  "enum": [
                    "rekor-v2"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "detail": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "logIndex": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": [
                "anchored",
                "not-anchored",
                "invalid"
              ],
              "type": "string"
            }
          },
          "required": [
            "status",
            "backend",
            "logIndex",
            "detail"
          ],
          "type": "object"
        },
        "status": {
          "enum": [
            "anchored",
            "unanchored",
            "not-applicable"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "detail"
      ],
      "type": "object"
    },
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "asOf": {
      "type": "string"
    },
    "completeness": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-evaluated"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "reasons"
      ],
      "type": "object"
    },
    "freshness": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-evaluated"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "reasons"
      ],
      "type": "object"
    },
    "integrity": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-evaluated"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "errors"
      ],
      "type": "object"
    },
    "issuerAdmission": {
      "additionalProperties": false,
      "properties": {
        "signatures": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "detail": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "keyId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "listId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "purpose": {
                "enum": [
                  "ledger-row",
                  "receipt",
                  "artifact-seal",
                  "revocation-list",
                  "config-signature",
                  "lease",
                  "session",
                  "release",
                  "notary",
                  "evidence-authority",
                  "independent-attestation",
                  "trust-list-root"
                ],
                "type": "string"
              },
              "signature": {
                "type": "string"
              },
              "source": {
                "anyOf": [
                  {
                    "enum": [
                      "explicit-key",
                      "trust-list",
                      "trust-list-history",
                      "workspace-self"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "admitted",
                  "not-pinned",
                  "wrong-purpose",
                  "not-yet-valid",
                  "expired",
                  "revoked",
                  "distrusted",
                  "unpinned-allowed"
                ],
                "type": "string"
              },
              "timeBasis": {
                "anyOf": [
                  {
                    "const": "claimed",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "signature",
              "purpose",
              "keyId",
              "status",
              "source",
              "listId",
              "timeBasis",
              "detail"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-evaluated"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "signatures"
      ],
      "type": "object"
    },
    "overrides": {
      "items": {
        "enum": [
          "allow-unpinned",
          "allow-unanchored"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "reasonCodes": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "items": {
            "enum": [
              "EMPTY_EVIDENCE",
              "EVIDENCE_MISSING",
              "CONTRADICTORY_EVIDENCE",
              "OUTCOME_UNKNOWN"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "freshness": {
          "items": {
            "enum": [
              "ATTESTATION_EXPIRED",
              "NOT_YET_VALID",
              "REPLAYED_OR_SUPERSEDED",
              "CLAIMED_TIME_BEFORE_KEY_VALIDITY"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "integrity": {
          "items": {
            "enum": [
              "MALFORMED",
              "UNKNOWN_FIELD",
              "UNSUPPORTED_VERSION",
              "DIGEST_MISMATCH",
              "SIGNATURE_INVALID"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "issuerAdmission": {
          "items": {
            "enum": [
              "ISSUER_NOT_PINNED",
              "ISSUER_WRONG_PURPOSE",
              "ISSUER_REVOKED",
              "ISSUER_DISTRUSTED",
              "KEY_NOT_YET_VALID",
              "KEY_EXPIRED",
              "TRUST_LIST_EXPIRED",
              "TRUST_LIST_SIGNATURE_INVALID",
              "UNANCHORED",
              "ROLLBACK_DETECTED"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "satisfaction": {
          "items": {
            "enum": [
              "CLAIMED_RESULT_FAILED",
              "NOT_RECOMPUTABLE"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "scope": {
          "items": {
            "enum": [
              "SCOPE_MISMATCH",
              "FOREIGN_EVIDENCE"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "integrity",
        "issuerAdmission",
        "scope",
        "freshness",
        "completeness",
        "satisfaction"
      ],
      "type": "object"
    },
    "satisfaction": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-evaluated"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "reasons"
      ],
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-evaluated"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "reasons"
      ],
      "type": "object"
    },
    "time": {
      "additionalProperties": false,
      "properties": {
        "attested": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "accuracyMs": {
                  "anyOf": [
                    {
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "genTime": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                  "type": "string"
                },
                "kind": {
                  "const": "rfc3161",
                  "type": "string"
                },
                "messageImprint": {
                  "additionalProperties": false,
                  "properties": {
                    "digest": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "hashAlgorithm": {
                      "const": "sha256",
                      "type": "string"
                    }
                  },
                  "required": [
                    "hashAlgorithm",
                    "digest"
                  ],
                  "type": "object"
                },
                "policyOid": {
                  "type": "string"
                },
                "revocationChecked": {
                  "const": false,
                  "type": "boolean"
                },
                "serialNumber": {
                  "pattern": "^[0-9a-f]+$",
                  "type": "string"
                },
                "tokenDerB64": {
                  "type": "string"
                },
                "tsa": {
                  "additionalProperties": false,
                  "properties": {
                    "anchorId": {
                      "type": "string"
                    },
                    "certSha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "subject": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "subject",
                    "certSha256",
                    "anchorId"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "kind",
                "tsa",
                "genTime",
                "accuracyMs",
                "policyOid",
                "serialNumber",
                "messageImprint",
                "tokenDerB64",
                "revocationChecked"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "claimed",
            "attested-upper-bound",
            "attested-window"
          ],
          "type": "string"
        },
        "claimedAt": {
          "type": "string"
        },
        "window": {
          "additionalProperties": false,
          "properties": {
            "notAfter": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
              "type": "string"
            },
            "notBefore": {
              "anyOf": [
                {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "notBefore",
            "notAfter"
          ],
          "type": "object"
        }
      },
      "required": [
        "claimedAt",
        "attested",
        "basis"
      ],
      "type": "object"
    },
    "trusted": {
      "type": "boolean"
    },
    "type": {
      "const": "amc.verifier-report",
      "type": "string"
    },
    "verifiedAt": {
      "type": "string"
    },
    "verifier": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "version": {
      "const": 1,
      "type": "number"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "type",
    "version",
    "artifact",
    "verifier",
    "verifiedAt",
    "asOf",
    "integrity",
    "issuerAdmission",
    "anchoring",
    "scope",
    "freshness",
    "completeness",
    "satisfaction",
    "trusted",
    "overrides",
    "warnings"
  ],
  "title": "AMC Verifier Report",
  "type": "object"
}
