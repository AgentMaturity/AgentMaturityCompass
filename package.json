{
  "name": "agent-maturity-compass",
  "version": "1.1.1",
  "description": "Tamper-evident maturity scoring, red-team testing, and compliance toolkit for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/**",
    "!dist/sea/**",
    "!dist/installers/**",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "amc": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js && npm run copy-assets",
    "build:pages": "node scripts/build-pages-site.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "brand:render": "node scripts/render-brand-assets.mjs",
    "package:desktop": "node scripts/package-desktop-installers.mjs",
    "package:desktop:verify": "node scripts/verify-desktop-installers.mjs",
    "release:prepare-assets": "node scripts/prepare-public-release-assets.mjs",
    "release:verify-version": "node scripts/verify-release-version.mjs",
    "copy-assets": "rm -rf dist/console/pages dist/console/assets dist/dashboard/templates && mkdir -p dist/console dist/dashboard && cp -r src/console/pages dist/console/pages && cp -r src/console/assets dist/console/assets && cp -r src/dashboard/templates dist/dashboard/templates",
    "dev": "tsx src/cli.ts",
    "api:start": "tsx api/index.ts",
    "lint": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.config.ts",
    "accessibility:release-evidence": "node scripts/write-accessibility-release-evidence.mjs --report tmp/accessibility-playwright.json --out docs/runbooks/accessibility-release-evidence-latest.md",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "release:gate": "node scripts/release-gate.mjs",
    "release:prepack-check": "node scripts/prepack-release-check.mjs",
    "qa:install-personas": "node scripts/install-persona-qa.mjs",
    "qa:dogfood-8-agents": "node scripts/amc-dogfood-8-agents.mjs",
    "research:amc-landscape": "node scripts/research-amc-landscape.mjs",
    "research:amc-landscape:verify": "node scripts/verify-amc-landscape.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=moderate",
    "check:incident-readiness": "node scripts/incident-readiness-check.mjs",
    "check:architecture-boundaries": "node scripts/architecture-boundaries-check.mjs",
    "check:docs-drift": "node scripts/docs-drift-check.mjs",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepack": "npm run release:gate -- --json --out tmp/release-gate/prepack.json && npm run release:prepack-check",
    "postinstall": "node scripts/postinstall.js || true"
  },
  "keywords": [
    "ai-agent",
    "agent-maturity",
    "agent-evaluation",
    "agent-trust",
    "ai-governance",
    "ai-safety",
    "ai-compliance",
    "maturity-model",
    "diagnostic",
    "evidence-ledger",
    "trust-score",
    "agent-ops",
    "eu-ai-act",
    "nist-ai-rmf",
    "iso-42001",
    "red-team",
    "assurance",
    "observability",
    "llm-evaluation",
    "ai-audit",
    "promptfoo-alternative",
    "agent-benchmark",
    "cli-tool"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentMaturity/AgentMaturityCompass.git"
  },
  "homepage": "https://agentmaturity.co",
  "bugs": {
    "url": "https://github.com/AgentMaturity/AgentMaturityCompass/issues"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sdk/mobile-fetch": {
      "import": "./dist/sdk/mobileFetch.js",
      "types": "./dist/sdk/mobileFetch.d.ts"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "inquirer": "^13.3.2",
    "semver": "^7.7.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "qs": "6.15.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@changesets/cli": "^2.30.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/space-mono": "5.2.9",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "8.18.0",
    "date-fns": "^4.1.0",
    "marked": "18.0.6",
    "tsx": "^4.23.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "author": {
    "name": "Sid",
    "url": "https://github.com/AgentMaturity"
  }
}
