{
  "name": "agent-maturity-compass",
  "version": "1.2.0",
  "description": "Tamper-evident maturity scoring, red-team testing, and compliance toolkit for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/**",
    "dist/trust/amc-distrust.json",
    "!dist/sea/**",
    "!dist/installers/**",
    "catalog/**",
    "scripts/postinstall.js",
    "scripts/run-policy-fixtures-ci.mjs",
    "fixtures/policy/amc-ci-policy-fixtures.yaml",
    "deploy/apparmor/**",
    "docs/NATIVE_SANDBOX_UBUNTU.md",
    "README.md",
    "THIRD_PARTY_NOTICES",
    "LICENSE"
  ],
  "bin": {
    "amc": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets && node scripts/bundle-kernel.mjs && npm run api:build && npm run build:verifier",
    "build:verifier": "tsc -p packages/verifier/tsconfig.json",
    "test:verifier-conformance": "node packages/verifier/conformance/run.mjs --cmd \"node packages/verifier/bin/amc-verify.mjs\" --out tmp/conformance-results.json",
    "build:pages": "node scripts/build-pages-site.mjs",
    "docs:api": "typedoc --options typedoc.json",
    "build:sea": "node scripts/build-sea.mjs",
    "brand:render": "node scripts/render-brand-assets.mjs",
    "package:desktop": "node scripts/package-desktop-installers.mjs",
    "package:desktop:verify": "node scripts/verify-desktop-installers.mjs",
    "release:prepare-assets": "node scripts/prepare-public-release-assets.mjs",
    "release:verify-version": "node scripts/verify-release-version.mjs",
    "copy-assets": "node scripts/copy-build-assets.mjs",
    "dev": "tsx src/cli.ts",
    "api:start": "tsx api/index.ts",
    "api:build": "node scripts/build-standalone-api.mjs",
    "api:start:production": "node dist/standalone-api.js",
    "lint": "oxlint --type-aware --deny-warnings -c .oxlintrc.json src && node scripts/lint-contract.mjs && node scripts/check-no-fabrication.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/verifier/tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "accessibility:release-evidence": "node scripts/write-accessibility-release-evidence.mjs --report tmp/accessibility-playwright.json --out docs/runbooks/accessibility-release-evidence-latest.md",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "node scripts/release-prepare.mjs --version-only",
    "release": "node -e \"console.error('Not published from a shell: push the v<version> tag; release.yml is the only publisher (docs/RELEASE_RUNBOOK.md).');process.exit(1)\"",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "check:release-candidate": "node scripts/check-release-candidate.mjs",
    "check:pack-contents": "node scripts/check-pack-contents.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:prepack-check": "node scripts/prepack-release-check.mjs",
    "qa:install-personas": "node scripts/install-persona-qa.mjs",
    "qa:dogfood-8-agents": "node scripts/amc-dogfood-8-agents.mjs",
    "research:amc-landscape": "node scripts/research-amc-landscape.mjs",
    "research:amc-landscape:verify": "node scripts/verify-amc-landscape.mjs",
    "audit:runtime": "pnpm audit --prod --audit-level moderate",
    "check:incident-readiness": "node scripts/incident-readiness-check.mjs",
    "check:architecture-boundaries": "node scripts/architecture-boundaries-check.mjs",
    "check:docs-drift": "node scripts/docs-drift-check.mjs",
    "check:policy-fixtures": "node scripts/run-policy-fixtures-ci.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "npm run clean",
    "prepack": "npm run release:gate -- --json --out tmp/release-gate/prepack.json && npm run release:prepack-check",
    "postinstall": "node scripts/postinstall.js || true",
    "gen-counts": "node scripts/gen-counts.mjs --write",
    "check:counts": "node scripts/gen-counts.mjs --check",
    "gen-industry-guides": "tsx scripts/gen-industry-guides.mts",
    "check:industry-guides": "tsx scripts/gen-industry-guides.mts --check",
    "gen:judge-calibration": "tsx scripts/gen-judge-calibration.mts",
    "check:judge-calibration": "tsx scripts/gen-judge-calibration.mts --check",
    "check:regulatory-calendar": "node scripts/gen-regulatory-calendar.mjs --check",
    "mutation:batch": "node scripts/mutation-batch.mjs",
    "check:freeze": "node scripts/check-freeze.mjs",
    "check:no-fabrication": "node scripts/check-no-fabrication.mjs",
    "check:threat-model": "node scripts/check-threat-model.mjs",
    "check:qualification": "node scripts/check-qualification-receipts.mjs",
    "check:regulatory-currency": "node scripts/check-regulatory-currency.mjs",
    "check:catalog-currency": "node scripts/check-catalog-currency.mjs",
    "check:catalog-changelog": "node scripts/check-catalog-changelog.mjs",
    "check:catalog-admission": "node scripts/check-catalog-admission.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "trust-list": "node scripts/trust-list.mjs",
    "check:compliance-freshness": "node scripts/compliance-artifact-freshness.mjs",
    "check:evidence-paths": "node scripts/evidence-path-check.mjs",
    "gen:api-ref": "node scripts/gen-api-ref.cjs",
    "gen:pack-framework-strings": "node scripts/gen-pack-framework-strings.mjs",
    "check:api-ref": "node scripts/gen-api-ref.cjs --check",
    "gen:schemas": "node scripts/gen-spec-schemas.mjs --write",
    "check:schemas": "node scripts/gen-spec-schemas.mjs --check",
    "gen:pi-conformance-matrix": "node scripts/gen-pi-conformance-matrix.mjs --write",
    "check:question-bank-export": "node scripts/gen-question-bank-export.mjs --check",
    "check:gates": "node scripts/check-gate-reachability.mjs",
    "test:coverage": "vitest run --coverage",
    "gen:changelog-page": "node scripts/gen-changelog-page.mjs",
    "check:changelog-page": "node scripts/gen-changelog-page.mjs --check",
    "vendor:rescope": "node scripts/vendor/rescope-vendor.mjs --apply",
    "check:vendor-links": "node scripts/vendor/verify-vendored-links.mjs",
    "check:vendor-rescope": "node scripts/vendor/rescope-vendor.mjs --check",
    "gen:third-party-notices": "node scripts/vendor/gen-third-party-notices.mjs",
    "check:third-party-notices": "node scripts/vendor/gen-third-party-notices.mjs --check",
    "gen:capability-matrix": "node scripts/gen-capability-matrix.mjs",
    "check:capability-matrix": "node scripts/gen-capability-matrix.mjs --check",
    "build:vendor": "tsc -b vendor/cordis vendor/loader vendor/include vendor/group vendor/timer vendor/hmr vendor/logger-console vendor/schemastery",
    "graph:update": "graphify update .",
    "check:clean-source": "node scripts/clean-source-check.mjs",
    "bundle:kernel": "node scripts/bundle-kernel.mjs",
    "check:packed-install": "node scripts/packed-install-check.mjs",
    "check:sdk-api": "node scripts/check-sdk-api.mjs",
    "qualify:platform": "node scripts/qualify-platform.mjs",
    "check:package": "node scripts/package-lint.mjs",
    "check:duplicates": "node scripts/source-quality.mjs duplicates",
    "conformance:verifier": "node packages/amc-conformance/bin/amc-conformance.mjs run --class verifier --impl \"node packages/verifier/bin/amc-verify.mjs verify {artifact} {verifierArgs}\" --name amc-verify --impl-version 0.1.0 --repository https://github.com/AgentMaturity/AgentMaturityCompass --language TypeScript --out spec/conformance/results/amc-verify-0.1.0.json",
    "check:dead-code": "node scripts/source-quality.mjs dead-code",
    "quality:baseline": "node scripts/source-quality.mjs",
    "check:coverage": "node scripts/per-file-coverage.mjs",
    "check:deploy-pack": "node scripts/deploy/deploy-pack-check.mjs",
    "deploy:rollback-drill": "node scripts/deploy/rollback-drill.mjs",
    "deploy:verify": "node scripts/deploy-verify.mjs",
    "check:credentials-presence": "node scripts/credentials-presence-check.mjs"
  },
  "keywords": [
    "ai-agent",
    "agent-maturity",
    "agent-evaluation",
    "agent-trust",
    "ai-governance",
    "ai-safety",
    "ai-compliance",
    "maturity-model",
    "diagnostic",
    "evidence-ledger",
    "trust-score",
    "agent-ops",
    "eu-ai-act",
    "nist-ai-rmf",
    "iso-42001",
    "red-team",
    "assurance",
    "observability",
    "llm-evaluation",
    "ai-audit",
    "promptfoo-alternative",
    "agent-benchmark",
    "cli-tool"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentMaturity/AgentMaturityCompass.git"
  },
  "homepage": "https://agentmaturity.co",
  "bugs": {
    "url": "https://github.com/AgentMaturity/AgentMaturityCompass/issues"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk/mobile-fetch": {
      "types": "./dist/sdk/mobileFetch.d.ts",
      "import": "./dist/sdk/mobileFetch.js"
    },
    "./sdk/native": {
      "types": "./dist/sdk/nativeAgentClient.d.ts",
      "import": "./dist/sdk/nativeAgentClient.js"
    },
    "./pi": {
      "types": "./dist/adapters/pi/amcPiExtension.d.ts",
      "import": "./dist/adapters/pi/amcPiExtension.js"
    },
    "./standard/external-evidence": {
      "types": "./dist/standard/externalEvidenceProfile.d.ts",
      "import": "./dist/standard/externalEvidenceProfile.js"
    },
    "./telemetry/pi": {
      "types": "./dist/importers/piTelemetryCallbacks.d.ts",
      "import": "./dist/importers/piTelemetryCallbacks.js"
    },
    "./trust": {
      "types": "./dist/trust/index.d.ts",
      "import": "./dist/trust/index.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "inquirer": "^13.3.2",
    "semver": "^7.7.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@aws-sdk/client-kms": "3.1146.0",
    "@google-cloud/kms": "6.2.1",
    "@azure/keyvault-keys": "4.10.2",
    "@azure/identity": "4.13.3",
    "agent-maturity-compass-key-provider-pkcs11": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@aws-sdk/client-kms": {
      "optional": true
    },
    "@google-cloud/kms": {
      "optional": true
    },
    "@azure/keyvault-keys": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "agent-maturity-compass-key-provider-pkcs11": {
      "optional": true
    }
  },
  "devDependencies": {
    "@amc/cordis": "workspace:*",
    "@amc/cordis-plugin-loader": "workspace:*",
    "@amc/core": "workspace:*",
    "@amc/schemastery": "workspace:*",
    "@axe-core/playwright": "^4.11.1",
    "@changesets/cli": "^2.30.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/space-mono": "5.2.9",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "date-fns": "^4.1.0",
    "esbuild": "0.28.2",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "marked": "18.0.6",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.24",
    "tsx": "^4.23.0",
    "typedoc": "0.28.20",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "author": {
    "name": "Sid",
    "url": "https://github.com/AgentMaturity"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "qs": ">=6.16.0",
      "fast-uri": "^3.1.8",
      "@modelcontextprotocol/sdk>hono": "4.13.11",
      "ip-address": "^10.7.1",
      "proxy-addr": "^2.0.8"
    }
  }
}
