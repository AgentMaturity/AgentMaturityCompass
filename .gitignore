# Stray CLI artifacts. These were the symptom of scripts taking argv[2] as an
# output path without checking it was not a flag; the cause is fixed in
# scripts/lib/outputPathArg.mjs, so nothing should land here again.
--json
--verbose
AMC_IMPROVEMENT_ROADMAP.md
# The real files are COMPETITIVE_ANALYSIS_G0DM0D3.md and
# COMPETITIVE_GAP_REPORT_G0DM0D3.md, which this pattern missed, so both stayed
# tracked in a public repo. Widened so future competitive material is excluded.
COMPETITIVE_*.md
# Internal reference; embeds the author's local filesystem paths.
AMC_COMPLETE_KNOWLEDGE.md
..bfg-report/
exports/
!src/exports/
!src/exports/**
tmp/

# AMC workspace artifacts (assurance blobs, ledger)
.amc/blobs/
.amc/ledger/
.amc/reports/
.amc/dashboard/
.amc/gatePolicy.json
test-results/
swarm-report.json
qa/node_modules/
qa/dist/
qa/.env

# Stray artifacts that were committed before these rules existed
.tmp-*
test_model.pkl

# Deployment secrets: only the .example templates are tracked, so an operator
# filling in real values cannot commit them by accident.
deploy/compose/secrets/*.txt
!deploy/compose/secrets/*.txt.example
deploy/k8s/secret.yaml
!deploy/k8s/secret.example.yaml

# Per-workspace runtime state, not source.
#
# These were tracked, so an ordinary `amc rate` dirtied the working tree and
# the committed ratings.json carried a real rating from a test run
# (traceId "test-trace-123"). Each is regenerated on demand: resolveAgentId
# falls back to "default", loadGovernanceState returns defaults when absent,
# and the quality store creates its own file.
#
# .amc/context-graph.json is deliberately NOT here — it is signed-paired with
# .amc/targets/default.target.json, which pins its hash.
.amc/current-agent
.amc/fleet/governance-state.json
.amc/agents/*/quality/ratings.json

# Local-only working area. internal/debug/ held five unreferenced HIPAA
# scratch scripts that were tracked in a public repo; internal/archive/ holds
# sales and handoff material that was untracked but unignored — one `git add .`
# from being published.
internal/
# The workspace installs with pnpm (ADR-0001): the vendored Cordis manifests
# use the `workspace:` protocol, which npm cannot parse. A stray package-lock
# would be a second, silently-drifting source of truth.
package-lock.json
