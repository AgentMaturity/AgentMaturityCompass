interface PendingIndex {
  version: 1; state: "not_evaluated"; measurement: string;
  humanLabels: "pending"; expertMinimumAndTolerances: "pending";
  sidPublicationApproval: "pending"; calibrations: unknown[];
}
const measurement = "not measured; real human labels, expert policy and an authorized model run are unavailable";
const expectedKeys = ["version", "state", "measurement", "humanLabels", "expertMinimumAndTolerances", "sidPublicationApproval", "calibrations"].sort();
function pendingIndex(value: unknown): PendingIndex {
  if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("Calibration status index must be an object");
  const x = value as Record<string, unknown>;
  if (JSON.stringify(Object.keys(x).sort()) !== JSON.stringify(expectedKeys) || x.version !== 1 || x.state !== "not_evaluated" ||
      x.measurement !== measurement || x.humanLabels !== "pending" || x.expertMinimumAndTolerances !== "pending" ||
      x.sidPublicationApproval !== "pending" || !Array.isArray(x.calibrations) || x.calibrations.length !== 0) {
    throw new Error("Only the explicit pending status is publishable here; measured records or approvals need a reviewed publication workflow");
  }
  return x as unknown as PendingIndex;
}
const compare = (a: string, b: string): number => a < b ? -1 : a > b ? 1 : 0;
