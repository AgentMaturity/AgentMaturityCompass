{
  "name": "@amc/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AMC composition kernel: boot, declarative composition, signed config.",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "dependencies": {
    "@amc/cordis": "workspace:^",
    "@amc/cordis-plugin-group": "workspace:^",
    "@amc/cordis-plugin-hmr": "workspace:^",
    "@amc/cordis-plugin-include": "workspace:^",
    "@amc/cordis-plugin-loader": "workspace:^",
    "@amc/cordis-plugin-timer": "workspace:^",
    "@amc/cosmokit": "workspace:^",
    "@amc/schemastery": "workspace:^",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
