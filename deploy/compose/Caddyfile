{
  # Keep internal certificate issuance; only the unpublished HTTP redirect is off.
  auto_https disable_redirects
  skip_install_trust
}

{$AMC_TLS_HOST:localhost}:443 {
  tls internal
  encode gzip

  @console path /console* /auth* /org* /transform* /approvals* /benchmarks* /integrations* /status /healthz /readyz
  handle @console {
    reverse_proxy amc-studio:3212 {
      # Below the shortest idle keep-alive Studio may use (Node's default, 5 s): Caddy must drop an idle upstream connection
      # before Studio closes it, or a request goes out on a closed connection and fails with a 502.
      transport http {
        keepalive 4s
      }
    }
  }

  @gateway path /openai* /anthropic* /gemini* /grok* /openrouter* /local* /__amc/health
  handle @gateway {
    reverse_proxy amc-studio:3210 {
      # Below the shortest idle keep-alive Studio may use (Node's default, 5 s): Caddy must drop an idle upstream connection
      # before Studio closes it, or a request goes out on a closed connection and fails with a 502.
      transport http {
        keepalive 4s
      }
    }
  }

  @proxyHealth path /__amc/proxy-health
  handle @proxyHealth {
    respond "AMC TLS reverse proxy" 200
  }

  # Studio owns /api/v1/* and its other authenticated/native routes.
  handle {
    reverse_proxy amc-studio:3212 {
      # Below the shortest idle keep-alive Studio may use (Node's default, 5 s): Caddy must drop an idle upstream connection
      # before Studio closes it, or a request goes out on a closed connection and fails with a 502.
      transport http {
        keepalive 4s
      }
    }
  }
}
